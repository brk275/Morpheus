                                        MatrixLink.withdraw(); UnreadNavigation.withdraw-jump();
                                        IdentityWarnings.withdraw(); ThreadBrowser.withdraw();
                                        root.member-confirm-open = true;
                                    }
                                }
                                if root.member-selected-membership != "ban" : Button {
