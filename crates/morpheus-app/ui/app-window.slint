                                changed reveal-request => {
                                    if self.reveal-request > 0 {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        self.focus();
                                        if self.has-focus { root.settings-revealed-id = "metric:" + root.metric-selected-key; }
                                    }
                                }
                                x: parent.wide ? metric-list-view.x + metric-list-view.width + 12px : 12px;
                                y: parent.wide ? 12px : metric-list-view.y + metric-list-view.height + 12px;
                                width: parent.wide ? parent.width - metric-list-view.width - 36px : parent.width - 24px;
                                state: root.metric-editor;
                                value-text <=> root.metric-value-input;
                                override-count: root.metric-override-count;
                                reset-all-notice: root.metric-reset-all-notice;
                                ink: root.ink; muted: root.muted; surface: root.canvas; hover-surface: root.hover;
                                accent: root.accent; outline: root.divider; text-scale: root.text-scale;
                                step(direction) => { root.metric-step(direction); }
                                edited(text) => { root.metric-value-edited(text); }
                                accepted(text) => { root.metric-value-accepted(text); }
                                restore-input => { root.metric-chosen(root.metric-selected-key); }
                                reset => { root.metric-reset(); }
                                undo => { root.metric-undo(); }
                                reset-all => { root.metric-reset-all(); }
                            }
                        }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "Base palette for all accounts"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 650; }
                        HorizontalLayout {
                            spacing: 12px;
                            for choice[index] in ["Dark", "Light", "High contrast", "System"] : ActionRect {
                                property <int> reveal-request: index == 0 ? root.reveal-request("appearance.base_palette") : 0;
                                // Keyboard focus and search share the same bounded reveal.
                                changed has-focus => {
                                    if self.has-focus {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    }
                                }
                                changed reveal-request => {
                                    if self.reveal-request > 0 {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        self.focus();
                                        if self.has-focus { root.settings-revealed-id = "appearance.base_palette"; }
                                    }
                                }
                                width: 128px;
                                height: 100px;
                                background: index == root.global-theme-mode ? root.hover : root.elevated;
                                border-color: index == root.global-theme-mode ? root.accent : root.divider;
                                border-width: index == root.global-theme-mode ? 2px : 1px;
                                border-radius: StyleTokens.radius * 1.1;
                                label: "Use " + choice + " theme";
                                reveal-full-control: true; focus-color: root.accent;
                                activated => { root.choose-theme(index); }
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 9px;
                                    Rectangle {
                                        height: 42px;
                                        border-radius: StyleTokens.radius * 0.6;
                                        background: index == 1 ? #e6eaf2 : #11151f;
                                        Rectangle {
                                            x: 8px; y: 8px; width: 30px; height: 26px; border-radius: StyleTokens.radius * 0.4;
                                            background: index == 1 ? #6545b5 : index == 2 ? #ffff00 : #ad91ff;
                                        }
                                    }
                                    Text { text: choice; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; overflow: elide; }
                                }
                            }
                        }
                        if root.account-theme-notice != "" : Text {
                            text: root.account-theme-notice; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                            accessible-role: text; accessible-label: root.account-theme-notice;
                        }
                        font-scale-row := Rectangle {
                            height: max(70px, max(70px * root.text-scale, font-scale-title.preferred-height + font-scale-value.preferred-height + 35px));
                            border-radius: StyleTokens.radius * 1; background: root.elevated;
                            // Anchor both labels to the same row the actions reveal.
                            // Intrinsic text heights accommodate custom fonts without
                            // a nested layout pushing the value beyond the focus band.
                            font-scale-title := Text {
                                x: 16px; width: max(0px, parent.width - 118px);
                                height: self.preferred-height;
                                y: (parent.height - self.height - font-scale-value.height - 3px) / 2;
                                text: "Font scale"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700;
                            }
                            font-scale-value := Text {
                                x: font-scale-title.x; width: font-scale-title.width;
                                height: self.preferred-height;
                                y: font-scale-title.y + font-scale-title.height + 3px;
                                text: root.font-scale-percent + "% · text throughout the app";
                                color: root.muted; font-size: 11px * root.text-scale;
                                accessible-role: text; accessible-label: self.text;
                            }
                            decrease-font-scale := IconAction {
                                property <int> reveal-request: root.reveal-request("appearance.font_scale");
                                // Keyboard focus and search share the same bounded reveal.
                                changed has-focus => {
                                    if self.has-focus {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    }
                                }
                                changed reveal-request => {
                                    if self.reveal-request > 0 {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        self.focus();
                                        if self.has-focus { root.settings-revealed-id = "appearance.font_scale"; }
                                    }
                                }
                                x: increase-font-scale.x - self.width - 9px;
                                y: (parent.height - self.height) / 2;
                                icon: "−"; label: "Decrease font scale"; reveal-full-control: true; reveal-height: font-scale-row.height;
                                ink: root.ink; surface: root.panel; hover-surface: root.hover;
                                activated => { root.change-font-scale(root.font-scale-percent - 10); }
                            }
                            increase-font-scale := IconAction {
                                x: parent.width - self.width - 16px;
                                y: (parent.height - self.height) / 2;
                                icon: "+"; label: "Increase font scale"; reveal-full-control: true; reveal-height: font-scale-row.height;
                                ink: root.ink; surface: root.panel; hover-surface: root.hover;
                                activated => { root.change-font-scale(root.font-scale-percent + 10); }
                            }
                        }
                        Text { text: "Density"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 10px;
                            for choice[index] in ["Compact", "Comfortable", "Spacious"] : ActionRect {
                                property <int> reveal-request: index == 0 ? root.reveal-request("appearance.density") : 0;
                                // Keyboard focus and search share the same bounded reveal.
                                changed has-focus => {
                                    if self.has-focus {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    }
                                }
                                changed reveal-request => {
                                    if self.reveal-request > 0 {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        self.focus();
                                        if self.has-focus { root.settings-revealed-id = "appearance.density"; }
                                    }
                                }
                                width: 142px; height: 40px; border-radius: StyleTokens.radius * 0.9;
                                background: index == root.density-mode ? root.hover : root.elevated;
                                border-color: index == root.density-mode ? root.accent : root.divider;
                                border-width: index == root.density-mode ? 2px : 1px;
                                label: "Use " + choice + " room and message density";
                                reveal-full-control: true; focus-color: root.accent;
                                activated => { root.choose-density(index); }
                                Text { text: choice; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "Layout"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Navigation"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 650; }
                        VerticalLayout {
                            spacing: 6px; alignment: start; vertical-stretch: 0;
                            for choice[index] in ["Icon rail", "Text sidebar"] : TextAction {
                                property <int> reveal-request: index == 0 ? root.reveal-request("layout.navigation") : 0;
                                // Keyboard focus and search share the same bounded reveal.
                                changed has-focus => {
                                    if self.has-focus {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    }
                                }
                                changed reveal-request => {
                                    if self.reveal-request > 0 {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        self.focus();
                                        if self.has-focus { root.settings-revealed-id = "layout.navigation"; }
                                    }
                                }
                                height: 36px * root.text-scale; vertical-stretch: 0;
                                text: choice; label: "Use " + choice + " navigation";
                                ink: root.ink; muted: root.muted; surface: root.navigation-mode == index ? root.hover : root.elevated;
                                hover-surface: root.hover; outline: root.navigation-mode == index ? root.accent : root.divider; text-scale: root.text-scale;
                                activated => { root.choose-navigation-mode(index); }
                            }
                        }
                        TextAction {
                            height: 36px * root.text-scale; vertical-stretch: 0;
                            text: root.show-space-labels ? "Space labels: on" : "Space labels: off";
                            label: root.show-space-labels ? "Hide Space labels in the icon rail" : "Show Space labels in the icon rail";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                            activated => { root.set-show-space-labels(!root.show-space-labels); }
                        }
                        TextAction {
                            height: 36px * root.text-scale; vertical-stretch: 0;
                            text: root.group-direct-messages ? "Separate DMs: on" : "Separate DMs: off";
                            label: root.group-direct-messages ? "Combine rooms and direct messages" : "Group direct messages separately";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                            activated => { root.set-group-direct-messages(!root.group-direct-messages); }
                        }
                        TextAction {
                            // Keyboard focus reveals it; search lands on the details-panel
                            // side below, which is enabled for combined lists too.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            height: 36px * root.text-scale; vertical-stretch: 0;
                            enabled: root.group-direct-messages;
                            text: root.direct-messages-first ? "Direct messages first: on" : "Direct messages first: off";
                            label: root.direct-messages-first ? "Show rooms above direct messages" : "Show direct messages above rooms";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                            activated => { root.set-direct-messages-first(!root.direct-messages-first); }
                        }
                        Text { text: "Details panel side"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 10px; alignment: start;
                            for side[index] in ["Right", "Left"] : TextAction {
                                // The search destination for pane order and density: the
                                // selected side, which is always enabled.
                                property <int> reveal-request: root.reveal-request("layout.composition");
                                changed has-focus => {
                                    if self.has-focus {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    }
                                }
                                // The request can precede creation of this repeated
                                // control when search opens Settings from the timeline.
                                // Initial bindings do not emit changed callbacks.
                                init => { self.reveal-requested-control(); }
                                changed reveal-request => { self.reveal-requested-control(); }
                                function reveal-requested-control() {
                                    if self.reveal-request > 0 && index == root.details-side {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        self.focus();
                                        if self.has-focus { root.settings-revealed-id = "layout.composition"; }
                                    }
                                }
                                height: 36px * root.text-scale; vertical-stretch: 0;
                                text: side; label: "Details panel on the " + side + " of the conversation" + (root.details-side == index ? ", selected" : "");
                                ink: root.ink; muted: root.muted; surface: root.details-side == index ? root.hover : root.elevated;
                                hover-surface: root.hover; outline: root.details-side == index ? root.accent : root.divider; text-scale: root.text-scale;
                                activated => { root.choose-details-side(index); }
                            }
                        }
                        for pane[which] in ["Room list density", "Message density"] : density-row := VerticalLayout {
                            spacing: 6px; alignment: start;
                            property <int> choice: which == 0 ? root.room-density-choice : root.message-density-choice;
                            Text { text: pane; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                // -1 follows the global density; 0 to 2 override it.
                                for option[index] in ["Follow density", "Compact", "Comfortable", "Spacious"] : TextAction {
                                    height: 36px * root.text-scale; vertical-stretch: 0;
                                    text: option; label: pane + ": " + option + (density-row.choice == index - 1 ? ", selected" : "");
                                    ink: root.ink; muted: root.muted; surface: density-row.choice == index - 1 ? root.hover : root.elevated;
                                    hover-surface: root.hover; outline: density-row.choice == index - 1 ? root.accent : root.divider; text-scale: root.text-scale;
                                    activated => { root.choose-pane-density(which, index - 1); }
                                }
                            }
                        }
                        Text {
                            text: "The details panel can sit on either side; Tab order, the room list and the account control stay where they are. Room list and message density override the global density for one pane each.";
                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                        }
                        Text {
                            text: "Text sidebar moves Home, Spaces and app routes into the room list. Combined conversations use name order, with unread conversations first when enabled. Space labels affect only the icon rail.";
                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                        }
                        Rectangle {
                            height: 70px; border-radius: StyleTokens.radius * 1; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Members & thread panel"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: "Show room context beside the conversation"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                IconAction {
                                    icon: root.show-side-panel ? "✓" : "+";
                                    property <int> reveal-request: root.reveal-request("layout.panes");
                                    // Keyboard focus and search share the same bounded reveal.
                                    changed has-focus => {
                                        if self.has-focus {
                                            settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        }
                                    }
                                    changed reveal-request => {
                                        if self.reveal-request > 0 {
                                            settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                            self.focus();
                                            if self.has-focus { root.settings-revealed-id = "layout.panes"; }
                                        }
                                    }
                                    label: root.show-side-panel ? "Hide side panel" : "Show side panel";
                                    ink: root.accent; surface: root.panel; hover-surface: root.hover;
                                    activated => { root.set-side-panel(!root.show-side-panel); }
                                }
                            }
                        }
                        Rectangle {
                            height: 70px; border-radius: StyleTokens.radius * 1; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 9px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Room list width"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: root.room-list-width + " px"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                WidthSpin {
                                    saved: root.room-list-width; minimum: 180; maximum: 480;
                                    label: "Room list width in pixels, 180 to 480";
                                    edited(width) => { root.change-room-list-width(width); }
                                }
                                IconAction { icon: "−"; label: "Narrow room list"; ink: root.ink; surface: root.panel; hover-surface: root.hover; activated => { root.change-room-list-width(root.room-list-width - 20); } }
                                IconAction { icon: "+"; label: "Widen room list"; ink: root.ink; surface: root.panel; hover-surface: root.hover; activated => { root.change-room-list-width(root.room-list-width + 20); } }
                            }
                        }
                        Rectangle {
                            height: 70px; border-radius: StyleTokens.radius * 1; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 9px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Details panel width"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: root.details-width + " px"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                WidthSpin {
                                    saved: root.details-width; minimum: 200; maximum: 520;
                                    label: "Details panel width in pixels, 200 to 520";
                                    edited(width) => { root.change-details-width(width); }
                                }
                                IconAction { icon: "−"; label: "Narrow details panel"; ink: root.ink; surface: root.panel; hover-surface: root.hover; activated => { root.change-details-width(root.details-width - 20); } }
                                IconAction { icon: "+"; label: "Widen details panel"; ink: root.ink; surface: root.panel; hover-surface: root.hover; activated => { root.change-details-width(root.details-width + 20); } }
                            }
                        }
                        // Pane arrangement: presets first, then the full editor.
                        Text { text: "Pane arrangement"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for preset[index] in ["Standard", "Focused", "Conversation first", "Minimal"] : TextAction {
                                height: 36px * root.text-scale; vertical-stretch: 0;
                                property <int> reveal-request: index == 0 ? root.reveal-request("layout.arrangement") : 0;
                                // Keyboard focus and search share the same bounded reveal.
                                changed has-focus => {
                                    if self.has-focus {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    }
                                }
                                changed reveal-request => {
                                    if self.reveal-request > 0 {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        self.focus();
                                        if self.has-focus { root.settings-revealed-id = "layout.arrangement"; }
                                    }
                                }
                                text: preset;
                                label: "Pane arrangement preset: " + preset + (root.layout-preset == index ? ", selected" : "");
                                ink: root.ink; muted: root.muted; surface: root.layout-preset == index ? root.hover : root.elevated;
                                hover-surface: root.hover; outline: root.layout-preset == index ? root.accent : root.divider; text-scale: root.text-scale;
                                activated => { root.choose-layout-preset(index); }
                            }
                        }
                        Text {
                            text: "Standard is the classic order. Focused hides the Space rail and collapses the room list. Conversation first puts the room list on the right. Minimal shows only the conversation and details. The account control stays at the bottom left in every arrangement.";
                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                        }
                        for pane[index] in root.layout-panes : Rectangle {
                            height: root.layout-row-height; border-radius: StyleTokens.radius * 1; background: root.elevated;
                            border-color: root.layout-editor-from == index ? root.accent : transparent;
                            border-width: root.layout-editor-from == index ? 2px : 0px;
                            // Where a dragged row would land: below this row when moving down, above it when moving up.
                            if root.layout-editor-from >= 0 && root.layout-editor-drop == index && root.layout-editor-from != index : Rectangle {
                                y: root.layout-editor-from < index ? parent.height - 3px : 0px;
                                height: 3px;
                                background: root.accent;
                            }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 10px; spacing: 6px;
                                // Drag to reorder; Move left/right do the same by keyboard.
                                Rectangle {
                                    width: 22px;
                                    property <bool> active: false;
                                    property <int> owned-token: 0;
                                    property <int> gesture-token: root.pane-gesture;
                                    changed gesture-token => {
                                        if self.owned-token != self.gesture-token { self.active = false; }
                                    }
                                    property <length> press-y;
                                    border-radius: 4px;
                                    background: grip-touch.has-hover || self.active ? root.hover : transparent;
                                    Text { text: "⋮⋮"; color: root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                                    grip-touch := TouchArea {
                                        enabled: (root.pane-gesture == 0 && root.pane-gesture-allowed) || parent.active;
                                        mouse-cursor: parent.active ? grabbing : grab;
                                        pointer-event(event) => {
                                            if event.kind == PointerEventKind.cancel {
                                                if parent.active && parent.owned-token == root.pane-gesture {
                                                    parent.active = false;
                                                    root.cancel-pane-preview();
                                                }
                                                return;
                                            }
                                            if event.button != PointerEventButton.left {
                                                return;
                                            }
                                            if event.kind == PointerEventKind.down {
                                                if root.start-pane-gesture() {
                                                    parent.owned-token = root.pane-gesture;
                                                    parent.active = true;
                                                    parent.press-y = self.absolute-position.y + self.mouse-y;
                                                    root.pane-dragging = pane.id;
                                                    root.layout-editor-from = index;
                                                    root.layout-editor-drop = index;
                                                }
                                            } else if event.kind == PointerEventKind.up {
                                                if parent.active && parent.owned-token == root.pane-gesture {
                                                    parent.active = false;
                                                    root.finish-pane-order(pane.id, root.pane-gesture != 0 ? root.layout-editor-drop : -1);
                                                }
                                            }
                                        }
                                        moved => {
                                            if parent.active && parent.owned-token == root.pane-gesture && root.pane-gesture != 0 {
                                                root.layout-editor-drop = clamp(index + round((self.absolute-position.y + self.mouse-y - parent.press-y) / (root.layout-row-height + 18px)), 0, 3);
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: pane.label + (pane.hidden ? " · hidden" : pane.collapsed ? " · collapsed" : "");
                                    color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                                }
                                IconAction {
                                    icon: "↑"; label: "Move " + pane.label + " left";
                                    enabled: pane.can-move-up;
                                    ink: root.ink; surface: root.panel; hover-surface: root.hover;
                                    activated => { root.move-pane(pane.id, -1); }
                                }
                                IconAction {
                                    icon: "↓"; label: "Move " + pane.label + " right";
                                    enabled: pane.can-move-down;
                                    ink: root.ink; surface: root.panel; hover-surface: root.hover;
                                    activated => { root.move-pane(pane.id, 1); }
                                }
                                if pane.can-collapse : TextAction {
                                    height: 32px * root.text-scale; vertical-stretch: 0;
                                    text: pane.collapsed ? "Expand" : "Collapse";
                                    label: (pane.collapsed ? "Expand " : "Collapse ") + pane.label;
                                    enabled: !pane.hidden;
                                    ink: root.ink; muted: root.muted; surface: root.panel; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                                    activated => { root.set-pane-collapsed(pane.id, !pane.collapsed); }
                                }
                                if pane.can-hide : TextAction {
                                    height: 32px * root.text-scale; vertical-stretch: 0;
                                    text: pane.hidden ? "Show" : "Hide";
                                    label: (pane.hidden ? "Show " : "Hide ") + pane.label;
                                    ink: root.ink; muted: root.muted; surface: root.panel; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                                    activated => { root.set-pane-hidden(pane.id, !pane.hidden); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            TextAction {
                                height: 34px * root.text-scale; vertical-stretch: 0;
                                text: "Reset order"; label: "Reset the pane order to follow the details side";
                                ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                                activated => { root.reset-pane-order(); }
                            }
                            TextAction {
                                height: 34px * root.text-scale; vertical-stretch: 0;
                                text: "Show all panes"; label: "Show and expand every pane";
                                ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                                activated => { root.reset-pane-visibility(); }
                            }
                            TextAction {
                                height: 34px * root.text-scale; vertical-stretch: 0;
                                text: "Restore default layout"; label: "Restore the default pane layout";
                                ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                                activated => { root.restore-default-layout(); }
                            }
                        }
                        Text {
                            text: (root.layout-editor-from >= 0 ? "Release to move it to position " + (root.layout-editor-drop + 1) + "; Escape cancels. " : "")
                                + "Drag a row's grip, a pane's top grip or a pane edge, or use Move left/right. Stored in config.toml [layout] as pane_order, hidden_panes and collapsed_panes. A narrow window gives way details first, then the room list, then the Space rail; the conversation always stays.";
                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                        }
                        Rectangle {
                            height: 70px; border-radius: StyleTokens.radius * 1; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Unread rooms first"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: root.group-direct-messages ? "Move unread rooms and DMs to the top of each list" : "Move unread conversations to the top of the combined list"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                IconAction {
                                    icon: root.sort-unread-first ? "✓" : "+";
                                    property <int> reveal-request: root.reveal-request("layout.unread_first");
                                    // Keyboard focus and search share the same bounded reveal.
                                    changed has-focus => {
                                        if self.has-focus {
                                            settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        }
                                    }
                                    changed reveal-request => {
                                        if self.reveal-request > 0 {
                                            settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                            self.focus();
                                            if self.has-focus { root.settings-revealed-id = "layout.unread_first"; }
                                        }
                                    }
                                    label: root.sort-unread-first ? "Turn off unread first sorting" : "Turn on unread first sorting";
                                    ink: root.accent; surface: root.panel; hover-surface: root.hover;
                                    activated => { root.set-sort-unread-first(!root.sort-unread-first); }
                                }
                            }
                        }
                        Rectangle {
                            height: 70px; border-radius: StyleTokens.radius * 1; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 9px;
