    in-out property <int> composer-mention-index: 0;
    in-out property <[MentionItem]> thread-mentions;
    in-out property <[EmojiItem]> emoji-items;
    in-out property <int> emoji-index: 0;
    in-out property <bool> emoji-open: false;
    in-out property <bool> emoji-threaded: false;
    in-out property <string> emoji-query-text;
    in-out property <bool> sticker-open: false;
    in-out property <bool> sticker-threaded: false;
    in-out property <[StickerItem]> sticker-items;
    in-out property <[string]> sticker-packs;
    in-out property <int> sticker-pack-index: 0;
    in-out property <int> sticker-index: -1;
    in-out property <string> sticker-query-text;
    in-out property <int> sticker-phase: 0;
    in-out property <string> sticker-status;
    in-out property <string> sticker-notice;
    in-out property <bool> sticker-needs-consent: false;
    in-out property <image> sticker-preview-image;
    in-out property <bool> sticker-preview-loaded: false;
    in-out property <string> sticker-preview-status;
    in-out property <bool> sticker-can-send: false;
    in-out property <bool> sticker-send-visible: false;
    in-out property <bool> sticker-send-threaded: false;
    in-out property <string> sticker-send-status;
    in-out property <bool> sticker-send-can-cancel: false;
    in-out property <bool> sticker-send-can-retry: false;
    in-out property <bool> sticker-send-uncertain: false;
    // The destination the picker and send status belong to; any change closes
    // or hides them before a stale choice can act.
    property <string> sticker-scope: root.active-account-local-id + "\n" + root.active-room-id + "\n" + root.thread-root-id + "\n" + root.composer-mode + "\n" + root.side-panel-tab;
    changed sticker-scope => { root.sticker-context-changed(); }
    // Poll drafts, pending votes and the create dialog belong to one account,
    // room and thread view; any change drops them before a stale action can run.
    property <string> poll-scope: (root.live-session ? "live" : "") + "\n" + root.active-account-local-id + "\n" + root.active-room-id + "\n" + root.thread-root-id + "\n" + root.timeline-jump-event-id + "\n" + (root.conversation-focused ? "focused" : "live");
    changed poll-scope => { root.poll-context-changed(); }
    // Typing names, Seen by and automatic read receipts belong to one live
    // account, room, page and shown thread; any change re-scopes them.
    property <string> activity-scope: (root.live-session ? "live" : "") + "\n" + root.active-account-local-id + "\n" + root.active-room-id + "\n" + root.page + "\n" + (root.show-side-panel && root.side-panel-tab == 1 ? root.thread-root-id : "");
    changed activity-scope => { RoomActivity.context-changed(); }
    property <bool> composer-focus-thread: false;
    property <int> composer-focus-request: 0;

    in-out property <int> thread-mention-index: 0;
    out property <bool> mention-ui-allowed: root.live-session && root.page == 0 && !root.show-sign-in && !root.account-menu-open && !root.manage-accounts-open && !root.access-open && !root.room-actions-open && !root.room-admin-open && !root.member-confirm-open && !root.native-capture-picker-open && !root.leave-call-dialog && root.security-recovery-key == "" && !root.quick-switcher-open && !root.people-open && !MemberPrivacy.inspector.open && !root.image-preview-open && !SpaceRooms.open && !RoomAddresses.open && !MatrixLink.open && !RoomLeave.view.open && !IdentityWarnings.open && !InvitationsState.open;
    changed mention-ui-allowed => { if !root.mention-ui-allowed { root.mention-context-changed(); root.sticker-context-changed(); } }
    // A Matrix link (matrix-link.slint), and a joined link's message still to
    // come, are withdrawn when anything else takes over: another page, sign-in,
    // the account and security surfaces, and every modal below. Rust's
    // matrix_links::surface_blocked reads this one list. The session ending also
    // withdraws a link (matrix-link-protected), while a signed-out card of its
    // own may still show. Each entry also withdraws the link synchronously
    // before it opens; this handler is the fallback for a route that does not.
    out property <bool> matrix-link-protected: !root.live-session || root.matrix-link-blocked;
    // Leave uses the same complete protected-surface inventory at its entry.
    // The header's More menu holds links too while it is open (it is not in
    // Leave's list: More closes before its Leave item runs).
    out property <bool> matrix-link-blocked: root.room-leave-blocked || RoomLeave.view.open || root.header-more-open;
    out property <bool> room-leave-blocked: root.page != 0
        || root.show-sign-in || root.access-open || root.manage-accounts-open
        || root.account-menu-open || root.account-switch-pending
        || root.security-busy || root.security-recovery-key != "" || root.sas-busy
        || root.sas-stage != 0
        || root.account-profile-open || root.people-open || MemberPrivacy.inspector.open
        || SpaceExplorer.open || SpaceRooms.open || RoomAddresses.open
        || RoomNotificationState.open || RoomActivity.seen-open || root.quick-switcher-open
        || root.room-actions-open || root.room-admin-open || root.member-confirm-open
        || root.native-capture-picker-open || root.leave-call-dialog
        || root.image-preview-open || root.poll-dialog-open || ThreadBrowser.open
        || IdentityWarnings.open || InvitationsState.open;
    changed room-leave-blocked => {
        if root.room-leave-blocked && RoomLeave.view.open { RoomLeave.close(); }
    }
    // A created room's open (room_creation.rs) is admitted only while no
    // newer protected surface is up; Rust's room_creation::surface_blocked
    // reads this one list. It is Leave's inventory without the room-actions
    // dialog the creation runs in and without the page (the dialog covers
    // the rail, and every route to another page withdraws the open first),
    // plus Leave itself, a Matrix link card and the header's More menu. The
    // open is the window's owned automatic open, so each of those entries
    // also withdraws it synchronously first (MatrixLink.withdraw(), Rust's
    // matrix_links::clear); refused here, it is ended for good.
    out property <bool> room-creation-blocked: root.show-sign-in || root.access-open
        || root.manage-accounts-open
        || root.account-menu-open || root.account-switch-pending
        || root.security-busy || root.security-recovery-key != "" || root.sas-busy
        || root.sas-stage != 0
        || root.account-profile-open || root.people-open || MemberPrivacy.inspector.open
        || SpaceExplorer.open || SpaceRooms.open || RoomAddresses.open
        || RoomNotificationState.open || RoomActivity.seen-open || root.quick-switcher-open
        || root.room-admin-open || root.member-confirm-open
        || root.native-capture-picker-open || root.leave-call-dialog
        || root.image-preview-open || root.poll-dialog-open || ThreadBrowser.open
        || IdentityWarnings.open || InvitationsState.open
        || MemberPrivacy.ignored.stage != 0 || MemberPrivacy.ignored.busy
        || RoomLeave.view.open || MatrixLink.open || root.header-more-open;
    // The "+" room-action entry's own admission (room-action-trigger): its
    // button's enabled state, which its accessibility default action, click
    // and keys obey, and the first check of its handler, before any reset,
    // peer withdrawal or RoomCreation.begin. Refused while its own dialog is
    // up or a creation step of it is still under way (entering again would
    // clear that attempt and drop its late result and room ID), and while
    // any incompatible visible owner is shown (room-creation-blocked above:
    // Leave, the thread browser, identity details, the invitations center,
    // a link card, More and the account, security and modal surfaces). It
    // reads no page and no session, so the offline preview and the Settings
    // page keep the entry. A refused entry changes nothing.
    out property <bool> room-creation-entry-blocked: root.room-actions-open
        || RoomCreation.busy || RoomCreation.relinking || root.room-creation-blocked;
    changed matrix-link-protected => { if root.matrix-link-protected { MatrixLink.context-protected(); UnreadNavigation.withdraw-jump(); } }
    // The thread browser (thread-browser.slint) may show and act only while
    // this holds; Rust's thread_browser::held reads it, so the two are one
    // predicate. The session is live, the conversation page is shown, and
    // nothing else owns the window: no sign-in, no account or security
    // surface, no Matrix link card, and no other panel or dialog (the
    // browser's own is not one of them). Each of those surfaces' entries also
    // withdraws the browser before it opens; this handler is the fallback.
