    in-out property <bool> notification-sounds: true;
    in-out property <bool> notification-show-preview: false;
    in-out property <[string]> notification-highlight-words;
    in-out property <string> notification-highlight-input;
    in-out property <string> notification-highlight-error;
    in-out property <int> room-list-width: 262;
    in-out property <int> details-width: 250;
    in-out property <bool> show-side-panel: true;
    in-out property <string> ui-font-family: "Inter";
    in-out property <string> message-font-family: "Inter";
    in-out property <string> monospace-font-family: "monospace";
    in-out property <int> message-font-size: 14;
    in-out property <int> sender-font-weight: 0; // zero preserves each surface's legacy weight
    in-out property <int> timestamp-format: 0; // 12-hour, 24-hour, 24-hour with seconds
    in-out property <bool> timestamp-brackets: false;
    in-out property <int> timestamp-width-px: 72;
    in-out property <int> corner-radius-px: 10;
    in-out property <int> message-gap-px: 12;
