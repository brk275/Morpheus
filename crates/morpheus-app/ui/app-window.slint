    out property <int> side-panel-tab: 0;
    in-out property <int> page: 0; // 0 chat, 1 settings, 2 call stage
    changed page => {
        if root.page != 0 { root.details-reveal-open = false; }
        root.cancel-room-settings();
        root.close-image-preview();
        if root.page != 1 {
            // Leaving Settings ends a recording, so shortcuts never stay paused.
            if root.shortcut-recording != "" { root.shortcut-cancel-recording(); }
            root.security-recovery-input = "";
            // Leaving Settings closes the verification view: its values go now.
            root.sas-compared = false;
            root.sas-emoji = "";
            root.sas-decimals = "";
            root.verification-protected();
            root.device-sessions-left();
            root.notification-highlight-error = "";
        }
        if root.page != 2 { root.native-capture-picker-open = false; }
        // A hidden stage pauses and stops decoding every remote video stream.
        root.native-call-stage-presented(root.page == 2);
    }
    changed native-call-joined => {
        if !root.native-call-joined { root.native-capture-picker-open = false; }
    }
