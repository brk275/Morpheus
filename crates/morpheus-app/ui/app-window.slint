                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                            accessible-label: "Call invitation status: " + root.native-invitation-status;
                            accessible-live-region: polite;
                        }
                    }
                    if root.live-session : CallStage {
                        vertical-stretch: 1;
                        tiles: root.native-call-tiles;
                        featured: root.native-call-featured;
                        featured-visible: root.native-call-featured-visible;
                        frames: root.native-call-frames;
                        page: root.native-call-page;
                        pages: root.native-call-pages;
                        tile-count: root.native-call-tile-count;
                        media-degraded: root.native-call-media-degraded;
                        participants: root.native-call-participants;
                        call-connected: root.call-connected;
                        calls-enabled: root.native-call-enabled;
                        legacy-mode: root.room-call-mode == 2;
                        can-open-slot: root.native-call-enabled && !root.call-connected && !root.native-call-request-pending && root.room-call-mode != 2;
                        text-scale: root.text-scale;
                        corner: StyleTokens.radius;
                        motion: StyleTokens.interaction-duration;
                        palette: {
                            ink: root.ink,
                            muted: root.muted,
                            panel: root.panel,
                            elevated: root.elevated,
                            hover: root.hover,
                            accent: root.accent,
                            accent-ink: root.accent-ink,
                            divider: root.divider,
                            backdrop: StyleTokens.roles.media-backdrop.present ? StyleTokens.roles.media-backdrop.color : #11131b,
                            focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
                            voice: StyleTokens.roles.voice.present ? StyleTokens.roles.voice.color : #78c8b1,
                            avatar-ink: StyleTokens.roles.avatar-ink.present ? StyleTokens.roles.avatar-ink.color : #ffffff
                        };
                        pin-tile(id) => { root.pin-native-call-tile(id); }
                        page-tiles(delta) => { root.page-native-call-tiles(delta); }
                        open-slot => { root.open-native-call-slot(); }
                    }
                    if !root.live-session : HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 12px;
                        Rectangle {
                            horizontal-stretch: 1; background: root.elevated; border-radius: StyleTokens.radius * 1.4;
                            AvatarBadge { x: (parent.width - 74px) / 2; y: (parent.height - 74px) / 2 - 16px; width: 74px; height: 74px; built-in-radius: 24px; initials: "CY"; accent: #a88cff; }
                            Text { y: parent.height - 43px; text: "Casey"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; horizontal-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1; background: root.elevated; border-radius: StyleTokens.radius * 1.4;
                            AvatarBadge { x: (parent.width - 74px) / 2; y: (parent.height - 74px) / 2 - 16px; width: 74px; height: 74px; built-in-radius: 24px; initials: "JN"; accent: #f39f78; }
                            Text { y: parent.height - 43px; text: "Jules"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; horizontal-alignment: center; }
                        }
                    }
                    if !root.live-session : HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 12px;
                        Rectangle {
                            horizontal-stretch: 1; background: root.elevated; border-radius: StyleTokens.radius * 1.4;
                            AvatarBadge { x: (parent.width - 74px) / 2; y: (parent.height - 74px) / 2 - 16px; width: 74px; height: 74px; built-in-radius: 24px; initials: "SK"; accent: #78c8b1; }
                            Text { y: parent.height - 43px; text: "Sam"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; horizontal-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1; background: root.panel; border-radius: StyleTokens.radius * 1.4;
                            Text { text: "Your camera is off"; color: root.muted; font-size: 13px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    Rectangle {
                        height: 62px; background: root.panel; border-radius: StyleTokens.radius * 1.2;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
                            if !root.live-session : IconAction { width: 43px; height: 43px; icon: root.mic-muted ? "mic-off" : "mic"; label: root.mic-muted ? "Unmute microphone preview" : "Mute microphone preview"; ink: root.ink; surface: root.elevated; hover-surface: root.hover; activated => { root.mic-muted = !root.mic-muted; } }
                            if !root.live-session : IconAction { width: 43px; height: 43px; icon: root.camera-off ? "camera-off" : "camera"; label: root.camera-off ? "Turn camera preview on" : "Turn camera preview off"; ink: root.ink; surface: root.elevated; hover-surface: root.hover; activated => { root.camera-off = !root.camera-off; } }
                            if root.live-session : ActionRect {
                                width: 88px; height: 43px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.9;
                                background: root.native-microphone-muted && root.native-audio-ready ? root.hover
                                    : root.control-fill(self.enabled && self.has-hover, self.enabled && self.has-pressed, root.elevated);
                                focus-color: root.accent;
                                label: root.native-microphone-muted ? "Unmute microphone" : "Mute microphone";
                                enabled: root.native-call-enabled && root.native-audio-ready;
                                activated => { root.toggle-native-microphone(); }
                                VerticalLayout {
                                    alignment: center; spacing: 2px;
                                    HorizontalLayout { alignment: center; MorpheusIcon { width: 16px; height: 16px; icon: root.native-microphone-muted ? "mic-off" : "mic"; ink: root.native-audio-ready ? root.ink : root.control-disabled-ink; } }
                                    Text {
                                        text: root.native-microphone-muted ? "Unmute mic" : "Mute mic";
                                        color: root.native-audio-ready ? root.ink : root.control-disabled-ink;
                                        font-size: 12px * root.text-scale; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }
                            if root.live-session : ActionRect {
                                width: 88px; height: 43px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.9;
                                background: root.native-deafened && root.native-audio-ready ? root.hover
                                    : root.control-fill(self.enabled && self.has-hover, self.enabled && self.has-pressed, root.elevated);
                                focus-color: root.accent;
                                label: root.native-deafened ? "Undeafen speaker" : "Deafen speaker";
                                enabled: root.native-call-enabled && root.native-audio-ready;
                                activated => { root.toggle-native-deafen(); }
                                VerticalLayout {
                                    alignment: center; spacing: 2px;
                                    HorizontalLayout { alignment: center; MorpheusIcon { width: 16px; height: 16px; icon: root.native-deafened ? "headphones-off" : "headphones"; ink: root.native-audio-ready ? root.ink : root.control-disabled-ink; } }
                                    Text {
                                        text: root.native-deafened ? "Undeafen" : "Deafen";
                                        color: root.native-audio-ready ? root.ink : root.control-disabled-ink;
                                        font-size: 12px * root.text-scale; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }
                            if root.live-session : ActionRect {
                                width: 96px; height: 43px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.9;
                                background: root.native-camera-active ? root.hover
                                    : root.control-fill(self.enabled && self.has-hover, self.enabled && self.has-pressed, root.elevated);
                                focus-color: root.accent;
                                label: root.native-camera-active ? "Stop camera" : "Choose camera and start video";
                                accessible-checkable: true;
                                accessible-checked: root.native-camera-active;
                                enabled: root.native-call-enabled && root.native-call-joined && !root.native-camera-busy;
                                activated => {
                                    if root.native-camera-active { root.stop-native-capture(0); }
                                    else {
                                        root.native-capture-picker-kind = 0;
                                        root.native-capture-picker-open = true;
                                        root.refresh-native-capture-sources(0);
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 2px;
                                    HorizontalLayout { alignment: center; MorpheusIcon { width: 16px; height: 16px; icon: root.native-camera-active ? "camera" : "camera-off"; ink: root.native-call-joined ? root.ink : root.control-disabled-ink; } }
                                    Text {
                                        text: root.native-camera-stopping ? "Stopping…" : root.native-camera-busy ? "Camera…" : root.native-camera-active ? "Stop camera" : "Camera";
                                        color: root.native-call-joined ? root.ink : root.control-disabled-ink;
                                        font-size: 11px * root.text-scale; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }
                            if root.live-session : ActionRect {
                                width: 106px; height: 43px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.9;
                                background: root.native-screen-active ? root.hover
                                    : root.control-fill(self.enabled && self.has-hover, self.enabled && self.has-pressed, root.elevated);
                                focus-color: root.accent;
                                label: root.native-screen-selecting ? "Cancel system screen selection" : root.native-screen-active ? "Stop screen sharing" : "Choose a display or window to share";
                                accessible-checkable: true;
                                accessible-checked: root.native-screen-active;
                                enabled: root.native-call-enabled && root.native-call-joined && (!root.native-screen-busy || root.native-screen-selecting);
                                activated => {
                                    if root.native-screen-active || root.native-screen-selecting { root.stop-native-capture(1); }
                                    else {
                                        root.native-capture-picker-kind = 1;
                                        root.native-capture-picker-open = true;
                                        root.refresh-native-capture-sources(1);
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 2px;
                                    HorizontalLayout { alignment: center; MorpheusIcon { width: 16px; height: 16px; icon: root.native-screen-active || root.native-screen-selecting ? "screen-share-stop" : "screen-share"; ink: root.native-call-joined ? root.ink : root.control-disabled-ink; } }
                                    Text {
                                        text: root.native-screen-stopping ? "Stopping…" : root.native-screen-selecting ? "Cancel selection" : root.native-screen-busy ? "Starting…" : root.native-screen-active ? "Stop share" : "Share screen";
                                        color: root.native-call-joined ? root.ink : root.control-disabled-ink;
                                        font-size: 11px * root.text-scale; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }
                            ActionRect {
                                width: 110px; height: 43px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.9; background: root.live-session && !root.native-call-enabled ? root.hover : root.call-connected ? (StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : #d65163) : root.accent;
                                focus-color: root.live-session && !root.native-call-enabled ? root.muted : root.call-connected ? (StyleTokens.roles.destructive-ink.present ? StyleTokens.roles.destructive-ink.color : #10131b) : root.accent-ink;
                                label: root.live-session ? (root.native-leave-unconfirmed ? "Review incomplete call cleanup" : (root.call-connected ? "Leave native call" : "Join native call")) : (root.call-connected ? "End call preview" : "Start call preview");
                                enabled: !root.live-session || root.native-call-enabled;
                                activated => {
                                    if root.live-session {
                                        if root.native-call-enabled {
                                            if root.native-leave-unconfirmed { root.pending-account-index = -4; root.leave-call-dialog = true; }
                                            else if root.call-connected { root.end-native-call(); }
                                            else { root.start-native-call(); }
                                        }
                                    } else { root.call-connected = !root.call-connected; }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 2px;
                                    HorizontalLayout { alignment: center; MorpheusIcon { width: 16px; height: 16px; icon: root.call-connected ? "call-leave" : "calls"; ink: root.live-session && !root.native-call-enabled ? root.muted : root.call-connected ? (StyleTokens.roles.destructive-ink.present ? StyleTokens.roles.destructive-ink.color : #10131b) : root.accent-ink; } }
                                    Text { text: root.live-session ? (root.native-call-enabled ? (root.native-leave-unconfirmed ? "Review leave" : (root.call-connected ? "Leave call" : (root.room-call-mode == 2 ? "Join legacy call" : "Join call"))) : "Unavailable") : (root.call-connected ? "End preview" : "Start preview"); color: root.live-session && !root.native-call-enabled ? root.muted : root.call-connected ? (StyleTokens.roles.destructive-ink.present ? StyleTokens.roles.destructive-ink.color : #10131b) : root.accent-ink; font-size: 13px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            IconAction { width: 40px; height: 43px; icon: "chat"; label: "Return to chat"; ink: root.ink; surface: root.elevated; hover-surface: root.hover; activated => { root.page = 0; } }
                        }
                    }
                }
            }
        }

        if root.show-side-panel && root.page == 0 : Rectangle {
            x: root.pane-x(root.pane-slot-details);
            y: main-area.y;
            height: main-area.height;
            width: root.pane-details-w;
            visible: root.pane-details-w > 0px;
            clip: true;
            background: root.window-panel;
            // Opt-in decorative fade-in: immediate at 0 ms and under reduced motion.
            property <bool> entered: false;
            // Opacity is first read here, at 0, so setting `entered` animates it;
            // `init` would set it before that first read and nothing would fade.
            Timer { interval: 1ms; running: !parent.entered && parent.opacity < 1; triggered => { parent.entered = true; } }
            opacity: StyleTokens.panel-duration == 0ms || self.entered ? 1 : 0;
            animate opacity { duration: StyleTokens.panel-duration; easing: ease-out; }
            border-color: root.divider;
            border-width: StyleTokens.line-width;
            accessible-role: region;
            accessible-label: "Conversation details";
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: max(64px, 40px * root.text-scale + 24px);
                    background: transparent;
                    details-tabs := HorizontalLayout {
                        // Tabs show their caption beside the icon only when every
                        // tab has room for it; the accessible label never changes.
                        property <bool> show-captions: self.width >= 440px * root.text-scale;
                        padding-left: 12px; padding-right: 12px; padding-top: 14px; padding-bottom: 14px; spacing: 4px;
                        ActionRect {
                            horizontal-stretch: 1; height: 34px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8;
                            background: root.side-panel-tab == 0 ? root.hover : transparent;
                            focus-color: root.accent;
                            label: "Show members";
                            accessible-checkable: true;
                            accessible-checked: root.side-panel-tab == 0;
                            activated => { root.side-panel-tab = 0; }
                            HorizontalLayout {
                                alignment: center; spacing: 6px;
                                VerticalLayout { alignment: center; MorpheusIcon { width: 16px * root.text-scale; height: 16px * root.text-scale; icon: "members"; ink: root.side-panel-tab == 0 ? root.ink : root.muted; } }
                                if details-tabs.show-captions : Text { text: "Members"; color: root.side-panel-tab == 0 ? root.ink : root.muted; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        ActionRect {
                            horizontal-stretch: 1; height: 34px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8;
                            background: root.side-panel-tab == 1 ? root.hover : transparent;
                            focus-color: root.accent;
                            label: "Show thread";
                            accessible-checkable: true;
                            accessible-checked: root.side-panel-tab == 1;
                            activated => { root.side-panel-tab = 1; }
                            HorizontalLayout {
                                alignment: center; spacing: 6px;
                                VerticalLayout { alignment: center; MorpheusIcon { width: 16px * root.text-scale; height: 16px * root.text-scale; icon: "thread"; ink: root.side-panel-tab == 1 ? root.ink : root.muted; } }
                                if details-tabs.show-captions : Text { text: "Thread"; color: root.side-panel-tab == 1 ? root.ink : root.muted; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        ActionRect {
                            horizontal-stretch: 1; height: 34px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8;
                            background: root.side-panel-tab == 2 ? root.hover : transparent;
                            focus-color: root.accent;
                            label: "Search messages";
                            accessible-checkable: true;
                            accessible-checked: root.side-panel-tab == 2;
                            enabled: root.live-session;
                            activated => { root.side-panel-tab = 2; }
                            HorizontalLayout {
                                alignment: center; spacing: 6px;
                                VerticalLayout { alignment: center; MorpheusIcon { width: 16px * root.text-scale; height: 16px * root.text-scale; icon: "search"; ink: root.side-panel-tab == 2 ? root.ink : root.muted; } }
                                if details-tabs.show-captions : Text { text: "Search"; color: root.side-panel-tab == 2 ? root.ink : root.muted; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        ActionRect {
                            horizontal-stretch: 1; height: 34px;
                            border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8;
                            background: root.side-panel-tab == 3 ? root.hover : transparent;
                            focus-color: root.accent;
                            label: "Show pinned messages";
                            accessible-checkable: true;
                            accessible-checked: root.side-panel-tab == 3;
                            enabled: root.live-session && root.active-room-id != "";
                            activated => {
                                if !root.pinned-pane-visible { root.pinned-focus-pending = true; }
                                root.side-panel-tab = 3;
                            }
                            HorizontalLayout {
                                alignment: center; spacing: 6px;
                                VerticalLayout { alignment: center; MorpheusIcon { width: 16px * root.text-scale; height: 16px * root.text-scale; icon: "pin"; ink: root.side-panel-tab == 3 ? root.ink : root.muted; } }
                                if details-tabs.show-captions : Text { text: "Pins"; color: root.side-panel-tab == 3 ? root.ink : root.muted; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                            }
                        }
                        ActionRect {
                            horizontal-stretch: 1; height: 34px;
                            border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8;
                            background: root.side-panel-tab == 4 ? root.hover : transparent;
                            focus-color: root.accent;
                            label: "Show transfers";
                            accessible-checkable: true;
                            accessible-checked: root.side-panel-tab == 4;
                            enabled: root.live-session;
                            activated => { root.side-panel-tab = 4; }
                            HorizontalLayout {
                                alignment: center; spacing: 6px;
                                VerticalLayout { alignment: center; MorpheusIcon { width: 16px * root.text-scale; height: 16px * root.text-scale; icon: "files"; ink: root.side-panel-tab == 4 ? root.ink : root.muted; } }
                                if details-tabs.show-captions : Text { text: "Files"; color: root.side-panel-tab == 4 ? root.ink : root.muted; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                            }
                        }
                    }
                }
                Rectangle { height: StyleTokens.line-width; background: root.divider; }
                if root.side-panel-tab == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;
                    HorizontalLayout {
                        height: 48px; padding-left: 12px; padding-right: 10px; spacing: 6px;
                        Text {
                            text: "ROOM MEMBERS — " + root.members.length;
                            color: root.muted; font-size: 10px * root.text-scale;
                            font-weight: 750; letter-spacing: 1px;
                            vertical-alignment: center; horizontal-stretch: 1;
                            accessible-live-region: polite;
                        }
                        if root.live-session : IconAction {
                            width: 28px; height: 28px;
                            icon: "refresh"; label: "Refresh room members";
                            ink: root.icon-ink; surface: transparent; hover-surface: root.hover;
                            enabled: !root.member-loading && root.active-room-id != "";
                            activated => { root.refresh-room-members(); }
                        }
                    }
                    if root.live-session && root.member-loading : Text {
                        height: 32px; text: "Loading members…";
                        color: root.muted; font-size: 11px * root.text-scale;
                        horizontal-alignment: center; vertical-alignment: center;
                        accessible-live-region: polite;
                    }
                    if root.live-session && root.member-error != "" : Text {
                        height: 58px; text: root.member-error;
                        color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #d65163; font-size: 11px * root.text-scale;
                        wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
                        accessible-live-region: assertive;
                    }
                    if root.live-session && !root.member-loading && root.member-error == "" && root.members.length == 0 : Text {
                        height: 52px; text: "No members to show";
                        color: root.muted; font-size: 11px * root.text-scale;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    if root.live-session && root.active-room-id != "" : Text {
                        height: 21px; text: "INVITE BY MATRIX USER ID";
                        color: root.muted; font-size: 10px * root.text-scale;
                        font-weight: 700;
                    }
                    if root.live-session && root.active-room-id != "" : HorizontalLayout {
                        height: max(42px, 32px * root.text-scale); padding-left: 10px; padding-right: 10px; spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1; background: root.elevated;
                            border-radius: StyleTokens.radius * 0.7; border-color: root.divider; border-width: StyleTokens.line-width;
                            ThemedTextInput {
                                x: 7px; width: parent.width - 14px; height: parent.height;
                                text <=> root.member-invite-user-id;
                                color: root.ink; font-size: 11px * root.text-scale;
                                enabled: !RoomAddresses.open && !root.member-action-busy;
                                accessible-label: "Matrix user ID to invite to this room";
                                accepted => {
                                    if root.member-invite-user-id != "" && !root.member-action-busy {
                                        root.submit-member-action(0, root.member-invite-user-id, "");
                                    }
                                }
                            }
                        }
                        TextAction {
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            text: "Invite";
                            enabled: !RoomAddresses.open && !root.member-action-busy && root.member-invite-user-id != "";
                            accessible-label: "Invite Matrix user to this room";
                            activated => { root.submit-member-action(0, root.member-invite-user-id, ""); }
                        }
                    }
                    if root.member-action-error != "" : Text {
                        height: 44px; text: root.member-action-error;
                        color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483; font-size: 11px * root.text-scale;
                        wrap: word-wrap; accessible-live-region: polite;
                    }
                    if root.member-action-notice != "" : Text {
                        height: 26px; text: root.member-action-notice;
                        color: root.accent; font-size: 11px * root.text-scale;
                        overflow: elide; accessible-live-region: polite;
                    }
                    member-list := ListView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        // Details and Manage sit beside the name when they leave it room,
                        // otherwise in one line below it, otherwise one per line, so at
                        // the narrowest details pane (200 px) and 200% text both stay
                        // whole and reachable.
                        for member in root.members : member-row := Rectangle {
                            width: member-list.visible-width;
                            property <length> top-h: max(55px, 34px * root.text-scale + 16px);
                            property <length> action-h: 30px * root.text-scale;
                            property <length> details-w: 62px * root.text-scale;
                            property <length> manage-w: 72px * root.text-scale;
                            // Where the name starts: padding, avatar and one gap.
                            property <length> lead: 12px + 32px + 9px;
                            property <length> below-w: max(0px, self.width - self.lead - 12px);
                            // 0: beside the name (with at least 96 px for it); 1: one
                            // line below; 2: one per line below.
                            property <int> mode: !root.live-session ? 0
                                : self.width >= self.lead + 96px + 9px + self.details-w + 9px + self.manage-w + 12px ? 0
                                : self.below-w >= self.details-w + 8px + self.manage-w ? 1 : 2;
                            height: self.mode == 0 ? self.top-h
                                : self.mode == 1 ? self.top-h + self.action-h + 6px
                                : self.top-h + 2 * self.action-h + 12px;
                            background: transparent;
                            HorizontalLayout {
                                y: 0; height: member-row.top-h;
                                padding-left: 12px; padding-top: 11px; padding-bottom: 11px; spacing: 9px;
                                padding-right: root.live-session && member-row.mode == 0 ? 12px + member-row.details-w + 9px + member-row.manage-w + 9px : 12px;
                                VerticalLayout { width: 32px; alignment: center; AvatarBadge { width: 32px; height: 32px; built-in-radius: 11px; initials: member.initials; accent: member.accent; } }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    Text { text: member.name; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; overflow: elide; }
                                    Text { text: member.detail; color: root.muted; font-size: 10px * root.text-scale; overflow: elide; }
                                }
                                if !root.live-session : Rectangle {
                                    width: 7px; background: transparent;
                                    Rectangle { y: (parent.height - 7px) / 2; width: 7px; height: 7px; border-radius: 4px; background: member.online ? (StyleTokens.roles.presence-online.present ? StyleTokens.roles.presence-online.color : #64c9a7) : root.muted; }
                                }
                            }
                            // Member details and ignore (member_privacy). Focus comes back
                            // here when the details this opened close.
                            if root.live-session : ActionRect {
                                x: member-row.mode == 0 ? parent.width - 12px - member-row.manage-w - 9px - member-row.details-w : member-row.lead;
                                y: member-row.mode == 0 ? (member-row.top-h - member-row.action-h) / 2 : member-row.top-h - 5px;
                                width: member-row.mode == 0 ? member-row.details-w : member-row.mode == 1 ? (member-row.below-w - 8px) * 62 / 134 : member-row.below-w;
                                height: member-row.action-h;
                                horizontal-stretch: 0; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.7;
                                background: root.control-fill(self.has-hover, self.has-pressed, root.elevated);
                                focus-color: root.accent;
                                label: "Details for room member " + member.name + " · " + member.user-id;
                                property <string> return-to;
                                property <bool> details-open: MemberPrivacy.inspector.open;
                                changed details-open => {
                                    if !self.details-open && self.return-to != "" {
                                        if self.return-to == member.user-id && root.member-inspector-allowed { self.focus(); }
                                        self.return-to = "";
                                    }
                                }
                                activated => {
                                    MemberPrivacy.inspect(member.user-id);
                                    if MemberPrivacy.inspector.open { self.return-to = member.user-id; }
                                }
                                Text {
                                    text: "Details";
                                    color: root.ink;
                                    font-size: 11px * root.text-scale;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            if root.live-session : ActionRect {
                                x: member-row.mode == 0 ? parent.width - 12px - member-row.manage-w : member-row.mode == 1 ? member-row.lead + (member-row.below-w - 8px) * 62 / 134 + 8px : member-row.lead;
                                y: member-row.mode == 2 ? member-row.top-h - 5px + member-row.action-h + 6px : member-row.mode == 0 ? (member-row.top-h - member-row.action-h) / 2 : member-row.top-h - 5px;
                                width: member-row.mode == 0 ? member-row.manage-w : member-row.mode == 1 ? (member-row.below-w - 8px) * 72 / 134 : member-row.below-w;
                                height: member-row.action-h;
                                horizontal-stretch: 0; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.7;
                                background: root.control-fill(self.has-hover, self.has-pressed, root.elevated);
                                focus-color: root.accent;
                                enabled: !RoomAddresses.open && !root.member-action-busy;
                                label: "Manage room member " + member.name + " · " + member.user-id;
                                activated => {
                                    root.member-selected-user-id = member.user-id;
                                    root.member-selected-name = member.name;
                                    root.member-selected-membership = member.membership;
                                    root.member-selected-power = member.power-level-text;
                                    root.member-selected-self = member.is-account-user;
                                    root.member-selected-creator = member.is-creator;
                                    root.member-action-error = "";
                                    root.member-action-notice = "";
                                }
                                Text {
                                    text: "Manage";
                                    color: root.member-action-busy ? root.muted : root.ink;
                                    font-size: 11px * root.text-scale;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                        }
                    }
                    if root.live-session && root.member-selected-user-id != "" : Rectangle {
                        height: root.member-selected-membership == "ban" ? 133px : 184px;
                        background: root.elevated; border-color: root.divider; border-width: StyleTokens.line-width;
                        VerticalLayout {
                            padding: 9px; spacing: 5px;
                            HorizontalLayout {
                                Text {
                                    text: "Manage " + root.member-selected-name;
                                    color: root.ink; font-size: 11px * root.text-scale; font-weight: 700;
                                    horizontal-stretch: 1; overflow: elide;
                                }
                                member-manage-close := Button {
                                    width: 27px; height: 25px; text: "×";
                                    accessible-label: "Close member controls";
                                    clicked => { root.member-selected-user-id = ""; }
                                }
                            }
                            Text {
                                text: root.member-selected-user-id;
                                color: root.muted; font-size: 10px * root.text-scale;
                                overflow: elide;
                            }
                            if root.member-selected-membership != "ban" : HorizontalLayout {
                                height: 34px; spacing: 5px;
                                Rectangle {
                                    horizontal-stretch: 1; background: root.panel;
                                    border-radius: StyleTokens.radius * 0.7; border-color: root.divider; border-width: StyleTokens.line-width;
                                    ThemedTextInput {
                                        x: 7px; width: parent.width - 14px; height: parent.height;
                                        text <=> root.member-selected-power;
                                        color: root.ink; font-size: 11px * root.text-scale;
                                        enabled: !RoomAddresses.open && !root.member-action-busy && !root.member-selected-creator;
                                        accessible-label: "Power level for selected room member";
                                    }
                                }
                                Button {
                                    width: 72px; text: "Set power";
                                    enabled: !RoomAddresses.open && !root.member-action-busy && !root.member-selected-creator && root.member-selected-power != "";
                                    accessible-label: "Review power level change for " + root.member-selected-name;
                                    clicked => {
                                        root.member-confirm-kind = 4;
                                        root.member-confirm-user-id = root.member-selected-user-id;
                                        root.member-confirm-name = root.member-selected-name;
                                        root.member-confirm-value = root.member-selected-power;
                                        root.member-confirm-account-id = root.active-account-local-id;
                                        root.member-confirm-room-id = root.active-room-id;
                                        root.member-confirm-open = true;
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 34px; spacing: 6px;
                                if root.member-selected-membership == "ban" : Button {
                                    text: "Unban";
                                    enabled: !RoomAddresses.open && !root.member-action-busy;
                                    accessible-label: "Review unban of " + root.member-selected-name;
                                    clicked => {
                                        root.member-confirm-kind = 3;
                                        root.member-confirm-user-id = root.member-selected-user-id;
                                        root.member-confirm-name = root.member-selected-name;
                                        root.member-confirm-value = "";
                                        root.member-confirm-account-id = root.active-account-local-id;
                                        root.member-confirm-room-id = root.active-room-id;
                                        root.member-confirm-open = true;
                                    }
                                }
                                if root.member-selected-membership != "ban" : Button {
                                    text: "Kick";
                                    enabled: !RoomAddresses.open && !root.member-action-busy && !root.member-selected-self && !root.member-selected-creator;
                                    accessible-label: "Review kick of " + root.member-selected-name;
                                    clicked => {
                                        root.member-confirm-kind = 1;
                                        root.member-confirm-user-id = root.member-selected-user-id;
                                        root.member-confirm-name = root.member-selected-name;
                                        root.member-confirm-value = "";
                                        root.member-confirm-account-id = root.active-account-local-id;
                                        root.member-confirm-room-id = root.active-room-id;
                                        root.member-confirm-open = true;
                                    }
                                }
                                if root.member-selected-membership != "ban" : Button {
                                    text: "Ban";
                                    enabled: !RoomAddresses.open && !root.member-action-busy && !root.member-selected-self && !root.member-selected-creator;
                                    accessible-label: "Review ban of " + root.member-selected-name;
                                    clicked => {
                                        root.member-confirm-kind = 2;
                                        root.member-confirm-user-id = root.member-selected-user-id;
                                        root.member-confirm-name = root.member-selected-name;
                                        root.member-confirm-value = "";
                                        root.member-confirm-account-id = root.active-account-local-id;
                                        root.member-confirm-room-id = root.active-room-id;
                                        root.member-confirm-open = true;
                                    }
                                }
                            }
                            Text {
                                text: "The homeserver checks your room permissions.";
                                color: root.muted; font-size: 10px * root.text-scale;
                            }
                        }
                    }
                }
                if root.side-panel-tab == 1 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;
                    HorizontalLayout {
                        height: 49px; padding-left: 14px; padding-right: 10px; spacing: 8px;
                        // A thread opened from a search hit returns to its results.
                        if root.room-search-selected-thread-root != "" && root.room-search-selected-thread-root == root.thread-root-id : IconAction {
                            width: 28px; height: 28px; icon: "←"; label: "Back to search results";
                            ink: root.muted; surface: transparent; hover-surface: root.hover;
                            activated => { root.side-panel-tab = 2; }
                        }
                        Text { text: "Thread"; color: root.ink; font-size: 17px * root.text-scale; font-weight: 750; horizontal-stretch: 1; vertical-alignment: center; }
                        if root.thread-root-id != "" : IconAction {
                            width: 28px; height: 28px; icon: "close"; label: "Close thread";
                            ink: root.icon-ink; surface: transparent; hover-surface: root.hover;
                            activated => {
                                root.thread-root-id = "";
                                root.thread-root-is-own = false;
                                root.thread-root-palette-index = 0;
                                root.thread-root-accent = transparent;
                                root.thread-messages = [];
                                root.thread-composer-text = "";
                                root.thread-send-pending = false;
                                root.close-thread();
                            }
                        }
                    }
                    Rectangle { height: StyleTokens.line-width; background: root.divider; }
                    if root.thread-root-id == "" : Text {
                        text: "Choose a message and open its thread.";
                        color: root.muted; font-size: 12px * root.text-scale;
                        wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
                        vertical-stretch: 1;
                    }
                    if root.thread-root-id != "" : thread-scroll := ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        // Automatic read receipts (room activity) for this thread.
                        property <bool> at-bottom: self.content-height <= self.visible-height + 1px || -self.content-y >= self.content-height - self.visible-height - 24px;
                        property <string> read-key: root.live-session && root.page == 0 && root.show-side-panel && root.side-panel-tab == 1 && self.at-bottom && root.thread-messages.length > 0 ? root.thread-messages[root.thread-messages.length - 1].event-id : "";
                        changed read-key => { RoomActivity.read-view(true, self.read-key); }
                        init => { RoomActivity.read-view(true, self.read-key); }
                        VerticalLayout {
                            width: parent.width;
                            padding: 12px;
                            spacing: 10px;
                            alignment: start;
                            vertical-stretch: 0;
                            Rectangle {
                                vertical-stretch: 0;
                                background: root.row-surface(false, false, root.thread-root-is-own, transparent);
                                border-radius: StyleTokens.radius * 0.8;
                                VerticalLayout {
                                    padding: root.thread-root-is-own && StyleTokens.roles.own-surface.present ? min(8px, root.content-inset) : 0px;
                                    spacing: 10px;
                                    // The root message follows the message font, the sender size and,
                                    // two pixels smaller as before, the message size.
                                    Text { text: root.thread-root-sender; color: root.sender-ink(false, root.thread-root-is-own, root.thread-root-palette-index, root.thread-root-accent); font-family: root.message-font-family; font-size: root.sender-font-px > 0px ? root.sender-font-px : 12px * root.text-scale; font-weight: root.sender-font-weight > 0 ? root.sender-font-weight : 750; vertical-stretch: 0; }
                                    StyledText {
                                        text: root.thread-root-rich-body;
                                        default-color: root.body-ink(false, root.thread-root-is-own);
                                        default-font-size: max(10px * root.text-scale, root.message-font-px - 2px * root.text-scale);
                                        default-font-family: root.message-font-family;
                                        link-color: StyleTokens.roles.link.present ? StyleTokens.roles.link.color : root.accent;
                                        accessible-role: text;
                                        accessible-label: root.thread-root-rich-accessible-body;
                                        link-clicked(url) => { root.open-message-link(url); }
                                    }
                                }
                            }
                            Rectangle { height: StyleTokens.line-width; background: root.divider; }
                            // A thread feed starts with its latest replies; earlier
                            // replies load on request, a page at a time.
                            if root.live-session : TextAction {
                                ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                                outline: root.divider; text-scale: root.text-scale; wrap-caption: true;
                                text: root.thread-history-loading ? "Loading earlier replies…" : root.thread-history-at-start ? "Start of thread" : "Load earlier replies";
                                enabled: !root.thread-history-loading && !root.thread-history-at-start;
                                accessible-label: root.thread-history-at-start ? "Start of thread reached" : "Load earlier replies in this thread";
                                activated => { root.load-older-thread-replies(); }
                            }
                            if root.thread-history-error != "" : Text {
                                text: root.thread-history-error;
                                color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483;
                                font-size: 11px * root.text-scale; wrap: word-wrap; vertical-stretch: 0;
                                accessible-live-region: polite;
                            }
                            Text { text: "REPLIES · " + root.thread-messages.length; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; vertical-stretch: 0; }
                            for reply in root.thread-messages : thread-reply := Rectangle {
                                property <string> time-label: root.message-time-label(reply);
                                // The reply a search hit opened, highlighted like a
                                // selected conversation row.
                                property <bool> search-hit: root.room-search-selected-event-id != "" && reply.event-id == root.room-search-selected-event-id;
                                min-height: 43px;
                                vertical-stretch: 0;
                                background: root.row-surface(thread-reply.search-hit, false, reply.is-own, root.elevated);
                                border-radius: StyleTokens.radius * 0.8;
                                // Reveal that reply once it is laid out (a zero-size
                                // holder carries the condition; a Timer cannot).
                                if reply.event-id != "" && reply.event-id == root.timeline-jump-event-id : Rectangle {
                                    width: 0px; height: 0px;
                                    Timer {
                                        interval: 1ms;
                                        running: true;
                                        triggered => {
                                            self.running = false;
                                            thread-scroll.content-y = -max(0px, min(thread-scroll.content-height - thread-scroll.visible-height, thread-reply.y - 12px));
                                        }
                                    }
                                }
                                VerticalLayout {
                                    padding: min(12px, root.content-inset); spacing: max(2px, root.message-row-gap);
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: reply.sender; color: root.sender-ink(thread-reply.search-hit, reply.is-own, reply.sender-palette-index, reply.accent); font-family: root.message-font-family; font-size: root.sender-font-px > 0px ? root.sender-font-px : 11px * root.text-scale; font-weight: root.sender-font-weight > 0 ? root.sender-font-weight : 700; wrap: word-wrap; horizontal-stretch: 0; min-width: 0px; accessible-label: reply.sender; }
                                        // Reply clocks keep the timestamp role and the delivery status
                                        // text even when optional timestamps are hidden.
                                        if (root.show-message-timestamps || reply.time == "Sending…" || reply.time == "Failed to send") && thread-reply.time-label != "" : Text {
                                            text: "· " + thread-reply.time-label; color: root.clock-ink(thread-reply.search-hit); font-family: root.monospace-font-family;
                                            font-size: root.timestamp-font-px; vertical-alignment: top; horizontal-stretch: 0; accessible-label: thread-reply.time-label;
                                        }
                                        Rectangle { horizontal-stretch: 1; min-width: 0px; }
                                        // This thread's read receipts at or after the reply (room activity).
                                        // Focus comes back here when the view it opened closes.
                                        if reply.event-id != "" : IconAction {
                                            quiet: true;
                                            width: 24px; height: 20px; icon: "✓✓"; label: "Seen in this thread: who has read up to this reply from " + reply.sender;
                                            ink: root.icon-ink; surface: transparent; hover-surface: root.hover;
                                            enabled: root.live-session;
                                            property <string> return-to;
                                            property <bool> seen-open: RoomActivity.seen-open;
                                            changed seen-open => {
                                                if !self.seen-open && self.return-to != "" {
                                                    if self.return-to == reply.event-id { self.focus(); }
                                                    self.return-to = "";
                                                }
                                            }
                                            activated => {
                                                RoomActivity.show-seen-by(reply.event-id, true);
                                                if RoomActivity.seen-open { self.return-to = reply.event-id; }
                                            }
                                        }
                                    }
                                    StyledText {
                                        text: reply.rich-body;
                                        default-color: root.body-ink(thread-reply.search-hit, reply.is-own);
                                        default-font-size: root.message-font-px;
                                        default-font-family: root.message-font-family;
                                        link-color: StyleTokens.roles.link.present ? StyleTokens.roles.link.color : root.accent;
                                        accessible-role: text;
                                        accessible-label: reply.rich-accessible-body;
                                        link-clicked(url) => { root.open-message-link(url); }
                                    }
                                    if reply.poll.present : PollCard {
                                        data: reply.poll;
                                        event-id: reply.event-id;
                                        thread-root: root.thread-root-id;
                                        enabled: root.live-session;
                                        palette: root.poll-palette;
                                        text-scale: root.text-scale;
                                        corner: StyleTokens.radius * 0.8;
                                    }
                                    // The window's token-drawn action: control radius, padding,
                                    // line and focus widths and control states apply.
                                    if reply.attachment-is-image && reply.event-id != "" : HorizontalLayout {
                                        alignment: start;
                                        TextAction {
                                            text: "Preview image"; label: "Preview image " + reply.attachment;
                                            enabled: root.live-session;
                                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                                            outline: root.divider; text-scale: root.text-scale;
                                            activated => { root.preview-image-attachment(reply.event-id, reply.attachment); }
                                        }
                                    }
                                    // The timeline pin rule: shown once the pinned list is known, for
                                    // anyone who may change it, and as a disabled marker on pinned
                                    // replies otherwise. Rust rechecks the account, room and scope.
                                    if reply.event-id != "" && root.pinned-state-loaded && (root.pinned-can-edit || reply.pinned) : HorizontalLayout {
                                        alignment: end;
                                        TextAction {
                                            text: reply.pinned ? "Unpin" : "Pin";
                                            ink: root.ink; muted: root.muted; surface: transparent;
                                            hover-surface: root.hover; outline: root.divider;
                                            text-scale: root.text-scale;
                                            accessible-label: (reply.pinned ? "Unpin reply from " : "Pin reply from ") + reply.sender;
                                            enabled: root.live-session && root.pinned-can-edit && !root.pinned-busy;
                                            activated => {
                                                root.toggle-message-pin(root.active-account-local-id, root.active-room-id, reply.event-id, !reply.pinned);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.thread-root-id != "" : Rectangle {
                        property <length> status-height: root.thread-status-visible ? thread-status.height + 12px : 0px;
                        height: root.thread-composer-height + self.status-height; background: transparent;
                        thread-status := PendingSendStrip {
                            x: 10px; y: 6px; width: parent.width - 20px;
                            items: root.thread-pending-items; blocked-notice: root.thread-blocked-notice;
                            composer-empty: root.thread-composer-text == "";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            cancel(key) => { root.cancel-pending-send(true, key); }
                            retry(key) => { root.retry-pending-send(true, key); }
                            review(key, sent) => { root.review-unconfirmed-send(true, key, sent); }
                            restore(key) => { root.restore-record-text(true, key); }
                            copy(key) => { root.copy-record-text(true, key); }
                            discard(key) => { root.discard-record-text(true, key); }
                            discard-unreadable => { root.discard-unreadable-status(true); }
                        }
                        HorizontalLayout {
                            padding-left: StyleTokens.composer-padding; padding-right: StyleTokens.composer-padding; padding-top: 8px + parent.status-height; padding-bottom: 8px; spacing: 5px;
                            Rectangle {
                                horizontal-stretch: 1; background: root.composer-surface; border-radius: StyleTokens.composer-radius >= 0px ? StyleTokens.composer-radius : StyleTokens.radius * 0.8;
                                // The thread composer has no border until a focus state is set.
                                border-width: thread-input.has-focus && StyleTokens.states.composer-focus.present ? StyleTokens.focus-width : 0px;
                                border-color: root.composer-focus-border;
                                thread-input := MentionInput {
                                    font-family: root.composer-font-family;
                                    x: 8px; width: parent.width - 16px; height: parent.height;
                                    text <=> root.thread-composer-text; color: root.ink; font-size: root.composer-font-px;
                                    accessible-label: "Reply in thread started by " + root.thread-root-sender;
                                    property <string> thread-context: root.thread-root-id;
                                    init => { self.focus(); root.mention-cursor(true, self.caret-bytes, self.anchor-bytes, self.composing); }
                                    changed thread-context => { if self.thread-context != "" { self.focus(); } }
                                    // Focus ends when the window stops being active (room activity).
                                    changed has-focus => { RoomActivity.composer-focus(true, self.has-focus); }
                                    accepted => { if !root.thread-send-pending { RoomActivity.composer-sent(true); root.send-thread-message(root.thread-composer-text); } }
                                    caret-changed => { root.mention-cursor(true, self.caret-bytes, self.anchor-bytes, self.composing); }
                                    property <int> composer-focus-request: root.composer-focus-request;
                                    changed composer-focus-request => { if root.composer-focus-thread { self.focus(); } }

                                    property <int> placement-request: root.mention-place-request;
                                    changed placement-request => {
                                        if root.mention-place-thread {
                                            self.set-selection-offsets(root.mention-place-position, root.mention-place-position); self.focus();
                                            root.mention-cursor(true, self.caret-bytes, self.anchor-bytes, self.composing);
                                        }
                                    }
                                    key-pressed(event) => {
                                            root.thread-caret = self.caret-bytes; root.thread-anchor = self.anchor-bytes; root.thread-preedit = self.composing;
                                            if !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt && !event.modifiers.shift && root.mention-key(true, event.text) { accept } else { reject }
                                    }
                                    edited => { root.thread-composer-edited(self.text); RoomActivity.composer-changed(true, self.text != ""); root.mention-cursor(true, self.caret-bytes, self.anchor-bytes, self.composing); }
                                }
                            }
                            IconAction {
                                width: 28px; icon: "emoji"; label: "Open emoji picker for thread reply";
                                ink: root.icon-composer-ink; surface: transparent; hover-surface: root.hover;
                                enabled: root.mention-ui-allowed && !root.thread-send-pending;
                                activated => {
                                    if root.sticker-open { root.sticker-dismiss(); }
                                    root.thread-caret = thread-input.caret-bytes; root.thread-anchor = thread-input.anchor-bytes; root.thread-preedit = thread-input.composing;
                                    root.open-emoji(true);
                                }
                            }
                            IconAction {
                                width: 28px; icon: "sticker"; label: "Open sticker picker for this thread";
                                ink: root.sticker-open && root.sticker-threaded ? root.icon-active-ink : root.icon-composer-ink;
                                selected: root.sticker-open && root.sticker-threaded;
                                surface: root.panel; hover-surface: root.hover;
                                enabled: root.mention-ui-allowed && !root.thread-send-pending;
                                activated => {
                                    if root.emoji-open { root.emoji-dismiss(); }
                                    root.open-stickers(true);
                                }
                            }
                            IconAction {
                                width: 32px; icon: "Md"; label: root.thread-markdown ? "Thread plain text" : "Thread Markdown";
                                selected: root.thread-markdown; enabled: !root.thread-send-pending;
                                ink: root.thread-markdown ? root.icon-active-ink : root.icon-composer-ink; surface: transparent; hover-surface: root.hover;
                                activated => { root.thread-markdown = !root.thread-markdown; root.thread-formatting-changed(root.thread-markdown); thread-input.focus(); }
                            }
                            IconAction {
                                icon: "send"; label: "Send thread reply"; ink: root.icon-active-ink;
                                enabled: !root.thread-send-pending;
                                surface: transparent; hover-surface: root.hover;
                                activated => {
                                    root.thread-caret = thread-input.caret-bytes; root.thread-anchor = thread-input.anchor-bytes; root.thread-preedit = thread-input.composing;
                                    RoomActivity.composer-sent(true);
                                    root.send-thread-message(root.thread-composer-text);
                                }
                            }
                        }
                        if root.emoji-open && root.emoji-threaded && root.mention-ui-allowed : EmojiPopup {
                            x: 4px; y: -self.height; width: parent.width - 8px;
                            items: root.emoji-items; current: root.emoji-index; query <=> root.emoji-query-text;
                            surface: root.panel; elevated: root.elevated; hover: root.hover; ink: root.ink; muted: root.muted; accent: root.accent; text-scale: root.text-scale;
                            searched(query) => { root.emoji-query(query); }
                            navigate(offset) => { root.emoji-navigate(offset); }
                            dismiss => { root.emoji-dismiss(); }
                            choose(key) => {
                                root.thread-caret = thread-input.caret-bytes; root.thread-anchor = thread-input.anchor-bytes; root.thread-preedit = thread-input.composing;
                                root.emoji-choose(key);
                            }
                        }
                        if root.sticker-open && root.sticker-threaded && root.mention-ui-allowed : StickerPopup {
                            x: 4px; y: -self.height; width: parent.width - 8px;
                            items: root.sticker-items; packs: root.sticker-packs; pack-index <=> root.sticker-pack-index;
                            current: root.sticker-index; query <=> root.sticker-query-text;
                            phase: root.sticker-phase; status: root.sticker-status; notice: root.sticker-notice;
                            needs-consent: root.sticker-needs-consent; can-send: root.sticker-can-send;
                            preview: root.sticker-preview-image; preview-loaded: root.sticker-preview-loaded; preview-status: root.sticker-preview-status;
                            available-height: max(140px, parent.absolute-position.y - 8px);
                            surface: root.panel; elevated: root.elevated; hover: root.hover; ink: root.ink; muted: root.muted; accent: root.accent;
                            outline: root.divider; text-scale: root.text-scale;
                            searched(query) => { root.sticker-query(query); }
                            navigate(offset) => { root.sticker-navigate(offset); }
                            choose-pack(index) => { root.sticker-choose-pack(index); }
                            highlight(key) => { root.sticker-highlight(key); }
                            send(key) => { root.sticker-send(key); }
                            consent(allowed) => { root.sticker-consent(allowed); }
                            dismiss => { root.sticker-dismiss(); }
                        }
                        if root.sticker-send-visible && root.sticker-send-threaded && !root.sticker-open && !root.emoji-open && root.thread-mentions.length == 0 : StickerSendStatus {
                            x: 4px; y: -self.height; width: parent.width - 8px;
                            status: root.sticker-send-status; can-cancel: root.sticker-send-can-cancel; can-retry: root.sticker-send-can-retry;
                            uncertain: root.sticker-send-uncertain; outline: root.divider;
                            surface: root.panel; hover: root.hover; ink: root.ink; muted: root.muted; accent: root.accent; text-scale: root.text-scale;
                            cancel => { root.sticker-send-cancel(); }
                            retry => { root.sticker-send-retry(); }
                            dismiss => { root.sticker-send-dismiss(); }
                        }
                        if root.thread-mentions.length > 0 && root.mention-ui-allowed && !root.emoji-open && !root.sticker-open : MentionPopup {
                            x: 4px; y: -self.height; width: parent.width - 8px;
                            items: root.thread-mentions; current: root.thread-mention-index;
                            surface: root.panel; hover: root.hover; ink: root.ink; muted: root.muted; accent: root.accent; text-scale: root.text-scale;
                            choose(key) => {
                                root.thread-caret = thread-input.caret-bytes; root.thread-anchor = thread-input.anchor-bytes; root.thread-preedit = thread-input.composing;
                                root.mention-choose(true, key);
                            }
                        }
                    }
                }
                if root.side-panel-tab == 2 : MessageSearchPanel {
                    vertical-stretch: 1;
                    palette: {
                        ink: root.ink,
                        muted: root.muted,
                        panel: root.panel,
                        elevated: root.elevated,
                        hover: root.hover,
                        accent: root.accent,
                        divider: root.divider,
                        error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b,
                        selection: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover,
                        selection-ink: StyleTokens.roles.selection-ink.color,
                        has-selection-ink: StyleTokens.roles.selection-ink.present,
                        focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent
                    };
                    text-scale: root.text-scale;
                    radius: StyleTokens.radius;
                    available: root.live-session;
                    room-available: root.active-room-id != "";
                    room-name: root.active-room-name;
                    query <=> root.room-search-query;
                    scope: root.room-search-scope;
                    results: root.room-search-results;
                    context: root.room-search-context;
                    loading: root.room-search-loading;
                    loading-more: root.room-search-loading-more;
                    searched: root.room-search-searched;
                    has-more: root.room-search-has-more;
                    error: root.room-search-error;
                    notice: root.room-search-notice;
                    context-loading: root.room-search-context-loading;
                    context-error: root.room-search-context-error;
                    context-notice: root.room-search-context-notice;
                    index <=> root.room-search-index;
                    selected-room-id: root.room-search-selected-room-id;
                    selected-event-id: root.room-search-selected-event-id;
                    selected-sender: root.room-search-selected-sender;
                    selected-time: root.room-search-selected-time;
                    selected-body: root.room-search-selected-body;
                    focus-request: root.search-focus-request;
                    filter-sender <=> root.room-search-filter-sender;
                    filter-since <=> root.room-search-filter-since;
                    filter-until <=> root.room-search-filter-until;
                    filter-attachment <=> root.room-search-filter-attachment;
                    filters-open <=> root.room-search-filters-open;
                    filter-error: root.room-search-filter-error;
                    filters-edited => { root.room-search-filters-edited(); }
                    edited(text) => { root.room-search-edited(text); }
                    submit => { root.query-room-messages(); }
                    choose-scope(scope) => { root.choose-room-search-scope(scope); }
                    load-more => { root.load-more-room-search(); }
                    open(room-id, event-id) => { root.open-search-result(room-id, event-id); }
                    dismiss => { root.focus-composer(false); }
                }
                if root.side-panel-tab == 3 : PinnedMessagesPanel {
                    vertical-stretch: 1;
                    items: root.pinned-items;
                    status: root.pinned-status;
                    error: root.pinned-error;
                    notice: root.pinned-notice;
                    summary: root.pinned-summary;
                    read-only-note: root.pinned-read-only-note;
                    busy: root.pinned-busy;
                    available: root.live-session && root.active-room-id != "";
                    filter <=> root.pinned-filter;
                    focus-request: root.pinned-focus-request;
                    text-scale: root.text-scale;
                    style: {
                        radius: StyleTokens.radius * 0.8,
                        control-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.7,
                        input-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.7,
                        line-width: StyleTokens.line-width,
                        focus-width: StyleTokens.focus-width,
                        control-padding: StyleTokens.control-padding,
                        input-padding: StyleTokens.input-padding,
                        sender-font-size: StyleTokens.sender-font-size,
                        timestamp-font-size: StyleTokens.timestamp-font-size,
                    };
                    palette: {
                        ink: root.ink,
                        muted: root.muted,
                        panel: root.panel,
                        elevated: root.elevated,
                        hover: StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover,
                        pressed: StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color : transparent,
                        disabled: StyleTokens.states.control-disabled.present ? StyleTokens.states.control-disabled.color : root.muted,
                        input-surface: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.elevated,
                        input-border: StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.divider,
                        accent: root.accent,
                        divider: root.divider,
                        focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
                        selection: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : Palette.selection-background,
                        selection-ink: StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : Palette.selection-foreground,
                        error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b,
                        warning: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b,
                    };
                    filter-edited(text) => { root.pinned-filter-edited(text); }
                    refresh => { root.refresh-pinned-messages(); }
                    open-message(event, thread) => { root.open-pinned-message(event, thread); }
                    unpin(event) => { root.unpin-pinned-message(event); }
                }
                if root.side-panel-tab == 4 : TransferCenterPanel {
                    vertical-stretch: 1;
