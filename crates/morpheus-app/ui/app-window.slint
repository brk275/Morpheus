                            width: parent.width;
                            padding: 12px;
                            spacing: 10px;
                            alignment: start;
                            vertical-stretch: 0;
                            Rectangle {
                                vertical-stretch: 0;
                                background: root.row-surface(false, false, root.thread-root-is-own, transparent);
                                border-radius: StyleTokens.radius * 0.8;
                                VerticalLayout {
                                    padding: root.thread-root-is-own && StyleTokens.roles.own-surface.present ? min(8px, root.content-inset) : 0px;
                                    spacing: 10px;
                                    // The root message follows the message font, the sender size and,
                                    // two pixels smaller as before, the message size.
                                    Text {
                                        text: root.thread-root-sender;
                                        color: root.sender-ink(false, root.thread-root-is-own, root.thread-root-palette-index, root.thread-root-accent);
                                        font-family: root.message-font-family;
                                        font-size: root.sender-font-px > 0px ? root.sender-font-px : 12px * root.text-scale;
                                        font-weight: root.sender-font-weight > 0 ? root.sender-font-weight : 750;
                                        wrap: word-wrap; min-width: 0px; vertical-stretch: 0;
                                        accessible-role: text;
                                        accessible-label: root.thread-root-sender;
                                    }
                                    if root.thread-root-copy-token != "" : TextAction {
                                        text: "Copy text"; accessible-label: "Copy text from thread root";
                                        ink: root.ink; muted: root.muted; surface: transparent; hover-surface: root.hover;
                                        outline: root.divider; text-scale: root.text-scale;
                                        enabled: root.viewport-seek-allowed && !root.settings-reveal-protected;
                                        activated => { root.copy-message-text(root.thread-root-copy-token, true); }
                                    }
                                    StyledText {
                                        text: root.thread-root-rich-body;
                                        default-color: root.body-ink(false, root.thread-root-is-own);
                                        default-font-size: max(10px * root.text-scale, root.message-font-px - 2px * root.text-scale);
                                        default-font-family: root.message-font-family;
                                        link-color: StyleTokens.roles.link.present ? StyleTokens.roles.link.color : root.accent;
                                        accessible-role: text;
                                        accessible-label: root.thread-root-rich-accessible-body;
