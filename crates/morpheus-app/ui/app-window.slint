    // Discovery joins and the explorer may act only on the live Home or
    // directory surface, never behind another protected native modal.
    // Their own two surfaces are checked separately so replacing one can
    // withdraw its exact pending operation synchronously.
    out property <bool> discovery-context-allowed: root.live-session && (root.page == 0 || root.page == 3)
        && !root.show-sign-in && !root.access-open && !root.manage-accounts-open
        && !root.account-switch-pending && !root.account-menu-open
        && root.security-recovery-key == "" && !root.security-busy && !root.sas-busy && root.sas-stage == 0
        && !root.account-profile-open && !MemberPrivacy.inspector.open && !SpaceRooms.open && !RoomAddresses.open
        && !RoomNotificationState.open && !RoomActivity.seen-open
        && !root.quick-switcher-open && !root.people-open && !root.room-admin-open
        && !root.member-confirm-open && !root.native-capture-picker-open
        && !root.leave-call-dialog && !root.image-preview-open && !root.poll-dialog-open;
    property <bool> discovery-join-context-current: !root.directory-join-busy
        || (root.discovery-context-allowed && root.page == 3 && !root.room-actions-open && !SpaceExplorer.open);
    changed discovery-join-context-current => {
        if !root.discovery-join-context-current { root.cancel-discovery-join(); }
    }
    property <bool> room-join-context-current: !(root.room-actions-open && root.room-action-mode == 1)
        || (root.discovery-context-allowed && !SpaceExplorer.open);
    changed room-join-context-current => {
        if !root.room-join-context-current {
            root.cancel-room-join();
            root.room-actions-open = false;
        }
    }
    property <bool> explorer-context-current: !SpaceExplorer.open
        || (root.discovery-context-allowed && !root.room-actions-open);
    changed explorer-context-current => {
        if !root.explorer-context-current { SpaceExplorer.close(); }
    }
    // A lock, account replacement or another modal cancels the exact People
    // window immediately; no pending result restores its private content.
    property <bool> people-context-current: !root.people-open || (root.live-session
        && !root.show-sign-in && !root.access-open && !root.manage-accounts-open
        && !root.account-switch-pending && !root.account-menu-open
        && root.security-recovery-key == "" && !root.security-busy && !root.sas-busy
        && !root.account-profile-open && !SpaceExplorer.open && !MemberPrivacy.inspector.open && !SpaceRooms.open && !RoomAddresses.open
        && !RoomNotificationState.open && !RoomActivity.seen-open
        && !root.quick-switcher-open && !root.room-actions-open && !root.room-admin-open
        && !root.member-confirm-open && !root.native-capture-picker-open
        && !root.leave-call-dialog && !root.image-preview-open && !root.poll-dialog-open);
    changed people-context-current => {
        if !root.people-context-current { root.close-people(); }
    }
    // The inspector is another account-private modal. A lock, pending
    // security/key/SAS step or another modal closes it and cancels its read;
    // returning focus must never jump behind the replacing modal.
    property <bool> member-inspector-allowed: root.live-session && root.active-room-id != ""
        && !root.show-sign-in && !root.access-open && !root.manage-accounts-open
        && !root.account-switch-pending && !root.account-menu-open
        && root.security-recovery-key == "" && !root.security-busy && !root.sas-busy && root.sas-stage == 0
        && !root.account-profile-open && !SpaceExplorer.open && !SpaceRooms.open && !RoomAddresses.open
        && !RoomNotificationState.open && !RoomActivity.seen-open
        && !root.quick-switcher-open && !root.people-open
        && !root.room-actions-open && !root.room-admin-open && !root.member-confirm-open
        && !root.native-capture-picker-open && !root.leave-call-dialog
        && !root.image-preview-open && !root.poll-dialog-open;
    property <bool> member-inspector-current: !MemberPrivacy.inspector.open || root.member-inspector-allowed;
    changed member-inspector-current => {
        if !root.member-inspector-current { MemberPrivacy.close-inspector(); }
