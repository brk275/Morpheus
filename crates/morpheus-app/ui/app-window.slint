                    if root.directory-error != "" : Text {
                        text: root.directory-error; color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #ff8d9d;
                        font-size: 12px * root.text-scale; wrap: word-wrap;
                        accessible-live-region: polite;
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    Text { text: "JOIN BY ROOM ID, ALIAS, OR MATRIX LINK"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; letter-spacing: 1px; }
                    HorizontalLayout {
                        height: 39px; spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1; height: 39px;
                            background: root.elevated; border-radius: StyleTokens.radius * 0.8;
                            if root.directory-join-input == "" : Text {
                                x: 10px; width: parent.width - 20px; height: parent.height;
                                text: "#room:server or matrix.to link"; color: root.muted;
                                font-size: 12px * root.text-scale; vertical-alignment: center;
                            }
                            ThemedTextInput {
                                x: 10px; y: 2px; width: parent.width - 20px; height: parent.height - 4px;
                                text <=> root.directory-join-input;
                                color: root.ink; font-size: 12px * root.text-scale;
                                enabled: root.live-session && !root.directory-join-busy;
                                accessible-label: "Room ID, room alias, or Matrix link to join";
                                accepted => { if root.live-session && !root.directory-join-busy { root.join-discovery-target(root.directory-join-input, "", "", "", false); } }
                            }
                        }
                        Button {
                            width: 93px; text: root.directory-join-busy ? "Joining…" : "Join";
                            accessible-label: "Join room by Matrix link or alias";
                            enabled: root.live-session && !root.directory-join-busy;
                            clicked => { root.join-discovery-target(root.directory-join-input, "", "", "", false); }
                        }
                    }
                    if root.directory-join-error != "" : Text {
                        text: root.directory-join-error; color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #ff8d9d;
                        font-size: 12px * root.text-scale; wrap: word-wrap;
                        accessible-live-region: polite;
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    HorizontalLayout {
                        height: 27px; spacing: 8px;
                        Text {
                            text: "PUBLIC ROOMS · " + root.directory-results.length;
                            color: root.ink; font-size: 12px * root.text-scale; font-weight: 750;
                            vertical-alignment: center; horizontal-stretch: 1;
                        }
                        if root.directory-next-batch != "" : Button {
                            width: 105px; text: root.directory-loading ? "Loading…" : "Load more";
                            accessible-label: "Load more public rooms";
                            enabled: !root.directory-loading && !root.directory-join-busy;
                            clicked => { root.query-public-rooms(true); }
                        }
                    }
                    if root.directory-loading : Text {
                        text: root.directory-results.length == 0 ? "Searching the public room directory…" : "Loading more rooms…";
                        color: root.muted; font-size: 12px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    if root.live-session && !root.directory-searched && !root.directory-loading : Text {
                        text: "Search to browse public rooms for this account.";
                        color: root.muted; font-size: 12px * root.text-scale;
                    }
                    if root.directory-searched && !root.directory-loading && root.directory-error == "" && root.directory-results.length == 0 : Text {
                        text: "No public rooms matched. Try another term or server.";
                        color: root.muted; font-size: 12px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    directory-list := ListView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        for room in root.directory-results : Rectangle {
                            width: directory-list.visible-width; height: 101px;
                            background: root.elevated; border-radius: StyleTokens.radius * 0.9;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 12px; padding-top: 10px; padding-bottom: 10px;
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: 5px;
                                    Text {
                                        text: (room.is-space ? "◇ " : "# ") + room.title;
                                        color: root.ink; font-size: 14px * root.text-scale;
                                        font-weight: 750; overflow: elide;
                                    }
                                    Text {
                                        text: room.alias != "" ? room.alias + " · " + room.members : room.members;
                                        color: root.accent; font-size: 11px * root.text-scale; overflow: elide;
                                    }
                                    Text {
                                        text: room.topic != "" ? room.topic : "No room topic";
                                        color: root.muted; font-size: 11px * root.text-scale; overflow: elide;
                                    }
                                }
                                Button {
                                    width: 76px; text: root.directory-join-busy && root.directory-joining-room-id == room.id ? "Joining…" : "Join";
                                    accessible-label: "Join public room " + room.title;
                                    enabled: root.live-session && !root.directory-join-busy;
                                    clicked => { root.join-discovery-target(room.id, room.canonical-alias, room.route-server, room.title, room.is-space); }
                                }
                            }
                        }
                    }
                }

                if root.page == 4 : SpaceManagerPage {
                    vertical-stretch: 1;
                    palette: root.roster-palette;
                    text-scale: root.text-scale;
                    available: root.live-session && root.active-space-id != "";
                    scope-key: root.active-account-local-id + "\n" + root.active-space-id;
                    view: root.space-manager-view;
                    rows: root.space-manager-rows;
                    picks: root.space-manager-picks;
                    removals: root.space-manager-removals;
                    pick-query <=> root.space-manager-pick-query;
                    query <=> root.space-manager-query;
                    target-input <=> root.space-manager-target-input;
                    target-suggested <=> root.space-manager-target-suggested;
                    target-order <=> root.space-manager-target-order;
                    suggested <=> root.space-manager-suggested;
                    order <=> root.space-manager-order;
                    create-name <=> root.space-manager-create-name;
                    create-is-space <=> root.space-manager-create-is-space;
                    create-members-only <=> root.space-manager-create-members-only;
                    create-suggested <=> root.space-manager-create-suggested;
                    scope-changed => { root.space-manager-scope-changed(); }
                    action(code) => { root.space-manager-action(code); }
                    select(key) => { root.space-manager-select(key); }
                    pick(key) => { root.space-manager-pick(key); }
                    search-edited(text) => { root.space-manager-search-edited(text); }
                    choose-filter(index) => { root.space-manager-choose-filter(index); }
                    close => { root.page = 0; }
                }
                if root.page == 1 : Rectangle {
                    height: settings-search.preferred-height + 20px;
                    background: transparent;
                    settings-search := SettingsSearchBar {
                        x: 26px; y: 10px; width: parent.width - 52px;
                        query <=> root.settings-search-query;
                        results: root.settings-search-results;
                        index <=> root.settings-search-index;
                        dismissed: root.settings-search-dismissed;
                        ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                        accent: root.accent; outline: root.divider; text-scale: root.text-scale;
                        // Keep this cap independent of Window.height: this
                        // pinned area's preferred height contributes to the
                        // window's intrinsic layout, so a fraction of its
                        // resulting height creates a binding cycle.
                        max-results-height: 200px;
                        search(query) => { root.settings-search(query); }
                        choose(id) => { root.settings-search-choose(id); }
                    }
                }
                if root.page == 1 : settings-scroll := ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    // This page scrolls vertically. Do not let a long label
                    // enlarge its content beyond the visible canvas.
                    content-width: self.visible-width;
                    // Bring a control at `offset` from the top of the content
                    // into view, computed from the live layout.
                    function reveal(offset: length) {
                        self.content-y = -max(0px, min(offset - 16px, self.content-height - self.visible-height));
                    }
                    settings-content := VerticalLayout {
                        width: settings-scroll.visible-width;
                        min-width: 0px;
                        padding: 26px;
                        spacing: 18px;
                        Text { text: "Appearance"; color: root.ink; font-size: 24px * root.text-scale; font-weight: 780; }
                        Text { text: "Shape your workspace: typography, spacing, geometry and conversation style."; color: root.muted; font-size: 13px * root.text-scale; wrap: word-wrap; }
                        Text { text: "Starting points"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 650; }
                        Text { text: "Presets fill in editable settings. Fonts use installed families; a missing family falls back to your system font."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                        for name[index] in ["Nocturne", "Terminal", "Paper"] : ActionRect {
                            property <int> reveal-request: index == 0 ? root.reveal-request("appearance.presets") : 0;
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus();
                                    if self.has-focus { root.settings-revealed-id = "appearance.presets"; }
                                }
                            }
                            height: 66px * root.text-scale;
                            label: "Apply " + name + " appearance preset";
                            background: self.has-hover ? root.hover : root.elevated;
                            border-radius: StyleTokens.radius; focus-color: root.accent;
                            activated => { root.choose-style-preset(index); }
                            VerticalLayout {
                                padding: 12px; spacing: 5px;
                                Text { text: name; color: root.ink; font-size: 13px * root.text-scale; font-weight: 650; }
                                Text { text: index == 0 ? "Charcoal · soft edges · avatars and room context" : index == 1 ? "Monospaced · square edges · aligned nickname columns" : "Warm paper · serif messages · quiet, open space";
                                    color: root.muted; font-size: 10px * root.text-scale; wrap: word-wrap; }
                            }
                        }
                        ActionRect {
                            height: 42px * root.text-scale;
                            property <int> reveal-request: root.reveal-request("appearance.reduce_motion");
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus();
                                    if self.has-focus { root.settings-revealed-id = "appearance.reduce_motion"; }
                                }
                            }
                            focus-state-changed(focused) => {
                                if focused {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            label: "Reduce motion" + (StyleTokens.reduced-motion ? ", on" : ", off");
                            accessible-checkable: true;
                            accessible-checked: StyleTokens.reduced-motion;
                            background: self.has-hover ? root.hover : root.elevated;
                            border-radius: StyleTokens.radius * 0.8; focus-color: root.accent;
                            activated => { root.set-reduce-motion(!StyleTokens.reduced-motion); }
                            HorizontalLayout { padding: 12px; spacing: 8px;
                                Text { text: "Reduce motion"; color: root.ink; font-size: 12px * root.text-scale; horizontal-stretch: 1; }
                                Text { text: StyleTokens.reduced-motion ? "On" : "Off"; color: root.accent; font-size: 12px * root.text-scale; }
                            }
                        }
                        Text { text: "Use immediate hover feedback for buttons and navigation.";
                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                        StyleNumberSetting {
                            label: "Hover fade duration"; value: StyleTokens.hover-duration-ms;
                            minimum: 0; maximum: 1000; step: 10; suffix: " ms";
                            property <int> reveal-request: root.reveal-request("appearance.hover_duration");
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus-control();
                                    if self.has-focus { root.settings-revealed-id = "appearance.hover_duration"; }
                                }
                            }
                            ink: root.ink; muted: root.muted; surface: root.elevated;
                            hover-surface: root.hover; text-scale: root.text-scale;
                            changed-value(value) => { root.change-style-number(7, value); }
                        }
                        Text { text: "0 ms is immediate. Reduce motion overrides this timing without changing your saved value.";
                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }

                        Text { text: "Colors and window"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 650; }
                        Text {
                            text: "Choose a color, then type #RRGGBB or #RRGGBBAA, with alpha last. A valid value applies and saves at once; Reset returns one color to its theme or built-in value. Your colors stay when you choose a starting point.";
                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                        }
                        color-workspace := Rectangle {
                            // Side by side when there is room; stacked at narrow widths or large text.
                            property <bool> wide: self.width >= 620px * root.text-scale;
                            height: self.wide ? max(token-list.preferred-height, token-editor.preferred-height) + 24px
                                : token-list.preferred-height + token-editor.preferred-height + 36px;
                            background: root.elevated;
                            border-radius: StyleTokens.radius;
                            token-list := ColorTokenList {
                                property <int> reveal-request: root.reveal-request("appearance.colors");
                                // Keyboard focus and search share the same bounded reveal.
                                changed has-focus => {
                                    if self.has-focus {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    }
                                }
                                changed reveal-request => {
                                    if self.reveal-request > 0 {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        self.focus();
                                        if self.has-focus { root.settings-revealed-id = "appearance.colors"; }
                                    }
                                }
                                x: 12px; y: 12px;
                                width: parent.wide ? min(300px * root.text-scale, (parent.width - 36px) * 0.45) : parent.width - 24px;
                                groups: root.color-groups; tokens: root.color-tokens;
                                group-index: root.color-group-index; selected-id: root.color-selected-id;
                                filter <=> root.color-filter;
                                ink: root.ink; muted: root.muted; surface: root.canvas; hover-surface: root.hover;
                                accent: root.accent; outline: root.divider; text-scale: root.text-scale;
                                max-list-height: parent.wide ? max(240px, root.height * 0.5) : max(140px, root.height * 0.24);
                                color-of(id) => { return root.token-color(id); }
                                filter-edited(text) => { root.color-filter-changed(text); }
                                group-chosen(index) => { root.color-group-chosen(index); }
                                token-chosen(id) => { root.color-token-chosen(id); token-editor.focus(); }
                            }
                            token-editor := ColorTokenEditor {
                                // A color search result selects its token first,
                                // then asks for this field.
                                property <int> reveal-request: root.reveal-request("appearance.color_hex");
                                // Keyboard focus and search share the same bounded reveal.
                                changed has-focus => {
                                    if self.has-focus {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    }
                                }
                                changed reveal-request => {
                                    if self.reveal-request > 0 {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        self.focus();
                                        if self.has-focus { root.settings-revealed-id = "appearance.color_hex"; }
                                    }
                                }
                                x: parent.wide ? token-list.x + token-list.width + 12px : 12px;
                                y: parent.wide ? 12px : token-list.y + token-list.height + 12px;
                                width: parent.wide ? parent.width - token-list.width - 36px : parent.width - 24px;
                                state: root.color-editor;
                                swatch: root.token-color(root.color-selected-id);
                                hex <=> root.color-hex-input;
                                override-count: root.color-override-count;
                                reset-all-notice: root.color-reset-all-notice;
                                ink: root.ink; muted: root.muted; surface: root.canvas; hover-surface: root.hover;
                                accent: root.accent; outline: root.divider; text-scale: root.text-scale;
                                hex-edited(text) => { root.color-hex-edited(text); }
                                restore-input => { root.color-token-chosen(root.color-selected-id); }
                                reset => { root.color-reset(); }
                                undo => { root.color-undo(); }
                                reset-all => { root.color-reset-all(); }
                            }
                        }
                        window-opacity-card := Rectangle {
                            height: window-opacity-setting.preferred-height + 24px;
                            background: root.elevated;
                            border-radius: StyleTokens.radius;
                            window-opacity-setting := WindowOpacitySetting {
                                property <int> reveal-request: root.reveal-request("appearance.window_opacity");
                                // Keyboard focus and search share the same bounded reveal.
                                changed has-focus => {
                                    if self.has-focus {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    }
                                }
                                changed reveal-request => {
                                    if self.reveal-request > 0 {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        self.focus();
                                        if self.has-focus { root.settings-revealed-id = "appearance.window_opacity"; }
                                    }
                                }
                                x: 12px; y: 12px; width: parent.width - 24px;
                                value: root.window-opacity-percent;
                                revision: root.window-opacity-revision;
                                status: root.window-transparency-status;
                                ink: root.ink; muted: root.muted; text-scale: root.text-scale;
                                previewed(value) => { root.preview-window-opacity(value); }
                                changed-value(value) => { root.set-window-opacity(value); }
                            }
                        }
                        Text { text: "Fonts"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 650; }
                        StyleFontSetting { label: "Interface font family"; family <=> root.appearance-ui-font-input;
                            property <int> reveal-request: root.reveal-request("appearance.fonts");
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus();
                                    if self.has-focus { root.settings-revealed-id = "appearance.fonts"; }
                                }
                            }
                            ink: root.ink; surface: root.elevated; accent: root.accent; text-scale: root.text-scale; }
                        StyleFontSetting { label: "Message font family · blank follows interface"; family <=> root.appearance-message-font-input;
                            ink: root.ink; surface: root.elevated; accent: root.accent; text-scale: root.text-scale; }
                        StyleFontSetting { label: "Monospaced font family · timestamps and security codes"; family <=> root.appearance-mono-font-input;
                            ink: root.ink; surface: root.elevated; accent: root.accent; text-scale: root.text-scale; }
                        TextAction {
                            text: "Apply fonts"; ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            activated => { root.set-style-fonts(root.appearance-ui-font-input, root.appearance-message-font-input, root.appearance-mono-font-input); }
                        }
                        StyleNumberSetting {
                            property <int> reveal-request: root.reveal-request("appearance.message_size");
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus-control();
                                    if self.has-focus { root.settings-revealed-id = "appearance.message_size"; }
                                }
                            }
                            label: "Message font size"; value: root.message-font-size; minimum: 10; maximum: 32;
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; text-scale: root.text-scale;
                            changed-value(value) => { root.change-style-number(0, value); } }
                        StyleNumberSetting {
                            property <int> reveal-request: root.reveal-request("appearance.sender_weight");
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus-control();
                                    if self.has-focus { root.settings-revealed-id = "appearance.sender_weight"; }
                                }
                            }
                            label: "Sender font weight"; value: root.sender-font-weight > 0 ? root.sender-font-weight : 650; minimum: 100; maximum: 900; step: 50;
                            // A CSS-style weight from 100 to 900 has no unit.
                            suffix: "";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; text-scale: root.text-scale;
                            changed-value(value) => { root.set-sender-weight(value); } }
                        TextAction {
                            text: root.sender-font-weight == 0 ? "Sender weight: surface defaults" : "Restore sender weight defaults";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            activated => { root.set-sender-weight(0); }
                        }
                        Text { text: "Available weights depend on your font. Message-body weight and line spacing are not configurable yet.";
                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                        Text { text: "Room header"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 650; }
                        for name[index] in ["Full · room header and introduction", "Compact · room header and topic", "Minimal · room name and actions"] : ActionRect {
                            property <int> reveal-request: index == 0 ? root.reveal-request("appearance.room_header") : 0;
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus();
                                    if self.has-focus { root.settings-revealed-id = "appearance.room_header"; }
                                }
                            }
                            height: 40px * root.text-scale;
                            label: "Room header: " + name + (root.conversation-header-mode == index ? ", selected" : "");
                            background: root.conversation-header-mode == index ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover) : self.has-hover ? root.hover : root.elevated;
                            border-radius: StyleTokens.radius * 0.8;
                            border-width: root.conversation-header-mode == index ? 1px : 0px;
                            border-color: root.accent;
                            focus-color: root.accent;
                            activated => { root.choose-conversation-header-mode(index); }
                            Text {
                                x: 12px; width: parent.width - 24px; height: parent.height;
                                text: name;
                                color: root.conversation-header-mode == index && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink;
                                font-size: 11px * root.text-scale;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Text {
