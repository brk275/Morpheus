        { name: "Terminal Soft", description: "Monospaced columns · rounded edges · small avatars" },
        { name: "Paper Wide", description: "Warm paper · serif · wide margins for long reading" },
        { name: "Contrast Reading", description: "Built-in high-contrast colors · heavier outlines · larger type" },
