    // Empty alternate clocks identify delivery status or a row with no clock.
    // Keep those labels unchanged even when clocks are hidden or decorated.
    pure function message-time-label(message: MessageItem) -> string {
        if message.time-24h == "" { return message.time; }
        let clock = root.timestamp-format == 1 ? message.time-24h
            : root.timestamp-format == 2 ? message.time-24h-seconds : message.time;
        return clock == "" ? "" : root.timestamp-brackets ? "[" + clock + "]" : clock;
    }
    // A fixed sample clock in the chosen timestamp format and decoration.
    pure function sample-clock(twelve: string, day: string, seconds: string) -> string {
        let clock = root.timestamp-format == 1 ? day : root.timestamp-format == 2 ? seconds : twelve;
        return root.timestamp-brackets ? "[" + clock + "]" : clock;
    }
    // Session only and never saved: whether Settings shows the live preview,
    // and whether a compact copy stays above the settings while editing.
    in-out property <bool> appearance-preview-shown: true;
    in-out property <bool> appearance-preview-pinned: false;
    property <length> pinned-preview-height: 66px * max(1, min(1.4, root.text-scale));
    // Colors of TokenButtons drawn on the window's own surfaces.
    property <ControlColors> button-colors: {
        ink: root.ink,
        muted: root.muted,
        surface: root.elevated,
        hover: root.hover,
        outline: root.divider,
        accent: root.accent,
        accent-ink: root.accent-ink,
    };
    // Optional nickname column decoration. Accessible labels keep the
    // plain name, so the brackets are visual only.
    pure function nickname-column-label(sender: string) -> string {
        return root.nickname-brackets ? "<" + sender + ">" : sender;
    }
    // Message text and surface precedence: selection first, then the sender
    // palette for names, then own-message roles from real is-own metadata,
    // then the plain roles, then the legacy ink/muted/transparent colors.
    public pure function clock-ink(selected: bool) -> color {
        return selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color
            : StyleTokens.roles.timestamp.present ? StyleTokens.roles.timestamp.color : root.muted;
    }
    public pure function sender-ink(selected: bool, own: bool, palette-index: int, accent: color) -> color {
        return selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color
            : root.color-message-senders ? (root.sender-palette.length > 0 ? root.sender-palette[mod(palette-index, max(1, root.sender-palette.length))] : accent)
            : own && StyleTokens.roles.own-message.present ? StyleTokens.roles.own-message.color
            : StyleTokens.roles.sender.present ? StyleTokens.roles.sender.color : root.ink;
    }
    public pure function body-ink(selected: bool, own: bool) -> color {
        return selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color
            : own && StyleTokens.roles.own-message.present ? StyleTokens.roles.own-message.color
            : StyleTokens.roles.message.present ? StyleTokens.roles.message.color : root.ink;
    }
    public pure function row-surface(selected: bool, hovered: bool, own: bool, idle: color) -> color {
        return selected ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover)
            : hovered ? root.message-hover-surface
            : own && StyleTokens.roles.own-surface.present ? StyleTokens.roles.own-surface.color : idle;
    }

