    // action runs exactly as its icon does (it may move focus on).
    function choose-header-more(slot: int) {
        root.close-header-more(true);
        root.header-action(slot);
    }
    changed header-more-allowed => {
        if !root.header-more-allowed { root.close-header-more(false); }
    }
    // A width change retires the menu (focus back on More, or Search) and an
    // action folded while focused hands focus to More without acting.
    property <int> header-layout: root.header-capacity * 4 + (root.header-leave-shown ? 1 : 0)
        + (root.header-jump-shown ? 2 : 0);
    changed header-layout => {
        let folded = root.header-focus >= 0 && !root.header-fits(root.header-focus);
        if root.header-more-open {
            root.close-header-more(true);
        } else if folded || (root.header-full && header-more.has-focus) {
            root.focus-header-more();
        }
        if folded { root.header-focus = -1; }
    }
    // Another account or room: the menu was shown for the old one.
    property <string> header-room-context: root.active-account-local-id + "\n" + root.active-room-id;
    changed header-room-context => { root.close-header-more(true); }
    // Leaving the conversation page drops the folded state with the header.
    property <bool> header-on-page: root.page == 0;
    changed header-on-page => {
        root.header-focus = -1;
        root.close-header-more(false);
    }
    // A panel opened from a folded action gives focus back to More, under
    // the same condition as the action's own icon.
    changed room-notification-focus-request => {
        if root.page == 0 && !root.header-shows(0) { root.focus-header-more(); }
    }
    property <int> header-thread-return: ThreadBrowser.return-focus;
    changed header-thread-return => {
        if root.page == 0 && !root.header-shows(3) { root.focus-header-more(); }
    }
    // Leave's dialog ended: whichever header control opened it, focus goes to
