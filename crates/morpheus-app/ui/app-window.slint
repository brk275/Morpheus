    in-out property <int> message-layout: 0;
    in-out property <int> conversation-header-mode: 0; // full, compact, minimal
    in-out property <bool> show-message-avatars: true;
    in-out property <bool> show-message-timestamps: true;
    in-out property <bool> color-message-senders: false;
    in-out property <[color]> sender-palette;
    in-out property <int> nickname-width-px: 128;
    in-out property <bool> nickname-brackets: false;
    in-out property <int> nickname-alignment: 1; // 0 left, 1 right
    callback choose-nickname-alignment(int);
    in-out property <string> appearance-ui-font-input;
    in-out property <string> appearance-message-font-input;
    in-out property <string> appearance-mono-font-input;
    callback choose-style-preset(int);
    callback set-style-fonts(string, string, string);
    callback change-style-number(int, int);
    callback choose-message-layout(int);
    callback choose-conversation-header-mode(int);
    callback set-style-flag(int, bool);
    callback set-sender-weight(int);
    callback choose-timestamp-format(int);

    // Settings search. Results come from the Rust registry; choosing one only
    // reveals and focuses its control and never changes a setting.
    in-out property <string> settings-search-query;
    in-out property <[SettingsResult]> settings-search-results;
    in-out property <int> settings-search-index: -1;
    in-out property <bool> settings-search-dismissed: false;
    callback settings-search(string);
    callback settings-search-choose(string);
    // The control whose registry ID matches scrolls into view and takes focus
    // each time the serial changes; it then reports its ID.
    in-out property <string> settings-reveal-id;
    in-out property <int> settings-reveal-serial: 0;
    in-out property <string> settings-revealed-id;
    // Manage accounts focuses "add", "protection" or its close action.
    in-out property <string> manage-accounts-focus;
    pure function reveal-request(id: string) -> int {
        return root.settings-reveal-id == id ? root.settings-reveal-serial : 0;
    }

    // Appearance workspace: one selected color token at a time.
    in-out property <[ColorGroupItem]> color-groups;
    in-out property <[ColorTokenItem]> color-tokens;
    in-out property <int> color-group-index: 0;
    in-out property <string> color-filter;
    in-out property <string> color-selected-id;
    in-out property <ColorEditorState> color-editor;
    in-out property <string> color-hex-input;
    in-out property <string> color-reset-all-notice;
    in-out property <int> color-override-count: 0;
    callback color-filter-changed(string);
    callback color-group-chosen(int);
    callback color-token-chosen(string);
    callback color-hex-edited(string);
    callback color-reset();
    callback color-undo();
    callback color-reset-all();
    in-out property <int> window-opacity-percent: 100;
    in-out property <int> window-opacity-revision: 0;
    in-out property <string> window-transparency-status;
    callback preview-window-opacity(int);
    callback set-window-opacity(int);

    // Empty alternate clocks identify delivery status or a row with no clock.
    // Keep those labels unchanged even when clocks are hidden or decorated.
    pure function message-time-label(message: MessageItem) -> string {
        if message.time-24h == "" { return message.time; }
        let clock = root.timestamp-format == 1 ? message.time-24h
            : root.timestamp-format == 2 ? message.time-24h-seconds : message.time;
        return clock == "" ? "" : root.timestamp-brackets ? "[" + clock + "]" : clock;
    }
    // Optional nickname column decoration. Accessible labels keep the
    // plain name, so the brackets are visual only.
    pure function nickname-column-label(sender: string) -> string {
        return root.nickname-brackets ? "<" + sender + ">" : sender;
    }
    // Message text and surface precedence: selection first, then the sender
    // palette for names, then own-message roles from real is-own metadata,
    // then the plain roles, then the legacy ink/muted/transparent colors.
    public pure function clock-ink(selected: bool) -> color {
        return selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color
            : StyleTokens.roles.timestamp.present ? StyleTokens.roles.timestamp.color : root.muted;
    }
    public pure function sender-ink(selected: bool, own: bool, palette-index: int, accent: color) -> color {
        return selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color
            : root.color-message-senders ? (root.sender-palette.length > 0 ? root.sender-palette[mod(palette-index, max(1, root.sender-palette.length))] : accent)
            : own && StyleTokens.roles.own-message.present ? StyleTokens.roles.own-message.color
            : StyleTokens.roles.sender.present ? StyleTokens.roles.sender.color : root.ink;
    }
    public pure function body-ink(selected: bool, own: bool) -> color {
        return selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color
            : own && StyleTokens.roles.own-message.present ? StyleTokens.roles.own-message.color
            : StyleTokens.roles.message.present ? StyleTokens.roles.message.color : root.ink;
    }
    public pure function row-surface(selected: bool, hovered: bool, own: bool, idle: color) -> color {
        return selected ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover)
            : hovered ? root.elevated
            : own && StyleTokens.roles.own-surface.present ? StyleTokens.roles.own-surface.color : idle;
    }

    in-out property <string> config-error;
