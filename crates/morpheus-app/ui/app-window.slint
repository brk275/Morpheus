    // Presentation only: show the thread tab of the side panel.
    public function show-thread-panel() {
        root.page = 0;
        root.show-side-panel = true;
        root.details-reveal-open = true;
        root.side-panel-tab = 1;
    }
    // Presentation only: show the pinned-messages tab of the side panel.
    public function show-pinned-panel() {
        if root.pinned-pane-visible { root.pinned-focus-request += 1; } else { root.pinned-focus-pending = true; }
        root.page = 0;
        root.show-side-panel = true;
        root.details-reveal-open = true;
        root.side-panel-tab = 3;
    }
    callback focus-room-search();
    focus-room-search => {
        root.page = 0;
        root.show-side-panel = true;
        root.details-reveal-open = true;
        root.side-panel-tab = 2;
        root.search-focus-request += 1;
    }
    // Keyboard shortcut destinations that need this window's own elements.
    public function go-home() {
        root.active-space-id = "";
        root.active-space-name = "Home";
        root.select-space("");
        root.page = 0;
    }
    // Presentation only, like show-thread-panel.
    public function show-members-panel() {
        root.page = 0;
        root.show-side-panel = true;
        root.details-reveal-open = true;
        root.side-panel-tab = 0;
    }
    // Presentation only: show the transfers tab of the side panel and focus
    // its heading.
    public function show-transfer-panel() {
        root.transfer-focus-request += 1;
        root.transfer-focus-pending = true;
        root.page = 0;
        root.show-side-panel = true;
        root.details-reveal-open = true;
        root.side-panel-tab = 4;
    }
    // Presentation only: show the media tab of the side panel and focus its
    // search. Close gives the panel back as it was, without editing the
    // saved layout.
    public function show-room-media() {
        if !root.room-media-visible {
            root.room-media-return-tab = root.side-panel-tab == 5 ? 0 : root.side-panel-tab;
            root.room-media-return-shown = root.page == 0 && root.show-side-panel;
            root.room-media-return-reveal = root.details-reveal-open;
            RoomMedia.focus-pending = true;
        } else {
            RoomMedia.focus-request += 1;
        }
        root.page = 0;
        root.show-side-panel = true;
        root.details-reveal-open = true;
        root.side-panel-tab = 5;
    }
    function close-room-media() {
        root.side-panel-tab = root.room-media-return-tab;
        root.details-reveal-open = root.room-media-return-reveal;
        root.show-side-panel = root.room-media-return-shown;
        root.focus-composer(false);
    }
    // Opens the menu and focuses its trigger; each entry keeps its own
    // activation and confirmation.
    public function open-account-menu() {
        if !RoomAddresses.open {
            root.account-menu-open = true;
            account-trigger.focus();
        }
    }
    property <bool> settings-search-focus-pending: false;
    property <int> settings-search-focus-request: 0;
    public function focus-settings-search() {
        root.settings-search-focus-pending = true;
        root.page = 1;
        // Searching again returns to the last results instead of hiding them.
        if root.settings-search-query != "" { root.settings-search-dismissed = false; }
        root.settings-search-focus-request += 1;
    }
