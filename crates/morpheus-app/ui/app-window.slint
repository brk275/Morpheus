    out property <bool> thread-browser-allowed: root.thread-browser-entry-allowed
        && !MatrixLink.open;
    out property <bool> thread-browser-entry-allowed: root.live-session && root.page == 0
        && !RoomLeave.view.open && !IdentityWarnings.open
        && !root.show-sign-in && !root.access-open && !root.manage-accounts-open
        && !root.account-menu-open && !root.account-switch-pending
        && !root.security-busy && root.security-recovery-key == "" && !root.sas-busy
        && root.sas-stage == 0
        && !root.account-profile-open && !root.people-open && !MemberPrivacy.inspector.open
        && !SpaceExplorer.open && !SpaceRooms.open && !RoomAddresses.open
        && !RoomNotificationState.open && !RoomActivity.seen-open && !root.quick-switcher-open
        && !root.room-actions-open && !root.room-admin-open && !root.member-confirm-open
        && !root.native-capture-picker-open && !root.leave-call-dialog
        && !root.image-preview-open && !root.poll-dialog-open && root.shortcut-recording == ""
        && !root.header-more-open && !InvitationsState.open;
    changed thread-browser-allowed => { if !root.thread-browser-allowed { ThreadBrowser.context-changed(); } }
    // Input IDs live inside conditional subtrees; callbacks cross that boundary.
    in-out property <int> composer-caret: -1;
    in-out property <int> composer-anchor: -1;
    in-out property <bool> composer-preedit: false;
    in-out property <int> thread-caret: -1;
    in-out property <int> thread-anchor: -1;
    in-out property <bool> thread-preedit: false;
    property <int> mention-place-request: 0;
    property <int> mention-place-position: 0;
    property <bool> mention-place-thread: false;
    in-out property <bool> thread-markdown: false;
    in-out property <string> composer-text;
    in-out property <bool> composer-markdown: false;
    in-out property <bool> composer-saved-markdown: false;
    in-out property <bool> composer-busy: false;
    in-out property <[AttachmentItem]> attachment-items;
    in-out property <int> attachment-ready-count: 0;
    in-out property <bool> attachment-can-add: true;
    out property <bool> composer-sends-attachments: root.composer-text == "" && root.composer-mode == 0 && root.attachment-ready-count > 0;
    in-out property <string> attachment-status;
    in-out property <string> downloading-event-id;
    in-out property <int> download-operation: 0;
    // The visible account's transfer center; see transfer-center.slint and
