                                ink: root.ink; muted: root.muted; surface: root.panel; hover-surface: root.hover;
                                outline: root.accent; text-scale: root.text-scale;
                                text: "Return to live";
                                accessible-label: "Return to the latest messages in this room";
                                activated => { root.return-to-live(); }
                            }
                        }
                    }
                    if root.live-session && root.page == 0 && root.active-room-id != "" && root.timeline-recovery-serial > 0 : TimelineRecoveryNotice {
                        action-enabled: root.viewport-seek-allowed && !root.settings-reveal-protected;
                        ink: root.ink; muted: root.muted; surface: root.elevated;
                        hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                        open-recovery => { root.open-timeline-recovery(false, root.timeline-recovery-serial); }
                    }
                    if root.live-session && root.active-room-id != "" : HorizontalLayout {
                        height: max(36px, 32px * root.text-scale);
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 10px;
                        TextAction {
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            text: root.history-loading ? "Loading earlier messages…" : root.history-at-start ? "Start of room history" : "Load earlier messages";
                            enabled: !root.history-loading && !root.history-at-start;
                            accessible-label: root.history-at-start ? "Start of room history reached" : "Load earlier messages in this Matrix room";
                            activated => { root.load-older-messages(); }
                        }
                        if root.history-error != "" : Text {
                            text: root.history-error;
                            color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483;
                            font-size: 11px * root.text-scale;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                            accessible-live-region: polite;
                        }
                    }
                    timeline-list := ListView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        // Automatic read receipts (room activity): the last row's event while
                        // the live list is scrolled to its bottom; Rust checks everything else.
                        property <bool> at-bottom: self.content-height <= self.visible-height + 1px || -self.content-y >= self.content-height - self.visible-height - 24px;
                        property <string> read-key: root.live-session && root.page == 0 && !root.conversation-focused && self.at-bottom && root.messages.length > 0 ? root.messages[root.messages.length - 1].event-id : "";
                        changed read-key => { RoomActivity.read-view(false, self.read-key); }
                        // A list created while a seek already runs takes its starting point
                        // here: `changed seek-id` below never fires for the first id it sees.
                        init => {
                            RoomActivity.read-view(false, self.read-key);
                            self.watch-created();
                        }
                        // The person's wheel, drag or scrollbar wins over a seek; content-y set
                        // here never reports as scrolled.
                        scrolled => {
                            if root.timeline-seek-id != 0 {
                                root.viewport-seek-ended(root.timeline-seek-id, 0);
                            }
                        }
                        // A new seek to a far row jumps at once, before the next frame is
                        // drawn; a near row may be drawn already and places itself.
                        property <int> seek-id: root.timeline-seek-id;
                        changed seek-id => {
                            self.watch-start();
                            self.approach-seek(true);
                        }
                        // Rows changed under the running seek (Rust resolved its row
                        // again): the top row the list then draws is its new baseline.
                        property <int> seek-rows: root.timeline-seek-rows;
                        changed seek-rows => { root.timeline-seek-expect = true; }
                        // The running seek's baseline: the reader's top row when it starts.
                        function watch-start() {
                            let id = root.timeline-seek-id;
                            if id != 0 && root.timeline-seek-seen-id != id {
                                root.timeline-seek-seen-id = id;
                                root.timeline-seek-seen-index = root.timeline-anchor-index;
                                root.timeline-seek-seen-offset = root.timeline-anchor-offset;
                                root.timeline-seek-expect = root.timeline-anchor-index < 0;
                            }
                        }
                        // The baseline of a seek that ran before this list existed: its
                        // content-y as created. No row of this list has reported the top
                        // yet, so its first report becomes the baseline only while the
                        // list is still where it was created.
                        function watch-created() {
                            let id = root.timeline-seek-id;
                            if id != 0 {
                                root.timeline-seek-seen-id = id;
                                root.timeline-seek-seen-index = -1;
                                root.timeline-seek-expect = false;
                                root.timeline-seek-created-id = id;
                                root.timeline-seek-created-y = self.content-y;
                            }
                        }
                        // The list moved since it was created under seek `id`, before
                        // that seek moved it: the person scrolled.
                        pure function moved-since-created(id: int) -> bool {
                            root.timeline-seek-created-id == id
                                && abs(self.content-y - root.timeline-seek-created-y) > 0.01px
                        }
                        // The top row reported again (after a layout). A change the seek
                        // expects (its own move or jump, or changed rows) becomes its
                        // baseline; any other change is the person's scrolling, which ends
                        // it. The list's own re-anchoring keeps the top row where it is.
                        function watch-seek() {
