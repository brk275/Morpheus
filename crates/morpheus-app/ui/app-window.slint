import { AboutSlint, Button, ComboBox, ListView, Palette, ScrollView, Slider, SpinBox } from "std-widgets.slint";
import { MemberActionDialog, RoomMembersPanel, RosterMember, RosterPalette, RosterPermission } from "room-admin.slint";
import { SpaceManagerPage, SpaceManagerView, SpacePick, SpaceRow } from "space-manager.slint";

// Optional overrides retain each control's existing color when absent.
export struct ColorRole {
    present: bool,
    color: color,
}

export struct ThemeRoleSet {
    error: ColorRole,
    error-surface: ColorRole,
    error-ink: ColorRole,
    success: ColorRole,
    success-surface: ColorRole,
    success-ink: ColorRole,
    selection: ColorRole,
    selection-ink: ColorRole,
    focus: ColorRole,
    link: ColorRole,
    unread: ColorRole,
    unread-ink: ColorRole,
    destructive: ColorRole,
    destructive-ink: ColorRole,
    voice: ColorRole,
    timestamp: ColorRole,
    sender: ColorRole,
    message: ColorRole,
    own-message: ColorRole,
    own-surface: ColorRole,
    scrim: ColorRole,
    shadow: ColorRole,
    media-backdrop: ColorRole,
    presence-online: ColorRole,
    avatar-ink: ColorRole,
}

// Sparse `[colors]` overrides of the eleven base colors. An absent entry
// keeps the theme pack's color, or the built-in palette's.
export struct BaseColorSet {
    rail: ColorRole,
    sidebar: ColorRole,
    canvas: ColorRole,
    panel: ColorRole,
    elevated: ColorRole,
    hover: ColorRole,
    ink: ColorRole,
    muted: ColorRole,
    divider: ColorRole,
    accent: ColorRole,
    accent-ink: ColorRole,
}

// One Settings search result. `id` is a registry target ID, never a path or URL.
export struct SettingsResult {
    id: string,
    label: string,
    breadcrumb: string,
    description: string,
}

export struct ColorGroupItem {
    id: string,
    label: string,
    count: int,
    window: bool,
}

export struct ColorTokenItem {
    id: string,
    label: string,
    group: string,
    overridden: bool,
}

export struct ColorEditorState {
    id: string,
    label: string,
    description: string,
    group: string,
    // Where the shown color comes from, as fixed text.
    source: string,
    overridden: bool,
    can-undo: bool,
    // Inline guidance for the typed value; the last valid color stays applied.
    hint: string,
}

// Runtime geometry shared by small reusable controls and the main view.
export global StyleTokens {
    in-out property <length> radius: 10px;
    in-out property <ThemeRoleSet> roles;
    in-out property <BaseColorSet> base;
    // Share of each window surface's own alpha that is painted, 0 to 1.
    in-out property <float> window-opacity: 1;
    in-out property <bool> reduced-motion: false;
    in-out property <int> hover-duration-ms: 90;
    out property <duration> interaction-duration: StyleTokens.reduced-motion ? 0ms : StyleTokens.hover-duration-ms * 1ms;
}

// Animate only the decorative hover layer. Selection colors, content, focus
// outlines and hit geometry change immediately. The direct reduced-motion
// branch also hides an in-flight transition as soon as the preference changes.
component HoverSurface inherits Rectangle {
    in property <bool> highlighted;
    property <float> intensity: root.highlighted ? 1 : 0;
    animate intensity { duration: StyleTokens.interaction-duration; easing: ease-out; }
    opacity: StyleTokens.reduced-motion ? (root.highlighted ? 1 : 0) : root.intensity;
}

export struct EmojiItem {
    key: string,
    symbol: string,
    name: string,
}

export struct MentionItem {
    key: string,
    name: string,
}

// One sticker row. `key` is an opaque routing value the controller checks
// against its open picker; it is never a media address and never displayed.
export struct StickerItem {
    key: string,
    label: string,
    pack: string,
}

// One saved send record of the visible composer scope. `key` is an opaque
// routing value for the exact record and is never displayed.
export struct PendingSendItem {
    key: string,
    status: string,
    preview: string,
    can-cancel: bool,
    can-retry: bool,
    unconfirmed: bool,
    kept: bool,
}

// These Palette fallbacks match Slint 1.18.1's TextInput defaults.
component ThemedTextInput inherits TextInput {
    selection-background-color: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : Palette.selection-background;
    selection-foreground-color: StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : Palette.selection-foreground;
}

// Pinned Slint 1.18.1 adapter. Only these three reads use its documented-as-
// internal test/IME properties; placement uses the public UTF-8 offset setter.
// This wrapper must receive native caret/selection/IME acceptance on upgrades.
component MentionInput inherits TextInput {
    selection-background-color: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : Palette.selection-background;
    selection-foreground-color: StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : Palette.selection-foreground;
    out property <int> caret-bytes: self.cursor-position-byte-offset;
    out property <int> anchor-bytes: self.anchor-position-byte-offset;
    out property <bool> composing: self.preedit-text != "";
    callback caret-changed();
    changed caret-bytes => { root.caret-changed(); }
    changed anchor-bytes => { root.caret-changed(); }
    changed composing => { root.caret-changed(); }
}

