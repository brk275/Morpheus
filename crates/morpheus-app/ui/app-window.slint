    // Settings search. Results come from the Rust registry; choosing one only
    // reveals and focuses its control and never changes a setting.
    in-out property <string> settings-search-query;
    in-out property <[SettingsResult]> settings-search-results;
    in-out property <int> settings-search-index: -1;
    in-out property <bool> settings-search-dismissed: false;
    callback settings-search(string);
    callback settings-search-choose(string);
    // The control whose registry ID matches scrolls into view and takes focus
    // each time the serial changes; it then reports its ID.
    in-out property <string> settings-reveal-id;
    in-out property <int> settings-reveal-serial: 0;
    in-out property <string> settings-revealed-id;
    // Only an explicit registry reveal can arm this one-attempt mount handoff.
    in-out property <bool> settings-controls-mounted: false;
    in-out property <bool> settings-reveal-pending: false;
    in-out property <string> settings-pending-reveal-id;
    in-out property <int> settings-pending-reveal-serial: 0;
    callback settings-reveal-ready(string, int);
    public function cancel-settings-reveal() {
        root.settings-reveal-pending = false;
        root.settings-pending-reveal-id = "";
        root.settings-pending-reveal-serial = 0;
    }
    public function prepare-settings-reveal() {
        root.cancel-settings-reveal();
        root.settings-search-focus-pending = false;
    }
    // Page and session availability are checked separately. Inline Settings
    // status/busy rows remain valid destinations; another modal owns its focus.
    out property <bool> settings-reveal-protected: root.show-sign-in || root.access-open
        || root.manage-accounts-open || root.account-menu-open || root.account-switch-pending
        || root.security-recovery-key != "" || root.account-profile-open || root.people-open
        || MemberPrivacy.inspector.open || SpaceExplorer.open || SpaceRooms.open || RoomAddresses.open
        || RoomNotificationState.open || RoomActivity.seen-open || root.quick-switcher-open
        || root.room-actions-open || root.room-admin-open || root.member-confirm-open
        || root.native-capture-picker-open || root.leave-call-dialog || root.image-preview-open
        || root.poll-dialog-open || ThreadBrowser.open || RoomLeave.view.open || MatrixLink.open
        || root.header-more-open || IdentityWarnings.open || InvitationsState.open
        || root.shortcut-recording != "";
    changed settings-reveal-protected => {
        if root.settings-reveal-protected { root.cancel-settings-reveal(); }
    }
