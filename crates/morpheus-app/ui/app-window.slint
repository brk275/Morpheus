    function header-focus-changed(slot: int, focused: bool) {
        if focused {
            root.header-focus = slot;
        } else if root.header-focus == slot {
            root.header-focus = -1;
        }
    }
    // More, or Search once nothing is folded.
    function focus-header-more() {
        if root.header-overflow { header-more.focus(); } else { root.header-search-focus-request += 1; }
    }
    // More may open, and stay open, only on the conversation page while no
    // other surface owns the window: the complete list Leave admission uses
    // (room-leave-blocked, which includes the thread browser), an open Leave
    // and a shown Matrix link card. Refused, More does nothing at all: a
    // surface that is up keeps what it shows and holds.
    property <bool> header-more-allowed: root.page == 0 && !root.room-leave-blocked && !RoomLeave.view.open && !MatrixLink.open;
    // The only way More opens (its own activation: click, Return/Space or
    // the accessibility action). Admitted, it is a protected entry: before its
    // flag changes, a Matrix link's held navigation (a joined link's message
    // still to come), the thread browser's work and a Leave owner that no
    // longer shows are withdrawn synchronously, so nothing joins, reveals or
    // comes back once the menu has taken the window or closed again.
    function toggle-header-more() {
        if root.header-more-open {
            root.close-header-more(true);
        } else if root.header-more-allowed && root.header-overflow {
            CallBar.withdraw();
            MatrixLink.withdraw(); UnreadNavigation.withdraw-jump();
            IdentityWarnings.withdraw(); ThreadBrowser.withdraw();
            root.header-more-open = true;
        }
    }
    function close-header-more(refocus: bool) {
        if root.header-more-open {
            root.header-more-open = false;
            root.header-menu-current = -1;
            if refocus { root.focus-header-more(); }
        }
    }
    // Keyboard focus inside the More menu, by slot. Its items live in
    // conditional subtrees, so each one focuses itself on a new serial.
    property <int> header-menu-target: -1;
    property <int> header-menu-serial: 0;
    // The More item that has keyboard focus, or -1.
    property <int> header-menu-current: -1;
    // The slot at a position on screen and in the menu (0-9), and back:
    // notifications, room settings, Leave, Jump, then slots 2-7.
    pure function header-menu-slot(position: int) -> int {
        position <= 1 ? position : position == 2 ? 8 : position == 3 ? 9 : position - 2
    }
    pure function header-menu-position(slot: int) -> int {
        slot <= 1 ? slot : slot == 8 ? 2 : slot == 9 ? 3 : slot + 2
    }
    // Listed in More and available now.
    pure function header-listed(slot: int) -> bool {
        !root.header-shows(slot) && root.header-enabled(slot)
    }
    // The slot of the next listed, available item after menu position `from`
    // (step 1) or before it (step 9), wrapping; -1 when there is none.
    pure function header-menu-step(from: int, step: int) -> int {
        let first = mod(from + step, 10);
        let second = mod(first + step, 10);
        let third = mod(second + step, 10);
        let fourth = mod(third + step, 10);
        let fifth = mod(fourth + step, 10);
        let sixth = mod(fifth + step, 10);
        let seventh = mod(sixth + step, 10);
        let eighth = mod(seventh + step, 10);
        let ninth = mod(eighth + step, 10);
        let tenth = mod(ninth + step, 10);
        return root.header-listed(root.header-menu-slot(first)) ? root.header-menu-slot(first)
            : root.header-listed(root.header-menu-slot(second)) ? root.header-menu-slot(second)
            : root.header-listed(root.header-menu-slot(third)) ? root.header-menu-slot(third)
            : root.header-listed(root.header-menu-slot(fourth)) ? root.header-menu-slot(fourth)
            : root.header-listed(root.header-menu-slot(fifth)) ? root.header-menu-slot(fifth)
            : root.header-listed(root.header-menu-slot(sixth)) ? root.header-menu-slot(sixth)
            : root.header-listed(root.header-menu-slot(seventh)) ? root.header-menu-slot(seventh)
            : root.header-listed(root.header-menu-slot(eighth)) ? root.header-menu-slot(eighth)
            : root.header-listed(root.header-menu-slot(ninth)) ? root.header-menu-slot(ninth)
            : root.header-listed(root.header-menu-slot(tenth)) ? root.header-menu-slot(tenth) : -1;
    }
    function focus-header-menu(slot: int) {
        if slot >= 0 {
            root.header-menu-target = slot;
            root.header-menu-serial += 1;
        }
    }
    // As the menu opens its first available item takes focus. With every
    // listed action unavailable More itself holds it (the menu may have been
    // opened by the accessibility action, with focus elsewhere).
    function focus-header-menu-first() {
