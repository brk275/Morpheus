                                        root.send-message(root.composer-text);
                                    }
                                }
                            }
                        }
                        if root.emoji-open && !root.emoji-threaded && root.mention-ui-allowed : EmojiPopup {
                            x: root.content-inset; y: -self.height; width: max(0px, parent.width - 2 * root.content-inset);
