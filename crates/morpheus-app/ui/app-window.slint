                                }
                            }
                            IconAction {
                                width: 28px; icon: "☺"; label: "Open emoji picker for thread reply";
                                ink: root.muted; surface: transparent; hover-surface: root.hover;
                                enabled: root.mention-ui-allowed && !root.thread-send-pending;
                                activated => {
                                    if root.sticker-open { root.sticker-dismiss(); }
                                    root.thread-caret = thread-input.caret-bytes; root.thread-anchor = thread-input.anchor-bytes; root.thread-preedit = thread-input.composing;
                                    root.open-emoji(true);
                                }
                            }
                            IconAction {
                                width: 28px; icon: "✿"; label: "Open sticker picker for this thread";
                                ink: root.sticker-open && root.sticker-threaded ? root.accent : root.muted;
                                selected: root.sticker-open && root.sticker-threaded;
                                surface: root.panel; hover-surface: root.hover;
                                enabled: root.mention-ui-allowed && !root.thread-send-pending;
                                activated => {
                                    if root.emoji-open { root.emoji-dismiss(); }
                                    root.open-stickers(true);
                                }
                            }
                            IconAction {
                                width: 32px; icon: "Md"; label: root.thread-markdown ? "Thread plain text" : "Thread Markdown";
                                selected: root.thread-markdown; enabled: !root.thread-send-pending;
                                ink: root.thread-markdown ? root.accent : root.muted; surface: transparent; hover-surface: root.hover;
                                activated => { root.thread-markdown = !root.thread-markdown; root.thread-formatting-changed(root.thread-markdown); thread-input.focus(); }
                            }
                            IconAction {
                                icon: "➤"; label: "Send thread reply"; ink: root.accent;
                                enabled: !root.thread-send-pending;
                                surface: transparent; hover-surface: root.hover;
                                activated => {
                                    root.thread-caret = thread-input.caret-bytes; root.thread-anchor = thread-input.anchor-bytes; root.thread-preedit = thread-input.composing;
                                    root.send-thread-message(root.thread-composer-text);
                                }
                            }
                        }
                        if root.emoji-open && root.emoji-threaded && root.mention-ui-allowed : EmojiPopup {
                            x: 4px; y: -self.height; width: parent.width - 8px;
                            items: root.emoji-items; current: root.emoji-index; query <=> root.emoji-query-text;
                            surface: root.panel; elevated: root.elevated; hover: root.hover; ink: root.ink; muted: root.muted; accent: root.accent; text-scale: root.text-scale;
                            searched(query) => { root.emoji-query(query); }
                            navigate(offset) => { root.emoji-navigate(offset); }
                            dismiss => { root.emoji-dismiss(); }
                            choose(key) => {
                                root.thread-caret = thread-input.caret-bytes; root.thread-anchor = thread-input.anchor-bytes; root.thread-preedit = thread-input.composing;
                                root.emoji-choose(key);
                            }
                        }
                        if root.sticker-open && root.sticker-threaded && root.mention-ui-allowed : StickerPopup {
                            x: 4px; y: -self.height; width: parent.width - 8px;
                            items: root.sticker-items; packs: root.sticker-packs; pack-index <=> root.sticker-pack-index;
                            current: root.sticker-index; query <=> root.sticker-query-text;
                            phase: root.sticker-phase; status: root.sticker-status; notice: root.sticker-notice;
                            needs-consent: root.sticker-needs-consent; can-send: root.sticker-can-send;
                            preview: root.sticker-preview-image; preview-loaded: root.sticker-preview-loaded; preview-status: root.sticker-preview-status;
                            available-height: max(140px, parent.absolute-position.y - 8px);
                            surface: root.panel; elevated: root.elevated; hover: root.hover; ink: root.ink; muted: root.muted; accent: root.accent;
                            outline: root.divider; text-scale: root.text-scale;
                            searched(query) => { root.sticker-query(query); }
                            navigate(offset) => { root.sticker-navigate(offset); }
                            choose-pack(index) => { root.sticker-choose-pack(index); }
                            highlight(key) => { root.sticker-highlight(key); }
                            send(key) => { root.sticker-send(key); }
                            consent(allowed) => { root.sticker-consent(allowed); }
                            dismiss => { root.sticker-dismiss(); }
                        }
                        if root.sticker-send-visible && root.sticker-send-threaded && !root.sticker-open && !root.emoji-open && root.thread-mentions.length == 0 : StickerSendStatus {
                            x: 4px; y: -self.height; width: parent.width - 8px;
                            status: root.sticker-send-status; can-cancel: root.sticker-send-can-cancel; can-retry: root.sticker-send-can-retry;
                            uncertain: root.sticker-send-uncertain; outline: root.divider;
                            surface: root.panel; hover: root.hover; ink: root.ink; muted: root.muted; accent: root.accent; text-scale: root.text-scale;
                            cancel => { root.sticker-send-cancel(); }
                            retry => { root.sticker-send-retry(); }
                            dismiss => { root.sticker-send-dismiss(); }
                        }
                        if root.thread-mentions.length > 0 && root.mention-ui-allowed && !root.emoji-open && !root.sticker-open : MentionPopup {
                            x: 4px; y: -self.height; width: parent.width - 8px;
                            items: root.thread-mentions; current: root.thread-mention-index;
                            surface: root.panel; hover: root.hover; ink: root.ink; muted: root.muted; accent: root.accent; text-scale: root.text-scale;
                            choose(key) => {
                                root.thread-caret = thread-input.caret-bytes; root.thread-anchor = thread-input.anchor-bytes; root.thread-preedit = thread-input.composing;
                                root.mention-choose(true, key);
                            }
                        }
                    }
                }
                if root.side-panel-tab == 2 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;
                    Rectangle {
                        height: 123px;
                        background: root.panel;
                        VerticalLayout {
                            padding: 12px; spacing: 7px;
                            Text { text: "Search this room"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 750; }
                            Rectangle {
                                height: 34px; background: root.elevated; border-radius: 7px;
                                search-message-input := ThemedTextInput {
                                    x: 8px; y: 2px; width: parent.width - 16px; height: parent.height - 4px;
                                    text <=> root.room-search-query; color: root.ink; font-size: 12px * root.text-scale;
                                    enabled: root.live-session && root.active-room-id != "" && !root.room-search-loading;
                                    accessible-label: "Search terms for current room";
                                    property <int> focus-request: root.search-focus-request;
                                    init => { if root.live-session { self.focus(); } }
                                    changed focus-request => { if root.live-session && self.enabled { self.focus(); } }
                                    accepted => { root.query-room-messages(); }
                                }
                            }
                            Button {
                                text: root.room-search-loading ? "Searching…" : "Search";
                                accessible-label: "Search messages in current room";
                                enabled: root.live-session && root.active-room-id != "" && !root.room-search-loading;
                                clicked => { root.query-room-messages(); }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    Text {
                        height: 43px; text: "Searches messages indexed on this device.";
                        color: root.muted; font-size: 11px * root.text-scale;
                        wrap: word-wrap; vertical-alignment: center;
                        x: 12px; width: parent.width - 24px;
                    }
                    if root.room-search-error != "" : Text {
                        height: 52px; text: root.room-search-error; color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b;
                        font-size: 11px * root.text-scale; wrap: word-wrap;
                        accessible-live-region: polite;
                    }
                    if root.room-search-loading : Text {
                        height: 34px; text: "Searching this room…";
                        color: root.muted; font-size: 11px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    if root.room-search-searched && !root.room-search-loading && root.room-search-error == "" && root.room-search-results.length == 0 : Text {
                        height: 54px; text: "No indexed messages matched in this room.";
                        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                        accessible-live-region: polite;
                    }
                    if root.room-search-selected-event-id != "" : ScrollView {
                        height: 210px; horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: parent.width; padding: 12px; spacing: 8px;
                            Text { text: "MESSAGE CONTEXT"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; }
                            if root.room-search-context-loading : Text {
                                text: "Loading nearby messages…"; color: root.muted; font-size: 11px * root.text-scale;
                                accessible-live-region: polite;
                            }
                            if root.room-search-context-error != "" : Text {
                                text: root.room-search-context-error; color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b;
                                font-size: 11px * root.text-scale; wrap: word-wrap;
                                accessible-live-region: polite;
                            }
                            if !root.room-search-context-loading && root.room-search-context-error == "" && root.room-search-context.length == 0 : Text {
                                text: root.room-search-selected-sender + " · " + root.room-search-selected-time;
                                color: root.accent; font-size: 11px * root.text-scale; wrap: word-wrap;
                            }
                            if !root.room-search-context-loading && root.room-search-context-error == "" && root.room-search-context.length == 0 : Text {
                                text: root.room-search-selected-body; color: root.ink;
                                font-size: 12px * root.text-scale; wrap: word-wrap;
                            }
                            for context in root.room-search-context : Rectangle {
                                min-height: 55px; background: context.event-id == root.room-search-selected-event-id ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover) : root.elevated;
                                border-radius: 7px;
                                VerticalLayout {
                                    padding: 8px; spacing: 3px;
                                    Text { text: context.sender + " · " + context.time; color: context.event-id == root.room-search-selected-event-id && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.accent; font-size: 10px * root.text-scale; overflow: elide; }
                                    Text { text: context.body; color: context.event-id == root.room-search-selected-event-id && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink; font-size: 11px * root.text-scale; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    Text {
                        height: 31px; text: "RESULTS · " + root.room-search-results.length;
                        color: root.muted; font-size: 10px * root.text-scale; font-weight: 750;
                        vertical-alignment: center;
                        x: 12px; width: parent.width - 24px;
                    }
                    search-results-list := ListView {
                        vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        for result in root.room-search-results : ActionRect {
                            width: search-results-list.visible-width; height: 94px;
                            border-radius: 8px; focus-color: result.event-id == root.room-search-selected-event-id && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.accent;
                            background: result.event-id == root.room-search-selected-event-id ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover) : self.has-hover ? root.elevated : root.panel;
                            label: "Show message context from " + result.sender + " at " + result.time;
                            activated => {
                                root.room-search-selected-event-id = result.event-id;
                                root.room-search-selected-sender = result.sender;
                                root.room-search-selected-time = result.time;
                                root.room-search-selected-body = result.body;
                                root.open-search-result(result.event-id);
                            }
                            VerticalLayout {
                                padding: 9px; spacing: 4px;
                                Text { text: result.sender; color: result.event-id == root.room-search-selected-event-id && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.accent; font-size: 11px * root.text-scale; font-weight: 700; overflow: elide; }
                                Text { text: result.time; color: result.event-id == root.room-search-selected-event-id && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.muted; font-size: 10px * root.text-scale; overflow: elide; }
                                Text { text: result.preview; color: result.event-id == root.room-search-selected-event-id && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink; font-size: 11px * root.text-scale; overflow: elide; }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.image-preview-open && root.image-preview-account-id == root.active-account-local-id && root.image-preview-room-id == root.active-room-id : FocusScope {
        focus-on-tab-navigation: false;
        init => { image-preview-close.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss-image-preview(); accept }
            else if event.text == Key.Tab || event.text == Key.Backtab { image-preview-close.focus(); accept }
            else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000cc;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: min(980px, parent.width - 48px); height: min(760px, parent.height - 48px);
                border-radius: 14px; border-width: 1px; border-color: root.accent; background: root.dialog-surface;
                accessible-role: region; accessible-label: "Image preview " + root.image-preview-title;
                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    HorizontalLayout {
                        Text { text: root.image-preview-title; color: root.ink; font-size: 15px * root.text-scale; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
                        image-preview-close := Button { text: "Close"; accessible-label: "Close image preview"; clicked => { root.dismiss-image-preview(); } }
                    }
                    Rectangle {
                        background: StyleTokens.roles.media-backdrop.present ? StyleTokens.roles.media-backdrop.color : #11131b; vertical-stretch: 1; border-radius: 9px;
                        if root.image-preview-loaded : Image {
                            width: parent.width; height: parent.height; source: root.image-preview-image; image-fit: contain;
                            accessible-role: image; accessible-label: "Attachment " + root.image-preview-title;
                        }
                        if !root.image-preview-loaded : Text { text: "▧"; color: root.muted; font-size: 54px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: root.image-preview-status; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap;
                        accessible-label: "Image preview status: " + root.image-preview-status; accessible-live-region: polite; }
                }
            }
        }
    }

    if root.quick-switcher-open : FocusScope {
        focus-on-tab-navigation: false;
        init => { quick-room-input.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-quick-switcher();
                accept
            } else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && quick-room-input.has-focus {
                close-quick-switcher.focus();
                accept
            } else if event.text == Key.Tab && !event.modifiers.shift && close-quick-switcher.has-focus {
                quick-room-input.focus();
                accept
            } else if quick-room-input.has-focus && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt && !event.modifiers.shift && root.quick-switcher-results.length > 0 && event.text == Key.DownArrow {
                root.quick-switcher-index = mod(root.quick-switcher-index + 1, root.quick-switcher-results.length);
                accept
            } else if quick-room-input.has-focus && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt && !event.modifiers.shift && root.quick-switcher-results.length > 0 && event.text == Key.UpArrow {
                root.quick-switcher-index = mod(root.quick-switcher-index + root.quick-switcher-results.length - 1, root.quick-switcher-results.length);
                accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 530px) / 2;
                y: (parent.height - self.height) / 2;
                width: 530px; height: min(580px, parent.height - 40px); background: root.dialog-surface;
                border-radius: 14px; border-color: root.accent; border-width: 1px;
                accessible-role: region;
                accessible-label: "Switch room in " + root.active-space-name;
                VerticalLayout {
                    padding: 20px; spacing: 6px;
                    Text { text: "Switch room · " + root.active-space-name; color: root.ink; font-size: 18px * root.text-scale; font-weight: 750; }
                    Rectangle {
                        height: 38px; background: root.elevated; border-radius: 8px;
                        if root.quick-switcher-query == "" : Text { x: 10px; text: "Room name or Matrix room ID"; color: root.muted; font-size: 12px * root.text-scale; vertical-alignment: center; }
                        quick-room-input := ThemedTextInput {
                            x: 10px; width: parent.width - 20px; height: parent.height;
                            text <=> root.quick-switcher-query; color: root.ink; font-size: 12px * root.text-scale;
                            single-line: true; accessible-label: "Filter rooms; arrows select, Enter opens, Escape closes";
                            edited => { root.filter-quick-switcher(); }
                            accepted => { root.choose-quick-room(root.quick-switcher-index); }
                        }
                    }
                    Text {
                        text: root.quick-switcher-match-count == 0 ? "No matching rooms" : root.quick-switcher-match-count > 6 ? "Showing 6 matches; type more to narrow the list" : root.quick-switcher-match-count + " matching rooms";
                        color: root.muted; font-size: 11px * root.text-scale; accessible-live-region: polite;
                    }
                    VerticalLayout {
                        spacing: 3px; alignment: start;
                        for room[index] in root.quick-switcher-results : ActionRect {
                            height: 36px; border-radius: 7px;
                            background: index == root.quick-switcher-index ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover) : root.elevated;
                            focus-color: root.accent;
                            label: "Open " + room.name + " · " + room.id;
                            activated => { root.choose-quick-room(index); }
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 8px;
                                Text { text: room.name; color: index == root.quick-switcher-index && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Text { text: room.unread > 0 ? room.unread + " unread" : ""; color: index == root.quick-switcher-index && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.muted; font-size: 11px * root.text-scale; vertical-alignment: center; }
                            }
                        }
                    }
                    Text {
                        text: root.quick-switcher-index >= 0 && root.quick-switcher-index < root.quick-switcher-results.length ? "Selected: " + root.quick-switcher-results[root.quick-switcher-index].name : "";
                        color: root.muted; font-size: 11px * root.text-scale; overflow: elide;
                        accessible-live-region: polite;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    close-quick-switcher := Button {
                        text: "Close";
                        clicked => { root.close-quick-switcher(); }
                    }
                }
            }
        }
    }

    if root.room-actions-open : FocusScope {
        focus-on-tab-navigation: false;
        init => { room-action-input.focus(); }
        capture-key-pressed(event) => {
            if root.room-action-busy && (event.text == Key.Tab || event.text == Key.Backtab) {
                accept
            } else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && room-action-close.has-focus {
                if root.live-session { room-action-submit.focus(); }
                else { room-action-cancel.focus(); }
                accept
            } else if event.text == Key.Tab && !event.modifiers.shift && (room-action-submit.has-focus || (!root.live-session && room-action-cancel.has-focus)) {
                room-action-close.focus();
                accept
            } else { reject }
        }
        key-pressed(event) => {
            if event.text == Key.Escape && !root.room-action-busy {
                root.room-actions-open = false;
                room-action-trigger.focus();
                accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 462px) / 2;
                y: (parent.height - 342px) / 2;
                width: 462px;
                height: 342px;
                border-radius: 14px;
                border-color: root.divider;
                border-width: 1px;
                background: root.dialog-surface;
                accessible-role: region;
                accessible-label: "Create or join a Matrix room";
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 31px;
                        Text { text: "Rooms and Spaces"; color: root.ink; font-size: 19px * root.text-scale; font-weight: 750; horizontal-stretch: 1; }
                        room-action-close := Button {
                            width: 34px; height: 31px; text: "×";
                            enabled: !root.room-action-busy;
                            accessible-label: "Close room actions";
                            clicked => { root.room-actions-open = false; room-action-trigger.focus(); }
                        }
                    }
                    HorizontalLayout {
                        height: 36px;
                        spacing: 5px;
                        for label[index] in ["Create room", "Join room", "Create Space"] : Button {
                            horizontal-stretch: 1;
                            text: label;
                            enabled: !root.room-action-busy;
                            accessible-label: label;
                            clicked => {
                                root.room-action-mode = index;
                                root.room-action-input = "";
                                root.room-action-error = "";
                            }
                        }
                    }
                    Text {
                        text: root.room-action-mode == 1 ? "Enter a room ID, alias, matrix.to link, or matrix: URI." : root.room-action-mode == 2 ? "Give your new private Space a name." : "Give your new private room a name.";
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 43px;
                        background: root.elevated;
                        border-radius: 8px;
                        room-action-input := ThemedTextInput {
                            x: 11px; width: parent.width - 22px; height: parent.height;
                            text <=> root.room-action-input;
                            color: root.ink;
                            font-size: 13px * root.text-scale;
                            enabled: !root.room-action-busy;
                            accessible-label: root.room-action-mode == 1 ? "Room ID, alias, or Matrix link" : "Room or Space name";
                            accepted => { if !root.room-action-busy { root.submit-room-action(root.room-action-mode, root.room-action-input); } }
                        }
                    }
                    Text {
                        text: root.live-session ? root.room-action-error : "Preview only · sign in to create or join rooms.";
                        accessible-live-region: polite;
                        color: root.live-session && root.room-action-error != "" ? (StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #ff8d9d) : root.muted;
                        font-size: 11px * root.text-scale;
                        wrap: word-wrap;
                        height: 40px;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        height: 38px;
                        spacing: 8px;
                        alignment: end;
                        room-action-cancel := Button {
                            width: 88px;
                            text: "Cancel";
                            enabled: !root.room-action-busy;
                            clicked => { root.room-actions-open = false; room-action-trigger.focus(); }
                        }
                        room-action-submit := Button {
                            width: 134px;
                            primary: true;
                            text: root.room-action-busy ? "Working…" : root.room-action-mode == 1 ? "Join room" : root.room-action-mode == 2 ? "Create Space" : "Create room";
                            accessible-label: root.room-action-mode == 1 ? "Join Matrix room" : root.room-action-mode == 2 ? "Create private Matrix Space" : "Create private Matrix room";
                            enabled: root.live-session && !root.room-action-busy;
                            clicked => { root.submit-room-action(root.room-action-mode, root.room-action-input); }
                        }
                    }
                }
            }
        }
    }

    if root.room-admin-open && root.room-admin-mode == 0 : FocusScope {
        focus-on-tab-navigation: false;
        init => { settings-close.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.room-settings-confirmation != 0 {
                    root.room-settings-action(7);
                    settings-close.focus();
                } else {
                    root.dismiss-room-settings();
                }
                accept
            } else if root.room-settings-confirmation != 0 { reject }
            else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && settings-refresh.has-focus {
                settings-close.focus(); accept
            } else if event.text == Key.Tab && !event.modifiers.shift && settings-close.has-focus {
                if !root.room-admin-busy { settings-refresh.focus(); }
                accept
            } else if root.room-admin-busy && (event.text == Key.Tab || event.text == Key.Backtab) {
                settings-close.focus(); accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                width: min(620px, parent.width - 40px);
                height: min(820px, parent.height - 40px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.dialog-surface; border-color: root.divider; border-width: 1px; border-radius: 14px;
                accessible-role: region;
                accessible-label: "Room settings";
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Room settings"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; vertical-alignment: center; horizontal-stretch: 1; }
                        settings-refresh := ActionRect {
                            width: 118px * root.text-scale;
                            height: 42px * root.text-scale; border-radius: 8px; border-width: 1px; border-color: root.divider;
                            background: self.enabled && self.has-hover ? root.hover : root.elevated; focus-color: root.ink;
                            label: "Refresh room settings from the homeserver";
                            enabled: !root.room-admin-busy && root.room-settings-confirmation == 0;
                            activated => { root.room-settings-action(0); }

                            Text { x: 12px; width: parent.width - 24px; text: root.room-settings-dirty ? "Refresh…" : "Refresh"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    Text { text: "Changes apply to this room for all members. Permissions are checked again when saving."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-right: 12px; spacing: 10px;
                            Text { text: "Room name"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 650; }
                            Rectangle {
                                min-height: 42px * root.text-scale; background: root.elevated; border-radius: 8px;
                                ThemedTextInput {
                                    x: 12px; width: parent.width - 24px; height: parent.height;
                                    text <=> root.room-admin-name-input; single-line: true;
                                    enabled: root.room-settings-editable && root.room-settings-name-allowed;
                                    color: root.ink; font-size: 13px * root.text-scale; accessible-label: "Room name; at most 1024 bytes";
                                    edited => { root.room-settings-edit(1); }
                                }
                            }
                            ActionRect {
                                height: 42px * root.text-scale; border-radius: 8px; border-width: 1px; border-color: root.divider;
                                background: self.enabled ? root.accent : root.panel; focus-color: root.ink;
                                label: "Save room name";
                                enabled: root.room-settings-editable && root.room-settings-name-allowed && root.room-admin-name-input != "";
                                activated => { root.submit-room-admin(0, root.room-admin-name-input, ""); }

                                Text { x: 12px; width: parent.width - 24px; text: "Save name"; color: parent.enabled ? root.accent-ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "Topic"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 650; }
                            Rectangle {
                                min-height: 70px * root.text-scale; background: root.elevated; border-radius: 8px;
                                ThemedTextInput {
                                    x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px;
                                    text <=> root.room-admin-topic-input; single-line: false; wrap: word-wrap;
                                    enabled: root.room-settings-editable && root.room-settings-topic-allowed;
                                    color: root.ink; font-size: 13px * root.text-scale; accessible-label: "Room topic; blank clears it; at most 16 KiB";
                                    edited => { root.room-settings-edit(2); }
                                }
                            }
                            ActionRect {
                                height: 42px * root.text-scale; border-radius: 8px; border-width: 1px; border-color: root.divider;
                                background: self.enabled ? root.accent : root.panel; focus-color: root.ink;
                                label: "Save room topic";
                                enabled: root.room-settings-editable && root.room-settings-topic-allowed;
                                activated => { root.submit-room-admin(1, root.room-admin-topic-input, ""); }

                                Text { x: 12px; width: parent.width - 24px; text: "Save topic"; color: parent.enabled ? root.accent-ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle { height: 1px; background: root.divider; }
                            Text { text: "Room avatar"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 700; }
                            Text { text: "Static PNG or baseline JPEG, up to 8 MiB and 4 megapixels. New avatars are resized to at most 512 px and stripped of metadata. Room avatars are shared metadata, even in encrypted rooms."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                            Rectangle {
                                height: 112px; background: root.elevated; border-radius: 10px;
                                if root.room-settings-image-visible : Image {
                                    x: (parent.width - 96px) / 2; y: 8px; width: 96px; height: 96px;
                                    source: root.room-settings-image; image-fit: contain;
                                    accessible-role: image;
                                    accessible-label: root.room-settings-staged ? "Staged room avatar; not uploaded" : "Current room avatar preview";
                                }
                                if !root.room-settings-image-visible : Text {
                                    text: root.room-settings-avatar-present ? "Avatar hidden · preview is optional" : "No avatar";
                                    color: root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                ActionRect {
                                    height: 42px * root.text-scale; border-radius: 8px; border-width: 1px; border-color: root.divider;
                                    background: self.enabled && self.has-hover ? root.hover : root.elevated; focus-color: root.ink;
                                    label: "Download and preview current room avatar";
                                    enabled: root.room-settings-editable && root.room-settings-preview-available && !root.room-settings-staged;
                                    activated => { root.room-settings-action(2); }

                                    Text { x: 12px; width: parent.width - 24px; text: "Preview current"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                ActionRect {
                                    height: 42px * root.text-scale; border-radius: 8px; border-width: 1px; border-color: root.divider;
                                    background: self.enabled && self.has-hover ? root.hover : root.elevated; focus-color: root.ink;
                                    label: "Choose a new room avatar image";
                                    enabled: root.room-settings-editable && root.room-settings-avatar-allowed && !root.room-settings-staged;
                                    activated => { root.room-settings-action(1); }

                                    Text { x: 12px; width: parent.width - 24px; text: "Choose image…"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                ActionRect {
                                    height: 42px * root.text-scale; border-radius: 8px; border-width: 1px; border-color: root.divider;
                                    background: self.enabled ? root.accent : root.panel; focus-color: root.ink;
                                    label: "Upload and save staged room avatar";
                                    enabled: root.room-settings-editable && root.room-settings-avatar-allowed && root.room-settings-staged;
                                    activated => { root.room-settings-action(3); }

                                    Text { x: 12px; width: parent.width - 24px; text: "Save avatar"; color: parent.enabled ? root.accent-ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                ActionRect {
                                    height: 42px * root.text-scale; border-radius: 8px; border-width: 1px; border-color: root.divider;
                                    background: self.enabled && self.has-hover ? root.hover : root.elevated; focus-color: root.ink;
                                    label: "Discard room avatar image from this form";
                                    enabled: !root.room-admin-busy && root.room-settings-confirmation == 0 && root.room-settings-image-visible;
                                    activated => { root.room-settings-action(4); }

                                    Text { x: 12px; width: parent.width - 24px; text: "Discard preview"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                }

                            }
                            ActionRect {
                                height: 42px * root.text-scale; border-radius: 8px; border-width: 1px; border-color: root.divider;
                                background: self.enabled && self.has-hover ? root.hover : root.elevated; focus-color: root.ink;
                                label: "Confirm removal of current room avatar";
                                enabled: root.room-settings-editable && root.room-settings-avatar-allowed && root.room-settings-avatar-present;
                                activated => { root.room-settings-action(5); }

                                Text { x: 12px; width: parent.width - 24px; text: "Remove…"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: root.room-settings-staged ? "Staged locally. Inspect orientation and colours before saving." : "Encrypted-room previews follow your Appearance privacy setting. No avatar is downloaded automatically."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                            Rectangle { height: 1px; background: root.divider; }
                            Text { text: "Who can join"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 700; }
                            Text { text: root.room-settings-access-description; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                            ComboBox {
                                model: root.room-settings-join-options; current-index <=> root.room-settings-join-index;
                                enabled: root.room-settings-editable && root.room-settings-join-allowed;
                                accessible-label: "Room join rule; only choices supported by this room version";
                                selected(value) => { root.room-settings-action(9); }
                            }
                            if root.room-settings-restricted : Text { text: "Allowed rooms · one Matrix room ID per line (up to 32)"; color: root.ink; font-size: 12px * root.text-scale; wrap: word-wrap; }
                            if root.room-settings-restricted : Rectangle {
                                min-height: 96px * root.text-scale; background: root.elevated; border-radius: 8px;
                                ThemedTextInput {
                                    x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px;
                                    text <=> root.room-settings-allow-rooms; single-line: false; wrap: word-wrap;
                                    enabled: root.room-settings-editable && root.room-settings-join-allowed;
                                    color: root.ink; font-size: 12px * root.text-scale;
                                    accessible-label: "Allowed Matrix room IDs; one per line; empty permits no automatic restricted joins";
                                    edited => { root.room-settings-edit(4); }
                                }
                            }
                            ActionRect {
                                height: 42px * root.text-scale; border-radius: 8px; border-width: 1px; border-color: root.divider;
                                background: self.enabled ? root.accent : root.panel; focus-color: root.ink;
                                label: "Save room join rule";
                                enabled: root.room-settings-editable && root.room-settings-join-allowed && root.room-settings-join-index >= 0;
                                activated => { root.room-settings-action(8); }

                                Text { x: 12px; width: parent.width - 24px; text: "Save join rule"; color: parent.enabled ? root.accent-ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "Public access requires confirmation. Directory listing is a separate setting and is not changed here. Unknown rules remain read-only."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                        }
                    }
                    if root.room-admin-busy : Text { text: "Working… You can close this form to cancel pending work."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                    if root.room-admin-error != "" : Text { text: root.room-admin-error; color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : root.ink; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                    if root.room-admin-notice != "" : Text { text: root.room-admin-notice; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                    settings-close := ActionRect {
                        height: 42px * root.text-scale; border-radius: 8px; border-width: 1px; border-color: root.divider;
                        background: self.enabled && self.has-hover ? root.hover : root.elevated; focus-color: root.ink;
                        label: "Close room settings and discard unsaved edits and images";
                        enabled: root.room-settings-confirmation == 0;
                        activated => { root.dismiss-room-settings(); }

                        Text { x: 12px; width: parent.width - 24px; text: "Close"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                if root.room-settings-confirmation != 0 : FocusScope {
                    init => { settings-confirm-cancel.focus(); }
                    Rectangle {
                        background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000bb;
                        TouchArea { width: parent.width; height: parent.height; }
                        Rectangle {
                            x: 20px; y: (parent.height - self.height) / 2; width: parent.width - 40px;
                            height: confirmation-layout.preferred-height;
                            background: root.elevated; border-radius: 12px; border-color: root.divider; border-width: 1px;
                            accessible-role: region;
                            accessible-label: root.room-settings-confirmation == 1 ? "Confirm public room access" : root.room-settings-confirmation == 2 ? "Confirm room avatar removal" : "Confirm discard and refresh";
                            confirmation-layout := VerticalLayout {
                                padding: 20px; spacing: 16px;
                                Text { text: root.room-settings-confirmation == 1 ? "Allow anyone to join?" : root.room-settings-confirmation == 2 ? "Remove this room's avatar?" : "Discard edits and refresh?"; color: root.ink; font-size: 18px * root.text-scale; font-weight: 700; wrap: word-wrap; }
                                Text { text: root.room-settings-confirmation == 1 ? "Anyone will be able to join this room. This does not list the room in a public directory." : root.room-settings-confirmation == 2 ? "This removes the shared avatar for everyone in the room. It does not delete previously uploaded media from the homeserver." : "Unsaved name, topic, access and image edits will be discarded. Current settings will be fetched from the homeserver."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    settings-confirm-cancel := ActionRect {
                                        height: 42px * root.text-scale; border-radius: 8px; background: root.panel; label: "Cancel room settings confirmation";
                                        trap-tab: true; cancel-on-escape: true; focus-color: root.accent;
                                        next-focus => { settings-confirm-save.focus(); } previous-focus => { settings-confirm-save.focus(); }
                                        cancelled => { root.room-settings-action(7); settings-close.focus(); }
                                        activated => { root.room-settings-action(7); settings-close.focus(); }
                                        Text { text: "Cancel"; color: root.ink; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    settings-confirm-save := ActionRect {
                                        height: 42px * root.text-scale; border-radius: 8px; background: root.accent;
                                        label: root.room-settings-confirmation == 1 ? "Confirm public access" : root.room-settings-confirmation == 2 ? "Confirm avatar removal" : "Confirm discard edits and refresh";
                                        trap-tab: true; cancel-on-escape: true; focus-color: root.ink;
                                        next-focus => { settings-confirm-cancel.focus(); } previous-focus => { settings-confirm-cancel.focus(); }
                                        cancelled => { root.room-settings-action(7); settings-close.focus(); }
                                        activated => { root.room-settings-action(6); settings-close.focus(); }
                                        Text { text: "Confirm"; color: root.accent-ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }


    if root.room-admin-open && root.room-admin-mode == 2 : FocusScope {
        init => { admin-close.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape && !root.room-admin-busy {
                root.room-admin-open = false;
                account-trigger.focus();
                accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 480px) / 2;
                y: (parent.height - (root.room-admin-mode == 2 ? 325px : 430px)) / 2;
                width: 480px;
                height: root.room-admin-mode == 2 ? 325px : 430px;
                background: root.dialog-surface;
                border-color: root.divider;
                border-width: 1px;
                border-radius: 14px;
                accessible-role: region;
                accessible-label: root.room-admin-mode == 2 ? "Confirm message redaction" : "Edit Matrix room details";
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: root.room-admin-mode == 2 ? "Redact this message?" : "Room details";
                        color: root.ink;
                        font-size: 19px * root.text-scale;
                        font-weight: 750;
                    }
                    if root.room-admin-mode == 2 : Text {
                        text: root.room-admin-event-preview;
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                        overflow: elide;
                        height: 48px;
                    }
                    if root.room-admin-mode == 2 : Text {
                        text: "This removes the message content for room members. Your homeserver decides whether you have permission.";
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                        height: 43px;
                    }
                    if root.room-admin-error != "" : Text {
                        text: root.room-admin-error;
                        color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #ff8d9d;
                        font-size: 11px * root.text-scale;
                        wrap: word-wrap;
                        accessible-live-region: polite;
                        height: 38px;
                    }
                    if root.room-admin-notice != "" : Text {
                        text: root.room-admin-notice;
                        color: root.accent;
                        font-size: 11px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 9px;
                        admin-close := Button {
                            width: 94px; height: 36px;
                            text: root.room-admin-mode == 2 ? "Cancel" : "Close";
                            enabled: !root.room-admin-busy;
                            clicked => { root.room-admin-open = false; account-trigger.focus(); }
                        }
                        if root.room-admin-mode == 2 : Button {
                            width: 145px; height: 36px;
                            primary: true;
                            text: root.room-admin-busy ? "Redacting…" : "Redact message";
                            enabled: !root.room-admin-busy;
                            clicked => {
                                if root.room-admin-account-id == root.active-account-local-id
                                    && root.room-admin-room-id == root.active-room-id {
                                    root.submit-room-admin(2, root.room-admin-event-id, "");
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.roster-confirm-open && root.live-session : MemberActionDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        palette: root.roster-palette;
        text-scale: root.text-scale;
        title: root.roster-confirm-title;
        body: root.roster-confirm-body;
        action-text: root.roster-confirm-action;
        destructive: root.roster-confirm-destructive;
        busy: root.roster-busy;
        confirm => { root.roster-confirm(); account-trigger.focus(); }
        cancel => { root.roster-cancel-confirm(); account-trigger.focus(); }
    }

    if root.space-manager-view.confirm-open && root.live-session : MemberActionDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        palette: root.roster-palette;
        text-scale: root.text-scale;
        title: root.space-manager-view.confirm-title;
        body: root.space-manager-view.confirm-body;
        action-text: root.space-manager-view.confirm-action;
        destructive: root.space-manager-view.confirm-destructive;
        busy: root.space-manager-view.busy;
        confirm => { root.space-manager-confirm(); account-trigger.focus(); }
        cancel => { root.space-manager-cancel-confirm(); account-trigger.focus(); }
    }

    if root.native-capture-picker-open && root.page == 2 && root.live-session && root.native-call-joined : FocusScope {
        focus-on-tab-navigation: false;
        init => { capture-picker-close.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.native-capture-picker-open = false;
                accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                width: 486px;
                height: 452px;
                x: (parent.width - 486px) / 2;
                y: (parent.height - 452px) / 2;
                background: root.dialog-surface;
                border-color: root.divider;
                border-width: 1px;
                border-radius: 14px;
                accessible-role: region;
                accessible-label: root.native-capture-picker-kind == 0 ? "Choose a camera" : "Choose a display or window to share";
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 33px;
                        spacing: 8px;
                        Text {
                            text: root.native-capture-picker-kind == 0 ? "Choose a camera" : "Share a display or window";
                            color: root.ink;
                            font-size: 19px * root.text-scale;
                            font-weight: 750;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        capture-picker-close := Button {
                            width: 35px; height: 33px;
                            text: "×";
                            accessible-label: "Close capture source picker";
                            clicked => { root.native-capture-picker-open = false; }
                        }
                    }
                    Text {
                        text: root.native-capture-picker-kind == 0
                            ? "Your system may ask for camera access after you choose a source."
                            : "Only picture from the selected display or window is shared. Your microphone remains separate.";
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                    }
                    if root.native-capture-source-loading : Text {
                        text: "Looking for available sources…";
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    if root.native-capture-source-error != "" : Text {
                        text: root.native-capture-source-error;
                        color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #ef9da9;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                        accessible-live-region: polite;
                    }
                    capture-source-list := ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: capture-source-list.visible-width;
                            spacing: 6px;
                            for source in root.native-capture-sources : Rectangle {
                                height: ((root.native-capture-picker-kind == 0 && source.kind == 0)
                                    || (root.native-capture-picker-kind == 1 && source.kind != 0)) ? 48px : 0px;
                                background: transparent;
                                if (root.native-capture-picker-kind == 0 && source.kind == 0)
                                    || (root.native-capture-picker-kind == 1 && source.kind != 0) : ActionRect {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 8px;
                                    border-color: root.divider;
                                    border-width: 1px;
                                    background: root.elevated;
                                    focus-color: root.accent;
                                    label: source.kind == 0 ? "Use camera " + source.name
                                        : source.kind == 1 ? "Share display " + source.name
                                        : "Share window " + source.name;
                                    enabled: !root.native-capture-source-loading
                                        && !root.native-camera-busy && !root.native-screen-busy;
                                    activated => {
                                        root.native-capture-picker-open = false;
                                        root.start-native-capture(source.kind, source.id);
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        Text {
                                            text: source.kind == 0 ? "CAMERA" : source.kind == 1 ? "DISPLAY" : "WINDOW";
                                            color: root.accent;
                                            font-size: 10px * root.text-scale;
                                            font-weight: 750;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: source.name;
                                            color: root.ink;
                                            font-size: 12px * root.text-scale;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.native-capture-picker-kind == 0
                            ? "If a camera is missing, check system permissions and refresh this list."
                            : "A changed window title or display layout stops sharing. Choose the source again to resume.";
                        color: root.muted;
                        font-size: 11px * root.text-scale;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        alignment: end;
                        Button {
                            width: 105px;
                            text: "Refresh";
                            enabled: !root.native-capture-source-loading;
                            accessible-label: "Refresh available capture sources";
                            clicked => { root.refresh-native-capture-sources(root.native-capture-picker-kind); }
                        }
                        Button {
                            width: 90px;
                            text: "Cancel";
                            accessible-label: "Cancel capture source selection";
                            clicked => { root.native-capture-picker-open = false; }
                        }
                    }
                }
            }
        }
    }

    if root.leave-call-dialog : FocusScope {
        init => { cancel-leave.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape && !root.leave-call-busy {
                root.cancel-pending-log-out();
                root.leave-call-dialog = false;
                root.pending-account-index = -1;
                account-trigger.focus();
                accept
            } else { reject }
        }
        Rectangle {
        background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - 392px) / 2;
            y: (parent.height - 250px) / 2;
            width: 440px;
            height: 250px;
            background: root.elevated;
            border-color: root.divider;
            border-width: 1px;
            border-radius: 14px;
            accessible-role: region;
            accessible-label: root.native-leave-unconfirmed ? "Incomplete MatrixRTC call cleanup" : root.live-session ? "Leave call before changing accounts" : "End call preview before changing accounts";
            VerticalLayout {
                padding: 22px;
                spacing: 13px;
                Text { text: root.leave-call-busy ? (root.native-leave-unconfirmed ? "Checking call cleanup…" : "Leaving call…") : root.native-leave-unconfirmed ? "Call cleanup incomplete" : root.live-session ? "Leave call?" : "Leave call preview?"; color: root.ink; font-size: 19px * root.text-scale; font-weight: 750; }
                Text { text: root.native-leave-unconfirmed ? "Account changes remain blocked while native capture is stopping. Once it ends, you can acknowledge an uncertain server leave; the app cannot retry that leave." : root.pending-account-index == -2 ? "Leave the current call before adding another account." : root.pending-account-index == -3 ? "Leave the current call before logging out." : "Leave the current call before switching accounts."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    spacing: 9px;
                    alignment: end;
                    cancel-leave := ActionRect {
                        width: 104px; height: 36px; border-radius: 8px; background: root.panel;
                        focus-color: root.accent;
                        label: "Cancel account switch";
                        enabled: !root.leave-call-busy;
                        trap-tab: true;
                        cancel-on-escape: true;
                        next-focus => { confirm-leave.focus(); }
                        previous-focus => { confirm-leave.focus(); }
                        cancelled => { root.cancel-pending-log-out(); root.leave-call-dialog = false; root.pending-account-index = -1; account-trigger.focus(); }
                        activated => { root.cancel-pending-log-out(); root.leave-call-dialog = false; root.pending-account-index = -1; account-trigger.focus(); }
                        Text { text: "Cancel"; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    confirm-leave := ActionRect {
                        width: 182px; height: 36px; border-radius: 8px; background: root.accent;
                        focus-color: root.accent-ink;
                        label: root.native-leave-unconfirmed ? (root.pending-account-index == -4 ? "Acknowledge incomplete call cleanup" : "Continue account action after call cleanup") : root.pending-account-index == -2 ? "Leave call and add account" : root.pending-account-index == -3 ? "Leave call and log out" : "Leave call and switch account";
                        enabled: !root.leave-call-busy;
                        trap-tab: true;
                        cancel-on-escape: true;
                        next-focus => { cancel-leave.focus(); }
                        previous-focus => { cancel-leave.focus(); }
                        cancelled => { root.cancel-pending-log-out(); root.leave-call-dialog = false; root.pending-account-index = -1; account-trigger.focus(); }
                        activated => { root.confirm-leave-call(root.pending-account-index); }
                        Text { text: root.leave-call-busy ? "Checking…" : root.native-leave-unconfirmed ? "Continue if safe" : "Leave call"; color: root.accent-ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
        }
    }

    if root.show-sign-in : FocusScope {
        focus-on-tab-navigation: false;
        in property <int> focus-request: root.account-focus-request;
        init => {
            if !root.manage-accounts-open && !root.access-open && root.saved-accounts.length == 0 { login-homeserver-input.focus(); }
        }
        changed focus-request => {
            if !root.manage-accounts-open && !root.access-open && root.saved-accounts.length == 0 { login-homeserver-input.focus(); }
        }
        capture-key-pressed(event) => {
            if event.text == Key.Tab && !event.modifiers.shift && login-preview.has-focus {
                if root.saved-accounts.length > 0 { root.return-account-focus(); }
                else { login-homeserver-input.focus(); }
                accept
            } else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) &&
                root.saved-accounts.length == 0 && login-homeserver-input.has-focus {
                if root.login-loading { login-password-input.focus(); }
                else { login-preview.focus(); }
                accept
            } else if root.login-loading && (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) &&
                (login-submit.has-focus || login-browser.has-focus || login-preview.has-focus) {
                login-password-input.focus(); accept
            } else if root.login-loading && event.text == Key.Tab && !event.modifiers.shift &&
                (login-password-input.has-focus || login-submit.has-focus || login-browser.has-focus) {
                if root.saved-accounts.length > 0 { root.return-account-focus(); }
                else { login-homeserver-input.focus(); }
                accept
            } else { reject }
        }
        Rectangle {
        background: root.sign-in-surface;
        // The sign-in surface stays inside the window at every text scale.
        // Its fields and actions scroll together; focused actions reveal their
        // complete bounds without allowing Tab into the covered conversation.
        Rectangle {
            width: min(448px * root.text-scale, parent.width - 32px);
            height: min(640px * root.text-scale, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: StyleTokens.radius * 1.8;
            border-color: root.divider;
            border-width: 1px;
            background: root.dialog-surface;
            accessible-role: form;
            accessible-label: "Sign in to Matrix";
            login-body-scroll := ScrollView {
                x: 24px; y: 24px;
                width: parent.width - 48px; height: parent.height - 48px;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                width: login-body-scroll.visible-width;
                alignment: start; vertical-stretch: 0;
                spacing: 11px;
                Rectangle {
                    width: 48px * root.text-scale; height: 48px * root.text-scale; vertical-stretch: 0; border-radius: StyleTokens.radius * 1.5; background: root.accent;
                    Text { text: "M"; color: root.accent-ink; font-size: 22px * root.text-scale; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: "Welcome to Morpheus"; color: root.ink; font-size: 22px * root.text-scale; font-weight: 770; wrap: word-wrap; vertical-stretch: 0; }
                Text { text: "Sign in with an existing Matrix account."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; vertical-stretch: 0; }
                if root.saved-accounts.length > 0 : TextAction {
                    in property <int> focus-request: root.account-focus-request;
                    init => { if !root.manage-accounts-open && !root.access-open { self.focus(); } }
                    changed focus-request => {
                        if root.show-sign-in && !root.manage-accounts-open && !root.access-open && root.saved-accounts.length > 0 { self.focus(); }
                    }
