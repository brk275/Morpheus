component AvatarBadge inherits Rectangle {
    in property <string> initials;
    in property <color> accent;
    in property <color> ink: StyleTokens.roles.avatar-ink.present ? StyleTokens.roles.avatar-ink.color : #ffffff;
    width: 38px;
    height: 38px;
    border-radius: StyleTokens.radius * 1.3;
    background: accent;
    Text {
        text: root.initials;
        color: root.ink;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component InterfaceGlyph inherits Path {
    in property <string> icon;
    in property <color> ink;
    width: 20px;
    height: 20px;
    viewbox-width: 20;
    viewbox-height: 20;
    stroke: ink;
    stroke-width: 1.6px;
    fill: transparent;
    commands: icon == "S" ? "M 14 8 A 6 6 0 1 1 2 8 A 6 6 0 1 1 14 8 M 12.5 12.5 L 18 18"
        : icon == "C" ? "M 5 2 L 2.5 3.5 C 1 5 3 10 7 14 C 11 18 15 19 16.5 17.5 L 18 15 L 14 12 L 12 14 C 10 13 7 10 6 8 L 8 6 Z"
        : icon == "P" ? "M 3 3 L 17 3 L 17 17 L 3 17 Z M 12 3 L 12 17"
        : icon == "⌂" ? "M 2 9 L 10 2 L 18 9 M 4 7 L 4 17 L 8 17 L 8 12 L 12 12 L 12 17 L 16 17 L 16 7"
        : icon == "+" ? "M 10 3 L 10 17 M 3 10 L 17 10"
        : icon == "↓" ? "M 10 2 L 10 13 M 5 8 L 10 13 L 15 8 M 3 13 L 3 17 L 17 17 L 17 13"
        : icon == "F" ? "M 4 2 L 11 2 L 16 7 L 16 18 L 4 18 Z M 11 2 L 11 7 L 16 7 M 7 11 L 13 11 M 7 14 L 12 14"
        : icon == "↩" ? "M 8 4 L 2 9 L 8 14 M 2 9 L 12 9 C 16 9 18 12 18 16"
        : icon == "♥" ? "M 10 17 C 8 15 2 11 2 6.5 C 2 2 8 1 10 5 C 12 1 18 2 18 6.5 C 18 11 12 15 10 17 Z"
        : icon == "⌫" ? "M 3 5 L 17 5 M 7 5 L 7 2 L 13 2 L 13 5 M 5 5 L 6 18 L 14 18 L 15 5 M 8 8 L 8 15 M 12 8 L 12 15"
        : icon == "✎" ? "M 4 16 L 8 15 L 16 7 L 13 4 L 5 12 Z M 12 5 L 15 8"
        : "M 3 4 L 17 4 L 17 13 L 10 13 L 6 17 L 6 13 L 3 13 Z M 6 7 L 14 7 M 6 10 L 12 10";
}

component IconAction inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> ink;
    in property <color> surface;
    in property <color> hover-surface;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <bool> quiet: false;
    in property <bool> context-hover: false;
    // Match the visible button so keyboard reveal keeps a nonzero focus target.
    in property <bool> reveal-full-control: true;
    // Reveal the associated value row as well as a small settings action.
    in property <length> reveal-height: root.height;
    out property <bool> has-focus: keyboard-focus.has-focus;
    property <bool> vector-icon: icon == "S" || icon == "C" || icon == "P" || icon == "⌂" || icon == "+" || icon == "↓" || icon == "F" || icon == "↩" || icon == "♥" || icon == "⌫" || icon == "✎" || icon == "☷";
    opacity: !quiet || context-hover || area.has-hover || keyboard-focus.has-focus ? 1 : 0;
    callback activated();
    callback focus-state-changed(bool);
    width: 34px;
    height: 34px;
    border-radius: StyleTokens.radius * 0.9;
    background: selected ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : hover-surface) : surface;
    forward-focus: keyboard-focus;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    HoverSurface {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        visible: !root.selected;
        highlighted: root.enabled && area.has-hover;
        background: root.hover-surface;
    }
    if !root.vector-icon : Text {
        text: root.icon;
        color: root.selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink;
        font-size: root.icon == "Md" ? 13px : 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.vector-icon : InterfaceGlyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        icon: root.icon;
        ink: root.selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink;
    }
    keyboard-focus := FocusScope {
        x: 0px;
        y: (root.height - self.height) / 2;
        width: root.reveal-full-control ? root.width : 0px;
        height: root.reveal-full-control ? max(root.height, root.reveal-height) : 0px;
        // Slint's accessibility bridge requests focus with PointerClick.
        focus-on-click: true;
        enabled: root.enabled;
        focus-gained(reason) => { root.focus-state-changed(true); }
        focus-lost(reason) => { root.focus-state-changed(false); }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if root.enabled { root.activated(); }
                accept
            } else { reject }
        }
    }
    // Keep pointer handling above the focus area so an unfocused button
    // activates on the first click, then retain its keyboard focus.
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keyboard-focus.focus(); root.activated(); }
    }
    if keyboard-focus.has-focus : Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.ink;
        background: transparent;
    }
}

// A custom action keeps its visual children while using the same keyboard path as Slint Button.
component ActionRect inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> focus-color: #a88cff;
    in property <bool> trap-tab: false;
    in property <bool> cancel-on-escape: false;
    // Zero-sized targets can round outside a scroll clip and lose focus on release.
    in property <bool> reveal-full-control: true;
    out property <bool> has-hover: hit.has-hover;
    out property <bool> has-focus: keyboard-focus.has-focus;
    callback activated();
    callback focus-state-changed(bool);
    callback next-focus();
    callback previous-focus();
    callback cancelled();
    forward-focus: keyboard-focus;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    @children
    keyboard-focus := FocusScope {
        x: 0px;
        width: root.reveal-full-control ? root.width : 0px;
        height: root.reveal-full-control ? root.height : 0px;
        // Accessible focus uses the same reason as a pointer focus request.
        focus-on-click: true;
        enabled: root.enabled;
        focus-gained(reason) => { root.focus-state-changed(true); }
        focus-lost(reason) => { root.focus-state-changed(false); }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if root.enabled { root.activated(); }
                accept
            } else if root.trap-tab && event.text == Key.Tab && !event.modifiers.shift {
                root.next-focus();
                accept
            } else if root.trap-tab && (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) {
                root.previous-focus();
                accept
            } else if root.cancel-on-escape && event.text == Key.Escape {
                if root.enabled { root.cancelled(); }
                accept
            } else { reject }
        }
    }
    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keyboard-focus.focus(); root.activated(); }
    }
    if keyboard-focus.has-focus : Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.focus-color;
        background: transparent;
    }
}

// The same row renders grouped and combined navigation. `direct` is carried
// from the originating model, never guessed from the display name or icon.
component NavigationRoomRow inherits ActionRect {
    in property <RoomItem> room;
    in property <bool> direct;
    in property <bool> selected;
    in property <int> density-mode;
    in property <float> text-scale;
    in property <color> ink;
    in property <color> muted;
    in property <color> elevated;
    in property <color> hover;
    in property <color> accent;
    in property <color> accent-ink;
    callback open(string, bool);
    height: max(root.direct ? (root.density-mode == 0 ? 32px : root.density-mode == 2 ? 47px : 39px)
        : (root.density-mode == 0 ? 30px : root.density-mode == 2 ? 44px : 36px), 22px * root.text-scale);
    border-radius: StyleTokens.radius * 0.8;
    background: root.selected ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover) : transparent;
    HoverSurface {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        visible: !root.selected;
        highlighted: root.enabled && root.has-hover;
        background: root.elevated;
    }
    focus-color: root.accent;
    label: root.room.voice-space ? (root.direct ? "Enter voice space with " : "Enter voice space ") + root.room.name
        : (root.direct ? "Open direct message with " : "Open room ") + root.room.name;
    activated => { root.open(root.room.id, root.room.voice-space); }
    HorizontalLayout {
        padding-left: root.direct ? 9px : 10px; padding-right: 9px; spacing: root.direct ? 9px : 8px;
        if root.direct : Rectangle {
            width: 25px; height: 25px; border-radius: StyleTokens.radius * 0.9; background: root.accent;
            Text { text: root.room.voice-space ? "◖" : "@"; color: root.accent-ink; font-size: 13px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
        }
        if !root.direct : Text {
            text: root.room.voice-space ? "◖" : (root.room.private-room ? "⌑" : "#");
            color: root.selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.room.voice-space ? (StyleTokens.roles.voice.present ? StyleTokens.roles.voice.color : #78c8b1) : root.muted;
            font-size: 18px * root.text-scale; vertical-alignment: center;
        }
        Text {
            text: root.room.name;
            color: root.selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : (root.room.unread > 0 ? root.ink : root.muted);
            font-size: 13px * root.text-scale; font-weight: root.direct ? 0 : root.room.unread > 0 ? 700 : 500;
            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
        }
        if root.room.voice-space : Text {
            text: "VOICE"; color: root.selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : StyleTokens.roles.voice.present ? StyleTokens.roles.voice.color : #78c8b1;
            font-size: 9px * root.text-scale; font-weight: 750; vertical-alignment: center;
        }
        if root.room.unread > 0 : Rectangle {
            width: 20px; height: 20px; border-radius: 10px;
            background: StyleTokens.roles.unread.present ? StyleTokens.roles.unread.color : root.accent;
            Text { text: root.room.unread; color: StyleTokens.roles.unread-ink.present ? StyleTokens.roles.unread-ink.color : root.accent-ink; font-size: 10px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

component NavigationTextAction inherits ActionRect {
    in property <string> text;
    in property <bool> selected;
    in property <float> text-scale;
    in property <color> ink;
    in property <color> muted;
    in property <color> hover;
    in property <color> accent;
    height: max(32px, 22px * root.text-scale + 8px); vertical-stretch: 0;
    reveal-full-control: true;
    border-radius: StyleTokens.radius * 0.8;
    background: root.selected ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover) : transparent;
    HoverSurface {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        visible: !root.selected;
        highlighted: root.enabled && root.has-hover;
        background: root.hover;
    }
    focus-color: root.accent;
    label: root.text;
    Text {
        x: 8px; width: parent.width - 16px; height: parent.height;
        text: root.text; color: root.selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.selected ? root.ink : root.muted;
        font-size: 13px * root.text-scale; font-weight: root.selected ? 650 : 500;
        overflow: elide; vertical-alignment: center;
    }
}

component TextAction inherits ActionRect {
    in property <string> text;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> outline;
    in property <float> text-scale: 1;
    in property <bool> wrap-caption: false;
    label: text;
    // Stacked actions must accept the pane's width rather than exporting an
    // unbroken caption's intrinsic width into the surrounding layout.
    min-width: root.wrap-caption ? 32px : max(32px, caption.preferred-width + 24px * root.text-scale);
    preferred-width: root.wrap-caption ? 32px : self.min-width;
    min-height: root.wrap-caption ? max(32px * root.text-scale, caption.preferred-height + 16px * root.text-scale) : 32px * root.text-scale;
    horizontal-stretch: root.wrap-caption ? 1 : 0;
    border-radius: StyleTokens.radius * 0.7;
    border-width: 1px;
    border-color: outline;
    background: surface;
    focus-color: ink;
    HoverSurface {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        highlighted: root.enabled && root.has-hover;
        background: root.hover-surface;
    }
    caption := Text {
        x: 12px * root.text-scale;
        width: parent.width - 24px * root.text-scale;
        height: root.wrap-caption ? self.preferred-height : parent.height;
        y: (parent.height - self.height) / 2;
        text: root.text;
        color: root.enabled ? root.ink : root.muted;
        font-size: 12px * root.text-scale;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: root.wrap-caption ? word-wrap : no-wrap;
        overflow: root.wrap-caption ? clip : elide;
    }
}

// Buttons for one saved send record. Rendered in a row when there is room and
// stacked when the pane is narrow or text is large, so no control is clipped.
component PendingRecordActions inherits VerticalLayout {
    in property <PendingSendItem> item;
    in property <bool> narrow;
    in property <bool> composer-empty;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> outline;
    in property <float> text-scale: 1;
    callback cancel();
    callback retry();
    callback review(bool);
    callback restore();
    callback copy();
    callback discard();
    spacing: 4px;
    if root.narrow : VerticalLayout {
        spacing: 4px; alignment: start;
        if root.item.unconfirmed : TextAction {
            wrap-caption: true;
            text: "It was sent"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "It was sent: drop this saved message without resending";
            activated => { root.review(true); }
        }
        if root.item.unconfirmed : TextAction {
            wrap-caption: true;
            text: "Not sent, keep my text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Not sent: keep this message's text";
            activated => { root.review(false); }
        }
        if root.item.can-retry : TextAction {
            wrap-caption: true;
            text: "Retry"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Retry sending this message";
            activated => { root.retry(); }
        }
        if root.item.can-cancel : TextAction {
            wrap-caption: true;
            text: "Cancel sending"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Cancel sending this message; a message that already reached the server stays sent";
            activated => { root.cancel(); }
        }
        if root.composer-empty : TextAction {
            wrap-caption: true;
            text: "Restore text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Restore this message's text into the empty composer";
            activated => { root.restore(); }
        }
        TextAction {
            wrap-caption: true;
            text: "Copy text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Copy this message's text to the system clipboard";
            activated => { root.copy(); }
        }
        if root.item.kept : TextAction {
            wrap-caption: true;
            text: "Discard text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Discard this kept text";
            activated => { root.discard(); }
        }
    }
    if !root.narrow : HorizontalLayout {
        spacing: 6px; alignment: start;
        if root.item.unconfirmed : TextAction {
            text: "It was sent"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "It was sent: drop this saved message without resending";
            activated => { root.review(true); }
        }
        if root.item.unconfirmed : TextAction {
            text: "Not sent, keep my text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Not sent: keep this message's text";
            activated => { root.review(false); }
        }
        if root.item.can-retry : TextAction {
            text: "Retry"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Retry sending this message";
            activated => { root.retry(); }
        }
        if root.item.can-cancel : TextAction {
            text: "Cancel sending"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Cancel sending this message; a message that already reached the server stays sent";
            activated => { root.cancel(); }
        }
        if root.composer-empty : TextAction {
            text: "Restore text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Restore this message's text into the empty composer";
            activated => { root.restore(); }
        }
        TextAction {
            text: "Copy text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Copy this message's text to the system clipboard";
            activated => { root.copy(); }
        }
        if root.item.kept : TextAction {
            text: "Discard text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Discard this kept text";
            activated => { root.discard(); }
        }
    }
}

// Saved send status for one composer scope: a quiet notice when saved data
// needs review, then one block per record with its own exact controls. The
// content keeps every record and action; `viewport-cap` bounds its visible
// height independently of the window's layout constraints. Focused controls are
// scrolled into view by the ScrollView, so every action stays keyboard
// reachable in a narrow pane or at large text sizes.
component PendingSendStrip inherits ScrollView {
    in property <[PendingSendItem]> items;
    in property <string> blocked-notice;
    in property <bool> composer-empty;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> outline;
    in property <float> text-scale: 1;
    in property <length> viewport-cap: 240px;
    out property <length> natural-height: content.preferred-height;
    callback cancel(string);
    callback retry(string);
    callback review(string, bool);
    callback restore(string);
    callback copy(string);
    callback discard(string);
    callback discard-unreadable();
    property <bool> narrow: self.width < 620px * root.text-scale;
    height: min(root.viewport-cap, root.natural-height);
    // Override Flickable's inferred content width: a child's intrinsic minimum
    // must never enlarge the horizontal canvas and center the actions offscreen.
    content-width: self.visible-width;
    content-height: root.natural-height;
    content-x: 0px;
    horizontal-scrollbar-policy: always-off;
    content := VerticalLayout {
    x: 0px; y: 0px;
    width: root.visible-width;
    height: self.preferred-height;
    // Leave room for styles whose vertical scrollbar overlays the viewport.
    padding-right: 16px;
    spacing: 8px;
    if root.blocked-notice != "" : Rectangle {
        height: notice.height + 4px + discard-status.height;
        notice := Text {
            width: parent.width; height: self.preferred-height;
            text: root.blocked-notice; color: root.muted; font-size: 12px * root.text-scale;
            wrap: word-wrap; accessible-live-region: polite;
        }
        discard-status := TextAction {
            y: notice.height + 4px;
            width: root.narrow ? parent.width : min(parent.width, self.preferred-width);
            height: self.preferred-height;
            wrap-caption: root.narrow;
            text: "Discard unreadable saved status"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Discard saved send status this version cannot read; your typed text stays";
            activated => { root.discard-unreadable(); }
        }
    }
    // Measure each wrapped status at its allocated width before summing the
    // scroll extent. Layout preferred-height alone can use an unwrapped text
    // estimate and leave the final records beyond the scrollbar's limit.
    for item in root.items : Rectangle {
        height: record-status.height + 4px + record-actions.height;
        record-status := Text {
            width: parent.width; height: self.preferred-height;
            text: item.status + (item.preview != "" ? ": “" + item.preview + "”" : "");
            color: root.muted; font-size: 12px * root.text-scale;
            wrap: word-wrap; accessible-live-region: polite;
        }
        record-actions := PendingRecordActions {
            y: record-status.height + 4px;
            width: parent.width; height: self.preferred-height;
            item: item; narrow: root.narrow; composer-empty: root.composer-empty;
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            cancel => { root.cancel(item.key); }
            retry => { root.retry(item.key); }
            review(sent) => { root.review(item.key, sent); }
            restore => { root.restore(item.key); }
            copy => { root.copy(item.key); }
            discard => { root.discard(item.key); }
        }
    }
    }
}

component MentionPopup inherits Rectangle {
    in property <[MentionItem]> items;
    in property <int> current;
    in property <color> surface;
    in property <color> hover;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <float> text-scale: 1;
    callback choose(string);
    height: min(360px, self.items.length * (36px * root.text-scale + 10px) + 8px);
    background: surface; border-radius: StyleTokens.radius * 0.8; border-width: 1px; border-color: accent;
    accessible-role: region; accessible-label: "Mention suggestions; arrows select, Enter or Tab inserts, Escape closes";
    mention-list := ListView {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        horizontal-scrollbar-policy: always-off;
        content-y: -max(0px, (root.current + 1) * (36px * root.text-scale + 10px) - self.height);
        for item[index] in root.items : ActionRect {
            width: mention-list.visible-width; height: 36px * root.text-scale + 10px;
            label: item.name + " " + item.key + (index == root.current ? ", selected" : "");
            focus-color: root.accent; border-radius: StyleTokens.radius * 0.5;
            background: index == root.current || self.has-hover ? root.hover : root.surface;
            activated => { root.choose(item.key); }
            VerticalLayout {
                padding: 5px; spacing: 2px;
                Text { text: item.name; color: root.ink; font-size: 12px * root.text-scale; overflow: elide; }
                Text { text: item.key; color: root.muted; font-size: 10px * root.text-scale; overflow: elide; }
            }
        }
    }
}

component EmojiPopup inherits Rectangle {
    in property <[EmojiItem]> items;
    in property <int> current;
    in-out property <string> query;
    in property <color> surface;
    in property <color> elevated;
    in property <color> hover;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <float> text-scale: 1;
    callback searched(string);
    callback navigate(int);
    callback choose(string);
    callback dismiss();
    height: min(380px, 280px * root.text-scale + 70px);
    background: surface; border-radius: StyleTokens.radius * 0.9; border-width: 1px; border-color: accent;
    accessible-role: region; accessible-label: "Emoji picker";
    FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); accept } else { reject }
        }
        VerticalLayout {
        padding: 8px; spacing: 6px;
        HorizontalLayout {
            height: 34px * root.text-scale; spacing: 6px;
            Rectangle {
                horizontal-stretch: 1; background: root.elevated; border-radius: StyleTokens.radius * 0.6;
                if root.query == "" : Text {
                    x: 8px; width: parent.width - 16px; height: parent.height;
                    text: "Search emoji"; color: root.muted; font-size: 12px * root.text-scale;
                    vertical-alignment: center;
                }
                emoji-search := ThemedTextInput {
                    x: 8px; width: parent.width - 16px; height: parent.height;
                    text <=> root.query; color: root.ink; font-size: 12px * root.text-scale;
                    vertical-alignment: center; accessible-label: "Search emoji by name";
                    init => { self.focus(); }
                    edited => { root.searched(self.text); }
                    key-pressed(event) => {
                        if !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt {
                            if event.text == Key.Escape { root.dismiss(); accept }
                            else if event.text == Key.UpArrow { root.navigate(-1); accept }
                            else if event.text == Key.DownArrow { root.navigate(1); accept }
                            else if event.text == Key.Return {
                                if root.current >= 0 && root.current < root.items.length { root.choose(root.items[root.current].key); }
                                accept
                            } else { reject }
                        } else { reject }
                    }
                }
            }
            IconAction {
                width: 30px * root.text-scale; icon: "×"; label: "Close emoji picker";
                ink: root.muted; surface: root.surface; hover-surface: root.hover;
                activated => { root.dismiss(); }
            }
        }
        Text {
            text: root.current >= 0 && root.current < root.items.length
                ? "Selected emoji: " + root.items[root.current].name
                : "No matching emoji";
            color: root.ink; font-size: 11px * root.text-scale; wrap: word-wrap;
            accessible-live-region: polite;
        }
        Text { text: "Arrows choose · Enter inserts · Escape closes";
            color: root.muted; font-size: 10px * root.text-scale; wrap: word-wrap; }
        emoji-list := ListView {
            vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
            content-y: -max(0px, (root.current + 1) * (34px * root.text-scale + 6px) - self.height);
            for item[index] in root.items : ActionRect {
                width: emoji-list.visible-width; height: 34px * root.text-scale + 6px;
                label: "Insert " + item.name + " " + item.symbol + (index == root.current ? ", selected" : "");
                background: index == root.current || self.has-hover ? root.hover : root.surface;
                border-radius: StyleTokens.radius * 0.5; focus-color: root.accent; cancel-on-escape: true;
                cancelled => { root.dismiss(); }
                activated => { root.choose(item.key); }
                HorizontalLayout {
                    padding-left: 7px; padding-right: 7px; spacing: 10px;
                    Text { width: 32px * root.text-scale; text: item.symbol; color: root.ink; font-size: 22px * root.text-scale; vertical-alignment: center; }
                    Text { text: item.name; color: root.ink; font-size: 12px * root.text-scale;
                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
            }
        }
        }
    }
}

// The sticker search field. It owns the arrows, Return and Escape so the list
// can be driven without leaving the field.
component StickerSearchField inherits Rectangle {
    in-out property <string> query;
    in property <bool> can-send;
    in property <bool> has-current;
    in property <color> elevated;
    in property <color> ink;
    in property <color> muted;
    in property <float> text-scale: 1;
    callback searched(string);
    callback navigate(int);
    callback send-current();
    callback dismiss();
    background: root.elevated; border-radius: StyleTokens.radius * 0.6;
    if root.query == "" : Text {
        x: 8px; width: parent.width - 16px; height: parent.height;
        text: "Search stickers"; color: root.muted; font-size: 12px * root.text-scale;
        vertical-alignment: center;
    }
    sticker-search := ThemedTextInput {
        x: 8px; width: parent.width - 16px; height: parent.height;
        text <=> root.query; color: root.ink; font-size: 12px * root.text-scale;
        single-line: true; vertical-alignment: center;
        accessible-label: "Search stickers by description, shortcode or pack";
        init => { self.focus(); }
        edited => { root.searched(self.text); }
        key-pressed(event) => {
            if !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt {
                if event.text == Key.Escape { root.dismiss(); accept }
                else if event.text == Key.UpArrow { root.navigate(-1); accept }
                else if event.text == Key.DownArrow { root.navigate(1); accept }
                else if event.text == Key.Return {
                    if root.has-current && root.can-send { root.send-current(); }
                    accept
                } else { reject }
            } else { reject }
        }
    }
}

// The explicit public-media consent. Its height is measured from the wrapped
// message and actions at the allocated width, side by side or stacked.
component StickerConsent inherits Rectangle {
    in property <bool> stacked;
    in property <bool> ready;
    in property <color> elevated;
    in property <color> outline;
    in property <color> surface;
    in property <color> hover;
    in property <color> ink;
    in property <color> muted;
    in property <float> text-scale: 1;
    callback consent(bool);
    height: root.stacked
        ? decline.y + decline.height + 8px
        : allow.y + max(allow.height, decline.height) + 8px;
    background: root.elevated; border-radius: StyleTokens.radius * 0.6;
    border-width: 1px; border-color: root.outline;
    message := Text {
        x: 8px; y: 8px; width: root.width - 16px; height: self.preferred-height;
        text: "This conversation is encrypted, but sticker images are not. Your homeserver can see which sticker images you load and send here. Labels stay available without images.";
        color: root.ink; font-size: 11px * root.text-scale; wrap: word-wrap;
        accessible-live-region: polite;
    }
    // TextAction exports its size as min-height only: its preferred height is
    // the zero of a plain rectangle, so a placed action sizes by min-height.
    allow := TextAction {
        x: 8px; y: message.y + message.height + 6px;
        width: root.stacked ? root.width - 16px : self.preferred-width;
        height: self.min-height;
        wrap-caption: root.stacked;
        text: "Allow sticker images here"; ink: root.ink; muted: root.muted;
        surface: root.surface; hover-surface: root.hover; outline: root.outline; text-scale: root.text-scale;
        enabled: root.ready;
        activated => { root.consent(true); }
    }
    decline := TextAction {
        x: root.stacked ? 8px : allow.x + allow.width + 8px;
        y: root.stacked ? allow.y + allow.height + 6px : allow.y;
        width: root.stacked ? root.width - 16px : self.preferred-width;
        height: self.min-height;
        wrap-caption: root.stacked;
        text: "Cancel"; ink: root.ink; muted: root.muted;
        surface: root.surface; hover-surface: root.hover; outline: root.outline; text-scale: root.text-scale;
        accessible-label: "Cancel and close the sticker picker";
        activated => { root.consent(false); }
    }
}

component StickerPreviewBox inherits Rectangle {
    in property <image> preview;
    in property <bool> loaded;
    in property <string> status;
    in property <string> label;
    in property <color> elevated;
    in property <color> muted;
    in property <float> text-scale: 1;
    background: root.elevated; border-radius: StyleTokens.radius * 0.6;
    if root.loaded : Image {
        x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
        source: root.preview; image-fit: contain;
        accessible-role: image;
        accessible-label: root.label != "" ? "Sticker preview: " + root.label : "Sticker preview";
    }
    if !root.loaded : Text {
        x: 8px; width: parent.width - 16px; height: parent.height;
        text: root.status; color: root.muted; font-size: 11px * root.text-scale;
        wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
    }
}

component StickerList inherits Rectangle {
    in property <[StickerItem]> items;
    in property <int> current;
    in property <length> row-height;
    in property <color> surface;
    in property <color> hover;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <float> text-scale: 1;
    callback highlight(string);
    callback dismiss();
    sticker-list := ListView {
        width: parent.width; height: parent.height;
        horizontal-scrollbar-policy: always-off;
        content-y: -max(0px, (root.current + 1) * root.row-height - self.height);
        for item[index] in root.items : ActionRect {
            width: sticker-list.visible-width; height: root.row-height;
            label: "Sticker " + item.label + " from " + item.pack + (index == root.current ? ", selected" : "");
            background: index == root.current || self.has-hover ? root.hover : root.surface;
            border-radius: StyleTokens.radius * 0.5; focus-color: root.accent; cancel-on-escape: true;
            cancelled => { root.dismiss(); }
            activated => { root.highlight(item.key); }
            VerticalLayout {
                padding-left: 7px; padding-right: 7px; padding-top: 2px; padding-bottom: 2px; spacing: 1px;
                Text { text: item.label; color: root.ink; font-size: 12px * root.text-scale; overflow: elide; vertical-alignment: center; }
                Text { text: item.pack; color: root.muted; font-size: 10px * root.text-scale; overflow: elide; }
            }
        }
    }
}

// Labels stay usable before any image loads. Images of an encrypted
// conversation appear only after the explicit consent in this popup. A narrow
// pane or large text stacks the controls in a bounded scrolling area above the
// list; it scrolls each focused control into view, so search, pack choice,
// consent, Send and Close stay reachable in the thread pane at 200% text. The
// popup never claims more height than the space above its composer.
component StickerPopup inherits Rectangle {
    in property <[StickerItem]> items;
    in property <[string]> packs;
    in-out property <int> pack-index;
    in property <int> current;
    in-out property <string> query;
    // 0 loading, 1 ready, 2 failed.
    in property <int> phase;
    in property <string> status;
    in property <string> notice;
    in property <bool> needs-consent;
    in property <image> preview;
    in property <bool> preview-loaded;
    in property <string> preview-status;
    in property <bool> can-send;
    // Space above the composer this popup may cover inside the window.
    in property <length> available-height: 470px;
    in property <color> surface;
    in property <color> elevated;
    in property <color> hover;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    callback searched(string);
    callback navigate(int);
    callback choose-pack(int);
    callback highlight(string);
    callback send(string);
    callback consent(bool);
    callback dismiss();
    property <bool> has-current: root.current >= 0 && root.current < root.items.length;
    property <bool> narrow: root.width < 340px * root.text-scale;
    property <length> row-height: 34px * root.text-scale + 6px;
    property <length> field-height: 34px * root.text-scale;
    property <string> current-label: root.has-current ? root.items[root.current].label : "";
    property <string> selected-text: root.notice != "" ? root.notice
        : root.phase != 1 ? root.status
        : root.has-current ? "Selected sticker: " + root.items[root.current].label + ", from " + root.items[root.current].pack
        : root.status;
    height: max(140px, min(root.available-height, root.narrow ? 620px : min(470px, 330px * root.text-scale + 130px)));
    background: surface; border-radius: StyleTokens.radius * 0.9; border-width: 1px; border-color: accent;
    accessible-role: region; accessible-label: "Sticker picker";
    FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); accept } else { reject }
        }
        if !root.narrow : VerticalLayout {
            padding: 8px; spacing: 6px;
            HorizontalLayout {
                height: root.field-height; spacing: 6px;
                StickerSearchField {
                    horizontal-stretch: 1;
                    query <=> root.query; can-send: root.can-send; has-current: root.has-current;
                    elevated: root.elevated; ink: root.ink; muted: root.muted; text-scale: root.text-scale;
                    searched(text) => { root.searched(text); }
                    navigate(offset) => { root.navigate(offset); }
                    send-current => { root.send(root.items[root.current].key); }
                    dismiss => { root.dismiss(); }
                }
                if root.packs.length > 1 : ComboBox {
                    width: 160px * root.text-scale;
                    model: root.packs;
                    current-index <=> root.pack-index;
                    accessible-label: "Sticker pack";
                    selected(value) => { root.choose-pack(self.current-index); }
                }
                IconAction {
                    width: 30px * root.text-scale; icon: "×"; label: "Close sticker picker";
                    ink: root.muted; surface: root.surface; hover-surface: root.hover;
                    activated => { root.dismiss(); }
                }
            }
            if root.needs-consent : StickerConsent {
                stacked: false; ready: root.phase == 1;
                elevated: root.elevated; outline: root.outline; surface: root.surface; hover: root.hover;
                ink: root.ink; muted: root.muted; text-scale: root.text-scale;
                consent(allowed) => { root.consent(allowed); }
            }
            Text {
                text: root.selected-text;
                color: root.ink; font-size: 11px * root.text-scale; wrap: word-wrap;
                accessible-live-region: polite;
            }
            HorizontalLayout {
                vertical-stretch: 1; spacing: 8px;
                StickerList {
                    horizontal-stretch: 1;
                    items: root.items; current: root.current; row-height: root.row-height;
                    surface: root.surface; hover: root.hover; ink: root.ink; muted: root.muted; accent: root.accent;
                    text-scale: root.text-scale;
                    highlight(key) => { root.highlight(key); }
                    dismiss => { root.dismiss(); }
                }
                StickerPreviewBox {
                    width: 132px * root.text-scale;
                    preview: root.preview; loaded: root.preview-loaded; status: root.preview-status;
                    label: root.current-label; elevated: root.elevated; muted: root.muted; text-scale: root.text-scale;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Arrows choose · Enter sends · Escape closes"; color: root.muted;
                    font-size: 10px * root.text-scale; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1;
                }
                TextAction {
                    text: "Send sticker"; ink: root.ink; muted: root.muted;
                    surface: root.surface; hover-surface: root.hover; outline: root.outline; text-scale: root.text-scale;
                    enabled: root.has-current && root.can-send;
                    activated => { root.send(root.items[root.current].key); }
                }
            }
        }
        if root.narrow : VerticalLayout {
            padding: 6px; spacing: 6px;
            controls := ScrollView {
                height: min(controls-content.preferred-height, root.height * 0.6);
                content-width: self.visible-width;
                content-height: controls-content.preferred-height;
                content-x: 0px;
                horizontal-scrollbar-policy: always-off;
                controls-content := VerticalLayout {
                    x: 0px; y: 0px;
                    width: controls.visible-width;
                    height: self.preferred-height;
                    // Leave room for styles whose vertical scrollbar overlays the viewport.
                    padding-right: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        height: root.field-height; spacing: 6px;
                        StickerSearchField {
                            horizontal-stretch: 1;
                            query <=> root.query; can-send: root.can-send; has-current: root.has-current;
                            elevated: root.elevated; ink: root.ink; muted: root.muted; text-scale: root.text-scale;
                            searched(text) => { root.searched(text); }
                            navigate(offset) => { root.navigate(offset); }
                            send-current => { root.send(root.items[root.current].key); }
                            dismiss => { root.dismiss(); }
                        }
                        IconAction {
                            width: 30px * root.text-scale; icon: "×"; label: "Close sticker picker";
                            ink: root.muted; surface: root.surface; hover-surface: root.hover;
                            activated => { root.dismiss(); }
                        }
                    }
                    if root.packs.length > 1 : ComboBox {
                        height: root.field-height;
                        model: root.packs;
                        current-index <=> root.pack-index;
                        accessible-label: "Sticker pack";
                        selected(value) => { root.choose-pack(self.current-index); }
                    }
                    if root.needs-consent : StickerConsent {
                        stacked: true; ready: root.phase == 1;
                        elevated: root.elevated; outline: root.outline; surface: root.surface; hover: root.hover;
                        ink: root.ink; muted: root.muted; text-scale: root.text-scale;
                        consent(allowed) => { root.consent(allowed); }
                    }
                    // Measured at its allocated width, so the scroll extent
                    // covers the wrapped text and the controls below it.
                    Rectangle {
                        height: narrow-status.height;
                        narrow-status := Text {
                            width: parent.width; height: self.preferred-height;
                            text: root.selected-text;
                            color: root.ink; font-size: 11px * root.text-scale; wrap: word-wrap;
                            accessible-live-region: polite;
                        }
                    }
                    StickerPreviewBox {
                        height: min(96px, 56px * root.text-scale);
                        preview: root.preview; loaded: root.preview-loaded; status: root.preview-status;
                        label: root.current-label; elevated: root.elevated; muted: root.muted; text-scale: root.text-scale;
                    }
                    TextAction {
                        wrap-caption: true;
                        text: "Send sticker"; ink: root.ink; muted: root.muted;
                        surface: root.surface; hover-surface: root.hover; outline: root.outline; text-scale: root.text-scale;
                        enabled: root.has-current && root.can-send;
                        activated => { root.send(root.items[root.current].key); }
                    }
                }
            }
            StickerList {
                vertical-stretch: 1; min-height: root.row-height;
                items: root.items; current: root.current; row-height: root.row-height;
                surface: root.surface; hover: root.hover; ink: root.ink; muted: root.muted; accent: root.accent;
                text-scale: root.text-scale;
                highlight(key) => { root.highlight(key); }
                dismiss => { root.dismiss(); }
            }
        }
    }
}

// The held send and the one tracked sticker send for the visible composer.
// Cancel and Retry act on the exact queued request; nothing here enqueues a
// second sticker. The status wraps rather than eliding, and a held send is
// lifted only by confirming the conversation was checked, never by a plain
// dismissal.
component StickerSendStatus inherits Rectangle {
    in property <string> status;
    in property <bool> can-cancel;
    in property <bool> can-retry;
    in property <bool> uncertain;
    in property <color> surface;
    in property <color> hover;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    callback cancel();
    callback retry();
    callback dismiss();
    property <length> action-height: max(30px, 32px * root.text-scale);
    height: message.y + message.height + 4px + root.action-height + 6px;
    background: surface; border-radius: StyleTokens.radius * 0.6;
    message := Text {
        x: 8px; y: 6px; width: root.width - 16px; height: self.preferred-height;
        text: root.status; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
        accessible-label: "Sticker send status: " + root.status; accessible-live-region: polite;
    }
    HorizontalLayout {
        x: 8px; y: message.y + message.height + 4px;
        width: root.width - 16px; height: root.action-height;
        alignment: end; spacing: 6px;
        if root.can-retry : IconAction {
            width: 27px * root.text-scale; icon: "↻"; label: "Retry this sticker";
            ink: root.accent; surface: transparent; hover-surface: root.hover;
            activated => { root.retry(); }
        }
        if root.can-cancel : IconAction {
            width: 27px * root.text-scale; icon: "×"; label: "Cancel this sticker";
            ink: root.muted; surface: transparent; hover-surface: root.hover;
            activated => { root.cancel(); }
        }
        if !root.can-cancel && !root.uncertain : IconAction {
            width: 27px * root.text-scale; icon: "✓"; label: "Dismiss sticker status";
            ink: root.muted; surface: transparent; hover-surface: root.hover;
            activated => { root.dismiss(); }
        }
        if root.uncertain : TextAction {
            text: "I checked"; ink: root.ink; muted: root.muted;
            surface: root.surface; hover-surface: root.hover; outline: root.outline; text-scale: root.text-scale;
            accessible-label: "I checked the conversation: allow sending stickers again";
            activated => { root.dismiss(); }
        }
    }
}

component ShortcutSetting inherits Rectangle {
    in property <string> label;
    in-out property <string> binding;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> accent;
    in property <float> text-scale: 1;
    callback edited();
    height: 52px;
    background: transparent;
    forward-focus: shortcut-input;
    out property <bool> has-focus: shortcut-input.has-focus;
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.label; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; }
        Rectangle {
            width: 200px; height: 38px; background: root.surface; border-radius: StyleTokens.radius * 0.7;
            border-width: shortcut-input.has-focus ? 2px : 0px; border-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent;
            if root.binding == "" : Text { x: 9px; text: "Disabled"; color: root.muted; font-size: 12px * root.text-scale; vertical-alignment: center; }
            shortcut-input := ThemedTextInput {
                x: 9px; width: parent.width - 18px; height: parent.height;
                text <=> root.binding; color: root.ink; font-size: 12px * root.text-scale;
                single-line: true; accessible-label: root.label + " keyboard shortcut; blank disables";
                edited => { root.edited(); }
            }
        }
    }
}

component StyleNumberSetting inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <int> minimum;
    in property <int> maximum;
    in property <int> step: 1;
    // Shown after the value: " px" for lengths, "" for a unitless value such
    // as a font weight, " ms" for a duration, "%" for a percentage.
    in property <string> suffix: " px";
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <float> text-scale: 1;
    callback changed-value(int);
    out property <bool> has-focus: decrease.has-focus || increase.has-focus;
    // At its minimum the decrease action is disabled; focus the other one.
    public function focus-control() {
        if root.value > root.minimum { decrease.focus(); } else { increase.focus(); }
    }
    height: max(58px, 34px * root.text-scale + 20px);
    background: surface; border-radius: StyleTokens.radius;
    forward-focus: decrease;
    HorizontalLayout {
        padding: 10px; spacing: 8px;
        Text { text: root.label; color: root.ink; font-size: 12px * root.text-scale;
            vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
        Text { text: root.value + root.suffix; color: root.muted; font-size: 11px * root.text-scale; vertical-alignment: center; }
        decrease := IconAction { icon: "−"; label: "Decrease " + root.label; ink: root.ink; surface: root.surface; hover-surface: root.hover-surface;
            enabled: root.value > root.minimum; activated => { root.changed-value(max(root.minimum, root.value - root.step)); } }
        increase := IconAction { icon: "+"; label: "Increase " + root.label; ink: root.ink; surface: root.surface; hover-surface: root.hover-surface;
            enabled: root.value < root.maximum; activated => { root.changed-value(min(root.maximum, root.value + root.step)); } }
    }
}

component StyleFontSetting inherits Rectangle {
    in property <string> label;
    in-out property <string> family;
    in property <color> ink;
    in property <color> surface;
    in property <color> accent;
    in property <float> text-scale: 1;
    height: 74px * root.text-scale;
    forward-focus: input;
    out property <bool> has-focus: input.has-focus;
    VerticalLayout {
        spacing: 7px;
        Text { text: root.label; color: root.ink; font-size: 12px * root.text-scale; wrap: word-wrap; }
        Rectangle {
            height: 38px * root.text-scale; background: root.surface; border-radius: StyleTokens.radius * 0.7;
            border-width: input.has-focus ? 2px : 0px; border-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent;
            input := ThemedTextInput {
                x: 10px; width: max(0px, parent.width - 20px); height: parent.height;
                text <=> root.family; single-line: true;
                color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center;
                accessible-label: root.label;
            }
        }
    }
}

// Pinned Settings search. Up and Down move the highlighted result, Enter
// reveals it and Escape clears the query. Choosing a result only reveals and
// focuses its control; it never changes a setting.
component SettingsSearchBar inherits VerticalLayout {
    in-out property <string> query;
    in property <[SettingsResult]> results;
    in-out property <int> index;
    in property <bool> dismissed;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    // Results scroll inside this height, so the field and Settings below
    // stay reachable at large text and small windows.
    in property <length> max-results-height: 240px;
    callback search(string);
    callback choose(string);
    property <bool> open: root.query != "" && !root.dismissed;
    forward-focus: input;
    spacing: 4px;
    alignment: start;
    function pick() {
        if root.index >= 0 && root.index < root.results.length {
            root.choose(root.results[root.index].id);
        }
    }
    Rectangle {
        height: max(40px, 32px * root.text-scale);
        background: root.surface;
        border-radius: StyleTokens.radius * 0.8;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent) : root.outline;
        InterfaceGlyph {
            x: 10px; y: (parent.height - self.height) / 2; width: 16px; height: 16px;
            icon: "S"; ink: root.muted;
        }
        if root.query == "" : Text {
            x: 34px; width: parent.width - 44px; height: parent.height;
            text: "Search settings: colors, fonts, transparency, password…";
            color: root.muted; font-size: 12px * root.text-scale; vertical-alignment: center; overflow: elide;
        }
        // Capture navigation keys before the text field edits with them.
        keys := FocusScope {
            x: 34px; width: parent.width - 44px; height: parent.height;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            capture-key-pressed(event) => {
                if event.text == Key.DownArrow && root.open && root.results.length > 0 {
                    root.index = min(root.index + 1, root.results.length - 1);
                    accept
                } else if event.text == Key.UpArrow && root.open && root.results.length > 0 {
                    root.index = max(root.index - 1, 0);
                    accept
                } else if event.text == Key.Escape && root.query != "" {
                    root.query = "";
                    root.search("");
                    accept
                } else { reject }
            }
            input := ThemedTextInput {
                width: parent.width; height: parent.height;
                text <=> root.query; single-line: true;
                color: root.ink; font-size: 13px * root.text-scale; vertical-alignment: center;
                accessible-label: "Search settings";
                accessible-description: root.open && root.results.length > 0 && root.index >= 0 && root.index < root.results.length
                    ? root.results[root.index].label + ", " + root.results[root.index].breadcrumb : "";
                edited => { root.search(self.text); }
                accepted => { root.pick(); }
            }
        }
    }
    if root.open && root.results.length == 0 : Text {
        text: "No matching settings. Try another word, such as color, font or password.";
        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
        accessible-live-region: polite;
    }
    if root.open && root.results.length > 0 : results-scroll := ScrollView {
        height: min(results-content.preferred-height, root.max-results-height);
        horizontal-scrollbar-policy: always-off;
        // Keep the highlighted row inside the visible part of the list.
        function reveal-row(top: length, height: length) {
            if top < -self.content-y {
                self.content-y = -top;
            } else if top + height > -self.content-y + self.visible-height {
                self.content-y = -(top + height - self.visible-height);
            }
        }
        results-content := VerticalLayout {
        width: results-scroll.visible-width;
        spacing: 2px; alignment: start;
        for result[i] in root.results : ActionRect {
            property <bool> highlighted: i == root.index;
            changed highlighted => {
                if self.highlighted { results-scroll.reveal-row(self.y, self.height); }
            }
            min-height: max(44px, label-text.preferred-height + trail-text.preferred-height + 14px);
            label: result.label + ", " + result.breadcrumb + ". " + result.description;
            background: i == root.index || self.has-hover ? root.hover-surface : transparent;
            border-radius: StyleTokens.radius * 0.6;
            border-width: i == root.index ? 1px : 0px;
            border-color: root.accent;
            focus-color: root.accent;
            activated => { root.index = i; root.choose(result.id); }
            VerticalLayout {
                padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px; spacing: 2px;
                label-text := Text { text: result.label; color: root.ink; font-size: 12px * root.text-scale; font-weight: 650; wrap: word-wrap; }
                trail-text := Text { text: result.breadcrumb; color: root.muted; font-size: 10px * root.text-scale; wrap: word-wrap; }
            }
        }
        }
    }
}

// Color groups, a filter over every token and the tokens shown. Choosing a
// token opens it in the editor; nothing changes until a valid value is typed.
component ColorTokenList inherits VerticalLayout {
    in property <[ColorGroupItem]> groups;
    in property <[ColorTokenItem]> tokens;
    in property <int> group-index;
    in property <string> selected-id;
    in-out property <string> filter;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    // The groups and tokens scroll inside this height, so the editor stays
    // close to the list at narrow widths and large text.
    in property <length> max-list-height: 320px;
    out property <bool> has-focus: filter-input.has-focus;
    pure callback color-of(string) -> color;
    callback filter-edited(string);
    callback group-chosen(int);
    callback token-chosen(string);
    forward-focus: filter-input;
    spacing: 4px;
    alignment: start;
    Rectangle {
        height: max(36px, 30px * root.text-scale);
        background: root.surface; border-radius: StyleTokens.radius * 0.7;
        border-width: filter-input.has-focus ? 2px : 1px;
        border-color: filter-input.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent) : root.outline;
        if root.filter == "" : Text {
            x: 10px; width: parent.width - 20px; height: parent.height;
            text: "Filter colors: link, badge, backdrop…"; color: root.muted;
            font-size: 12px * root.text-scale; vertical-alignment: center; overflow: elide;
        }
        filter-input := ThemedTextInput {
            x: 10px; width: parent.width - 20px; height: parent.height;
            text <=> root.filter; single-line: true;
            color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center;
            accessible-label: "Filter colors by name";
            edited => { root.filter-edited(self.text); }
        }
    }
    list-scroll := ScrollView {
        height: min(list-content.preferred-height, root.max-list-height);
        horizontal-scrollbar-policy: always-off;
        accessible-role: list;
        accessible-label: "Colors to edit";
        // A row that takes keyboard focus is scrolled into view by Slint in
        // this list and in the Settings page alike.
        list-content := VerticalLayout {
    width: list-scroll.visible-width;
    spacing: 2px; alignment: start;
    if root.filter == "" : VerticalLayout {
        spacing: 2px; alignment: start;
        for group[index] in root.groups : ActionRect {
            height: max(32px, 26px * root.text-scale);
            label: group.label + (index == root.group-index ? ", selected" : "");
            background: index == root.group-index ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover-surface)
                : self.has-hover ? root.hover-surface : transparent;
            border-radius: StyleTokens.radius * 0.6; focus-color: root.accent;
            activated => { root.group-chosen(index); }
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 6px;
                Text {
                    text: group.label;
                    color: index == root.group-index && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink;
                    font-size: 12px * root.text-scale; font-weight: index == root.group-index ? 700 : 500;
                    vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                }
                Text { text: group.window ? "" : ("" + group.count); color: root.muted; font-size: 11px * root.text-scale; vertical-alignment: center; }
            }
        }
    }
    Rectangle { height: 1px; background: root.outline; }
    if root.tokens.length == 0 : Text {
        text: "No colors match. Try another word."; color: root.muted;
        font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite;
    }
    for token in root.tokens : ActionRect {
        height: max(36px, 30px * root.text-scale);
        label: token.label + (token.overridden ? ", customized" : "") + (token.id == root.selected-id ? ", selected" : "");
        background: token.id == root.selected-id ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover-surface)
            : self.has-hover ? root.hover-surface : transparent;
        border-radius: StyleTokens.radius * 0.6; focus-color: root.accent;
        activated => { root.token-chosen(token.id); }
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px; spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 18px; height: 18px; border-radius: 4px;
                    border-width: 1px; border-color: root.outline; background: root.color-of(token.id);
                }
            }
            Text {
                text: token.label;
                color: token.id == root.selected-id && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink;
                font-size: 12px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
            }
            if token.overridden : Text { text: "edited"; color: root.muted; font-size: 10px * root.text-scale; vertical-alignment: center; }
        }
    }
        }
    }
}

// The one selected color. A valid #RRGGBB or #RRGGBBAA value applies and
// saves at once; partial or invalid input only shows a hint and the last
// valid color stays applied. Escape restores the field to the shown color.
component ColorTokenEditor inherits VerticalLayout {
    in property <ColorEditorState> state;
    in property <color> swatch;
    in-out property <string> hex;
    in property <int> override-count;
    in property <string> reset-all-notice;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    callback hex-edited(string);
    callback restore-input();
    callback reset();
    callback undo();
    callback reset-all();
    out property <bool> has-focus: hex-input.has-focus;
    forward-focus: hex-input;
    spacing: 8px;
    alignment: start;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 52px; height: 52px; border-radius: StyleTokens.radius * 0.8;
                border-width: 1px; border-color: root.outline; background: root.swatch;
                accessible-role: image; accessible-label: "Current color of " + root.state.label;
            }
        }
        VerticalLayout {
            alignment: start; spacing: 3px; horizontal-stretch: 1;
            Text { text: root.state.label; color: root.ink; font-size: 14px * root.text-scale; font-weight: 700; wrap: word-wrap; }
            Text { text: root.state.group + " · " + root.state.source; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
        }
    }
    Text { text: root.state.description; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
    Rectangle {
        height: max(38px, 32px * root.text-scale);
        background: root.surface; border-radius: StyleTokens.radius * 0.7;
        border-width: hex-input.has-focus ? 2px : 1px;
        border-color: hex-input.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent) : root.outline;
        FocusScope {
            x: 10px; width: parent.width - 20px; height: parent.height;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.restore-input(); accept } else { reject }
            }
            hex-input := ThemedTextInput {
                width: parent.width; height: parent.height;
                text <=> root.hex; single-line: true;
                color: root.ink; font-size: 13px * root.text-scale; vertical-alignment: center;
                accessible-label: "Hex color for " + root.state.label + ", #RRGGBB or #RRGGBBAA";
                accessible-description: root.state.hint;
                edited => { root.hex-edited(self.text); }
                accepted => { root.hex-edited(self.text); }
            }
        }
    }
    if root.state.hint != "" : Text {
        text: root.state.hint; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
        accessible-live-region: polite;
    }
    HorizontalLayout {
        spacing: 8px; alignment: start;
        if root.state.overridden : TextAction {
            text: "Reset"; label: "Reset " + root.state.label + " to its theme or built-in color";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.reset(); }
        }
        if root.state.can-undo : TextAction {
            text: "Undo"; label: "Undo the last change to " + root.state.label;
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.undo(); }
        }
    }
    Text { text: "Advanced: key " + root.state.id + " in the [colors] table of config.toml"; color: root.muted; font-size: 10px * root.text-scale; wrap: word-wrap; }
    if root.override-count > 0 || root.reset-all-notice != "" : TextAction {
        wrap-caption: true;
        text: root.reset-all-notice != "" ? root.reset-all-notice : "Reset all " + root.override-count + " customized colors";
        ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
        outline: root.outline; text-scale: root.text-scale;
        activated => { root.reset-all(); }
    }
}

// Native window transparency. The slider previews while dragging and saves
// on release; the number saves when edited. Both edit the same value.
component WindowOpacitySetting inherits VerticalLayout {
    in property <int> value;
    // Bumped after every save attempt so both controls show the saved value,
    // including after a rejected save restored the previous one.
    in property <int> revision;
    in property <string> status;
    in property <color> ink;
    in property <color> muted;
    in property <float> text-scale: 1;
    // A value to preview now and save shortly; keyboard and accessibility
    // changes arrive here too.
    callback previewed(int);
    // A value to save now, such as on pointer or key release.
    callback changed-value(int);
    out property <bool> has-focus: slider.has-focus;
    forward-focus: slider;
    spacing: 6px;
    alignment: start;
    changed value => {
        slider.value = root.value;
        number.value = root.value;
    }
    changed revision => {
        slider.value = root.value;
        number.value = root.value;
    }
    Text { text: "Window transparency"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
    Text {
        text: "Lower values let the desktop show through the window's panes. Text, icons, inputs, cards and dialogs stay opaque; sign-in and recovery always stay opaque.";
        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 10px;
        slider := Slider {
            horizontal-stretch: 1; minimum: 0; maximum: 100; step: 1;
            value: root.value;
            accessible-label: "Window background opacity, percent";
            changed(value) => { root.previewed(round(value)); }
            released(value) => { root.changed-value(round(value)); }
        }
        number := SpinBox {
            width: max(96px, 80px * root.text-scale);
            minimum: 0; maximum: 100; value: root.value;
            accessible-label: "Window background opacity, percent, as a number";
            edited(value) => { root.previewed(value); }
        }
        Text { text: "%"; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; }
    }
    Text { text: root.status; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
}

// Separate from AppWindow so a blocked account store exposes no sign-in,
// account switching, preview, file deletion or policy-reset callbacks.
export component StartupErrorWindow inherits Window {
    title: "Morpheus — account recovery";
    preferred-width: 560px;
    preferred-height: 360px;
    min-width: 440px;
    min-height: 340px;
    background: #10131f;
    in property <string> detail;
    callback exit-requested();
    forward-focus: close-button;

    VerticalLayout {
        padding: 28px;
        spacing: 16px;
        Text {
            text: "Morpheus";
            accessible-role: text;
            accessible-label: self.text;
            color: #f2f4ff;
            font-size: 26px;
            font-weight: 750;
        }
        Text {
            text: "Saved accounts could not be opened";
            accessible-role: text;
            accessible-label: self.text;
            color: #c7baff;
            font-size: 18px;
            wrap: word-wrap;
        }
        Text {
            text: root.detail;
            accessible-role: text;
            accessible-label: self.text;
            color: #f2f4ff;
            font-size: 14px;
            wrap: word-wrap;
            vertical-stretch: 1;
        }
        close-button := Button {
            text: "Close Morpheus";
            clicked => { root.exit-requested(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Morpheus";
    preferred-width: 1310px;
    preferred-height: 820px;
    // Derive the minimum from saved pane sizes, not the window width. A
    // width-dependent pane constraint creates a layout-info binding cycle.
    min-width: max(940px, (root.navigation-mode == 0 ? root.rail-width-px * 1px : 0px) + root.room-list-width * 1px
        + (root.show-side-panel && root.page == 0 ? root.details-width * 1px : 0px) + 360px);
    min-height: 620px;

    in-out property <[AccountItem]> accounts;
    in-out property <[AccountOption]> account-options;
    in-out property <[SpaceItem]> spaces;
    in-out property <string> active-space-id;
    in-out property <string> active-space-name: "Home";
    in-out property <[RoomItem]> channels;
    in-out property <[RoomItem]> direct-messages;
    in-out property <[NavigationRoomItem]> combined-rooms;
    out property <int> navigation-mode: 0; // rail or text-first sidebar
    in-out property <bool> show-space-labels: false;
    in-out property <bool> group-direct-messages: true;
    callback choose-navigation-mode(int);
    callback set-show-space-labels(bool);
    callback set-group-direct-messages(bool);
    callback set-reduce-motion(bool);
    property <int> navigation-focus-owner: -1;
    property <string> navigation-focus-token;
    function navigation-focus-changed(owner: int, token: string, focused: bool) {
        if focused {
            root.navigation-focus-owner = owner;
            root.navigation-focus-token = token;
        } else if root.navigation-focus-owner == owner && root.navigation-focus-token == token {
            root.navigation-focus-owner = -1;
            root.navigation-focus-token = "";
        }
    }
    public function apply-navigation-mode(mode: int) {
        if mode != root.navigation-mode && root.navigation-focus-owner == root.navigation-mode
            && !root.show-sign-in && !root.manage-accounts-open && !root.access-open
            && !root.account-menu-open && !root.room-actions-open && !root.room-admin-open
            && !root.roster-confirm-open && !root.space-manager-view.confirm-open
            && !root.native-capture-picker-open && !root.leave-call-dialog
            && !root.quick-switcher-open && !root.image-preview-open && root.security-recovery-key == "" {
            account-trigger.focus();
        }
        root.navigation-mode = mode;
    }
    in-out property <[RoomItem]> invitations;
    in-out property <[RoomItem]> unsorted-channels;
    in-out property <[RoomItem]> unsorted-direct-messages;
    in-out property <[MessageItem]> messages;
    in-out property <[MessageItem]> thread-messages;
    // Offline preview roster. Live rooms use the roster-* administration state.
    in-out property <[MemberItem]> members;
    // Native room administration: room-admin.slint, owned by room_admin/ui.rs.
    // `roster-panel-id` fences every asynchronous result to one open roster.
    in-out property <string> roster-panel-id;
    in-out property <[RosterMember]> roster-members;
    in-out property <string> roster-summary;
    in-out property <string> roster-shown-text;
    in-out property <string> roster-own-role;
    in-out property <bool> roster-loaded: false;
    in-out property <bool> roster-loading: false;
    in-out property <bool> roster-busy: false;
    in-out property <string> roster-pending-text;
    in-out property <string> roster-error;
    in-out property <string> roster-notice;
    in-out property <bool> roster-can-invite: false;
    in-out property <int> roster-own-level: 0;
    in-out property <int> roster-member-level: 0;
    in-out property <string> roster-query;
    in-out property <int> roster-filter: 0;
    in-out property <string> roster-invite-input;
    in-out property <string> roster-selected-key;
    in-out property <RosterMember> roster-selected;
    in-out property <string> roster-selected-status;
    in-out property <string> roster-selected-restriction;
    in-out property <string> roster-level-input;
    in-out property <string> roster-reason-input;
    in-out property <bool> roster-confirm-open: false;
    in-out property <string> roster-confirm-title;
    in-out property <string> roster-confirm-body;
    in-out property <string> roster-confirm-action;
    in-out property <bool> roster-confirm-destructive: false;
    in-out property <[RosterPermission]> roster-permissions;
    // Native Space management: space-manager.slint, owned by space_management/ui.rs.
