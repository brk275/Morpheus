    in-out property <bool> thread-root-is-own: false;
    in-out property <int> thread-root-palette-index: 0;
    in-out property <color> thread-root-accent: transparent;
    in-out property <string> thread-root-body;
    in-out property <styled-text> thread-root-rich-body;
    in-out property <string> thread-root-rich-accessible-body;
    in-out property <string> thread-composer-text;
    in-out property <bool> thread-send-pending: false;
    // Saved send status for the visible room and thread composers: counts,
    // paused/unconfirmed flags, one row per saved record and a fixed notice
