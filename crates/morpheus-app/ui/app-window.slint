}

component AvatarBadge inherits Rectangle {
    in property <string> initials;
    in property <color> accent;
    // A decoded, bounded picture (an account's own avatar); initials show
    // whenever there is none. Purely presentation: no input or action.
    in property <image> avatar;
    in property <bool> has-avatar: false;
    in property <color> ink: StyleTokens.roles.avatar-ink.present ? StyleTokens.roles.avatar-ink.color : #ffffff;
    // Each call site's own corners. Avatar roundness, when set, replaces
    // them with a share of this avatar's size, so every size stays alike.
    in property <length> built-in-radius: StyleTokens.radius * 1.3;
    in property <length> initials-size: 12px;
    width: 38px;
    height: 38px;
    border-radius: StyleTokens.avatar-roundness >= 0 ? min(self.width, self.height) * StyleTokens.avatar-roundness / 100 : root.built-in-radius;
    background: accent;
    clip: root.has-avatar;
    if !root.has-avatar : Text {
        text: root.initials;
        color: root.ink;
        font-size: root.initials-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.has-avatar : Image {
        width: parent.width; height: parent.height;
        source: root.avatar; image-fit: cover;
        accessible-role: none;
    }
}

// A pane's resize edge: a subtle line that shows on hover and while
// dragging. Only the window previews the new width while the pointer moves;
// `finished` reports the final width once, on release. A cancelled pointer
// (lost grab) reports `cancelled`. Keyboard users have Settings' width
// fields, so the edge itself takes no focus.
component PaneResizeEdge inherits Rectangle {
    in property <bool> grows-right: true;
    in property <length> start-width;
    in property <length> minimum;
    in property <length> maximum;
    in property <color> accent;
    in property <bool> enabled: true;
    callback began() -> bool;
    callback previewed(length);
    callback finished(length);
    callback cancelled();
    property <bool> active: false;
    in property <int> gesture-token;
    property <int> owned-token: 0;
    changed gesture-token => {
        if root.owned-token != root.gesture-token { root.active = false; }
    }
    property <length> press-x;
    property <length> base;
    pure function value-now() -> length {
        clamp(root.base + (root.grows-right ? 1 : -1) * (self.absolute-position.x + touch.mouse-x - root.press-x), root.minimum, root.maximum)
    }
    width: 8px;
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: touch.has-hover || root.active ? 3px : 1px;
        height: parent.height;
        background: touch.has-hover || root.active ? root.accent : transparent;
    }
    touch := TouchArea {
        enabled: root.enabled || root.active;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel {
                if root.active && root.owned-token == root.gesture-token {
                    root.active = false;
                    root.cancelled();
                }
                return;
            }
            if event.button != PointerEventButton.left {
                return;
            }
            if event.kind == PointerEventKind.down {
                if root.began() {
                    root.owned-token = root.gesture-token;
                    root.active = true;
                    root.press-x = root.absolute-position.x + self.mouse-x;
                    root.base = root.start-width;
                }
            } else if event.kind == PointerEventKind.up {
                if root.active && root.owned-token == root.gesture-token {
                    root.active = false;
                    root.finished(root.value-now());
                }
            }
        }
        moved => {
            if root.active && root.owned-token == root.gesture-token {
                root.previewed(root.value-now());
            }
        }
    }
}

// A pane's drag grip for arranging panes by pointer. While dragging it
// reports the pointer's window x; the window shows where the pane would go
// and commits once on release. Move left/right in Settings does the same by
// keyboard.
component PaneDragGrip inherits Rectangle {
    in property <color> ink;
    in property <color> accent;
    in property <color> hover;
    in property <bool> enabled: true;
    callback began() -> bool;
    callback dragged(length);
    callback dropped(length);
    callback cancelled();
    property <bool> active: false;
    in property <int> gesture-token;
    property <int> owned-token: 0;
    changed gesture-token => {
        if root.owned-token != root.gesture-token { root.active = false; }
    }
    width: 36px;
    height: 12px;
    border-radius: 6px;
    background: root.active ? root.accent : touch.has-hover ? root.hover : transparent;
    Text {
        text: "⋯";
        color: root.active ? root.hover : root.ink;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea {
        enabled: root.enabled || root.active;
        mouse-cursor: root.active ? grabbing : grab;
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel {
                if root.active && root.owned-token == root.gesture-token {
                    root.active = false;
                    root.cancelled();
                }
                return;
            }
            if event.button != PointerEventButton.left {
                return;
            }
            if event.kind == PointerEventKind.down {
                if root.began() {
                    root.owned-token = root.gesture-token;
                    root.active = true;
                }
            } else if event.kind == PointerEventKind.up {
                if root.active && root.owned-token == root.gesture-token {
                    root.active = false;
                    root.dropped(root.absolute-position.x + self.mouse-x);
                }
            }
        }
        moved => {
            if root.active && root.owned-token == root.gesture-token {
                root.dragged(root.absolute-position.x + self.mouse-x);
            }
        }
    }
}

// An exact width entry that follows the saved width after every save.
component WidthSpin inherits Rectangle {
    in property <int> saved;
    in property <int> minimum;
    in property <int> maximum;
    in property <string> label;
    callback edited(int);
    changed saved => { spin.value = root.saved; }
    width: 120px;
    spin := SpinBox {
        width: parent.width;
        minimum: root.minimum;
        maximum: root.maximum;
        value: root.saved;
        accessible-label: root.label;
        edited(value) => { root.edited(value); }
    }
}

component IconAction inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> ink;
    in property <color> surface;
    in property <color> hover-surface;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <bool> quiet: false;
    in property <bool> context-hover: false;
    // Match the visible button so keyboard reveal keeps a nonzero focus target.
    in property <bool> reveal-full-control: true;
    // Reveal the associated value row as well as a small settings action.
    in property <length> reveal-height: root.height;
    out property <bool> has-focus: keyboard-focus.has-focus;
    // A stable MorpheusIcons ID, or a legacy one-glyph caption that maps to
    // one. Anything else keeps the bounded text fallback below.
    property <string> icon-id: MorpheusIcons.outline(root.icon) != "" ? root.icon : MorpheusIcons.from-legacy(root.icon);
    // The configured icon size. A larger icon stays inside a call site's
    // explicitly smaller button, but never below the built-in 18 px, so the
    // default look is unchanged at every text scale. The button's own size
    // never depends on its children.
    property <length> glyph-size: min(StyleTokens.icon-size, max(18px, min(root.width, root.height) - 6px));
    opacity: !quiet || context-hover || area.has-hover || keyboard-focus.has-focus ? 1 : 0;
    callback activated();
    callback focus-state-changed(bool);
    width: StyleTokens.icon-button-size;
    height: StyleTokens.icon-button-size;
    border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.9;
    background: selected ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : hover-surface) : surface;
    forward-focus: keyboard-focus;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    HoverSurface {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        visible: !root.selected;
        highlighted: root.enabled && area.has-hover;
        background: StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover-surface;
    }
    // Drawn only when a theme or config.toml sets a pressed state.
    Rectangle {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        background: root.enabled && area.pressed && StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color : transparent;
    }
    // Disabled, then selected, then the caller's ink.
    property <color> glyph-ink: !root.enabled && StyleTokens.states.control-disabled.present ? StyleTokens.states.control-disabled.color
        : root.selected && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink;
    if root.icon-id == "" : Text {
        text: root.icon;
        color: root.glyph-ink;
        font-size: root.icon == "Md" ? root.glyph-size * 13 / 18 : root.glyph-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon-id != "" : MorpheusIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        icon: root.icon-id;
        ink: root.glyph-ink;
    }
    keyboard-focus := FocusScope {
        x: 0px;
        y: (root.height - self.height) / 2;
        width: root.reveal-full-control ? root.width : 0px;
        height: root.reveal-full-control ? max(root.height, root.reveal-height) : 0px;
        // Slint's accessibility bridge requests focus with PointerClick.
        focus-on-click: true;
        enabled: root.enabled;
        focus-gained(reason) => { root.focus-state-changed(true); }
        focus-lost(reason) => { root.focus-state-changed(false); }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if root.enabled { root.activated(); }
                accept
            } else { reject }
        }
    }
    // Keep pointer handling above the focus area so an unfocused button
    // activates on the first click, then retain its keyboard focus.
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keyboard-focus.focus(); root.activated(); }
    }
    if keyboard-focus.has-focus : Rectangle {
        border-radius: parent.border-radius;
        border-width: StyleTokens.focus-width;
        border-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.ink;
        background: transparent;
    }
}

// The same row renders grouped and combined navigation. `direct` is carried
// from the originating model, never guessed from the display name or icon.
component NavigationRoomRow inherits ActionRect {
    in property <RoomItem> room;
    in property <bool> direct;
    in property <bool> selected;
    in property <int> density-mode;
    in property <float> text-scale;
    in property <color> ink;
    in property <color> muted;
    in property <color> elevated;
    in property <color> hover;
    in property <color> accent;
    in property <color> accent-ink;
    // Mentions and highlights use their own badge colors, so a ping stays
    // distinct from a plain unread count. The window resolves both colors.
    in property <color> mention-surface;
    in property <color> mention-ink;
    // Room kept free at the right edge for an overlay (a voice room's
    // presence pill), which this control would otherwise cover.
    in property <length> trailing-reserve: 0px;
    callback open(string, bool);
    property <bool> selected-ink-set: StyleTokens.states.nav-selected-ink.present || StyleTokens.roles.selection-ink.present;
    property <color> selected-ink: StyleTokens.states.nav-selected-ink.present ? StyleTokens.states.nav-selected-ink.color : StyleTokens.roles.selection-ink.color;
    height: max(root.direct ? (root.density-mode == 0 ? 32px : root.density-mode == 2 ? 47px : 39px)
        : (root.density-mode == 0 ? 30px : root.density-mode == 2 ? 44px : 36px), (StyleTokens.sidebar-font-size + 9px) * root.text-scale);
    border-radius: StyleTokens.radius * 0.8;
    background: root.selected ? (StyleTokens.states.nav-selected.present ? StyleTokens.states.nav-selected.color
        : StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover) : transparent;
    HoverSurface {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        visible: !root.selected;
        highlighted: root.enabled && root.has-hover;
        background: StyleTokens.states.nav-hover.present ? StyleTokens.states.nav-hover.color : root.elevated;
    }
    Rectangle {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        background: root.enabled && root.has-pressed && StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color : transparent;
    }
    focus-color: root.accent;
    label: root.room.voice-space ? (root.direct ? "Enter voice space with " : "Enter voice space ") + root.room.name
        : (root.direct ? "Open direct message with " : "Open room ") + root.room.name;
    // Counts are spoken without changing the action's name.
    accessible-description: root.room.mentions > 0 ? root.room.mentions + " unread mentions, " + root.room.unread + " unread"
        : root.room.unread > 0 ? root.room.unread + " unread" : "";
    activated => { root.open(root.room.id, root.room.voice-space); }
    HorizontalLayout {
        padding-left: root.direct ? 9px : 10px; padding-right: 9px; spacing: root.direct ? 9px : 8px;
        if root.direct : Rectangle {
            width: 25px; height: 25px; border-radius: StyleTokens.radius * 0.9; background: root.accent;
            Text { text: root.room.voice-space ? "◖" : "@"; color: root.accent-ink; font-size: 13px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
        }
        if !root.direct : Text {
            text: root.room.voice-space ? "◖" : (root.room.private-room ? "⌑" : "#");
            color: root.selected && root.selected-ink-set ? root.selected-ink : root.room.voice-space ? (StyleTokens.roles.voice.present ? StyleTokens.roles.voice.color : #78c8b1) : root.muted;
            font-size: 18px * root.text-scale; vertical-alignment: center;
        }
        Text {
            text: root.room.name;
            color: root.selected && root.selected-ink-set ? root.selected-ink : (root.room.unread > 0 ? root.ink : root.muted);
            font-size: StyleTokens.sidebar-font-size * root.text-scale; font-weight: root.direct ? 0 : root.room.unread > 0 ? 700 : 500;
            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
        }
        if root.room.voice-space : Text {
            text: "VOICE"; color: root.selected && root.selected-ink-set ? root.selected-ink : StyleTokens.roles.voice.present ? StyleTokens.roles.voice.color : #78c8b1;
            font-size: 9px * root.text-scale; font-weight: 750; vertical-alignment: center;
        }
        // One badge: mentions win over the plain unread count. Both grow with
        // a long count or large text instead of overflowing the pill; at the
        // default size a two-digit count keeps the 20 px circle.
        if root.room.mentions > 0 : mention-pill := Rectangle {
            width: max(self.height, mention-count.preferred-width + 8px); height: max(20px, 14px * root.text-scale);
            border-radius: self.height / 2;
            background: root.mention-surface;
            mention-count := Text { text: "@" + root.room.mentions; color: root.mention-ink; font-size: 10px * root.text-scale; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
        }
        if root.room.mentions <= 0 && root.room.unread > 0 : Rectangle {
            width: max(self.height, unread-count.preferred-width + 6px); height: max(20px, 14px * root.text-scale);
            border-radius: self.height / 2;
            background: StyleTokens.roles.unread.present ? StyleTokens.roles.unread.color : root.accent;
            unread-count := Text { text: root.room.unread; color: StyleTokens.roles.unread-ink.present ? StyleTokens.roles.unread-ink.color : root.accent-ink; font-size: 10px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        if root.trailing-reserve > 0px : Rectangle { width: root.trailing-reserve; }
    }
}

// A room-list row with its organization menu. The menu area lies above the
// row: a right click opens it, every other input reaches the row. The row's
// own control passes on keys it does not use, so the Menu key or Shift+F10
// on a focused row opens the same menu; the room header has it too
// (RoomOrganizationButton).
component OrganizableRoomRow inherits Rectangle {
    in property <RoomItem> room;
    in property <bool> direct;
    in property <bool> selected;
    in property <int> density-mode;
    in property <float> text-scale;
    in property <color> ink;
    in property <color> muted;
    in property <color> elevated;
    in property <color> hover;
    in property <color> accent;
    in property <color> accent-ink;
    in property <color> mention-surface;
    in property <color> mention-ink;
    // A live account is shown; the preview has no Matrix tags.
    in property <bool> organizable;
    in property <bool> can-move-up;
    in property <bool> can-move-down;
    callback open(string, bool);
    // A watched voice room's presence pill sits over the row's reserved
    // right edge: inside the row, the row's own control would take its
    // clicks. Inspecting it never joins (see voice-rosters.slint).
    property <bool> presence-shown: root.room.voice-space && VoiceRosters.presence(root.room.id, VoiceRosters.revision).state != 0;
    property <length> presence-width: 34px * root.text-scale;
    height: row.height;
    // Never focused itself; it only sees keys the row's control passes on.
    FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if root.organizable && RoomOrganizationState.pending-room == "" && (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                row-menu.show({ x: 0px, y: root.height });
                accept
            } else {
                reject
            }
        }
        row := NavigationRoomRow {
            x: 0px;
            y: 0px;
            width: root.width;
            room: root.room;
            direct: root.direct;
            selected: root.selected;
            density-mode: root.density-mode;
            text-scale: root.text-scale;
            ink: root.ink;
            muted: root.muted;
            elevated: root.elevated;
            hover: root.hover;
            accent: root.accent;
            accent-ink: root.accent-ink;
            mention-surface: root.mention-surface;
            mention-ink: root.mention-ink;
            trailing-reserve: root.presence-shown ? root.presence-width + 6px : 0px;
            open(id, voice) => { root.open(id, voice); }
        }
        if root.presence-shown : VoicePresencePill {
            x: root.width - self.width - 9px;
            y: (root.height - self.height) / 2;
            pill-width: root.presence-width;
            room-id: root.room.id;
            room-name: root.room.name;
            ink: root.ink;
            muted: root.muted;
            accent: root.accent;
            surface: root.elevated;
            text-scale: root.text-scale;
        }
    }
    row-menu := ContextMenuArea {
        // One change at a time per account; every menu waits for it.
        enabled: root.organizable && RoomOrganizationState.pending-room == "";
        Menu {
            // Each item sends only the action its title states. The menu
            // keeps the items it was shown with: if sync changes the row's
            // tags meanwhile, an outdated item still sends its action, which
            // changes nothing when the room already has that result.
            // Room activity: the private read marker plus a read receipt,
            // public only when chosen in Settings. Rust checks the account.
            MenuItem {
                title: "Mark as read";
                enabled: !RoomActivity.marking;
                activated => { RoomActivity.mark-read(root.room.id); }
            }
            MenuSeparator { }
            if !root.room.favourite: MenuItem {
                title: "Add to Favorites";
                activated => { RoomOrganizationState.organize(root.room.id, 0); }
            }
            if root.room.favourite: MenuItem {
                title: "Remove from Favorites";
                activated => { RoomOrganizationState.organize(root.room.id, 1); }
            }
            if !root.room.low-priority: MenuItem {
                title: "Mark as low priority";
                activated => { RoomOrganizationState.organize(root.room.id, 2); }
            }
            if root.room.low-priority: MenuItem {
                title: "Normal priority";
                activated => { RoomOrganizationState.organize(root.room.id, 3); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Move up in Favorites";
                enabled: root.room.favourite && root.can-move-up;
                activated => { RoomOrganizationState.organize(root.room.id, 4); }
            }
            MenuItem {
                title: "Move down in Favorites";
                enabled: root.room.favourite && root.can-move-down;
                activated => { RoomOrganizationState.organize(root.room.id, 5); }
            }
        }
    }
}

component NavigationTextAction inherits ActionRect {
    in property <string> text;
    in property <bool> selected;
    in property <float> text-scale;
    in property <color> ink;
    in property <color> muted;
    in property <color> hover;
    in property <color> accent;
    property <bool> selected-ink-set: StyleTokens.states.nav-selected-ink.present || StyleTokens.roles.selection-ink.present;
    property <color> selected-ink: StyleTokens.states.nav-selected-ink.present ? StyleTokens.states.nav-selected-ink.color : StyleTokens.roles.selection-ink.color;
    height: max(32px, (StyleTokens.sidebar-font-size + 9px) * root.text-scale + 8px); vertical-stretch: 0;
    reveal-full-control: true;
    border-radius: StyleTokens.radius * 0.8;
    background: root.selected ? (StyleTokens.states.nav-selected.present ? StyleTokens.states.nav-selected.color
        : StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover) : transparent;
    HoverSurface {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        visible: !root.selected;
        highlighted: root.enabled && root.has-hover;
        background: StyleTokens.states.nav-hover.present ? StyleTokens.states.nav-hover.color : root.hover;
    }
    Rectangle {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        background: root.enabled && root.has-pressed && StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color : transparent;
    }
    focus-color: root.accent;
    label: root.text;
    Text {
        x: 8px; width: parent.width - 16px; height: parent.height;
        text: root.text; color: root.selected && root.selected-ink-set ? root.selected-ink : root.selected ? root.ink : root.muted;
        font-size: StyleTokens.sidebar-font-size * root.text-scale; font-weight: root.selected ? 650 : 500;
        overflow: elide; vertical-alignment: center;
    }
}

// Buttons for one saved send record. Rendered in a row when there is room and
// stacked when the pane is narrow or text is large, so no control is clipped.
component PendingRecordActions inherits VerticalLayout {
    in property <PendingSendItem> item;
    in property <bool> narrow;
    in property <bool> composer-empty;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> outline;
    in property <float> text-scale: 1;
    callback cancel();
    callback retry();
    callback review(bool);
    callback restore();
    callback copy();
    callback discard();
    spacing: 4px;
    if root.narrow : VerticalLayout {
        spacing: 4px; alignment: start;
        if root.item.unconfirmed : TextAction {
            wrap-caption: true;
            text: "It was sent"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "It was sent: drop this saved message without resending";
            activated => { root.review(true); }
        }
        if root.item.unconfirmed : TextAction {
            wrap-caption: true;
            text: "Not sent, keep my text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Not sent: keep this message's text";
            activated => { root.review(false); }
        }
        if root.item.can-retry : TextAction {
            wrap-caption: true;
            text: "Retry"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Retry sending this message";
            activated => { root.retry(); }
        }
        if root.item.can-cancel : TextAction {
            wrap-caption: true;
            text: "Cancel sending"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Cancel sending this message; a message that already reached the server stays sent";
            activated => { root.cancel(); }
        }
        if root.composer-empty : TextAction {
            wrap-caption: true;
            text: "Restore text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Restore this message's text into the empty composer";
            activated => { root.restore(); }
        }
        TextAction {
            wrap-caption: true;
            text: "Copy text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Copy this message's text to the system clipboard";
            activated => { root.copy(); }
        }
        if root.item.kept : TextAction {
            wrap-caption: true;
            text: "Discard text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Discard this kept text";
            activated => { root.discard(); }
        }
    }
    if !root.narrow : HorizontalLayout {
        spacing: 6px; alignment: start;
        if root.item.unconfirmed : TextAction {
            text: "It was sent"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "It was sent: drop this saved message without resending";
            activated => { root.review(true); }
        }
        if root.item.unconfirmed : TextAction {
            text: "Not sent, keep my text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Not sent: keep this message's text";
            activated => { root.review(false); }
        }
        if root.item.can-retry : TextAction {
            text: "Retry"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Retry sending this message";
            activated => { root.retry(); }
        }
        if root.item.can-cancel : TextAction {
            text: "Cancel sending"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Cancel sending this message; a message that already reached the server stays sent";
            activated => { root.cancel(); }
        }
        if root.composer-empty : TextAction {
            text: "Restore text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Restore this message's text into the empty composer";
            activated => { root.restore(); }
        }
        TextAction {
            text: "Copy text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Copy this message's text to the system clipboard";
            activated => { root.copy(); }
        }
        if root.item.kept : TextAction {
            text: "Discard text"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Discard this kept text";
            activated => { root.discard(); }
        }
    }
}

// Saved send status for one composer scope: a quiet notice when saved data
// needs review, then one block per record with its own exact controls. The
// content keeps every record and action; `viewport-cap` bounds its visible
// height independently of the window's layout constraints. Focused controls are
// scrolled into view by the ScrollView, so every action stays keyboard
// reachable in a narrow pane or at large text sizes.
component PendingSendStrip inherits ScrollView {
    in property <[PendingSendItem]> items;
    in property <string> blocked-notice;
    in property <bool> composer-empty;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> outline;
    in property <float> text-scale: 1;
    in property <length> viewport-cap: 240px;
    out property <length> natural-height: content.preferred-height;
    callback cancel(string);
    callback retry(string);
    callback review(string, bool);
    callback restore(string);
    callback copy(string);
    callback discard(string);
    callback discard-unreadable();
    property <bool> narrow: self.width < 620px * root.text-scale;
    height: min(root.viewport-cap, root.natural-height);
    // Override Flickable's inferred content width: a child's intrinsic minimum
    // must never enlarge the horizontal canvas and center the actions offscreen.
    content-width: self.visible-width;
    content-height: root.natural-height;
    content-x: 0px;
    horizontal-scrollbar-policy: always-off;
    content := VerticalLayout {
    x: 0px; y: 0px;
    width: root.visible-width;
    height: self.preferred-height;
    // Leave room for styles whose vertical scrollbar overlays the viewport.
    padding-right: 16px;
    spacing: 8px;
    if root.blocked-notice != "" : Rectangle {
        height: notice.height + 4px + discard-status.height;
        notice := Text {
            width: parent.width; height: self.preferred-height;
            text: root.blocked-notice; color: root.muted; font-size: 12px * root.text-scale;
            wrap: word-wrap; accessible-live-region: polite;
        }
        discard-status := TextAction {
            y: notice.height + 4px;
            width: root.narrow ? parent.width : min(parent.width, self.preferred-width);
            height: self.preferred-height;
            wrap-caption: root.narrow;
            text: "Discard unreadable saved status"; ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale; reveal-full-control: true;
            accessible-label: "Discard saved send status this version cannot read; your typed text stays";
            activated => { root.discard-unreadable(); }
        }
    }
    // Measure each wrapped status at its allocated width before summing the
    // scroll extent. Layout preferred-height alone can use an unwrapped text
    // estimate and leave the final records beyond the scrollbar's limit.
    for item in root.items : Rectangle {
        height: record-status.height + 4px + record-actions.height;
        record-status := Text {
            width: parent.width; height: self.preferred-height;
            text: item.status + (item.preview != "" ? ": “" + item.preview + "”" : "");
            color: root.muted; font-size: 12px * root.text-scale;
            wrap: word-wrap; accessible-live-region: polite;
        }
        record-actions := PendingRecordActions {
            y: record-status.height + 4px;
            width: parent.width; height: self.preferred-height;
            item: item; narrow: root.narrow; composer-empty: root.composer-empty;
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            cancel => { root.cancel(item.key); }
            retry => { root.retry(item.key); }
            review(sent) => { root.review(item.key, sent); }
            restore => { root.restore(item.key); }
            copy => { root.copy(item.key); }
            discard => { root.discard(item.key); }
        }
    }
    }
}

component MentionPopup inherits Rectangle {
    in property <[MentionItem]> items;
    in property <int> current;
    in property <color> surface;
    in property <color> hover;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <float> text-scale: 1;
    callback choose(string);
    height: min(360px, self.items.length * (36px * root.text-scale + 10px) + 8px);
    // Opt-in decorative fade-in: immediate at 0 ms and under reduced motion.
    property <bool> entered: false;
    // Opacity is first read here, at 0, so setting `entered` animates it;
    // `init` would set it before that first read and nothing would fade.
    Timer { interval: 1ms; running: !root.entered && root.opacity < 1; triggered => { root.entered = true; } }
    opacity: StyleTokens.popup-duration == 0ms || self.entered ? 1 : 0;
    animate opacity { duration: StyleTokens.popup-duration; easing: ease-out; }
    background: surface; border-radius: StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: accent;
    accessible-role: region; accessible-label: "Mention suggestions; arrows select, Enter or Tab inserts, Escape closes";
    mention-list := ListView {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        horizontal-scrollbar-policy: always-off;
        content-y: -max(0px, (root.current + 1) * (36px * root.text-scale + 10px) - self.height);
        for item[index] in root.items : ActionRect {
            width: mention-list.visible-width; height: 36px * root.text-scale + 10px;
            label: item.name + " " + item.key + (index == root.current ? ", selected" : "");
            focus-color: root.accent; border-radius: StyleTokens.radius * 0.5;
            background: index == root.current ? root.hover
                : self.has-hover ? (StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover) : root.surface;
            activated => { root.choose(item.key); }
            VerticalLayout {
                padding: 5px; spacing: 2px;
                Text { text: item.name; color: root.ink; font-size: 12px * root.text-scale; overflow: elide; }
                Text { text: item.key; color: root.muted; font-size: 10px * root.text-scale; overflow: elide; }
            }
        }
    }
}

component EmojiPopup inherits Rectangle {
    in property <[EmojiItem]> items;
    in property <int> current;
    in-out property <string> query;
    in property <color> surface;
    in property <color> elevated;
    in property <color> hover;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <float> text-scale: 1;
    callback searched(string);
    callback navigate(int);
    callback choose(string);
    callback dismiss();
    height: min(380px, 280px * root.text-scale + 70px);
    // Opt-in decorative fade-in: immediate at 0 ms and under reduced motion.
    property <bool> entered: false;
    // Opacity is first read here, at 0, so setting `entered` animates it;
    // `init` would set it before that first read and nothing would fade.
    Timer { interval: 1ms; running: !root.entered && root.opacity < 1; triggered => { root.entered = true; } }
    opacity: StyleTokens.popup-duration == 0ms || self.entered ? 1 : 0;
    animate opacity { duration: StyleTokens.popup-duration; easing: ease-out; }
    background: surface; border-radius: StyleTokens.radius * 0.9; border-width: StyleTokens.line-width; border-color: accent;
    accessible-role: region; accessible-label: "Emoji picker";
    FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); accept } else { reject }
        }
        VerticalLayout {
        padding: 8px; spacing: 6px;
        HorizontalLayout {
            height: 34px * root.text-scale + StyleTokens.icon-button-growth; spacing: 6px;
            Rectangle {
                horizontal-stretch: 1; background: root.elevated; border-radius: StyleTokens.radius * 0.6;
                if root.query == "" : Text {
                    x: 8px; width: parent.width - 16px; height: parent.height;
                    text: "Search emoji"; color: root.muted; font-size: 12px * root.text-scale;
                    vertical-alignment: center;
                }
                emoji-search := ThemedTextInput {
                    x: 8px; width: parent.width - 16px; height: parent.height;
                    text <=> root.query; color: root.ink; font-size: 12px * root.text-scale;
                    vertical-alignment: center; accessible-label: "Search emoji by name";
                    init => { self.focus(); }
                    edited => { root.searched(self.text); }
                    key-pressed(event) => {
                        if !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt {
                            if event.text == Key.Escape { root.dismiss(); accept }
                            else if event.text == Key.UpArrow { root.navigate(-1); accept }
                            else if event.text == Key.DownArrow { root.navigate(1); accept }
                            else if event.text == Key.Return {
                                if root.current >= 0 && root.current < root.items.length { root.choose(root.items[root.current].key); }
                                accept
                            } else { reject }
                        } else { reject }
                    }
                }
            }
            IconAction {
                width: 30px * root.text-scale; icon: "×"; label: "Close emoji picker";
                ink: root.muted; surface: root.surface; hover-surface: root.hover;
                activated => { root.dismiss(); }
            }
        }
        Text {
            text: root.current >= 0 && root.current < root.items.length
                ? "Selected emoji: " + root.items[root.current].name
                : "No matching emoji";
            color: root.ink; font-size: 11px * root.text-scale; wrap: word-wrap;
            accessible-live-region: polite;
        }
        Text { text: "Arrows choose · Enter inserts · Escape closes";
            color: root.muted; font-size: 10px * root.text-scale; wrap: word-wrap; }
        emoji-list := ListView {
            vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
            content-y: -max(0px, (root.current + 1) * (34px * root.text-scale + 6px) - self.height);
            for item[index] in root.items : ActionRect {
                width: emoji-list.visible-width; height: 34px * root.text-scale + 6px;
                label: "Insert " + item.name + " " + item.symbol + (index == root.current ? ", selected" : "");
                background: index == root.current ? root.hover
                : self.has-hover ? (StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover) : root.surface;
                border-radius: StyleTokens.radius * 0.5; focus-color: root.accent; cancel-on-escape: true;
                cancelled => { root.dismiss(); }
                activated => { root.choose(item.key); }
                HorizontalLayout {
                    padding-left: 7px; padding-right: 7px; spacing: 10px;
                    Text { width: 32px * root.text-scale; text: item.symbol; color: root.ink; font-size: 22px * root.text-scale; vertical-alignment: center; }
                    Text { text: item.name; color: root.ink; font-size: 12px * root.text-scale;
                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
            }
        }
        }
    }
}

// The sticker search field. It owns the arrows, Return and Escape so the list
// can be driven without leaving the field.
component StickerSearchField inherits Rectangle {
    in-out property <string> query;
    in property <bool> can-send;
    in property <bool> has-current;
    in property <color> elevated;
    in property <color> ink;
    in property <color> muted;
    in property <float> text-scale: 1;
    callback searched(string);
    callback navigate(int);
    callback send-current();
    callback dismiss();
    background: root.elevated; border-radius: StyleTokens.radius * 0.6;
    if root.query == "" : Text {
        x: 8px; width: parent.width - 16px; height: parent.height;
        text: "Search stickers"; color: root.muted; font-size: 12px * root.text-scale;
        vertical-alignment: center;
    }
    sticker-search := ThemedTextInput {
        x: 8px; width: parent.width - 16px; height: parent.height;
        text <=> root.query; color: root.ink; font-size: 12px * root.text-scale;
        single-line: true; vertical-alignment: center;
        accessible-label: "Search stickers by description, shortcode or pack";
        init => { self.focus(); }
        edited => { root.searched(self.text); }
        key-pressed(event) => {
            if !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt {
                if event.text == Key.Escape { root.dismiss(); accept }
                else if event.text == Key.UpArrow { root.navigate(-1); accept }
                else if event.text == Key.DownArrow { root.navigate(1); accept }
                else if event.text == Key.Return {
                    if root.has-current && root.can-send { root.send-current(); }
                    accept
                } else { reject }
            } else { reject }
        }
    }
}

// The explicit public-media consent. Its height is measured from the wrapped
// message and actions at the allocated width, side by side or stacked.
component StickerConsent inherits Rectangle {
    in property <bool> stacked;
    in property <bool> ready;
    in property <color> elevated;
    in property <color> outline;
    in property <color> surface;
    in property <color> hover;
    in property <color> ink;
    in property <color> muted;
    in property <float> text-scale: 1;
    callback consent(bool);
    height: root.stacked
        ? decline.y + decline.height + 8px
        : allow.y + max(allow.height, decline.height) + 8px;
    background: root.elevated; border-radius: StyleTokens.radius * 0.6;
    border-width: StyleTokens.line-width; border-color: root.outline;
    message := Text {
        x: 8px; y: 8px; width: root.width - 16px; height: self.preferred-height;
        text: "This conversation is encrypted, but sticker images are not. Your homeserver can see which sticker images you load and send here. Labels stay available without images.";
        color: root.ink; font-size: 11px * root.text-scale; wrap: word-wrap;
        accessible-live-region: polite;
    }
    // TextAction exports its size as min-height only: its preferred height is
    // the zero of a plain rectangle, so a placed action sizes by min-height.
    allow := TextAction {
        x: 8px; y: message.y + message.height + 6px;
        width: root.stacked ? root.width - 16px : self.preferred-width;
        height: self.min-height;
        wrap-caption: root.stacked;
        text: "Allow sticker images here"; ink: root.ink; muted: root.muted;
        surface: root.surface; hover-surface: root.hover; outline: root.outline; text-scale: root.text-scale;
        enabled: root.ready;
        activated => { root.consent(true); }
    }
    decline := TextAction {
        x: root.stacked ? 8px : allow.x + allow.width + 8px;
        y: root.stacked ? allow.y + allow.height + 6px : allow.y;
        width: root.stacked ? root.width - 16px : self.preferred-width;
        height: self.min-height;
        wrap-caption: root.stacked;
        text: "Cancel"; ink: root.ink; muted: root.muted;
        surface: root.surface; hover-surface: root.hover; outline: root.outline; text-scale: root.text-scale;
        accessible-label: "Cancel and close the sticker picker";
        activated => { root.consent(false); }
    }
}

component StickerPreviewBox inherits Rectangle {
    in property <image> preview;
    in property <bool> loaded;
    in property <string> status;
    in property <string> label;
    in property <color> elevated;
    in property <color> muted;
    in property <float> text-scale: 1;
    background: root.elevated; border-radius: StyleTokens.radius * 0.6;
    if root.loaded : Image {
        x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
        source: root.preview; image-fit: contain;
        accessible-role: image;
        accessible-label: root.label != "" ? "Sticker preview: " + root.label : "Sticker preview";
    }
    if !root.loaded : Text {
        x: 8px; width: parent.width - 16px; height: parent.height;
        text: root.status; color: root.muted; font-size: 11px * root.text-scale;
        wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
    }
}

component StickerList inherits Rectangle {
    in property <[StickerItem]> items;
    in property <int> current;
    in property <length> row-height;
    in property <color> surface;
    in property <color> hover;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <float> text-scale: 1;
    callback highlight(string);
    callback dismiss();
    sticker-list := ListView {
        width: parent.width; height: parent.height;
        horizontal-scrollbar-policy: always-off;
        content-y: -max(0px, (root.current + 1) * root.row-height - self.height);
        for item[index] in root.items : ActionRect {
            width: sticker-list.visible-width; height: root.row-height;
            label: "Sticker " + item.label + " from " + item.pack + (index == root.current ? ", selected" : "");
            background: index == root.current ? root.hover
                : self.has-hover ? (StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover) : root.surface;
            border-radius: StyleTokens.radius * 0.5; focus-color: root.accent; cancel-on-escape: true;
            cancelled => { root.dismiss(); }
            activated => { root.highlight(item.key); }
            VerticalLayout {
                padding-left: 7px; padding-right: 7px; padding-top: 2px; padding-bottom: 2px; spacing: 1px;
                Text { text: item.label; color: root.ink; font-size: 12px * root.text-scale; overflow: elide; vertical-alignment: center; }
                Text { text: item.pack; color: root.muted; font-size: 10px * root.text-scale; overflow: elide; }
            }
        }
    }
}

// Labels stay usable before any image loads. Images of an encrypted
// conversation appear only after the explicit consent in this popup. A narrow
// pane or large text stacks the controls in a bounded scrolling area above the
// list; it scrolls each focused control into view, so search, pack choice,
// consent, Send and Close stay reachable in the thread pane at 200% text. The
// popup never claims more height than the space above its composer.
component StickerPopup inherits Rectangle {
    in property <[StickerItem]> items;
    in property <[string]> packs;
    in-out property <int> pack-index;
    in property <int> current;
    in-out property <string> query;
    // 0 loading, 1 ready, 2 failed.
    in property <int> phase;
    in property <string> status;
    in property <string> notice;
    in property <bool> needs-consent;
    in property <image> preview;
    in property <bool> preview-loaded;
    in property <string> preview-status;
    in property <bool> can-send;
    // Space above the composer this popup may cover inside the window.
    in property <length> available-height: 470px;
    in property <color> surface;
    in property <color> elevated;
    in property <color> hover;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    // The pack list's colors; a select draws no accent ink.
    property <ControlColors> select-colors: {
        ink: root.ink,
        muted: root.muted,
        surface: root.elevated,
        hover: root.hover,
        outline: root.outline,
        accent: root.accent,
        accent-ink: root.surface,
    };
    callback searched(string);
    callback navigate(int);
    callback choose-pack(int);
    callback highlight(string);
    callback send(string);
    callback consent(bool);
    callback dismiss();
    property <bool> has-current: root.current >= 0 && root.current < root.items.length;
    property <bool> narrow: root.width < 340px * root.text-scale;
    property <length> row-height: 34px * root.text-scale + 6px;
    property <length> field-height: 34px * root.text-scale + StyleTokens.icon-button-growth;
    property <string> current-label: root.has-current ? root.items[root.current].label : "";
    property <string> selected-text: root.notice != "" ? root.notice
        : root.phase != 1 ? root.status
        : root.has-current ? "Selected sticker: " + root.items[root.current].label + ", from " + root.items[root.current].pack
        : root.status;
    height: max(140px, min(root.available-height, root.narrow ? 620px : min(470px, 330px * root.text-scale + 130px)));
    // Opt-in decorative fade-in: immediate at 0 ms and under reduced motion.
    property <bool> entered: false;
    // Opacity is first read here, at 0, so setting `entered` animates it;
    // `init` would set it before that first read and nothing would fade.
    Timer { interval: 1ms; running: !root.entered && root.opacity < 1; triggered => { root.entered = true; } }
    opacity: StyleTokens.popup-duration == 0ms || self.entered ? 1 : 0;
    animate opacity { duration: StyleTokens.popup-duration; easing: ease-out; }
    background: surface; border-radius: StyleTokens.radius * 0.9; border-width: StyleTokens.line-width; border-color: accent;
    accessible-role: region; accessible-label: "Sticker picker";
    FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); accept } else { reject }
        }
        if !root.narrow : VerticalLayout {
            padding: 8px; spacing: 6px;
            HorizontalLayout {
                height: root.field-height; spacing: 6px;
                StickerSearchField {
                    horizontal-stretch: 1;
                    query <=> root.query; can-send: root.can-send; has-current: root.has-current;
                    elevated: root.elevated; ink: root.ink; muted: root.muted; text-scale: root.text-scale;
                    searched(text) => { root.searched(text); }
                    navigate(offset) => { root.navigate(offset); }
                    send-current => { root.send(root.items[root.current].key); }
                    dismiss => { root.dismiss(); }
                }
                if root.packs.length > 1 : TokenSelect {
                    width: 160px * root.text-scale;
                    model: root.packs;
                    current-index <=> root.pack-index;
                    colors: root.select-colors;
                    text-scale: root.text-scale;
                    accessible-label: "Sticker pack";
                    selected(value) => { root.choose-pack(self.current-index); }
                }
                IconAction {
                    width: 30px * root.text-scale; icon: "×"; label: "Close sticker picker";
                    ink: root.muted; surface: root.surface; hover-surface: root.hover;
                    activated => { root.dismiss(); }
                }
            }
            if root.needs-consent : StickerConsent {
                stacked: false; ready: root.phase == 1;
                elevated: root.elevated; outline: root.outline; surface: root.surface; hover: root.hover;
                ink: root.ink; muted: root.muted; text-scale: root.text-scale;
                consent(allowed) => { root.consent(allowed); }
            }
            Text {
                text: root.selected-text;
                color: root.ink; font-size: 11px * root.text-scale; wrap: word-wrap;
                accessible-live-region: polite;
            }
            HorizontalLayout {
                vertical-stretch: 1; spacing: 8px;
                StickerList {
                    horizontal-stretch: 1;
                    items: root.items; current: root.current; row-height: root.row-height;
                    surface: root.surface; hover: root.hover; ink: root.ink; muted: root.muted; accent: root.accent;
                    text-scale: root.text-scale;
                    highlight(key) => { root.highlight(key); }
                    dismiss => { root.dismiss(); }
                }
                StickerPreviewBox {
                    width: 132px * root.text-scale;
                    preview: root.preview; loaded: root.preview-loaded; status: root.preview-status;
                    label: root.current-label; elevated: root.elevated; muted: root.muted; text-scale: root.text-scale;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Arrows choose · Enter sends · Escape closes"; color: root.muted;
                    font-size: 10px * root.text-scale; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1;
                }
                TextAction {
                    text: "Send sticker"; ink: root.ink; muted: root.muted;
                    surface: root.surface; hover-surface: root.hover; outline: root.outline; text-scale: root.text-scale;
                    enabled: root.has-current && root.can-send;
                    activated => { root.send(root.items[root.current].key); }
                }
            }
        }
        if root.narrow : VerticalLayout {
            padding: 6px; spacing: 6px;
            controls := ScrollView {
                height: min(controls-content.preferred-height, root.height * 0.6);
                content-width: self.visible-width;
                content-height: controls-content.preferred-height;
                content-x: 0px;
                horizontal-scrollbar-policy: always-off;
                controls-content := VerticalLayout {
                    x: 0px; y: 0px;
                    width: controls.visible-width;
                    height: self.preferred-height;
                    // Leave room for styles whose vertical scrollbar overlays the viewport.
                    padding-right: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        height: root.field-height; spacing: 6px;
                        StickerSearchField {
                            horizontal-stretch: 1;
                            query <=> root.query; can-send: root.can-send; has-current: root.has-current;
                            elevated: root.elevated; ink: root.ink; muted: root.muted; text-scale: root.text-scale;
                            searched(text) => { root.searched(text); }
                            navigate(offset) => { root.navigate(offset); }
                            send-current => { root.send(root.items[root.current].key); }
                            dismiss => { root.dismiss(); }
                        }
                        IconAction {
                            width: 30px * root.text-scale; icon: "×"; label: "Close sticker picker";
                            ink: root.muted; surface: root.surface; hover-surface: root.hover;
                            activated => { root.dismiss(); }
                        }
                    }
                    if root.packs.length > 1 : TokenSelect {
                        height: root.field-height;
                        model: root.packs;
                        current-index <=> root.pack-index;
                        colors: root.select-colors;
                        text-scale: root.text-scale;
                        accessible-label: "Sticker pack";
                        selected(value) => { root.choose-pack(self.current-index); }
                    }
                    if root.needs-consent : StickerConsent {
                        stacked: true; ready: root.phase == 1;
                        elevated: root.elevated; outline: root.outline; surface: root.surface; hover: root.hover;
                        ink: root.ink; muted: root.muted; text-scale: root.text-scale;
                        consent(allowed) => { root.consent(allowed); }
                    }
                    // Measured at its allocated width, so the scroll extent
                    // covers the wrapped text and the controls below it.
                    Rectangle {
                        height: narrow-status.height;
                        narrow-status := Text {
                            width: parent.width; height: self.preferred-height;
                            text: root.selected-text;
                            color: root.ink; font-size: 11px * root.text-scale; wrap: word-wrap;
                            accessible-live-region: polite;
                        }
                    }
                    StickerPreviewBox {
                        height: min(96px, 56px * root.text-scale);
                        preview: root.preview; loaded: root.preview-loaded; status: root.preview-status;
                        label: root.current-label; elevated: root.elevated; muted: root.muted; text-scale: root.text-scale;
                    }
                    TextAction {
                        wrap-caption: true;
                        text: "Send sticker"; ink: root.ink; muted: root.muted;
                        surface: root.surface; hover-surface: root.hover; outline: root.outline; text-scale: root.text-scale;
                        enabled: root.has-current && root.can-send;
                        activated => { root.send(root.items[root.current].key); }
                    }
                }
            }
            StickerList {
                vertical-stretch: 1; min-height: root.row-height;
                items: root.items; current: root.current; row-height: root.row-height;
                surface: root.surface; hover: root.hover; ink: root.ink; muted: root.muted; accent: root.accent;
                text-scale: root.text-scale;
                highlight(key) => { root.highlight(key); }
                dismiss => { root.dismiss(); }
            }
        }
    }
}

// The held send and the one tracked sticker send for the visible composer.
// Cancel and Retry act on the exact queued request; nothing here enqueues a
// second sticker. The status wraps rather than eliding, and a held send is
// lifted only by confirming the conversation was checked, never by a plain
// dismissal.
component StickerSendStatus inherits Rectangle {
    in property <string> status;
    in property <bool> can-cancel;
    in property <bool> can-retry;
    in property <bool> uncertain;
    in property <color> surface;
    in property <color> hover;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    callback cancel();
    callback retry();
    callback dismiss();
    property <length> action-height: max(30px, 32px * root.text-scale) + StyleTokens.icon-button-growth;
    height: message.y + message.height + 4px + root.action-height + 6px;
    background: surface; border-radius: StyleTokens.radius * 0.6;
    message := Text {
        x: 8px; y: 6px; width: root.width - 16px; height: self.preferred-height;
        text: root.status; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
        accessible-label: "Sticker send status: " + root.status; accessible-live-region: polite;
    }
    HorizontalLayout {
        x: 8px; y: message.y + message.height + 4px;
        width: root.width - 16px; height: root.action-height;
        alignment: end; spacing: 6px;
        if root.can-retry : IconAction {
            width: 27px * root.text-scale; icon: "↻"; label: "Retry this sticker";
            ink: root.accent; surface: transparent; hover-surface: root.hover;
            activated => { root.retry(); }
        }
        if root.can-cancel : IconAction {
            width: 27px * root.text-scale; icon: "×"; label: "Cancel this sticker";
            ink: root.muted; surface: transparent; hover-surface: root.hover;
            activated => { root.cancel(); }
        }
        if !root.can-cancel && !root.uncertain : IconAction {
            width: 27px * root.text-scale; icon: "✓"; label: "Dismiss sticker status";
            ink: root.muted; surface: transparent; hover-surface: root.hover;
            activated => { root.dismiss(); }
        }
        if root.uncertain : TextAction {
            text: "I checked"; ink: root.ink; muted: root.muted;
            surface: root.surface; hover-surface: root.hover; outline: root.outline; text-scale: root.text-scale;
            accessible-label: "I checked the conversation: allow sending stickers again";
            activated => { root.dismiss(); }
        }
    }
}

// Every registry shortcut action with its combination. Activating a binding
// records the next combination pressed; Escape or Tab cancels without a
// trap. A combination can also be typed. Each change saves at once, and a
// conflict names the other action instead of saving.
component ShortcutEditor inherits VerticalLayout {
    in property <[ShortcutItem]> items;
    in-out property <string> filter;
    in property <string> recording;
    in property <string> message;
    in property <bool> message-error;
    in property <bool> can-undo;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    callback filter-edited(string);
    callback record(string);
    callback cancel-recording();
    callback recorded(string, string, bool, bool, bool, bool) -> bool;
    callback typed(string, string);
    callback disable(string);
    callback use-default(string);
    callback undo();
    callback restore-defaults();
    out property <bool> has-focus: filter-input.has-focus;
    // The action whose record button takes focus back when recording ends.
    property <string> return-focus;
    forward-focus: filter-input;
    spacing: 6px;
    alignment: start;
    Rectangle {
        height: max(36px, 30px * root.text-scale);
        background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.surface;
        border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.7;
        border-width: filter-input.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
        border-color: filter-input.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent)
            : StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.outline;
        if root.filter == "" : Text {
            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
            text: "Filter shortcuts: panel, composer, Mod+K…"; color: root.muted;
            font-size: 12px * root.text-scale; vertical-alignment: center; overflow: elide;
        }
        filter-input := ThemedTextInput {
            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
            text <=> root.filter; single-line: true;
            color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center;
            accessible-label: "Filter keyboard shortcuts by action, group or combination";
            edited => { root.filter-edited(self.text); }
        }
    }
    if root.items.length == 0 : Text {
        text: "No shortcuts match. Try another word."; color: root.muted;
        font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite;
    }
    for item in root.items : VerticalLayout {
        spacing: 4px; padding-top: 4px; padding-bottom: 4px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1; alignment: center; spacing: 2px;
                Text { text: item.label; color: root.ink; font-size: 12px * root.text-scale; wrap: word-wrap; }
                Text {
                    text: item.group + (item.customized ? " · default " + (item.default-binding == "" ? "none" : item.default-binding) : "");
                    color: root.muted; font-size: 10px * root.text-scale; wrap: word-wrap;
                }
            }
            if root.recording != item.action : TextAction {
                text: item.binding == "" ? "Disabled" : item.binding;
                label: item.label + " shortcut, " + (item.binding == "" ? "disabled" : item.binding) + ". Activate to record a new combination";
                ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                outline: root.outline; text-scale: root.text-scale;
                // Recording ended from this row: focus comes back here.
                init => {
                    if root.return-focus == item.action {
                        root.return-focus = "";
                        self.focus();
                    }
                }
                activated => { root.record(item.action); }
            }
            if root.recording == item.action : FocusScope {
                min-width: 180px * root.text-scale; height: max(32px, 32px * root.text-scale);
                accessible-role: text-input;
                accessible-label: "Recording a shortcut for " + item.label + ". Press the new combination, or Escape to cancel";
                focus-on-tab-navigation: false;
                init => { self.focus(); }
                // Escape and Tab cancel and return focus to this row's button,
                // so focus is never trapped and the next Tab moves on.
                key-pressed(event) => {
                    if event.text == Key.Escape || event.text == Key.Tab || event.text == Key.Backtab {
                        root.return-focus = item.action;
                        root.cancel-recording();
                        accept
                    } else if root.recorded(item.action, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) {
                        if root.recording != item.action { root.return-focus = item.action; }
                        accept
                    } else { reject }
                }
                // Clicking elsewhere ends recording, which pauses every shortcut.
                // Switching windows keeps it, and focus comes back here.
                focus-lost(reason) => {
                    if reason != FocusReason.window-activation && root.recording == item.action {
                        root.cancel-recording();
                    }
                }
                Rectangle {
                    background: root.surface;
                    border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.7;
                    border-width: StyleTokens.focus-width;
                    border-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent;
                    Text {
                        x: StyleTokens.control-padding; width: parent.width - 2 * StyleTokens.control-padding; height: parent.height;
                        text: "Press keys… Esc cancels"; color: root.ink;
                        font-size: 12px * root.text-scale; vertical-alignment: center; overflow: elide;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px; alignment: start;
            Rectangle {
                width: 170px * root.text-scale; height: max(32px, 28px * root.text-scale);
                background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.surface;
                border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.7;
                border-width: typed-field.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
                border-color: typed-field.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent)
                    : StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.outline;
                if typed-field.text == "" : Text {
                    x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
                    text: "Type, e.g. Mod+Shift+K"; color: root.muted;
                    font-size: 11px * root.text-scale; vertical-alignment: center; overflow: elide;
                }
                typed-field := ThemedTextInput {
                    x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
                    single-line: true; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center;
                    accessible-label: "Type a combination for " + item.label + "; Enter applies";
                    accepted => {
                        root.typed(item.action, self.text);
                        self.text = "";
                    }
                }
            }
            if item.binding != item.default-binding : TextAction {
                text: "Default"; label: "Use the default shortcut for " + item.label + (item.default-binding == "" ? "" : ", " + item.default-binding);
                ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                outline: root.outline; text-scale: root.text-scale;
                // This button disappears once used; keep focus in the row.
                activated => { typed-field.focus(); root.use-default(item.action); }
            }
            if item.binding != "" : TextAction {
                text: "Disable"; label: "Disable the shortcut for " + item.label;
                ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                outline: root.outline; text-scale: root.text-scale;
                activated => { typed-field.focus(); root.disable(item.action); }
            }
        }
    }
    if root.message != "" : Text {
        text: root.message;
        color: root.message-error ? (StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b)
            : (StyleTokens.roles.success.present ? StyleTokens.roles.success.color : root.ink);
        font-size: 12px * root.text-scale; wrap: word-wrap;
        accessible-live-region: polite;
    }
    HorizontalLayout {
        spacing: 8px; alignment: start;
        if root.can-undo : TextAction {
            text: "Undo"; label: "Undo the last shortcut change";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            // Undo disappears once used; focus returns to the filter.
            activated => { filter-input.focus(); root.undo(); }
        }
        TextAction {
            text: "Restore all defaults"; label: "Restore every shortcut to its default";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.restore-defaults(); }
        }
    }
}

component StyleNumberSetting inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <int> minimum;
    in property <int> maximum;
    in property <int> step: 1;
    // Shown after the value: " px" for lengths, "" for a unitless value such
    // as a font weight, " ms" for a duration, "%" for a percentage.
    in property <string> suffix: " px";
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <float> text-scale: 1;
    // The built-in value; a Default action appears while the value differs.
    // Negative offers no such action.
    in property <int> default-value: -1;
    callback changed-value(int);
    property <bool> reset-focused: false;
    out property <bool> has-focus: decrease.has-focus || increase.has-focus || root.reset-focused;
    // At its minimum the decrease action is disabled; focus the other one.
    public function focus-control() {
        if root.value > root.minimum { decrease.focus(); } else { increase.focus(); }
    }
    height: max(58px, 34px * root.text-scale + 20px) + StyleTokens.icon-button-growth;
    background: surface; border-radius: StyleTokens.radius;
    forward-focus: decrease;
    HorizontalLayout {
        padding: 10px; spacing: 8px;
        Text { text: root.label; color: root.ink; font-size: 12px * root.text-scale;
            vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
        Text { text: root.value + root.suffix; color: root.muted; font-size: 11px * root.text-scale; vertical-alignment: center; }
        decrease := IconAction { icon: "−"; label: "Decrease " + root.label; ink: root.ink; surface: root.surface; hover-surface: root.hover-surface;
            enabled: root.value > root.minimum; activated => { root.changed-value(max(root.minimum, root.value - root.step)); } }
        increase := IconAction { icon: "+"; label: "Increase " + root.label; ink: root.ink; surface: root.surface; hover-surface: root.hover-surface;
            enabled: root.value < root.maximum; activated => { root.changed-value(min(root.maximum, root.value + root.step)); } }
        if root.default-value >= 0 && root.value != root.default-value : VerticalLayout {
            alignment: center;
            TextAction {
                text: "Default";
                label: "Reset " + root.label + " to its default, " + root.default-value + root.suffix;
                ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                outline: root.muted.transparentize(0.6); text-scale: root.text-scale;
                focus-state-changed(focused) => { root.reset-focused = focused; }
                // This action disappears once the value is the default, so the
                // stepper takes focus first and the row keeps it.
                activated => {
                    root.reset-focused = false;
                    root.focus-control();
                    root.changed-value(root.default-value);
                }
            }
        }
    }
}

component StyleFontSetting inherits Rectangle {
    in property <string> label;
    in-out property <string> family;
    in property <color> ink;
    in property <color> surface;
    in property <color> accent;
    in property <float> text-scale: 1;
    height: 74px * root.text-scale;
    forward-focus: input;
    out property <bool> has-focus: input.has-focus;
    VerticalLayout {
        spacing: 7px;
        Text { text: root.label; color: root.ink; font-size: 12px * root.text-scale; wrap: word-wrap; }
        Rectangle {
            height: 38px * root.text-scale; background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.surface; border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.7;
            border-width: input.has-focus ? StyleTokens.focus-width : 0px; border-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent;
            input := ThemedTextInput {
                x: StyleTokens.input-padding; width: max(0px, parent.width - 2 * StyleTokens.input-padding); height: parent.height;
                text <=> root.family; single-line: true;
                color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center;
                accessible-label: root.label;
            }
        }
    }
}

// The installed font browser for one font role, inside the Fonts card: a
// search, a monospaced filter, the generic names and the installed families
// (Rust bounds the list), and a sample of the previewed family at the
// role's own size and weight. Choosing writes the role through the normal
// Settings path. Nothing here animates.
component FontBrowser inherits VerticalLayout {
    in property <string> title;
    in property <string> current;
    in property <bool> current-missing;
    in property <[FontFamilyItem]> items;
    in property <string> status;
    in property <string> notice;
    in property <string> previewed;
    in property <string> sample-family;
    in property <int> sample-size: 13;
    in property <int> sample-weight: 400;
    in property <string> sample-text;
    in property <string> sample-label;
    in property <bool> monospace-only;
    // Message and composer fonts follow another role; the others return to
    // their built-in family.
    in property <bool> can-follow;
    in-out property <string> query;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    callback query-edited(string);
    callback monospace-toggled();
    callback preview(string);
    callback choose(string);
    callback follow();
    callback reread();
    callback dismiss();
    forward-focus: search;
    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.title; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700;
            vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap;
        }
        TextAction {
            text: "Close"; label: "Close the font list";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.dismiss(); }
        }
    }
    Text { text: root.current; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
    if root.current-missing : Text {
        text: "That family is not in this app's font list. It is kept as typed, and the renderer uses a fallback. Restart Morpheus after installing or removing system fonts.";
        color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : root.ink;
        font-size: 11px * root.text-scale; wrap: word-wrap;
    }
    Rectangle {
        height: 34px * root.text-scale;
        background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.surface;
        border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.7;
        border-width: search.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
        border-color: search.has-focus && StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : search.has-focus ? root.accent : root.outline;
        search := ThemedTextInput {
            x: StyleTokens.input-padding; width: max(0px, parent.width - 2 * StyleTokens.input-padding); height: parent.height;
            text <=> root.query; single-line: true;
            color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center;
            accessible-label: "Search installed font families";
            edited => { root.query-edited(self.text); }
        }
    }
    HorizontalLayout {
        spacing: 8px; alignment: start;
        TextAction {
            text: root.monospace-only ? "Monospaced only: on" : "Monospaced only: off";
            label: "Show only monospaced families" + (root.monospace-only ? ", on" : ", off");
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.monospace-only ? root.accent : root.outline; text-scale: root.text-scale;
            activated => { root.monospace-toggled(); }
        }
        TextAction {
            text: "Refresh cached list"; label: "Read the font families already known to this app again";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.reread(); }
        }
    }
    Text { text: root.status; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
    Text {
        text: "Restart Morpheus after installing or removing system fonts. Refresh reads the app's existing font list.";
        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
    }
    ListView {
        height: min(240px * root.text-scale, max(48px * root.text-scale, root.items.length * 40px * root.text-scale));
        for item in root.items : TextAction {
            height: 38px * root.text-scale;
            text: item.name + (item.detail != "" ? " · " + item.detail : "");
            label: "Font " + item.name + (item.current ? ", in use" : "") + (item.name == root.previewed ? ", previewed" : "");
            ink: root.ink; muted: root.muted;
            surface: item.name == root.previewed ? root.hover-surface : root.surface;
            hover-surface: root.hover-surface; outline: item.current ? root.accent : root.outline;
            text-scale: root.text-scale;
            activated => { root.preview(item.name); }
        }
    }
    Rectangle {
        height: sample.preferred-height + 20px;
        background: root.surface;
        border-radius: StyleTokens.radius; border-width: StyleTokens.line-width; border-color: root.outline;
        sample := Text {
            x: 10px; y: 10px; width: parent.width - 20px;
            text: root.sample-text; font-family: root.sample-family;
            font-size: root.sample-size * 1px * root.text-scale; font-weight: root.sample-weight;
            color: root.ink; wrap: word-wrap;
            accessible-label: "Sample of " + root.sample-label;
        }
    }
    Text { text: root.sample-label; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px; alignment: start;
        TextAction {
            text: "Use " + root.previewed; label: "Use " + root.previewed + " for this font";
            enabled: root.previewed != "";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.accent; text-scale: root.text-scale;
            activated => { root.choose(root.previewed); }
        }
        TextAction {
            text: root.can-follow ? "Follow the inherited font" : "Use the built-in font";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.follow(); }
        }
    }
    if root.notice != "" : Text {
        text: root.notice; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
        accessible-live-region: polite;
    }
}

// Pinned Settings search. Up and Down move the highlighted result, Enter
// reveals it and Escape clears the query. Choosing a result only reveals and
// focuses its control; it never changes a setting.
component SettingsSearchBar inherits VerticalLayout {
    in-out property <string> query;
    in property <[SettingsResult]> results;
    in-out property <int> index;
    in property <bool> dismissed;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    in property <string> key-font-family;
    // Results scroll inside this height, so the field and Settings below
    // stay reachable at large text and small windows.
    in property <length> max-results-height: 240px;
    callback search(string);
    callback choose(string);
    // Show the results of the current query again, keeping the highlight.
    callback reopen();
    property <bool> open: root.query != "" && !root.dismissed;
    // A result was chosen; its list can be shown again without retyping.
    out property <bool> can-return: root.query != "" && root.dismissed;
    forward-focus: input;
    spacing: 4px;
    alignment: start;
    function pick() {
        if root.index >= 0 && root.index < root.results.length {
            root.choose(root.results[root.index].id);
        }
    }
    Rectangle {
        height: max(40px, 32px * root.text-scale);
        background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.surface;
        border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.8;
        border-width: input.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
        border-color: input.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent) : StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.outline;
        MorpheusIcon {
            x: StyleTokens.input-padding; y: (parent.height - self.height) / 2; width: 16px; height: 16px;
            icon: "search"; ink: root.muted;
        }
        if root.query == "" : Text {
            x: StyleTokens.input-padding + 24px; width: parent.width - 2 * StyleTokens.input-padding - 24px; height: parent.height;
            text: "Search settings: colors, fonts, transparency, password…";
            color: root.muted; font-size: 12px * root.text-scale; vertical-alignment: center; overflow: elide;
        }
        // Capture navigation keys before the text field edits with them.
        keys := FocusScope {
            x: StyleTokens.input-padding + 24px; width: parent.width - 2 * StyleTokens.input-padding - 24px; height: parent.height;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            capture-key-pressed(event) => {
                if event.text == Key.DownArrow && root.can-return {
                    root.reopen();
                    accept
                } else if event.text == Key.DownArrow && root.open && root.results.length > 0 {
                    root.index = min(root.index + 1, root.results.length - 1);
                    accept
                } else if event.text == Key.UpArrow && root.open && root.results.length > 0 {
                    root.index = max(root.index - 1, 0);
                    accept
                } else if event.text == Key.Escape && root.query != "" {
                    root.query = "";
                    root.search("");
                    accept
                } else { reject }
            }
            input := ThemedTextInput {
                width: parent.width; height: parent.height;
                text <=> root.query; single-line: true;
                color: root.ink; font-size: 13px * root.text-scale; vertical-alignment: center;
                accessible-label: "Search settings";
                accessible-description: root.open && root.results.length > 0 && root.index >= 0 && root.index < root.results.length
                    ? root.results[root.index].label + ", " + root.results[root.index].breadcrumb
                        + (root.results[root.index].key != "" ? ", in config.toml " + root.results[root.index].key : "")
                    : root.can-return ? "Press Down to show the results again" : "";
                edited => { root.search(self.text); }
                accepted => { root.pick(); }
            }
        }
    }
    // Choosing a result moves focus to its control; this brings the list back.
    if root.can-return : HorizontalLayout {
        alignment: start;
        TextAction {
            text: "Back to results";
            label: "Back to the results for " + root.query;
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.reopen(); }
        }
    }
    if root.open && root.results.length == 0 : Text {
        text: "No matching settings. Try another word, such as color, font or password.";
        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
        accessible-live-region: polite;
    }
    if root.open && root.results.length > 0 : results-scroll := ScrollView {
        height: min(results-content.preferred-height, root.max-results-height);
        horizontal-scrollbar-policy: always-off;
        // Keep the highlighted row inside the visible part of the list.
        function reveal-row(top: length, height: length) {
            if top < -self.content-y {
                self.content-y = -top;
            } else if top + height > -self.content-y + self.visible-height {
                self.content-y = -(top + height - self.visible-height);
            }
        }
        results-content := VerticalLayout {
        width: results-scroll.visible-width;
        spacing: 2px; alignment: start;
        for result[i] in root.results : ActionRect {
            property <bool> highlighted: i == root.index;
            changed highlighted => {
                if self.highlighted { results-scroll.reveal-row(self.y, self.height); }
            }
            min-height: max(44px, label-text.preferred-height + trail-text.preferred-height + 14px
                + (result.key != "" ? key-text.preferred-height + 2px : 0px));
            label: result.label + ", " + result.breadcrumb + ". " + result.description
                + (result.key != "" ? " In config.toml: " + result.key + "." : "");
            background: i == root.index ? root.hover-surface
                : self.has-hover ? (StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover-surface) : transparent;
            border-radius: StyleTokens.radius * 0.6;
            border-width: i == root.index ? StyleTokens.line-width : 0px;
            border-color: root.accent;
            focus-color: root.accent;
            activated => { root.index = i; root.choose(result.id); }
            VerticalLayout {
                padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px; spacing: 2px;
                label-text := Text { text: result.label; color: root.ink; font-size: 12px * root.text-scale; font-weight: 650; wrap: word-wrap; }
                trail-text := Text { text: result.breadcrumb; color: root.muted; font-size: 10px * root.text-scale; wrap: word-wrap; }
                // Shown for exact fields, so the matching config.toml key is discoverable.
                key-text := Text {
                    visible: result.key != "";
                    height: result.key != "" ? self.preferred-height : 0px;
                    text: result.key;
                    color: root.muted; font-family: root.key-font-family; font-size: 10px * root.text-scale; wrap: word-wrap;
                    accessible-role: none;
                }
            }
        }
        }
    }
}

// Color groups, a filter over every token and the tokens shown. Choosing a
// token opens it in the editor; nothing changes until a valid value is typed.
component ColorTokenList inherits VerticalLayout {
    in property <[ColorGroupItem]> groups;
    in property <[ColorTokenItem]> tokens;
    in property <int> group-index;
    in property <string> selected-id;
    in-out property <string> filter;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    // The groups and tokens scroll inside this height, so the editor stays
    // close to the list at narrow widths and large text.
    in property <length> max-list-height: 320px;
    out property <bool> has-focus: filter-input.has-focus;
    pure callback color-of(string) -> color;
    callback filter-edited(string);
    callback group-chosen(int);
    callback token-chosen(string);
    forward-focus: filter-input;
    spacing: 4px;
    alignment: start;
    Rectangle {
        height: max(36px, 30px * root.text-scale);
        background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.surface; border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.7;
        border-width: filter-input.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
        border-color: filter-input.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent) : StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.outline;
        if root.filter == "" : Text {
            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
            text: "Filter colors: link, badge, backdrop…"; color: root.muted;
            font-size: 12px * root.text-scale; vertical-alignment: center; overflow: elide;
        }
        filter-input := ThemedTextInput {
            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
            text <=> root.filter; single-line: true;
            color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center;
            accessible-label: "Filter colors by name";
            edited => { root.filter-edited(self.text); }
        }
    }
    list-scroll := ScrollView {
        height: min(list-content.preferred-height, root.max-list-height);
        horizontal-scrollbar-policy: always-off;
        accessible-role: list;
        accessible-label: "Colors to edit";
        // A row that takes keyboard focus is scrolled into view by Slint in
        // this list and in the Settings page alike.
        list-content := VerticalLayout {
    width: list-scroll.visible-width;
    spacing: 2px; alignment: start;
    if root.filter == "" : VerticalLayout {
        spacing: 2px; alignment: start;
        for group[index] in root.groups : ActionRect {
            height: max(32px, 26px * root.text-scale);
            label: group.label + (index == root.group-index ? ", selected" : "");
            background: index == root.group-index ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover-surface)
                : self.has-hover ? (StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover-surface) : transparent;
            border-radius: StyleTokens.radius * 0.6; focus-color: root.accent;
            activated => { root.group-chosen(index); }
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 6px;
                Text {
                    text: group.label;
                    color: index == root.group-index && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink;
                    font-size: 12px * root.text-scale; font-weight: index == root.group-index ? 700 : 500;
                    vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                }
                Text { text: group.window ? "" : ("" + group.count); color: root.muted; font-size: 11px * root.text-scale; vertical-alignment: center; }
            }
        }
    }
    Rectangle { height: StyleTokens.line-width; background: root.outline; }
    if root.tokens.length == 0 : Text {
        text: "No colors match. Try another word."; color: root.muted;
        font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite;
    }
    for token in root.tokens : ActionRect {
        height: max(36px, 30px * root.text-scale);
        label: token.label + (token.overridden ? ", customized" : "") + (token.id == root.selected-id ? ", selected" : "");
        background: token.id == root.selected-id ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover-surface)
            : self.has-hover ? (StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover-surface) : transparent;
        border-radius: StyleTokens.radius * 0.6; focus-color: root.accent;
        activated => { root.token-chosen(token.id); }
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px; spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 18px; height: 18px; border-radius: 4px;
                    border-width: StyleTokens.line-width; border-color: root.outline; background: root.color-of(token.id);
                }
            }
            Text {
                text: token.label;
                color: token.id == root.selected-id && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink;
                font-size: 12px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
            }
            if token.overridden : Text { text: "edited"; color: root.muted; font-size: 10px * root.text-scale; vertical-alignment: center; }
        }
    }
        }
    }
}

// The one selected color. A valid #RRGGBB or #RRGGBBAA value applies and
// saves at once; partial or invalid input only shows a hint and the last
// valid color stays applied. Escape restores the field to the shown color.
component ColorTokenEditor inherits VerticalLayout {
    in property <ColorEditorState> state;
    in property <color> swatch;
    in-out property <string> hex;
    in property <int> override-count;
    in property <string> reset-all-notice;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    callback hex-edited(string);
    callback restore-input();
    callback reset();
    callback undo();
    callback reset-all();
    out property <bool> has-focus: hex-input.has-focus;
    forward-focus: hex-input;
    spacing: 8px;
    alignment: start;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 52px; height: 52px; border-radius: StyleTokens.radius * 0.8;
                border-width: StyleTokens.line-width; border-color: root.outline; background: root.swatch;
                accessible-role: image; accessible-label: "Current color of " + root.state.label;
            }
        }
        VerticalLayout {
            alignment: start; spacing: 3px; horizontal-stretch: 1;
            Text { text: root.state.label; color: root.ink; font-size: 14px * root.text-scale; font-weight: 700; wrap: word-wrap; }
            Text { text: root.state.group + " · " + root.state.source; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
        }
    }
    Text { text: root.state.description; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
    if root.state.contrast != "" : Text {
        text: root.state.contrast; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; min-width: 0px;
    }
    Rectangle {
        height: max(38px, 32px * root.text-scale);
        background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.surface; border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.7;
        border-width: hex-input.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
        border-color: hex-input.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent) : StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.outline;
        FocusScope {
            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.restore-input(); accept } else { reject }
            }
            hex-input := ThemedTextInput {
                width: parent.width; height: parent.height;
                text <=> root.hex; single-line: true;
                color: root.ink; font-size: 13px * root.text-scale; vertical-alignment: center;
                accessible-label: "Hex color for " + root.state.label + ", #RRGGBB or #RRGGBBAA";
                accessible-description: root.state.hint;
                edited => { root.hex-edited(self.text); }
                accepted => { root.hex-edited(self.text); }
            }
        }
    }
    if root.state.hint != "" : Text {
        text: root.state.hint; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
        accessible-live-region: polite;
    }
    HorizontalLayout {
        spacing: 8px; alignment: start;
        if root.state.overridden : TextAction {
            text: "Reset"; label: "Reset " + root.state.label + " to its theme or built-in color";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.reset(); }
        }
        if root.state.can-undo : TextAction {
            text: "Undo"; label: "Undo the last change to " + root.state.label;
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.undo(); }
        }
    }
    Text { text: "Advanced: key " + root.state.id + " in the [colors] table of config.toml"; color: root.muted; font-size: 10px * root.text-scale; wrap: word-wrap; }
    if root.override-count > 0 || root.reset-all-notice != "" : TextAction {
        wrap-caption: true;
        text: root.reset-all-notice != "" ? root.reset-all-notice : "Reset all " + root.override-count + " customized colors";
        ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
        outline: root.outline; text-scale: root.text-scale;
        activated => { root.reset-all(); }
    }
}

// Metric groups, a filter over every metric and the metrics shown. Choosing
// one opens it in the editor; nothing changes until a value is applied.
component MetricList inherits VerticalLayout {
    in property <[MetricGroupItem]> groups;
    in property <[MetricItem]> items;
    in property <int> group-index;
    in property <string> selected-key;
    in-out property <string> filter;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    // The groups and metrics scroll inside this height, so the editor stays
    // close to the list at narrow widths and large text.
    in property <length> max-list-height: 320px;
    out property <bool> has-focus: filter-input.has-focus;
    callback filter-edited(string);
    callback group-chosen(int);
    callback metric-chosen(string);
    forward-focus: filter-input;
    spacing: 4px;
    alignment: start;
    Rectangle {
        height: max(36px, 30px * root.text-scale);
        background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.surface;
        border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.7;
        border-width: filter-input.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
        border-color: filter-input.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent) : StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.outline;
        if root.filter == "" : Text {
            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
            text: "Filter sizes: border, focus, avatar…"; color: root.muted;
            font-size: 12px * root.text-scale; vertical-alignment: center; overflow: elide;
        }
        filter-input := ThemedTextInput {
            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
            text <=> root.filter; single-line: true;
            color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center;
            accessible-label: "Filter typography and geometry by name";
            edited => { root.filter-edited(self.text); }
        }
    }
    list-scroll := ScrollView {
        height: min(list-content.preferred-height, root.max-list-height);
        horizontal-scrollbar-policy: always-off;
        accessible-role: list;
        accessible-label: "Typography and geometry to edit";
        list-content := VerticalLayout {
            width: list-scroll.visible-width;
            spacing: 2px; alignment: start;
            if root.filter == "" : VerticalLayout {
                spacing: 2px; alignment: start;
                for group[index] in root.groups : ActionRect {
                    height: max(32px, 26px * root.text-scale);
                    label: group.label + (index == root.group-index ? ", selected" : "");
                    background: index == root.group-index ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover-surface)
                        : self.has-hover ? (StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover-surface) : transparent;
                    border-radius: StyleTokens.radius * 0.6; focus-color: root.accent;
                    activated => { root.group-chosen(index); }
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px; spacing: 6px;
                        Text {
                            text: group.label;
                            color: index == root.group-index && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink;
                            font-size: 12px * root.text-scale; font-weight: index == root.group-index ? 700 : 500;
                            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                        }
                        Text { text: "" + group.count; color: root.muted; font-size: 11px * root.text-scale; vertical-alignment: center; }
                    }
                }
            }
            Rectangle { height: StyleTokens.line-width; background: root.outline; }
            if root.items.length == 0 : Text {
                text: "No sizes match. Try another word."; color: root.muted;
                font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite;
            }
            for item in root.items : ActionRect {
                height: max(36px, 30px * root.text-scale);
                label: item.label + ", " + item.value-text + (item.overridden ? ", customized" : "") + (item.key == root.selected-key ? ", selected" : "");
                background: item.key == root.selected-key ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover-surface)
                    : self.has-hover ? (StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover-surface) : transparent;
                border-radius: StyleTokens.radius * 0.6; focus-color: root.accent;
                activated => { root.metric-chosen(item.key); }
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 8px;
                    Text {
                        text: item.label;
                        color: item.key == root.selected-key && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink;
                        font-size: 12px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                    }
                    Text {
                        text: item.value-text;
                        color: item.key == root.selected-key && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.muted;
                        font-size: 11px * root.text-scale; vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// The one selected metric. The steppers apply at once; a typed whole number
// applies with Enter and Escape restores the field. Other input only shows a
// hint, and the last valid value stays applied.
component MetricValueEditor inherits VerticalLayout {
    in property <MetricEditorState> state;
    in-out property <string> value-text;
    in property <int> override-count;
    in property <string> reset-all-notice;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    callback step(int);
    callback edited(string);
    callback accepted(string);
    callback restore-input();
    callback reset();
    callback undo();
    callback reset-all();
    out property <bool> has-focus: value-input.has-focus;
    forward-focus: value-input;
    spacing: 8px;
    alignment: start;
    Text { text: root.state.label; color: root.ink; font-size: 14px * root.text-scale; font-weight: 700; wrap: word-wrap; }
    Text {
        text: root.state.group + " · " + (root.state.inherited ? root.state.inherit-text : root.state.default-text)
            + " · " + root.state.minimum + "–" + root.state.maximum + root.state.suffix;
        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
    }
    Text { text: root.state.description; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px;
        IconAction {
            icon: "−"; label: "Decrease " + root.state.label;
            ink: root.ink; surface: root.surface; hover-surface: root.hover-surface;
            enabled: root.state.value > root.state.minimum;
            activated => { root.step(-1); }
        }
        Rectangle {
            horizontal-stretch: 1;
            height: max(38px, 32px * root.text-scale);
            background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.surface;
            border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.7;
            border-width: value-input.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
            border-color: value-input.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent) : StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.outline;
            if root.value-text == "" : Text {
                x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
                text: root.state.inherit-text; color: root.muted;
                font-size: 12px * root.text-scale; vertical-alignment: center; overflow: elide;
            }
            FocusScope {
                x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                capture-key-pressed(event) => {
                    if event.text == Key.Escape { root.restore-input(); accept } else { reject }
                }
                value-input := ThemedTextInput {
                    width: parent.width; height: parent.height;
                    text <=> root.value-text; single-line: true; input-type: number;
                    color: root.ink; font-size: 13px * root.text-scale; vertical-alignment: center;
                    accessible-label: root.state.label + " in " + root.state.unit-spoken + ", " + root.state.minimum + " to " + root.state.maximum + "; Enter applies";
                    accessible-description: root.state.hint;
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(self.text); }
                }
            }
        }
        Text { text: root.state.suffix; color: root.muted; font-size: 12px * root.text-scale; vertical-alignment: center; }
        IconAction {
            icon: "+"; label: "Increase " + root.state.label;
            ink: root.ink; surface: root.surface; hover-surface: root.hover-surface;
            enabled: root.state.value < root.state.maximum;
            activated => { root.step(1); }
        }
    }
    if root.state.hint != "" : Text {
        text: root.state.hint; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
        accessible-live-region: polite;
    }
    HorizontalLayout {
        spacing: 8px; alignment: start;
        if root.state.overridden : TextAction {
            text: root.state.inherit-text != "" ? "Use built-in" : "Reset to default";
            label: root.state.inherit-text != "" ? "Return " + root.state.label + " to its built-in value" : "Reset " + root.state.label + " to its default";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.reset(); }
        }
        if root.state.can-undo : TextAction {
            text: "Undo"; label: "Undo the last change to " + root.state.label;
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.undo(); }
        }
    }
    Text { text: "Advanced: key " + root.state.key + " in config.toml"; color: root.muted; font-size: 10px * root.text-scale; wrap: word-wrap; }
    if root.override-count > 0 || root.reset-all-notice != "" : TextAction {
        wrap-caption: true;
        text: root.reset-all-notice != "" ? root.reset-all-notice : "Reset all " + root.override-count + " customized sizes";
        ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
        outline: root.outline; text-scale: root.text-scale;
        activated => { root.reset-all(); }
    }
}

// The sample name of one sender color, drawn on the conversation background.
component SenderColorSample inherits Rectangle {
    in property <SenderColorRow> palette-entry;
    in property <color> canvas;
    in property <color> outline;
    in property <string> sample-font-family;
    in property <float> text-scale: 1;
    height: max(34px, 26px * root.text-scale);
    background: root.canvas; border-radius: StyleTokens.radius * 0.6;
    border-width: StyleTokens.line-width; border-color: root.outline;
    Text {
        x: 8px; width: parent.width - 16px; height: parent.height;
        text: "Sample name " + (root.palette-entry.index + 1); color: root.palette-entry.swatch;
        font-family: root.sample-font-family; font-size: 12px * root.text-scale; font-weight: 650;
        vertical-alignment: center; overflow: elide;
        accessible-label: "Sample of sender color " + (root.palette-entry.index + 1) + (root.palette-entry.readable ? "" : ", low contrast on the conversation background");
    }
}

// The contrast note and the order and remove actions of one sender color.
component SenderColorActions inherits HorizontalLayout {
    in property <SenderColorRow> palette-entry;
    in property <int> count;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <float> text-scale: 1;
    callback moved(int, int);
    callback removed(int);
    // Fixed-size actions: the hex field or the sample takes the free width.
    horizontal-stretch: 0;
    spacing: 8px;
    if !root.palette-entry.readable : Text {
        text: "Low contrast"; color: root.muted; font-size: 10px * root.text-scale; vertical-alignment: center;
    }
    IconAction {
        icon: "▲"; label: "Move sender color " + (root.palette-entry.index + 1) + " earlier";
        ink: root.ink; surface: root.surface; hover-surface: root.hover-surface;
        enabled: root.palette-entry.index > 0;
        activated => { root.moved(root.palette-entry.index, -1); }
    }
    IconAction {
        icon: "▼"; label: "Move sender color " + (root.palette-entry.index + 1) + " later";
        ink: root.ink; surface: root.surface; hover-surface: root.hover-surface;
        enabled: root.palette-entry.index < root.count - 1;
        activated => { root.moved(root.palette-entry.index, 1); }
    }
    IconAction {
        icon: "×"; label: "Remove sender color " + (root.palette-entry.index + 1);
        ink: root.ink; surface: root.surface; hover-surface: root.hover-surface;
        enabled: root.count > 1;
        activated => { root.removed(root.palette-entry.index); }
    }
}

// The sender-name palette: one row per slot with a sample name drawn on the
// conversation background, its hex value, reordering and removal. A valid
// value saves at once; partial input only hints. Low contrast is reported
// beside the sample and never corrected.
component SenderPaletteEditor inherits VerticalLayout {
    in property <[SenderColorRow]> rows;
    // Narrow Settings or large text: each row puts its hex field on a line
    // of its own so it stays wide enough to edit.
    in property <bool> stacked: false;
    in property <string> source;
    in property <bool> custom;
    in property <bool> can-undo;
    in property <string> hint;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> accent;
    in property <color> outline;
    // The background the timeline draws names on.
    in property <color> canvas;
    in property <string> sample-font-family;
    in property <float> text-scale: 1;
    callback edited(int, string);
    callback moved(int, int);
    callback removed(int);
    callback added();
    callback reset();
    callback undo();
    out property <bool> has-focus: add-color.has-focus;
    forward-focus: add-color;
    spacing: 6px;
    alignment: start;
    Text { text: root.source; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
    for row in root.rows : VerticalLayout {
        spacing: 6px;
        // Typing replaces the field's binding to the row, so an in-place
        // change (move, undo, reload) is copied in unless the field is being
        // edited, and a value left half typed returns to the saved one.
        property <string> saved-hex: row.hex;
        changed saved-hex => { if !hex-field.has-focus { hex-field.text = self.saved-hex; } }
        HorizontalLayout {
            spacing: 8px;
            if !root.stacked : SenderColorSample {
                width: 128px * root.text-scale;
                palette-entry: row; canvas: root.canvas; outline: root.outline;
                sample-font-family: root.sample-font-family; text-scale: root.text-scale;
            }
            Rectangle {
                horizontal-stretch: 1; height: max(34px, 28px * root.text-scale);
                background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.surface;
                border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.7;
                border-width: hex-field.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
                border-color: hex-field.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent)
                    : StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.outline;
                hex-field := ThemedTextInput {
                    x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
                    text: row.hex; single-line: true;
                    color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center;
                    accessible-label: "Sender color " + (row.index + 1) + " hex, #RRGGBB or #RRGGBBAA";
                    changed has-focus => { if !self.has-focus { self.text = row.hex; } }
                    accessible-description: row.readable ? "" : "Low contrast on the conversation background";
                    edited => { root.edited(row.index, self.text); }
                    accepted => { root.edited(row.index, self.text); }
                }
            }
            if !root.stacked : SenderColorActions {
                palette-entry: row; count: root.rows.length;
                ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                text-scale: root.text-scale;
                moved(index, direction) => { root.moved(index, direction); }
                removed(index) => { root.removed(index); }
            }
        }
        // Narrow Settings or large text: the hex field keeps the whole first
        // line, and the sample and actions share the second.
        if root.stacked : HorizontalLayout {
            spacing: 8px;
            SenderColorSample {
                horizontal-stretch: 1; min-width: 48px; preferred-width: 128px * root.text-scale;
                palette-entry: row; canvas: root.canvas; outline: root.outline;
                sample-font-family: root.sample-font-family; text-scale: root.text-scale;
            }
            SenderColorActions {
                palette-entry: row; count: root.rows.length;
                ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                text-scale: root.text-scale;
                moved(index, direction) => { root.moved(index, direction); }
                removed(index) => { root.removed(index); }
            }
        }
    }
    if root.hint != "" : Text {
        text: root.hint; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
        accessible-live-region: polite;
    }
    HorizontalLayout {
        spacing: 8px; alignment: start;
        add-color := TextAction {
            text: "Add color"; label: "Add a sender color";
            enabled: root.rows.length < 16;
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.added(); }
        }
        if root.can-undo : TextAction {
            text: "Undo"; label: "Undo the last change to sender colors";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.undo(); }
        }
        if root.custom : TextAction {
            text: "Use theme colors"; label: "Remove your sender colors and use the theme's";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.reset(); }
        }
    }
    Text {
        text: "Advanced: [senders] colors in config.toml. Each sender keeps the slot derived from their user ID, so names keep their color in every room; nothing about senders is saved.";
        color: root.muted; font-size: 10px * root.text-scale; wrap: word-wrap;
    }
}

// Native window transparency. The slider previews while dragging and saves
// on release; the number saves when edited. Both edit the same value.
component WindowOpacitySetting inherits VerticalLayout {
    in property <int> value;
    // Bumped after every save attempt so both controls show the saved value,
    // including after a rejected save restored the previous one.
    in property <int> revision;
    in property <string> status;
    in property <color> ink;
    in property <color> muted;
    in property <ControlColors> colors;
    in property <float> text-scale: 1;
    // A value to preview now and save shortly; keyboard and accessibility
    // changes arrive here too.
    callback previewed(int);
    // A value to save now, such as on pointer or key release.
    callback changed-value(int);
    out property <bool> has-focus: slider.has-focus;
    forward-focus: slider;
    spacing: 6px;
    alignment: start;
    changed value => {
        slider.value = root.value;
        number.value = root.value;
    }
    changed revision => {
        slider.value = root.value;
        number.value = root.value;
    }
    Text { text: "Window transparency"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
    Text {
        text: "Lower values let the desktop show through the window's panes. Text, icons, inputs, cards and dialogs stay opaque; sign-in and recovery always stay opaque. Readability then depends on what is behind the window: light text over a bright desktop, or dark text over a dark one, is harder to read, and the contrast advice in the color editor assumes an opaque pane. No blur is added.";
        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 10px;
        slider := TokenSlider {
            horizontal-stretch: 1; minimum: 0; maximum: 100; step: 1;
            value: root.value;
            colors: root.colors; text-scale: root.text-scale;
            accessible-label: "Window background opacity, percent";
            changed(value) => { root.previewed(round(value)); }
            released(value) => { root.changed-value(round(value)); }
        }
        number := SpinBox {
            width: max(96px, 80px * root.text-scale);
            minimum: 0; maximum: 100; value: root.value;
            accessible-label: "Window background opacity, percent, as a number";
            edited(value) => { root.previewed(value); }
        }
        Text { text: "%"; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; }
    }
    Text { text: root.status; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
}

// Saved looks: a filter, the list, the one selected profile with its
// actions, a name field for saving, renaming and copying, and a message.
// Buttons that disappear once used move focus to the filter first.
component StyleProfilesEditor inherits VerticalLayout {
    in property <[StyleProfileItem]> items;
    in-out property <string> filter;
    in property <string> selected-key;
    in property <StyleProfileState> state;
    in-out property <string> name-input;
    in property <string> message;
    in property <bool> message-error;
    in property <bool> busy;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> accent;
    in property <color> outline;
    in property <float> text-scale: 1;
    in property <length> max-list-height: 260px;
    callback filter-edited(string);
    callback chosen(string);
    callback save-current();
    callback rename();
    callback duplicate();
    callback delete-profile();
    callback confirm();
    callback dismiss();
    callback preview();
    callback apply();
    callback cancel-preview();
    callback import-file();
    callback export-file();
    callback refresh();
    out property <bool> has-focus: filter-input.has-focus;
    forward-focus: filter-input;
    spacing: 8px;
    alignment: start;
    Rectangle {
        height: max(36px, 30px * root.text-scale);
        background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.surface;
        border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.7;
        border-width: filter-input.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
        border-color: filter-input.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent)
            : StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.outline;
        if root.filter == "" : Text {
            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
            text: "Filter profiles by name or look: serif, light, columns…"; color: root.muted;
            font-size: 12px * root.text-scale; vertical-alignment: center; overflow: elide;
        }
        filter-input := ThemedTextInput {
            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
            text <=> root.filter; single-line: true;
            color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center;
            accessible-label: "Filter style profiles by name or look";
            edited => { root.filter-edited(self.text); }
        }
    }
    if root.items.length == 0 : Text {
        text: root.filter == "" ? "No style profiles yet. Type a name below and save your current look, or import a profile file."
            : "No profiles match. Try another word.";
        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
        accessible-live-region: polite;
    }
    if root.items.length > 0 : list-scroll := ScrollView {
        height: min(list-content.preferred-height, root.max-list-height);
        horizontal-scrollbar-policy: always-off;
        accessible-role: list;
        accessible-label: "Style profiles";
        list-content := VerticalLayout {
            width: list-scroll.visible-width;
            spacing: 2px; alignment: start;
            for item in root.items : ActionRect {
                height: max(44px, 30px * root.text-scale + 14px);
                label: item.name + ", " + item.detail + (item.current ? ", matches your current look" : "")
                    + (item.key == root.selected-key ? ", selected" : "");
                background: item.key == root.selected-key ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover-surface)
                    : self.has-hover ? (StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover-surface) : transparent;
                border-radius: StyleTokens.radius * 0.6; focus-color: root.accent;
                activated => { root.chosen(item.key); }
                VerticalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 1px; alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: item.name;
                            color: item.key == root.selected-key && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color
                                : item.valid ? root.ink : root.muted;
                            font-size: 12px * root.text-scale; font-weight: item.key == root.selected-key ? 700 : 550;
                            horizontal-stretch: 1; overflow: elide;
                        }
                        if item.current : Text { text: "Current look"; color: root.accent; font-size: 10px * root.text-scale; }
                    }
                    Text { text: item.detail; color: root.muted; font-size: 10px * root.text-scale; overflow: elide; }
                }
            }
        }
    }
    if root.state.key != "" : Rectangle {
        height: detail.preferred-height + 20px;
        background: root.surface;
        border-radius: StyleTokens.radius * 0.8;
        border-width: StyleTokens.line-width; border-color: root.outline;
        detail := VerticalLayout {
            x: 10px; y: 10px; width: parent.width - 20px;
            spacing: 6px; alignment: start;
            Text { text: root.state.name; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; wrap: word-wrap; }
            if root.state.valid : Text {
                text: root.state.summary + (root.state.matches-current ? ". This is your current look." : "");
                color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
            }
            if !root.state.valid : Text {
                text: root.state.problem;
                color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b;
                font-size: 11px * root.text-scale; wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                if !root.state.previewed : TextAction {
                    text: "Preview"; wrap-caption: true; enabled: root.state.valid;
                    label: "Preview " + root.state.name + " without saving it";
                    ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                    outline: root.outline; text-scale: root.text-scale;
                    // This button gives way to Cancel preview; keep focus in the card.
                    activated => { filter-input.focus(); root.preview(); }
                }
                if root.state.previewed : TextAction {
                    text: "Cancel preview"; wrap-caption: true;
                    label: "Cancel the preview and restore your look";
                    ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                    outline: root.outline; text-scale: root.text-scale;
                    activated => { filter-input.focus(); root.cancel-preview(); }
                }
                TextAction {
                    text: "Apply"; wrap-caption: true; enabled: root.state.valid;
                    label: "Apply " + root.state.name + " and save it as your look";
                    ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                    outline: root.accent; text-scale: root.text-scale;
                    activated => { root.apply(); }
                }
                TextAction {
                    text: "Export…"; wrap-caption: true; enabled: root.state.valid && !root.busy;
                    label: "Export " + root.state.name + " to a file you choose";
                    ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                    outline: root.outline; text-scale: root.text-scale;
                    activated => { root.export-file(); }
                }
                TextAction {
                    text: "Delete…"; wrap-caption: true;
                    label: "Delete " + root.state.name;
                    ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                    outline: root.outline; text-scale: root.text-scale;
                    activated => { root.delete-profile(); }
                }
            }
        }
    }
    if root.state.confirm != 0 : Rectangle {
        height: confirm-box.preferred-height + 20px;
        background: root.surface;
        border-radius: StyleTokens.radius * 0.8;
        border-width: StyleTokens.focus-width;
        border-color: root.state.confirm == 1 ? (StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : #e58e9b) : root.accent;
        // The safe choice takes focus; both choices return it to the filter.
        init => { keep.focus(); }
        confirm-box := VerticalLayout {
            x: 10px; y: 10px; width: parent.width - 20px;
            spacing: 8px; alignment: start;
            Text {
                text: root.state.confirm-text; color: root.ink; font-size: 12px * root.text-scale; wrap: word-wrap;
                accessible-live-region: polite;
            }
            HorizontalLayout {
                spacing: 8px;
                TextAction {
                    text: root.state.confirm == 1 ? "Delete" : "Replace"; wrap-caption: true;
                    label: root.state.confirm == 1 ? "Delete the profile" : "Replace the profile with the same name";
                    ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                    outline: root.outline; text-scale: root.text-scale;
                    activated => { filter-input.focus(); root.confirm(); }
                }
                keep := TextAction {
                    text: root.state.confirm == 1 ? "Keep it" : "Cancel"; wrap-caption: true;
                    label: root.state.confirm == 1 ? "Keep the profile" : "Cancel and keep the existing profile";
                    ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
                    outline: root.accent; text-scale: root.text-scale;
                    activated => { filter-input.focus(); root.dismiss(); }
                }
            }
        }
    }
    Text { text: "Name"; color: root.ink; font-size: 12px * root.text-scale; font-weight: 650; }
    Rectangle {
        height: max(36px, 30px * root.text-scale);
        background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.surface;
        border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.7;
        border-width: name-field.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
        border-color: name-field.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent)
            : StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.outline;
        if root.name-input == "" : Text {
            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
            text: "A name for a saved look, up to 48 characters"; color: root.muted;
            font-size: 12px * root.text-scale; vertical-alignment: center; overflow: elide;
        }
        name-field := ThemedTextInput {
            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
            text <=> root.name-input; single-line: true;
            color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center;
            accessible-label: "Style profile name, up to 48 characters";
        }
    }
    HorizontalLayout {
        spacing: 8px;
        TextAction {
            text: "Save current look"; wrap-caption: true; enabled: !root.state.previewing;
            label: "Save your current look as a profile with this name";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.accent; text-scale: root.text-scale;
            activated => { root.save-current(); }
        }
        TextAction {
            text: "Rename"; wrap-caption: true; enabled: root.state.valid;
            label: "Rename the selected profile to this name";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.rename(); }
        }
        TextAction {
            text: "Duplicate"; wrap-caption: true; enabled: root.state.valid;
            label: "Save a copy of the selected profile with this name";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.duplicate(); }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        TextAction {
            text: root.busy ? "File dialog open…" : "Import…"; wrap-caption: true; enabled: !root.busy;
            label: "Import a style profile from a file you choose";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.import-file(); }
        }
        TextAction {
            text: "Refresh list"; wrap-caption: true;
            label: "Reload the list of style profiles";
            ink: root.ink; muted: root.muted; surface: root.surface; hover-surface: root.hover-surface;
            outline: root.outline; text-scale: root.text-scale;
            activated => { root.refresh(); }
        }
    }
    if root.state.truncated : Text {
        text: "Only the first 64 profile files are listed. Delete some to see the rest.";
        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
    }
    if root.message != "" : Text {
        text: root.message;
        color: root.message-error ? (StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b)
            : (StyleTokens.roles.success.present ? StyleTokens.roles.success.color : root.ink);
        font-size: 12px * root.text-scale; wrap: word-wrap;
        accessible-live-region: polite;
    }
    Text {
        text: "A profile holds only your look: theme and theme pack, fonts and sizes, shapes and spacing, message and pane layout, window opacity, colors and sender colors. Text size, Reduce motion, the focus ring, notifications, shortcuts, devices and accounts are never saved in it or changed by it.";
        color: root.muted; font-size: 10px * root.text-scale; wrap: word-wrap;
    }
}

// Separate from AppWindow so a blocked account store exposes no sign-in,
// account switching, preview, file deletion or policy-reset callbacks.
export component StartupErrorWindow inherits Window {
    title: "Morpheus — account recovery";
    preferred-width: 560px;
    preferred-height: 360px;
    min-width: 440px;
    min-height: 340px;
    background: #10131f;
    in property <string> detail;
    callback exit-requested();
    forward-focus: close-button;

    VerticalLayout {
        padding: 28px;
        spacing: 16px;
        Text {
            text: "Morpheus";
            accessible-role: text;
            accessible-label: self.text;
            color: #f2f4ff;
            font-size: 26px;
            font-weight: 750;
        }
        Text {
            text: "Saved accounts could not be opened";
            accessible-role: text;
            accessible-label: self.text;
            color: #c7baff;
            font-size: 18px;
            wrap: word-wrap;
        }
        Text {
            text: root.detail;
            accessible-role: text;
            accessible-label: self.text;
            color: #f2f4ff;
            font-size: 14px;
            wrap: word-wrap;
            vertical-stretch: 1;
        }
        close-button := Button {
            text: "Close Morpheus";
            clicked => { root.exit-requested(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Morpheus";
    preferred-width: 1310px;
    preferred-height: 820px;
    // A fixed floor, never derived from the window width (that would be a
    // layout-info binding cycle). Narrower than the saved panes, the
    // arrangement falls back: details, then the room list, then the Space
    // rail give way; the conversation and the account control always stay.
    min-width: 640px;
    min-height: 620px;

    in-out property <[AccountItem]> accounts;
    in-out property <[AccountOption]> account-options;
    in-out property <[SpaceItem]> spaces;
    in-out property <string> active-space-id;
    in-out property <string> active-space-name: "Home";
    in-out property <[RoomItem]> channels;
    in-out property <[RoomItem]> direct-messages;
    in-out property <[NavigationRoomItem]> combined-rooms;
    // Rooms tagged m.favourite / m.lowpriority, out of the lists above, in
    // tag order (see navigation.rs).
    in-out property <[NavigationRoomItem]> favourite-rooms;
    in-out property <[NavigationRoomItem]> low-priority-rooms;
    out property <int> navigation-mode: 0; // rail or text-first sidebar
    in-out property <bool> show-space-labels: false;
    in-out property <bool> group-direct-messages: true;
    callback choose-navigation-mode(int);
    callback set-show-space-labels(bool);
    callback set-group-direct-messages(bool);
    callback set-reduce-motion(bool);
    property <int> navigation-focus-owner: -1;
    property <string> navigation-focus-token;
    function navigation-focus-changed(owner: int, token: string, focused: bool) {
        if focused {
            root.navigation-focus-owner = owner;
            root.navigation-focus-token = token;
        } else if root.navigation-focus-owner == owner && root.navigation-focus-token == token {
            root.navigation-focus-owner = -1;
            root.navigation-focus-token = "";
        }
    }
    public function apply-navigation-mode(mode: int) {
        if mode != root.navigation-mode && root.navigation-focus-owner == root.navigation-mode
            && !root.show-sign-in && !root.manage-accounts-open && !root.access-open
            && !root.account-menu-open && !root.room-actions-open && !root.room-admin-open
            && !root.member-confirm-open && !root.native-capture-picker-open && !root.leave-call-dialog
