    // Native navigation and protection entries call this before changing
    // their visible state. A changed handler is only a deferred fallback;
    // a leave-and-return in one event batch must still retire the old view.
    public function withdraw-verification() {
        root.clear-room-key-file-inputs();
        root.room-key-file-withdraw();
        root.stop-attachment-audio();
        root.sas-compared = false;
        root.sas-emoji = "";
        root.sas-decimals = "";
        root.verification-protected();
        PeerVerification.protect();
    }
    public function navigate-page(next: int) {
        if next != root.page { root.message-copy-withdraw(); root.stop-attachment-audio(); }
        if next != 1 {
            root.cancel-settings-reveal();
            root.settings-controls-mounted = false;
            root.withdraw-verification();
        }
        root.page = next;
        // Returning in the same event batch can coalesce the deferred context
        // change. Reissue retained notices under their original leases now.
        root.timeline-recovery-context-changed();
    }
