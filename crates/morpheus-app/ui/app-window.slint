                            for reply[index] in root.thread-messages : thread-reply := Rectangle {
                                property <string> time-label: root.message-time-label(reply);
                                // The reply a search hit or a jump opened, highlighted like a
                                // selected conversation row.
                                property <bool> search-hit: reply.event-id != ""
                                    && (reply.event-id == root.room-search-selected-event-id || reply.event-id == root.timeline-jump-event-id);
                                // At least 43 px and never less than its content. A repeated
                                // row's explicit minimum replaces the one its content gives, and
