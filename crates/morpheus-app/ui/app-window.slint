    mention-cursor(threaded, caret, anchor, preedit) => {
        if threaded { root.thread-caret = caret; root.thread-anchor = anchor; root.thread-preedit = preedit; }
        else { root.composer-caret = caret; root.composer-anchor = anchor; root.composer-preedit = preedit; }
        root.mention-query(threaded, caret, anchor, preedit);
    }
    callback place-mention-caret(bool, int);
    place-mention-caret(threaded, position) => {
        root.mention-place-thread = threaded; root.mention-place-position = position;
