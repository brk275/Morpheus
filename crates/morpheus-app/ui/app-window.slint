    in-out property <bool> directory-join-busy: false;
    in-out property <string> directory-joining-room-id;
    in-out property <int> directory-operation: 0;
    in-out property <int> directory-join-operation: 0;
    in-out property <bool> native-audio-ready: false;
    in-out property <bool> native-microphone-muted: true;
    in-out property <bool> native-deafened: false;
