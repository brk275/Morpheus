}

export struct SpaceItem {
    id: string,
    name: string,
    initials: string,
    accent: color,
}

// One person in Start a conversation. Text is bounded and single-line.
export struct PersonItem {
    user-id: string,
    name: string,
    // The complete Matrix ID typed, offered without a directory result.
    exact: bool,
}

export struct RoomItem {
    id: string,
    name: string,
    unread: int,
    // Unread messages that mention this account; shown as a distinct badge.
    mentions: int,
    private-room: bool,
    voice-space: bool,
    voice-local: bool,
    voice-shared: bool,
    // Standard Matrix m.favourite / m.lowpriority tags (room organization).
    favourite: bool,
    low-priority: bool,
}

// A variation of a built-in starting point (theme_studio/presets.rs).
export struct StudioVariation {
    name: string,
    description: string,
}

export struct MessageItem {
    event-id: string,
    is-own: bool,
    sender: string,
    sender-palette-index: int,
    initials: string,
    time: string,
    time-24h: string,
    time-24h-seconds: string,
    body: string,
    rich-body: styled-text,
    rich-accessible-body: string,
    edit-source: string,
    edit-markdown: bool,
    reply-to: string,
    attachment: string,
    attachment-is-image: bool,
    reaction: string,
    // Native poll card state; `present` is false for every other message.
    poll: PollCardData,
    accent: color,
    // The visible room's authoritative pinned list contains this event.
    pinned: bool,
}

// Type comes from the originating list, independently of a room's display name.
export struct NavigationRoomItem {
