// One Settings search result. `id` is a registry target ID, never a path or URL.
// One row of the pane arrangement editor, in the current order.
export struct LayoutPaneItem {
    // Stable config ID: spaces, rooms, conversation or details.
    id: string,
    label: string,
    hidden: bool,
    collapsed: bool,
    can-hide: bool,
    can-collapse: bool,
    can-move-up: bool,
    can-move-down: bool,
}

export struct SettingsResult {
    id: string,
    label: string,
    breadcrumb: string,
    description: string,
    // The config.toml key the result edits, such as `typography.sender_size`, or
    // the keys a section edits; empty when not listed. Registry text, never a path.
    key: string,
}

export struct ColorGroupItem {
    id: string,
    label: string,
    count: int,
    window: bool,
}

export struct ColorTokenItem {
    id: string,
    label: string,
    group: string,
    overridden: bool,
}

export struct ColorEditorState {
    id: string,
    label: string,
    description: string,
    group: string,
    // Where the shown color comes from, as fixed text.
    source: string,
    overridden: bool,
    can-undo: bool,
    // Inline guidance for the typed value; the last valid color stays applied.
    hint: string,
    // Advisory contrast of this text color and its surface, or empty.
    contrast: string,
}

// One keyboard shortcut action. `action` is a registry name, never a command.
export struct ShortcutItem {
    action: string,
    label: string,
    group: string,
    // Canonical combination, or empty when the action is disabled.
    binding: string,
    default-binding: string,
    customized: bool,
}

// One color of the sender-name palette, in slot order.
export struct SenderColorRow {
    index: int,
    hex: string,
    swatch: color,
    // At least 4.5:1 against the conversation background; reported only.
    readable: bool,
}

// One group of the typography and geometry workspace.
export struct MetricGroupItem {
    id: string,
    label: string,
    count: int,
}

// One metric row. `key` is a registry field key, never a path.
export struct MetricItem {
    key: string,
    label: string,
    value-text: string,
    overridden: bool,
}

// The one selected metric. Range, step and unit come from the registry.
export struct MetricEditorState {
    key: string,
    label: string,
    description: string,
    group: string,
    // The value the steppers move from; for an omitted metric, the value
    // its built-in look is closest to.
    value: int,
    minimum: int,
    maximum: int,
    step: int,
    suffix: string,
    unit-spoken: string,
    // Omitted: every surface keeps its built-in value.
    inherited: bool,
    inherit-text: string,
    default-text: string,
    overridden: bool,
    can-undo: bool,
    hint: string,
}

// One saved style profile in the Settings list. `key` is an opaque value of
// this session, never a file name or path.
export struct StyleProfileItem {
    key: string,
    name: string,
    detail: string,
    valid: bool,
    // The look this profile holds is the look shown now.
    current: bool,
}

// One row of the installed font browser: a generic name or an installed
// family, with its weights and whether the system lists it as monospaced.
export struct FontFamilyItem {
    name: string,
    detail: string,
    generic: bool,
    monospace: bool,
    // The role draws with this family now.
    current: bool,
}

// The selected style profile and any pending confirmation.
export struct StyleProfileState {
    key: string,
    name: string,
    summary: string,
    // Why the file cannot be used; empty when it is valid.
    problem: string,
    valid: bool,
    matches-current: bool,
    // This profile is the one being previewed.
    previewed: bool,
    // Some profile is being previewed.
    previewing: bool,
    // More files were in the folder than were listed.
    truncated: bool,
    // 0 none, 1 delete the selected profile, 2 replace a profile of the same name.
    confirm: int,
    confirm-text: string,
}

export struct EmojiItem {
    key: string,
    symbol: string,
    name: string,
}

export struct MentionItem {
    key: string,
    name: string,
}

// One sticker row. `key` is an opaque routing value the controller checks
// against its open picker; it is never a media address and never displayed.
export struct StickerItem {
    key: string,
    label: string,
    pack: string,
}

// One saved send record of the visible composer scope. `key` is an opaque
// routing value for the exact record and is never displayed.
export struct PendingSendItem {
    key: string,
    status: string,
    preview: string,
    can-cancel: bool,
    can-retry: bool,
    unconfirmed: bool,
    kept: bool,
}

// These Palette fallbacks match Slint 1.18.1's TextInput defaults.
component ThemedTextInput inherits TextInput {
    selection-background-color: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : Palette.selection-background;
    selection-foreground-color: StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : Palette.selection-foreground;
}

// Pinned Slint 1.18.1 adapter. Only these three reads use its documented-as-
// internal test/IME properties; placement uses the public UTF-8 offset setter.
// This wrapper must receive native caret/selection/IME acceptance on upgrades.
component MentionInput inherits TextInput {
    // typography.line_height_percent and typography.body_weight.
    line-height-factor: StyleTokens.line-height-factor;
    font-weight: StyleTokens.body-font-weight;
    selection-background-color: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : Palette.selection-background;
    selection-foreground-color: StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : Palette.selection-foreground;
    out property <int> caret-bytes: self.cursor-position-byte-offset;
    out property <int> anchor-bytes: self.anchor-position-byte-offset;
    out property <bool> composing: self.preedit-text != "";
    callback caret-changed();
    changed caret-bytes => { root.caret-changed(); }
    changed anchor-bytes => { root.caret-changed(); }
    changed composing => { root.caret-changed(); }
}

export struct AudioDeviceItem {
    id: string,
    name: string,
}

export struct AccountItem {
    name: string,
    handle: string,
    initials: string,
    status: string,
    accent: color,
    // The account's own public avatar, already read while it was active
