    // A seek (timeline_viewport.rs) brings one loaded row into the
    // conversation's viewport without rebuilding any row: Rust starts it
    // with its own id, the row's event and index, and either a reveal (the
    // row a third of the way down) or an anchor (the row's top kept at
    // `offset` from the viewport's top). The list approaches an undrawn row
    // and the drawn row places itself from its own measured geometry; Rust
    // admits every move and ends the seek (id 0).
    in-out property <int> timeline-seek-id: 0;
    in-out property <string> timeline-seek-event;
    in-out property <int> timeline-seek-index: -1;
    in-out property <bool> timeline-seek-reveal: true;
    in-out property <length> timeline-seek-offset: 0px;
    // List passes, the pass and seek in which the row was last drawn, the
    // last approach, and the last placement with its waits for a layout.
    property <int> timeline-seek-pass: 0;
    property <int> timeline-seek-heard: 0;
    property <int> timeline-seek-heard-id: 0;
    property <int> timeline-seek-approached: 0;
    property <int> timeline-seek-approached-id: 0;
    property <int> timeline-seek-moved-id: 0;
    property <length> timeline-seek-moved-top: 0px;
    property <length> timeline-seek-moved-y: 0px;
    property <int> timeline-seek-waits: 0;
    // The reader's top row as the running seek last accepted it: at its
