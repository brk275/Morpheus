                            accessible-live-region: polite;
                        }
                        if root.studio-conflicts == 0 : TextAction {
                            text: "Undo";
                            label: "Undo the last unsaved appearance change";
                            enabled: root.studio-can-undo;
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            activated => { root.studio-undo(); }
                        }
                        if root.studio-conflicts == 0 : TextAction {
                            text: "Redo";
                            label: "Redo the appearance change you undid";
                            enabled: root.studio-can-redo;
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            activated => { root.studio-redo(); }
                        }
                        if root.studio-conflicts == 0 : TextAction {
                            text: "Discard";
                            label: "Discard the unsaved appearance changes and restore your saved look";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            // The bar closes: keep keyboard focus in the window.
                            activated => { shortcut-scope.focus(); root.studio-discard(); }
                        }
                        if root.studio-conflicts == 0 : TextAction {
                            text: "Apply";
                            label: "Save the appearance changes to the settings file";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.accent; text-scale: root.text-scale;
                            activated => { shortcut-scope.focus(); root.studio-apply(); }
                        }
                        if root.studio-conflicts > 0 : TextAction {
                            text: "Keep mine";
                            label: "Save this window's values for the settings changed in both places";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.accent; text-scale: root.text-scale;
                            activated => { shortcut-scope.focus(); root.studio-resolve(1); }
                        }
                        if root.studio-conflicts > 0 : TextAction {
                            text: "Keep the file's";
                            label: "Keep the settings file's values for the settings changed in both places and save the rest";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            activated => { shortcut-scope.focus(); root.studio-resolve(2); }
                        }
                        if root.studio-conflicts > 0 : TextAction {
                            text: "Back";
                            label: "Go back to editing without saving";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            activated => { shortcut-scope.focus(); root.studio-resolve(0); }
                        }
                    }
                }
                // The outcome of Apply, Discard or an account switch, until dismissed.
                if root.studio-notice != "" : Rectangle {
                    height: max(36px, 32px * root.text-scale + 8px);
                    background: root.panel;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 12px; padding-top: 4px; padding-bottom: 4px; spacing: 10px;
                        Text {
                            text: root.studio-notice;
                            color: root.studio-notice-error && StyleTokens.roles.error.present ? StyleTokens.roles.error.color : root.ink;
                            font-size: 11px * root.text-scale;
                            vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide;
                            accessible-live-region: polite;
                        }
                        TextAction {
                            text: "Dismiss";
                            label: "Dismiss the appearance notice";
                            ink: root.ink; muted: root.muted; surface: root.panel; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            activated => { shortcut-scope.focus(); root.studio-notice-dismiss(); }
                        }
                    }
                }
                // How a preview ended, on every page, until dismissed.
                if root.style-profile-notice != "" : Rectangle {
                    height: max(36px, 32px * root.text-scale + 8px);
                    background: root.panel;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 12px; padding-top: 4px; padding-bottom: 4px; spacing: 10px;
                        Text {
                            text: root.style-profile-notice;
                            color: root.style-profile-notice-error && StyleTokens.roles.error.present ? StyleTokens.roles.error.color : root.ink;
                            font-size: 11px * root.text-scale;
                            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                            accessible-live-region: polite;
                        }
                        TextAction {
                            text: "Dismiss";
                            label: "Dismiss the style profile notice";
                            ink: root.ink; muted: root.muted; surface: root.panel; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            // The notice closes: keep keyboard focus in the window.
                            activated => { shortcut-scope.focus(); root.style-profile-notice-dismiss(); }
                        }
                    }
                }

                if root.page == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;
                    if root.conversation-header-mode == 0 : Rectangle {
                        height: root.message-layout == 0 ? max(110px, 54px * root.text-scale + 56px) : max(48px, 24px * root.text-scale + 24px);
                        background: transparent;
                        VerticalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: root.message-layout == 0 ? 23px : 8px;
                            padding-bottom: root.message-layout == 0 ? 20px : 8px;
                            spacing: 8px;
                            if root.message-layout == 0 : Text {
                                text: "Welcome to #" + root.active-room-name;
                                color: root.ink; font-size: 24px * root.text-scale; font-weight: 780;
                                min-width: 0px; overflow: elide;
                                accessible-label: self.text;
                            }
                            Text { text: root.active-room-topic; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; min-width: 0px; }
                        }
                    }
