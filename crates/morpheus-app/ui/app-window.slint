    callback start-native-capture(int, string);
    callback stop-native-capture(int);
    callback confirm-leave-call(int);
    callback open-security();
    callback refresh-security();
    callback enable-recovery();
    callback recover-account(string);
    callback copy-recovery-key();
    callback dismiss-recovery-key();
    callback request-own-verification();
    callback refresh-incoming-verification();
    callback accept-incoming-verification();
    callback refresh-sas-verification();
    callback start-sas-verification();
    callback confirm-sas-verification();
    callback cancel-sas-verification();

    in-out property <bool> account-menu-open: false;
    in-out property <bool> manage-accounts-open: false;
    in-out property <bool> room-actions-open: false;
    in-out property <int> room-action-mode: 0; // 0 private room, 1 join, 2 Space
    in-out property <string> room-action-input;
    in-out property <string> room-action-error;
    in-out property <string> invite-error;
    in-out property <bool> room-action-busy: false;
    in-out property <int> room-action-operation: 0;
    in-out property <bool> stress-timeline-active: false;
    property <int> side-panel-tab: 0;
    in-out property <int> page: 0; // 0 chat, 1 settings, 2 call stage
    changed page => {
        if root.page != 1 {
            root.security-recovery-input = "";
            root.sas-compared = false;
            root.notification-highlight-error = "";
        }
        if root.page != 2 { root.native-capture-picker-open = false; }
    }
    changed native-call-joined => {
        if !root.native-call-joined { root.native-capture-picker-open = false; }
    }
    property <bool> mic-muted: false;
    property <bool> camera-off: true;
    in-out property <bool> call-connected: false;
    in-out property <string> native-call-room-id;
    in-out property <string> native-call-room-display;
    in-out property <bool> leave-call-dialog: false;
    in-out property <bool> leave-call-busy: false;
    in-out property <int> pending-account-index: -1;
    in-out property <string> composer-text;
    in-out property <bool> composer-markdown: false;
    in-out property <bool> composer-saved-markdown: false;
    in-out property <bool> composer-busy: false;
    in-out property <bool> attachment-busy: false;
    in-out property <bool> attachment-needs-retry: false;
    in-out property <string> attachment-status;
    in-out property <int> attachment-operation: 0;
    in-out property <string> downloading-event-id;
    in-out property <int> download-operation: 0;
    in-out property <int> composer-operation: 0;
    in-out property <bool> history-loading: false;
    in-out property <bool> history-at-start: false;
    in-out property <string> history-error;
    in-out property <int> history-operation: 0;
    in-out property <int> composer-mode: 0; // 0 message, 1 reply, 2 edit
    in-out property <string> composer-target-id;
    in-out property <string> composer-target-label;
    in-out property <string> composer-saved-draft;
    in-out property <string> thread-root-id;
    in-out property <string> thread-root-sender;
    in-out property <string> thread-root-body;
    in-out property <styled-text> thread-root-rich-body;
    in-out property <string> thread-root-rich-accessible-body;
    in-out property <string> thread-composer-text;
    property <string> login-homeserver: "https://matrix.org";
    property <string> login-username;
    property <string> login-password;

    property <bool> light-palette: root.theme-mode == 1 || (root.theme-mode == 3 && Palette.color-scheme == ColorScheme.light);
    property <float> text-scale: root.font-scale-percent / 100.0;
    property <color> rail: custom-theme-active ? custom-rail : light-palette ? #e7ebf3 : theme-mode == 2 ? #000000 : #10131b;
    property <color> sidebar: custom-theme-active ? custom-sidebar : light-palette ? #f1f3f8 : theme-mode == 2 ? #101010 : #171b26;
    property <color> canvas: custom-theme-active ? custom-canvas : light-palette ? #ffffff : theme-mode == 2 ? #000000 : #1e2330;
    property <color> panel: custom-theme-active ? custom-panel : light-palette ? #f8f9fc : theme-mode == 2 ? #101010 : #191e2a;
    property <color> elevated: custom-theme-active ? custom-elevated : light-palette ? #ffffff : theme-mode == 2 ? #181818 : #272d3b;
    property <color> hover: custom-theme-active ? custom-hover : light-palette ? #e3e8f2 : theme-mode == 2 ? #333333 : #32394b;
    property <color> ink: custom-theme-active ? custom-ink : light-palette ? #182132 : #ffffff;
    property <color> muted: custom-theme-active ? custom-muted : light-palette ? #637083 : theme-mode == 2 ? #ffffff : #a7afc1;
    property <color> divider: custom-theme-active ? custom-divider : light-palette ? #dfe4ee : theme-mode == 2 ? #ffffff : #303747;
    property <color> accent: custom-theme-active ? custom-accent : theme-mode == 2 ? #ffff00 : #a88cff;
    property <color> accent-ink: custom-theme-active ? custom-accent-ink : theme-mode == 2 ? #000000 : #ffffff;
    default-font-family: root.ui-font-family;
    background: canvas;

    HorizontalLayout {
        spacing: 0px;

        // Space and navigation rail.
        Rectangle {
            width: 70px;
            background: root.rail;
            VerticalLayout {
                padding: 9px;
                spacing: 10px;
                Rectangle {
                    height: 48px;
                    border-radius: 15px;
                    background: root.accent;
                    Text {
                        text: "M";
                        color: root.accent-ink;
                        font-size: 23px * root.text-scale;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 1px; background: root.divider; }
                IconAction {
                    width: 52px;
                    height: 48px;
                    icon: "⌂";
                    label: "Home and all rooms";
                    ink: root.page == 0 && root.active-space-id == "" ? root.accent : root.muted;
                    surface: root.rail;
                    hover-surface: root.hover;
                    selected: root.page == 0 && root.active-space-id == "";
                    activated => { root.active-space-id = ""; root.active-space-name = "Home"; root.select-space(""); root.page = 0; }
                }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: parent.width;
                        spacing: 8px;
                        for space in root.spaces : ActionRect {
                            width: 52px;
                            height: 48px;
                            border-radius: 12px;
                            background: root.active-space-id == space.id && root.page == 0 ? root.hover : self.has-hover ? root.hover : transparent;
                            focus-color: root.accent;
                            label: "Select space " + space.name;
                            activated => {
                                root.active-space-id = space.id;
                                root.active-space-name = space.name;
                                root.select-space(space.id);
                                root.page = 0;
                            }
                            AvatarBadge {
                                x: (parent.width - 38px) / 2;
                                y: 5px;
                                initials: space.initials;
                                accent: space.accent;
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: root.divider; }
                IconAction {
                    width: 52px;
                    height: 48px;
                    icon: "S";
                    label: "Explore public Matrix rooms";
                    ink: root.page == 3 ? root.accent : root.muted;
                    surface: root.rail;
                    hover-surface: root.hover;
                    selected: root.page == 3;
                    activated => { root.page = 3; root.open-discovery(); }
                }
                IconAction {
                    width: 52px;
                    height: 48px;
                    icon: "C";
                    label: "Open call stage";
                    ink: root.page == 2 ? root.accent : root.muted;
                    surface: root.rail;
                    hover-surface: root.hover;
                    selected: root.page == 2;
                    activated => { root.page = 2; }
                }
                IconAction {
                    width: 52px;
                    height: 48px;
                    icon: "⚙";
                    label: "Open settings";
                    ink: root.page == 1 ? root.accent : root.muted;
                    surface: root.rail;
                    hover-surface: root.hover;
                    selected: root.page == 1;
                    activated => { root.page = 1; root.open-security(); }
                }
            }
        }

        // Room list and Discord-style account control.
        Rectangle {
            width: root.room-list-width * 1px;
            background: root.sidebar;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 62px;
                    background: root.sidebar;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 14px;
                        spacing: 8px;
                        Text {
                            text: "Morpheus";
                            color: root.ink;
                            font-size: 17px * root.text-scale;
                            font-weight: 750;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        room-action-trigger := Button {
                            width: 34px;
                            height: 34px;
                            text: "+";
                            accessible-label: "Create or join a Matrix room";
                            clicked => {
                                root.room-action-mode = 0;
                                root.room-action-input = "";
                                root.room-action-error = "";
                                root.room-actions-open = true;
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: root.divider; }
                Rectangle {
                    height: 57px;
                    background: root.sidebar;
                    ActionRect {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: 37px;
                        border-radius: 9px;
                        background: root.elevated;
                        focus-color: root.accent;
                        label: "Search the public Matrix room directory";
                        activated => { root.page = 3; root.open-discovery(); }
                        Text {
                            x: 12px;
                            text: "Discover rooms";
                            color: root.muted;
                            font-size: 13px * root.text-scale;
                            vertical-alignment: center;
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: parent.width;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 18px;
                        spacing: 3px;
                        Text {
                            text: root.active-space-id == "" ? "YOUR ROOMS" : "SPACE ROOMS";
                            color: root.muted;
                            font-size: 10px * root.text-scale;
                            font-weight: 750;
                            letter-spacing: 1px;
                            height: 29px;
                            vertical-alignment: bottom;
                        }
                        Rectangle {
                            height: 30px;
                            background: transparent;
                            Text {
                                x: 8px;
                                text: "v   " + (root.active-space-id == "" ? "Home" : root.active-space-name);
                                color: root.ink;
                                font-size: 13px * root.text-scale;
                                font-weight: 650;
                                vertical-alignment: center;
                            }
                        }
                        if root.invitations.length > 0 : Text {
                            text: "INVITATIONS · " + root.invitations.length;
                            color: root.accent;
                            font-size: 10px * root.text-scale;
                            font-weight: 750;
                            letter-spacing: 1px;
                            height: 29px;
                            vertical-alignment: bottom;
                        }
                        if root.invite-error != "" : Text {
                            text: root.invite-error;
                            color: #ff8d9d;
                            font-size: 11px * root.text-scale;
                            wrap: word-wrap;
                            height: 40px;
                        }
                        for invite in root.invitations : Rectangle {
                            height: 58px;
                            border-radius: 8px;
                            background: root.elevated;
                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 7px;
                                spacing: 4px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: invite.name; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; overflow: elide; }
                                    Text { text: "Room invitation"; color: root.muted; font-size: 10px * root.text-scale; }
                                }
                                Button {
                                    width: 30px; height: 30px;
                                    text: "✓";
                                    accessible-label: "Accept invitation to " + invite.name;
                                    enabled: !root.room-action-busy;
                                    clicked => { root.respond-invite(invite.id, true); }
                                }
                                Button {
                                    width: 30px; height: 30px;
                                    text: "×";
                                    accessible-label: "Decline invitation to " + invite.name;
                                    enabled: !root.room-action-busy;
                                    clicked => { root.respond-invite(invite.id, false); }
                                }
                            }
                        }
                        for room in root.channels : ActionRect {
                            height: max(root.density-mode == 0 ? 30px : root.density-mode == 2 ? 44px : 36px, 22px * root.text-scale);
                            border-radius: 8px;
                            background: room.id == root.active-room-id && root.page == 0 ? root.hover : self.has-hover ? root.elevated : transparent;
                            focus-color: root.accent;
                            label: room.voice-space ? "Enter voice space " + room.name : "Open room " + room.name;
                            activated => {
                                if room.voice-space && root.live-session { root.open-voice-space(room.id); }
                                else { root.page = 0; root.open-room(room.id); }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 9px;
                                spacing: 8px;
                                Text { text: room.voice-space ? "◖" : (room.private-room ? "⌑" : "#"); color: room.voice-space ? #78c8b1 : root.muted; font-size: 18px * root.text-scale; vertical-alignment: center; }
                                Text { text: room.name; color: room.unread > 0 ? root.ink : root.muted; font-size: 13px * root.text-scale; font-weight: room.unread > 0 ? 700 : 500; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                if room.voice-space : Text { text: "VOICE"; color: #78c8b1; font-size: 9px * root.text-scale; font-weight: 750; vertical-alignment: center; }
                                if room.unread > 0 : Rectangle {
                                    width: 20px; height: 20px; border-radius: 10px; background: root.accent;
                                    Text { text: room.unread; color: root.accent-ink; font-size: 10px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                        Text {
                            text: "DIRECT MESSAGES";
                            color: root.muted;
                            font-size: 10px * root.text-scale;
                            font-weight: 750;
                            letter-spacing: 1px;
                            height: 40px;
                            vertical-alignment: bottom;
                        }
                        for room in root.direct-messages : ActionRect {
                            height: max(root.density-mode == 0 ? 32px : root.density-mode == 2 ? 47px : 39px, 22px * root.text-scale);
                            border-radius: 8px;
                            background: room.id == root.active-room-id && root.page == 0 ? root.hover : self.has-hover ? root.elevated : transparent;
                            focus-color: root.accent;
                            label: room.voice-space ? "Enter voice space with " + room.name : "Open direct message with " + room.name;
                            activated => {
                                if room.voice-space && root.live-session { root.open-voice-space(room.id); }
                                else { root.page = 0; root.open-room(room.id); }
                            }
                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 9px;
                                spacing: 9px;
                                Rectangle {
                                    width: 25px; height: 25px; border-radius: 9px; background: root.accent;
                                    Text { text: room.voice-space ? "◖" : "@"; color: root.accent-ink; font-size: 13px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Text { text: room.name; color: room.unread > 0 ? root.ink : root.muted; font-size: 13px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                if room.voice-space : Text { text: "VOICE"; color: #78c8b1; font-size: 9px * root.text-scale; font-weight: 750; vertical-alignment: center; }
                                if room.unread > 0 : Rectangle {
                                    width: 20px; height: 20px; border-radius: 10px; background: root.accent;
                                    Text { text: room.unread; color: root.accent-ink; font-size: 10px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: root.divider; }
                account-trigger := ActionRect {
                    height: 69px;
                    background: root.rail;
                    focus-color: root.accent;
                    label: "Account menu for " + root.active-account-name + ", " + root.active-account-handle;
                    accessible-expanded: root.account-menu-open;
                    activated => { root.account-menu-open = !root.account-menu-open; }
                    HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 11px;
                        spacing: 10px;
                        AvatarBadge { initials: root.active-account-initials; accent: root.active-account-accent; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: root.active-account-name; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; overflow: elide; }
                            Text { text: root.active-account-handle; color: root.muted; font-size: 11px * root.text-scale; overflow: elide; }
                        }
                        Text { text: "⌃"; color: root.muted; font-size: 16px * root.text-scale; vertical-alignment: center; }
                    }
                }
            }

            // Drawn after the sidebar so it opens upward over the room list.
            if root.account-menu-open : Rectangle {
                x: 9px;
                y: parent.height - self.height - 74px;
                width: parent.width - 18px;
                height: root.account-options.length > 5 ? 430px : 170px + root.account-options.length * 44px;
                background: root.elevated;
                border-color: root.divider;
                border-width: 1px;
                border-radius: 12px;
                drop-shadow-color: #00000044;
                drop-shadow-blur: 18px;
                drop-shadow-offset-y: 7px;
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    Text {
                        text: "SWITCH ACCOUNT";
                        color: root.muted;
                        font-size: 10px * root.text-scale;
                        font-weight: 750;
                        letter-spacing: 1px;
                        height: 22px;
                        vertical-alignment: center;
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: parent.width;
                            spacing: 2px;
                    for account[index] in root.account-options : account-choice := ActionRect {
                        height: 42px;
                        border-radius: 8px;
                        background: account.index == root.active-account-index ? root.hover : self.has-hover ? root.hover : transparent;
                        focus-color: root.accent;
                        cancel-on-escape: true;
                        label: "Switch to " + account.name + ", " + account.handle;
                        // Repeater children become focusable after initialization; defer one tick.
                        Timer {
                            interval: 1ms;
                            running: index == 0;
                            triggered => { self.running = false; account-choice.focus(); }
                        }
                        cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                        activated => {
                            if root.call-connected {
                                root.pending-account-index = account.index;
                                root.leave-call-dialog = true;
                                root.account-menu-open = false;
                            } else {
                                root.switch-account(account.index);
                                root.account-menu-open = false;
                                account-trigger.focus();
                            }
                        }
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            spacing: 9px;
                            AvatarBadge { width: 30px; height: 30px; border-radius: 10px; initials: account.initials; accent: account.accent; }
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                horizontal-stretch: 1;
                                Text { text: account.name; color: root.ink; font-size: 12px * root.text-scale; font-weight: 650; overflow: elide; }
                                Text { text: account.handle; color: root.muted; font-size: 10px * root.text-scale; overflow: elide; }
                            }
                            if account.index == root.active-account-index : Text { text: "✓"; color: root.accent; font-size: 15px * root.text-scale; vertical-alignment: center; }
                        }
                    }
                        }
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    add-account-choice := ActionRect {
                        height: 35px;
                        border-radius: 8px;
                        background: self.has-hover ? root.hover : transparent;
                        focus-color: root.accent;
                        cancel-on-escape: true;
                        label: "Add another Matrix account";
                        Timer {
                            interval: 1ms;
                            running: root.account-options.length == 0;
                            triggered => { self.running = false; add-account-choice.focus(); }
                        }
                        cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                        activated => {
                            if root.call-connected {
                                root.pending-account-index = -2;
                                root.leave-call-dialog = true;
                                root.account-menu-open = false;
                            } else {
                                root.add-account();
                                root.account-menu-open = false;
                            }
                        }
                        Text { x: 9px; text: "+   Add an account"; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; }
                    }
                    ActionRect {
                        height: 35px;
                        border-radius: 8px;
                        background: self.has-hover ? root.hover : transparent;
                        focus-color: root.accent;
                        cancel-on-escape: true;
                        label: "Manage accounts";
                        cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                        activated => { root.manage-accounts-open = true; root.manage-accounts(); root.account-menu-open = false; }
                        Text { x: 9px; text: "⚙   Manage accounts"; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; }
                    }
                    ActionRect {
                        height: 35px;
                        border-radius: 8px;
                        background: self.has-hover ? root.hover : transparent;
                        focus-color: root.accent;
                        cancel-on-escape: true;
                        label: "Log out of current Matrix account";
                        cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                        activated => {
                            if root.call-connected { root.pending-account-index = -3; root.leave-call-dialog = true; root.account-menu-open = false; }
                            else { root.log-out(); root.account-menu-open = false; }
                        }
                        Text { x: 9px; text: "↪   Log out"; color: #e47483; font-size: 12px * root.text-scale; vertical-alignment: center; }
                    }
                }
            }
        }

        // Conversation, settings, and call stage share the main canvas.
        Rectangle {
            horizontal-stretch: 1;
            background: root.canvas;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 62px;
                    background: root.canvas;
                    HorizontalLayout {
                        padding-left: 22px;
                        padding-right: 16px;
                        spacing: 11px;
                        Text {
                            text: root.page == 1 ? "⚙" : root.page == 2 ? "☏" : root.page == 3 ? "⌕" : "#";
                            color: root.muted;
                            font-size: 20px * root.text-scale;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.page == 1 ? "Settings" : root.page == 2 ? "Voice & video" : root.page == 3 ? "Discover rooms" : root.active-room-name;
                            color: root.ink;
                            font-size: 16px * root.text-scale;
                            font-weight: 750;
                            vertical-alignment: center;
                        }
                        Rectangle { width: 1px; height: 24px; background: root.divider; }
                        Text {
                            text: root.page == 0 ? root.active-room-topic : root.page == 1 ? "Make Morpheus yours" : root.page == 3 ? "Public rooms on your Matrix homeserver" : "The Workshop";
                            color: root.muted;
                            font-size: 12px * root.text-scale;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if root.page == 0 : IconAction {
                            icon: "⚙"; label: "Edit room name and topic"; ink: root.muted; surface: root.canvas; hover-surface: root.hover;
                            enabled: root.live-session && root.active-room-id != "";
                            activated => {
                                root.room-admin-mode = 0;
                                root.room-admin-name-input = root.active-room-name;
                                root.room-admin-topic-input = root.active-room-topic-raw;
                                root.room-admin-account-id = root.active-account-local-id;
                                root.room-admin-room-id = root.active-room-id;
                                root.room-admin-error = "";
                                root.room-admin-notice = "";
                                root.room-admin-open = true;
                            }
                        }
                        if root.page == 0 : IconAction {
                            icon: "S"; label: "Search messages in this room"; ink: root.muted; surface: root.canvas; hover-surface: root.hover;
                            selected: root.show-side-panel && root.side-panel-tab == 2;
                            enabled: root.live-session && root.active-room-id != "";
                            activated => { root.show-side-panel = true; root.side-panel-tab = 2; }
                        }
                        if root.page == 0 : IconAction {
                            icon: "C"; label: "Open call stage"; ink: root.muted; surface: root.canvas; hover-surface: root.hover;
                            activated => { root.page = 2; }
                        }
                        if root.page == 0 : IconAction {
                            icon: "P"; label: root.show-side-panel ? "Hide details panel" : "Show details panel";
                            ink: root.muted; surface: root.canvas; hover-surface: root.hover;
                            selected: root.show-side-panel;
                            activated => { root.set-side-panel(!root.show-side-panel); }
                        }
                    }
                }
                Rectangle { height: 1px; background: root.divider; }
                if root.config-error != "" : Rectangle {
                    height: 39px;
                    background: #9f3f50;
                    Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: "Settings file: " + root.config-error;
                        color: #ffffff;
                        font-size: 11px * root.text-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.session-error != "" : Rectangle {
                    height: 34px;
                    background: #613743;
                    Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: root.session-error;
                        accessible-live-region: polite;
                        color: #ffffff;
                        font-size: 11px * root.text-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.transfer-notice != "" : Rectangle {
                    height: 30px;
                    background: #214a46;
                    Text {
                        x: 16px; width: parent.width - 32px;
                        text: root.transfer-notice;
                        accessible-live-region: polite;
                        color: #ffffff;
                        font-size: 11px * root.text-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if root.page == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;
                    Rectangle {
                        height: 76px;
                        background: root.canvas;
                        VerticalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            spacing: 5px;
                            Text { text: "Welcome to #" + root.active-room-name; color: root.ink; font-size: 24px * root.text-scale; font-weight: 780; }
                            Text { text: root.active-room-topic; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        }
                    }
                    if root.live-session && root.active-room-id != "" : HorizontalLayout {
                        height: 39px;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 8px;
                        Text {
                            text: root.active-voice-local || root.active-voice-shared ? "◖ VOICE" : "Voice";
                            color: root.active-voice-local || root.active-voice-shared ? #78c8b1 : root.muted;
                            font-size: 11px * root.text-scale;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button {
                            text: root.active-voice-local ? "✓ Mine" : "Mine";
                            enabled: !root.voice-designation-busy;
                            accessible-label: root.active-voice-local ? "Remove this room from my local voice spaces" : "Mark this room as a voice space only for my account";
                            clicked => { root.set-local-voice-space(!root.active-voice-local); }
                        }
                        if root.native-call-enabled : Button {
                            text: root.active-voice-shared ? "✓ Shared" : "Share";
                            enabled: !root.voice-designation-busy;
                            accessible-label: root.active-voice-shared ? "Remove shared voice-space marker from this Matrix room" : "Share a voice-space marker with this Matrix room";
                            clicked => { root.set-shared-voice-space(!root.active-voice-shared); }
                        }
                        if root.active-voice-local || root.active-voice-shared : Button {
                            text: "Join";
                            enabled: !root.voice-designation-busy;
                            accessible-label: "Join this room's MatrixRTC voice space without ringing members";
                            clicked => { root.open-voice-space(root.active-room-id); }
                        }
                    }
                    if root.voice-designation-error != "" || root.voice-designation-notice != "" : Text {
                        height: 25px;
                        text: root.voice-designation-error != "" ? root.voice-designation-error : root.voice-designation-notice;
                        color: root.voice-designation-error != "" ? #ff8d9d : #78c8b1;
                        font-size: 11px * root.text-scale;
                        accessible-live-region: polite;
                        overflow: elide;
                    }
                    if root.live-session && root.active-room-id != "" : HorizontalLayout {
                        height: 36px;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 10px;
                        Button {
                            text: root.history-loading ? "Loading earlier messages…" : root.history-at-start ? "Start of room history" : "Load earlier messages";
                            enabled: !root.history-loading && !root.history-at-start;
                            accessible-label: root.history-at-start ? "Start of room history reached" : "Load earlier messages in this Matrix room";
                            clicked => { root.load-older-messages(); }
                        }
                        if root.history-error != "" : Text {
                            text: root.history-error;
                            color: #e47483;
                            font-size: 11px * root.text-scale;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                            accessible-live-region: polite;
                        }
                    }
                    timeline-list := ListView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        for message[index] in root.messages : Rectangle {
                                width: timeline-list.visible-width;
                                background: root.room-search-selected-event-id != "" && message.event-id == root.room-search-selected-event-id ? root.hover : message-hover.has-hover ? root.elevated : transparent;
                                min-height: root.density-mode == 0 ? 52px : root.density-mode == 2 ? 80px : 65px;
                                message-hover := TouchArea { mouse-cursor: default; }
                                VerticalLayout {
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    padding-top: root.density-mode == 0 ? 5px : root.density-mode == 2 ? 15px : 9px;
                                    padding-bottom: root.density-mode == 0 ? 5px : root.density-mode == 2 ? 16px : 10px;
                                    spacing: root.density-mode == 0 ? 3px : root.density-mode == 2 ? 8px : 5px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        AvatarBadge { width: 36px; height: 36px; border-radius: 12px; initials: message.initials; accent: message.accent; }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: root.density-mode == 0 ? 3px : root.density-mode == 2 ? 8px : 5px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: message.sender; color: root.ink; font-size: 13px * root.text-scale; font-weight: 750; }
                                                Text { text: message.time; color: root.muted; font-size: 10px * root.text-scale; vertical-alignment: center; }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                                if message.event-id != "" : IconAction {
                                                    width: 28px; height: 26px; icon: "↩"; label: "Reply to " + message.sender;
                                                    ink: root.muted; surface: transparent; hover-surface: root.hover;
                                                    activated => {
                                                        if root.composer-mode == 0 {
                                                            root.composer-saved-draft = root.composer-text;
                                                            root.composer-saved-markdown = root.composer-markdown;
                                                        }
                                                        root.composer-mode = 1;
                                                        root.composer-target-id = message.event-id;
                                                        root.composer-target-label = message.sender;
                                                        root.composer-text = "";
                                                        root.composer-markdown = false;
                                                        message-input.focus();
                                                    }
                                                }
                                                if message.event-id != "" && message.is-own && message.attachment == "" : IconAction {
                                                    width: 28px; height: 26px; icon: "✎"; label: "Edit your message";
                                                    ink: root.muted; surface: transparent; hover-surface: root.hover;
                                                    activated => {
                                                        if root.composer-mode == 0 {
                                                            root.composer-saved-draft = root.composer-text;
                                                            root.composer-saved-markdown = root.composer-markdown;
                                                        }
                                                        root.composer-mode = 2;
                                                        root.composer-target-id = message.event-id;
                                                        root.composer-target-label = message.sender;
                                                        root.composer-text = message.edit-source;
                                                        root.composer-markdown = message.edit-markdown;
                                                        message-input.focus();
                                                    }
                                                }
                                                if message.event-id != "" : IconAction {
                                                    width: 28px; height: 26px; icon: "♥"; label: "Toggle heart reaction";
                                                    ink: root.muted; surface: transparent; hover-surface: root.hover;
                                                    activated => { root.toggle-message-reaction(message.event-id, "❤️"); }
                                                }
                                                if message.event-id != "" : IconAction {
                                                    width: 28px; height: 26px; icon: "☷"; label: "Open thread for " + message.sender;
                                                    ink: root.muted; surface: transparent; hover-surface: root.hover;
                                                    activated => {
                                                        root.thread-root-id = message.event-id;
                                                        root.thread-root-sender = message.sender;
                                                        root.thread-root-body = message.body;
                                                        root.thread-root-rich-body = message.rich-body;
                                                        root.thread-root-rich-accessible-body = message.rich-accessible-body;
                                                        root.thread-composer-text = "";
                                                        root.thread-messages = [];
                                                        root.side-panel-tab = 1;
                                                        root.show-side-panel = true;
                                                        root.open-thread(message.event-id, message.sender, message.body);
                                                    }
                                                }
                                                if message.event-id != "" : IconAction {
                                                    width: 28px; height: 26px; icon: "⌫"; label: "Redact message from " + message.sender;
                                                    ink: root.muted; surface: transparent; hover-surface: root.hover;
                                                    enabled: root.live-session && !root.room-admin-busy;
                                                    activated => {
                                                        root.room-admin-mode = 2;
                                                        root.room-admin-event-id = message.event-id;
                                                        root.room-admin-event-preview = message.sender + ": " + message.body;
                                                        root.room-admin-account-id = root.active-account-local-id;
                                                        root.room-admin-room-id = root.active-room-id;
                                                        root.room-admin-error = "";
                                                        root.room-admin-notice = "";
                                                        root.room-admin-open = true;
                                                    }
                                                }
                                            }
                                            if message.reply-to != "" : Rectangle {
                                                height: 25px;
                                                border-radius: 5px;
                                                background: root.hover;
                                                Text { x: 8px; text: "Reply to " + message.reply-to; color: root.muted; font-size: 11px * root.text-scale; vertical-alignment: center; overflow: elide; }
                                            }
                                            StyledText {
                                                width: max(100px, timeline-list.visible-width - 110px);
                                                text: message.rich-body;
                                                default-color: root.ink;
                                                default-font-size: 13px * root.text-scale;
                                                link-color: root.accent;
                                                accessible-role: text;
                                                accessible-label: message.rich-accessible-body;
                                                link-clicked(url) => { root.open-message-link(url); }
                                            }
                                            if message.attachment != "" : Rectangle {
                                                height: 49px;
                                                border-radius: 8px;
                                                border-color: root.divider;
                                                border-width: 1px;
                                                background: root.panel;
                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    spacing: 10px;
                                                    Text { text: "F"; color: root.accent; font-size: 20px * root.text-scale; vertical-alignment: center; }
                                                    Text { text: message.attachment; color: root.ink; font-size: 12px * root.text-scale; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                                    IconAction {
                                                        icon: "↓";
                                                        label: "Save attachment " + message.attachment;
                                                        ink: root.accent; surface: transparent; hover-surface: root.hover;
                                                        enabled: root.live-session && message.event-id != "" && root.downloading-event-id == "";
                                                        activated => { root.save-attachment(message.event-id, message.attachment); }
                                                    }
                                                }
                                            }
                                            if message.reaction != "" : Rectangle {
                                                width: 126px;
                                                height: 24px;
                                                border-radius: 8px;
                                                border-color: root.divider;
                                                border-width: 1px;
                                                background: root.panel;
                                                Text { text: message.reaction; color: root.ink; font-size: 11px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                        }
                    }
                    Rectangle {
                        height: (root.composer-mode == 0 ? 78px : 109px) + (root.attachment-busy ? 29px : 0px);
                        background: root.canvas;
                        if root.attachment-busy : HorizontalLayout {
                            x: 22px; y: root.composer-mode == 0 ? 2px : 33px;
                            width: parent.width - 44px; height: 28px; spacing: 8px;
                            Text {
                                text: root.attachment-status;
                                color: root.muted;
                                font-size: 11px * root.text-scale;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                                accessible-live-region: polite;
                            }
                            if root.attachment-needs-retry : IconAction {
                                width: 27px; height: 26px; icon: "↻"; label: "Retry queued attachment";
                                ink: root.accent; surface: transparent; hover-surface: root.hover;
                                activated => { root.retry-attachment(); }
                            }
                            IconAction {
                                width: 27px; height: 26px; icon: "×"; label: "Cancel attachment upload";
                                ink: root.muted; surface: transparent; hover-surface: root.hover;
                                activated => { root.cancel-attachment(); }
                            }
                        }
                        if root.composer-mode != 0 : HorizontalLayout {
                            x: 20px; y: 4px; width: parent.width - 40px; height: 27px; spacing: 8px;
                            Text {
                                text: root.composer-mode == 1 ? "Replying to " + root.composer-target-label : "Editing your message";
                                color: root.accent; font-size: 11px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                            }
                            IconAction {
                                width: 26px; height: 25px; icon: "×"; label: "Cancel reply or edit";
                                ink: root.muted; surface: transparent; hover-surface: root.hover;
                                activated => {
                                    root.composer-mode = 0;
                                    root.composer-target-id = "";
                                    root.composer-target-label = "";
                                    root.composer-text = root.composer-saved-draft;
                                    root.composer-markdown = root.composer-saved-markdown;
                                    root.composer-saved-draft = "";
                                    root.composer-saved-markdown = false;
                                }
                            }
                        }
                        Rectangle {
                            x: 18px;
                            y: (root.composer-mode == 0 ? 7px : 38px) + (root.attachment-busy ? 29px : 0px);
                            width: parent.width - 36px;
                            height: 58px;
                            border-radius: 11px;
                            border-color: root.divider;
                            border-width: 1px;
                            background: root.elevated;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                IconAction {
                                    icon: "+"; label: "Attach file"; ink: root.muted; surface: transparent; hover-surface: root.hover;
                                    enabled: root.live-session && root.active-room-id != "" && root.composer-mode == 0 && !root.attachment-busy;
                                    activated => { root.attach-file(); }
                                }
                                IconAction {
                                    width: 38px;
                                    icon: "Md";
                                    label: root.composer-markdown ? "Clear Markdown formatting" : "Use Markdown formatting";
                                    selected: root.composer-markdown;
                                    ink: root.composer-markdown ? root.accent : root.muted;
                                    surface: transparent; hover-surface: root.hover;
                                    enabled: root.active-room-id != "" && !root.composer-busy;
                                    activated => {
                                        root.composer-markdown = !root.composer-markdown;
                                        if root.composer-mode == 0 {
                                            root.composer-formatting-changed(root.composer-markdown);
                                        }
                                        message-input.focus();
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    clip: true;
                                    if root.composer-text == "" : Text {
                                        x: 3px;
                                        text: root.composer-mode == 1 ? "Write a reply" : root.composer-mode == 2 ? "Edit your message" : "Message #" + root.active-room-name;
                                        color: root.muted;
                                        font-size: 13px * root.text-scale;
                                        vertical-alignment: center;
                                    }
                                    message-input := TextInput {
                                        x: 3px;
                                        width: parent.width - 6px;
                                        height: parent.height;
                                        text <=> root.composer-text;
                                        color: root.ink;
                                        font-size: 13px * root.text-scale;
                                        vertical-alignment: center;
                                        accessible-label: root.composer-mode == 1 ? "Reply to " + root.composer-target-label : root.composer-mode == 2 ? "Edit your message" : "Message composer for " + root.active-room-name;
                                        edited => {
                                            root.composer-edited(root.composer-text);
                                        }
                                        accepted => {
                                            root.send-message(root.composer-text);
                                        }
                                    }
                                }
                                IconAction {
                                    icon: "➤"; label: root.composer-mode == 2 ? "Save edit" : root.composer-mode == 1 ? "Send reply" : "Send message"; ink: root.accent;
                                    surface: transparent; hover-surface: root.hover;
                                    activated => { root.send-message(root.composer-text); }
                                }
                            }
                        }
                    }
                }

                if root.page == 3 : VerticalLayout {
                    vertical-stretch: 1;
                    padding: 24px;
                    spacing: 14px;
                    Text {
                        text: "Find your next room";
                        color: root.ink; font-size: 24px * root.text-scale; font-weight: 780;
                    }
                    Text {
                        text: "Search public rooms through your current homeserver. A remote server name is optional.";
                        color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap;
                    }
                    if !root.live-session : Text {
                        text: "Sign in to a Matrix account to search and join rooms.";
                        color: root.accent; font-size: 13px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    Text { text: "SEARCH PUBLIC DIRECTORY"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; letter-spacing: 1px; }
                    HorizontalLayout {
                        height: 39px; spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 2; height: 39px;
                            background: root.elevated; border-radius: 8px;
                            if root.directory-search == "" : Text {
                                x: 10px; width: parent.width - 20px; height: parent.height;
                                text: "Room name or topic"; color: root.muted;
                                font-size: 12px * root.text-scale; vertical-alignment: center;
                            }
                            directory-search-input := TextInput {
                                x: 10px; y: 2px; width: parent.width - 20px; height: parent.height - 4px;
                                text <=> root.directory-search;
                                color: root.ink; font-size: 13px * root.text-scale;
                                enabled: root.live-session && !root.directory-loading;
                                accessible-label: "Public room search terms";
                                accepted => { if root.live-session && !root.directory-loading { root.query-public-rooms(false); } }
                            }
                        }
                        Rectangle {
                            width: 190px; height: 39px;
                            background: root.elevated; border-radius: 8px;
                            if root.directory-server == "" : Text {
                                x: 10px; width: parent.width - 20px; height: parent.height;
                                text: "Server (optional)"; color: root.muted;
                                font-size: 12px * root.text-scale; vertical-alignment: center;
                            }
                            TextInput {
                                x: 10px; y: 2px; width: parent.width - 20px; height: parent.height - 4px;
                                text <=> root.directory-server;
                                color: root.ink; font-size: 12px * root.text-scale;
                                enabled: root.live-session && !root.directory-loading;
                                accessible-label: "Optional remote Matrix server name";
                                accepted => { if root.live-session && !root.directory-loading { root.query-public-rooms(false); } }
                            }
                        }
                        Button {
                            width: 93px; text: root.directory-loading ? "Searching…" : "Search";
                            accessible-label: "Search public Matrix rooms";
                            enabled: root.live-session && !root.directory-loading;
                            clicked => { root.query-public-rooms(false); }
                        }
                    }
                    Text {
                        text: "Leave search blank to browse. For a remote directory, enter its server name without https://.";
                        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                    }
                    if root.directory-error != "" : Text {
                        text: root.directory-error; color: #ff8d9d;
                        font-size: 12px * root.text-scale; wrap: word-wrap;
                        accessible-live-region: polite;
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    Text { text: "JOIN BY ROOM ID, ALIAS, OR MATRIX LINK"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; letter-spacing: 1px; }
                    HorizontalLayout {
                        height: 39px; spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1; height: 39px;
                            background: root.elevated; border-radius: 8px;
                            if root.directory-join-input == "" : Text {
                                x: 10px; width: parent.width - 20px; height: parent.height;
                                text: "#room:server or matrix.to link"; color: root.muted;
                                font-size: 12px * root.text-scale; vertical-alignment: center;
                            }
                            TextInput {
                                x: 10px; y: 2px; width: parent.width - 20px; height: parent.height - 4px;
                                text <=> root.directory-join-input;
                                color: root.ink; font-size: 12px * root.text-scale;
                                enabled: root.live-session && !root.directory-join-busy;
                                accessible-label: "Room ID, room alias, or Matrix link to join";
                                accepted => { if root.live-session && !root.directory-join-busy { root.join-discovery-target(root.directory-join-input, "", "", "", false); } }
                            }
                        }
                        Button {
                            width: 93px; text: root.directory-join-busy ? "Joining…" : "Join";
                            accessible-label: "Join room by Matrix link or alias";
                            enabled: root.live-session && !root.directory-join-busy;
                            clicked => { root.join-discovery-target(root.directory-join-input, "", "", "", false); }
                        }
                    }
                    if root.directory-join-error != "" : Text {
                        text: root.directory-join-error; color: #ff8d9d;
                        font-size: 12px * root.text-scale; wrap: word-wrap;
                        accessible-live-region: polite;
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    HorizontalLayout {
                        height: 27px; spacing: 8px;
                        Text {
                            text: "PUBLIC ROOMS · " + root.directory-results.length;
                            color: root.ink; font-size: 12px * root.text-scale; font-weight: 750;
                            vertical-alignment: center; horizontal-stretch: 1;
                        }
                        if root.directory-next-batch != "" : Button {
                            width: 105px; text: root.directory-loading ? "Loading…" : "Load more";
                            accessible-label: "Load more public rooms";
                            enabled: !root.directory-loading && !root.directory-join-busy;
                            clicked => { root.query-public-rooms(true); }
                        }
                    }
                    if root.directory-loading : Text {
                        text: root.directory-results.length == 0 ? "Searching the public room directory…" : "Loading more rooms…";
                        color: root.muted; font-size: 12px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    if root.live-session && !root.directory-searched && !root.directory-loading : Text {
                        text: "Search to browse public rooms for this account.";
                        color: root.muted; font-size: 12px * root.text-scale;
                    }
                    if root.directory-searched && !root.directory-loading && root.directory-error == "" && root.directory-results.length == 0 : Text {
                        text: "No public rooms matched. Try another term or server.";
                        color: root.muted; font-size: 12px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    directory-list := ListView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        for room in root.directory-results : Rectangle {
                            width: directory-list.visible-width; height: 101px;
                            background: root.elevated; border-radius: 9px;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 12px; padding-top: 10px; padding-bottom: 10px;
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: 5px;
                                    Text {
                                        text: (room.is-space ? "◇ " : "# ") + room.title;
                                        color: root.ink; font-size: 14px * root.text-scale;
                                        font-weight: 750; overflow: elide;
                                    }
                                    Text {
                                        text: room.alias != "" ? room.alias + " · " + room.members : room.members;
                                        color: root.accent; font-size: 11px * root.text-scale; overflow: elide;
                                    }
                                    Text {
                                        text: room.topic != "" ? room.topic : "No room topic";
                                        color: root.muted; font-size: 11px * root.text-scale; overflow: elide;
                                    }
                                }
                                Button {
                                    width: 76px; text: root.directory-join-busy && root.directory-joining-room-id == room.id ? "Joining…" : "Join";
                                    accessible-label: "Join public room " + room.title;
                                    enabled: root.live-session && !root.directory-join-busy;
                                    clicked => { root.join-discovery-target(room.id, room.canonical-alias, room.route-server, room.title, room.is-space); }
                                }
                            }
                        }
                    }
                }

                if root.page == 1 : ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: parent.width;
                        padding: 26px;
                        spacing: 18px;
                        Text { text: "Appearance"; color: root.ink; font-size: 24px * root.text-scale; font-weight: 780; }
                        Text { text: "Choose a theme that feels right in every room."; color: root.muted; font-size: 13px * root.text-scale; }
                        HorizontalLayout {
                            spacing: 12px;
                            for choice[index] in ["Dark", "Light", "High contrast", "System"] : Rectangle {
                                width: 128px;
                                height: 100px;
                                background: index == root.theme-mode ? root.hover : root.elevated;
                                border-color: index == root.theme-mode ? root.accent : root.divider;
                                border-width: index == root.theme-mode ? 2px : 1px;
                                border-radius: 11px;
                                accessible-role: button;
                                accessible-label: "Use " + choice + " theme";
                                accessible-action-default => { root.choose-theme(index); }
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 9px;
                                    Rectangle {
                                        height: 42px;
                                        border-radius: 6px;
                                        background: index == 1 ? #e6eaf2 : #11151f;
                                        Rectangle {
                                            x: 8px; y: 8px; width: 30px; height: 26px; border-radius: 4px;
                                            background: index == 2 ? #ffff00 : #a88cff;
                                        }
                                    }
                                    Text { text: choice; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; overflow: elide; }
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { root.choose-theme(index); } }
                            }
                        }
                        Rectangle {
                            height: 70px; border-radius: 10px; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 9px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Font scale"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: root.font-scale-percent + "% · text throughout the app"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                IconAction { icon: "−"; label: "Decrease font scale"; ink: root.ink; surface: root.panel; hover-surface: root.hover; activated => { root.change-font-scale(root.font-scale-percent - 10); } }
                                IconAction { icon: "+"; label: "Increase font scale"; ink: root.ink; surface: root.panel; hover-surface: root.hover; activated => { root.change-font-scale(root.font-scale-percent + 10); } }
                            }
                        }
                        Text { text: "Density"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 10px;
                            for choice[index] in ["Compact", "Comfortable", "Spacious"] : Rectangle {
                                width: 142px; height: 40px; border-radius: 9px;
                                background: index == root.density-mode ? root.hover : root.elevated;
                                border-color: index == root.density-mode ? root.accent : root.divider;
                                border-width: index == root.density-mode ? 2px : 1px;
                                accessible-role: button;
                                accessible-label: "Use " + choice + " room and message density";
                                accessible-action-default => { root.choose-density(index); }
                                Text { text: choice; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.choose-density(index); } }
                            }
                        }
                        Rectangle { height: 1px; background: root.divider; }
                        Text { text: "Layout"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Rectangle {
                            height: 70px; border-radius: 10px; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Members & thread panel"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: "Show room context beside the conversation"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                IconAction {
                                    icon: root.show-side-panel ? "✓" : "+";
                                    label: root.show-side-panel ? "Hide side panel" : "Show side panel";
                                    ink: root.accent; surface: root.panel; hover-surface: root.hover;
                                    activated => { root.set-side-panel(!root.show-side-panel); }
                                }
                            }
                        }
                        Rectangle {
                            height: 70px; border-radius: 10px; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 9px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Room list width"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: root.room-list-width + " px"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                IconAction { icon: "−"; label: "Narrow room list"; ink: root.ink; surface: root.panel; hover-surface: root.hover; activated => { root.change-room-list-width(root.room-list-width - 20); } }
                                IconAction { icon: "+"; label: "Widen room list"; ink: root.ink; surface: root.panel; hover-surface: root.hover; activated => { root.change-room-list-width(root.room-list-width + 20); } }
                            }
                        }
                        Rectangle {
                            height: 70px; border-radius: 10px; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 9px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Details panel width"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: root.details-width + " px"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                IconAction { icon: "−"; label: "Narrow details panel"; ink: root.ink; surface: root.panel; hover-surface: root.hover; activated => { root.change-details-width(root.details-width - 20); } }
                                IconAction { icon: "+"; label: "Widen details panel"; ink: root.ink; surface: root.panel; hover-surface: root.hover; activated => { root.change-details-width(root.details-width + 20); } }
                            }
                        }
                        Rectangle {
                            height: 70px; border-radius: 10px; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Unread rooms first"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: "Move unread rooms and DMs to the top of each list"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                IconAction {
                                    icon: root.sort-unread-first ? "✓" : "+";
                                    label: root.sort-unread-first ? "Turn off unread first sorting" : "Turn on unread first sorting";
                                    ink: root.accent; surface: root.panel; hover-surface: root.hover;
                                    activated => { root.set-sort-unread-first(!root.sort-unread-first); }
                                }
                            }
                        }
                        Rectangle {
                            height: 70px; border-radius: 10px; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 9px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Timeline performance preview"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: root.stress-timeline-active ? "10,000 synthetic messages loaded" : "Test variable-height messages at scale"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                IconAction {
                                    icon: root.stress-timeline-active ? "✓" : "10k";
                                    label: root.stress-timeline-active ? "Restore preview messages" : "Load 10,000 preview messages";
                                    ink: root.accent; surface: root.panel; hover-surface: root.hover;
                                    activated => { root.toggle-stress-timeline(); }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: root.divider; }
                        Text { text: "Notifications"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Notifications are shown for the active account while Morpheus runs. These preferences are shared by all accounts; room rules still come from Matrix."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        ActionRect {
                            height: 68px; border-radius: 10px; background: root.elevated; focus-color: root.accent;
                            label: "Desktop notifications";
                            accessible-checkable: true; accessible-checked: root.notifications-enabled;
                            activated => { root.set-notifications-enabled(!root.notifications-enabled); }
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Desktop notifications"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: root.notifications-enabled ? "On" : "Off"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                Text { text: root.notifications-enabled ? "✓" : "○"; color: root.accent; font-size: 20px * root.text-scale; vertical-alignment: center; }
                            }
                        }
                        ActionRect {
                            height: 68px; border-radius: 10px; background: root.elevated; focus-color: root.accent;
                            label: "Notification sounds";
                            accessible-checkable: true; accessible-checked: root.notification-sounds;
                            activated => { root.set-notification-sounds(!root.notification-sounds); }
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Sounds"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: "Play when the Matrix push rule requests a sound"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                Text { text: root.notification-sounds ? "✓" : "○"; color: root.accent; font-size: 20px * root.text-scale; vertical-alignment: center; }
                            }
                        }
                        ActionRect {
                            height: 68px; border-radius: 10px; background: root.elevated; focus-color: root.accent;
                            label: "Show message previews in desktop notifications";
                            accessible-checkable: true; accessible-checked: root.notification-show-preview;
                            activated => { root.set-notification-show-preview(!root.notification-show-preview); }
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Message previews"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: "May show decrypted text on your desktop"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                Text { text: root.notification-show-preview ? "✓" : "○"; color: root.accent; font-size: 20px * root.text-scale; vertical-alignment: center; }
                            }
                        }
                        Text { text: "Highlight words and phrases"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                        Text { text: "Local matches mark an approved notification as a highlight. They do not override muted rooms."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                        HorizontalLayout {
                            height: 38px; spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1; background: root.panel; border-radius: 8px; border-color: root.divider; border-width: 1px;
                                TextInput {
                                    x: 10px; width: parent.width - 20px; height: parent.height;
                                    text <=> root.notification-highlight-input;
                                    color: root.ink; font-size: 12px * root.text-scale;
                                    accessible-label: "New highlight word or phrase";
                                    edited => { root.notification-highlight-error = ""; }
                                    accepted => { root.add-highlight-word(root.notification-highlight-input); }
                                }
                            }
                            Button {
                                width: 78px; text: "Add"; enabled: root.notification-highlight-input != "";
                                accessible-label: "Add highlight word or phrase";
                                clicked => { root.add-highlight-word(root.notification-highlight-input); }
                            }
                        }
                        if root.notification-highlight-error != "" : Text {
                            text: root.notification-highlight-error; color: #e47483;
                            font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite;
                        }
                        for word in root.notification-highlight-words : Rectangle {
                            height: 36px; border-radius: 8px; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 8px; spacing: 8px;
                                Text { text: word; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                IconAction {
                                    icon: "×"; label: "Remove highlight " + word;
                                    ink: root.muted; surface: root.elevated; hover-surface: root.hover;
                                    activated => { root.remove-highlight-word(word); }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: root.divider; }
                        Text { text: "Accounts"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Select your account in the bottom-left corner to switch instantly."; color: root.muted; font-size: 13px * root.text-scale; wrap: word-wrap; }
                        Rectangle { height: 1px; background: root.divider; }
                        Text { text: "Security & recovery"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: root.live-session ? "Security for " + root.active-account-handle : "Sign in to inspect device verification and recovery."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        if root.live-session : VerticalLayout {
                            spacing: 11px;
                            Rectangle {
                                height: 116px; border-radius: 10px; background: root.elevated;
                                VerticalLayout {
                                    padding: 14px; spacing: 5px;
                                    HorizontalLayout {
                                        Text { text: "Account security"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; horizontal-stretch: 1; }
                                        Button { text: root.security-loading ? "Loading…" : "Refresh"; enabled: !root.security-loading && !root.security-busy; accessible-label: "Refresh account security status"; clicked => { root.refresh-security(); } }
                                    }
                                    Text { text: "This device: " + root.security-device-status; color: root.muted; font-size: 12px * root.text-scale; accessible-live-region: polite; }
                                    Text { text: "Recovery: " + root.security-recovery-status + "  ·  Key backup: " + root.security-backup-status; color: root.muted; font-size: 12px * root.text-scale; accessible-live-region: polite; }
                                }
                            }
                            if root.security-error != "" : Text { text: root.security-error; color: #e47483; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                            if root.security-notice != "" : Text { text: root.security-notice; color: root.accent; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                            Timer {
                                interval: 3s;
                                running: root.page == 1 && !root.sas-busy && (root.sas-stage == 1 || root.sas-stage == 3 || root.sas-stage == 5);
                                triggered => { root.refresh-sas-verification(); }
                            }
                            Timer {
                                interval: 3s;
                                running: root.page == 1 && root.sas-stage == 0 && !root.sas-incoming-loading && !root.security-busy;
                                triggered => { root.refresh-incoming-verification(); }
                            }
                            Rectangle {
                                height: (root.sas-stage == 4 ? 380px : root.sas-stage == 0 ? (root.sas-incoming-flow-id == "" ? 160px : 222px) : 250px) * root.text-scale;
                                border-radius: 10px; background: root.elevated;
                                VerticalLayout {
                                    padding: 14px; spacing: 7px;
                                    Text { text: "Verify this device"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    if root.sas-stage == 0 : Text {
                                        text: "Start here, then approve on another signed-in, verified device of this account. Compare the values on both devices before confirming.";
                                        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                                    }
                                    if root.sas-stage == 0 && root.sas-incoming-flow-id != "" : HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: "Another device on this account requested verification.";
                                            color: root.accent; font-size: 11px * root.text-scale;
                                            wrap: word-wrap; horizontal-stretch: 1;
                                            accessible-live-region: polite;
                                        }
                                        Button {
                                            text: root.sas-busy ? "Accepting…" : "Review request";
                                            enabled: !root.sas-busy && !root.security-busy;
                                            accessible-label: "Accept incoming verification request from another device on this account";
                                            clicked => { root.accept-incoming-verification(); }
                                        }
                                    }
                                    if root.sas-stage == 0 : Button {
                                        width: 178px; text: root.sas-busy ? "Starting…" : "Verify with another device";
                                        enabled: !root.sas-busy && !root.security-busy && root.security-recovery-key == "" && root.security-device-status == "Unverified";
                                        accessible-label: "Request SAS verification from another device on this Matrix account";
                                        clicked => { root.request-own-verification(); }
                                    }
                                    if root.sas-stage != 0 : Text {
                                        text: root.sas-stage == 1 ? (root.sas-request-initiator
                                            ? "Approve the verification request on your other device. Morpheus checks for its response while Settings is open."
                                            : "Request accepted. Waiting for the requesting device to start the comparison.")
                                            : root.sas-stage == 2 ? "The other device accepted. Start the short authentication string comparison."
                                            : root.sas-stage == 3 ? "Waiting for the other device to accept the comparison. Keep both devices open."
                                            : root.sas-stage == 4 ? "Compare every shown emoji or all three numbers with the other device. Confirm only if they match exactly."
                                            : "Your confirmation was sent. Waiting for the other device to finish.";
                                        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite;
                                    }
                                    if root.sas-stage == 4 && root.sas-emoji != "" : Text {
                                        text: root.sas-emoji; color: root.ink; font-size: 14px * root.text-scale;
                                        wrap: word-wrap; accessible-label: "SAS emoji comparison: " + root.sas-emoji;
                                    }
                                    if root.sas-stage == 4 && root.sas-decimals != "" : Text {
                                        text: "Numbers: " + root.sas-decimals; color: root.ink;
                                        font-family: "monospace"; font-size: 14px * root.text-scale;
                                        accessible-label: "SAS number comparison: " + root.sas-decimals;
                                    }
                                    if root.sas-stage == 4 : ActionRect {
                                        height: 38px; border-radius: 7px;
                                        background: root.sas-compared ? root.hover : root.panel;
                                        border-color: root.sas-compared ? root.accent : root.divider;
                                        border-width: 1px; focus-color: root.accent;
                                        label: "I compared these values on both devices and they match exactly";
                                        accessible-checkable: true; accessible-checked: root.sas-compared;
                                        enabled: !root.sas-busy;
                                        activated => { root.sas-compared = !root.sas-compared; }
                                        Text {
                                            x: 10px; width: parent.width - 20px; height: parent.height;
                                            text: (root.sas-compared ? "✓ " : "○ ") + "I compared both devices; the values match";
                                            color: root.ink; font-size: 11px * root.text-scale; vertical-alignment: center;
                                        }
                                    }
                                    if root.sas-error != "" : Text { text: root.sas-error; color: #e47483; font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                                    if root.sas-notice != "" : Text { text: root.sas-notice; color: root.accent; font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                                    if root.sas-stage != 0 : HorizontalLayout {
                                        spacing: 8px;
                                        if root.sas-stage == 1 || root.sas-stage == 3 || root.sas-stage == 5 : Button {
                                            text: root.sas-busy ? "Checking…" : "Check status";
                                            enabled: !root.sas-busy;
                                            accessible-label: "Check device verification progress";
                                            clicked => { root.refresh-sas-verification(); }
                                        }
                                        if root.sas-stage == 2 : Button {
                                            text: root.sas-busy ? "Starting…" : "Start comparison";
                                            enabled: !root.sas-busy;
                                            accessible-label: "Start or accept SAS comparison on this device";
                                            clicked => { root.start-sas-verification(); }
                                        }
                                        if root.sas-stage == 4 : Button {
                                            text: root.sas-busy ? "Confirming…" : "Confirm match";
                                            primary: true; enabled: root.sas-compared && !root.sas-busy;
                                            accessible-label: "Confirm that SAS values match on both devices";
                                            clicked => { root.confirm-sas-verification(); }
                                        }
                                        Button {
                                            text: root.sas-stage == 4 ? "Values differ / cancel" : "Cancel verification";
                                            enabled: !root.sas-busy;
                                            accessible-label: root.sas-stage == 4 ? "The SAS values differ; cancel verification" : "Cancel this verification request";
                                            clicked => { root.cancel-sas-verification(); }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 108px; border-radius: 10px; background: root.elevated;
                                VerticalLayout {
                                    padding: 14px; spacing: 8px;
                                    Text { text: "Set up recovery"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: "Creates a recovery key for encrypted history. Save it in a password manager or another private place; Morpheus shows it only once."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                                    Button {
                                        width: 170px; text: root.security-busy ? "Working…" : "Create recovery key";
                                        primary: true; enabled: root.security-can-enable && !root.security-busy && !root.security-loading && root.security-recovery-key == "" && root.sas-stage == 0 && !root.sas-busy;
                                        accessible-label: "Create and reveal a one-time Matrix recovery key";
                                        clicked => { root.enable-recovery(); }
                                    }
                                }
                            }
                            Text { text: "If recovery is incomplete, use your existing recovery key below. Setup is available when recovery is disabled."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                            Rectangle {
                                height: 128px; border-radius: 10px; background: root.elevated;
                                VerticalLayout {
                                    padding: 14px; spacing: 8px;
                                    Text { text: "Recover this device"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: "Enter a recovery key or passphrase from your existing account. The input is cleared when submitted or when you leave Settings."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            height: 38px; horizontal-stretch: 1; background: root.panel; border-radius: 8px; border-color: root.divider; border-width: 1px;
                                            TextInput {
                                                x: 10px; width: parent.width - 20px; height: parent.height;
                                                text <=> root.security-recovery-input; input-type: password;
                                                enabled: root.sas-stage == 0 && !root.sas-busy && !root.security-busy;
                                                color: root.ink; font-size: 12px * root.text-scale;
                                                accessible-label: "Recovery key or passphrase";
                                                accepted => {
                                                    if !root.security-busy && root.security-recovery-input != "" {
                                                        let secret = root.security-recovery-input;
                                                        root.security-recovery-input = "";
                                                        root.recover-account(secret);
                                                    }
                                                }
                                            }
                                        }
                                        Button {
                                            width: 96px; text: root.security-busy ? "Working…" : "Recover";
                                            enabled: root.sas-stage == 0 && !root.sas-busy && !root.security-busy && !root.security-loading && root.security-recovery-input != "";
                                            accessible-label: "Recover this Matrix device with the entered key or passphrase";
                                            clicked => {
                                                let secret = root.security-recovery-input;
                                                root.security-recovery-input = "";
                                                root.recover-account(secret);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: root.divider; }
                        Text { text: "Advanced customization"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Edit your settings and theme pack files. Valid changes appear here automatically."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        Text { text: root.config-path; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                        Rectangle { height: 1px; background: root.divider; }
                        Text { text: "About"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Morpheus is an open-source Matrix desktop client."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        Text { text: "Interface powered by Slint · slint.dev"; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        AboutSlint { }
                    }
                }

                if root.page == 2 : VerticalLayout {
                    vertical-stretch: 1;
                    padding: 24px;
                    spacing: 16px;
                    Text {
                        text: root.live-session
                            ? ((root.active-voice-local || root.active-voice-shared ? "Voice space · " : "Room call · ") + (root.call-connected ? root.native-call-room-display : root.active-room-name))
                            : "The Workshop · Lounge";
                        color: root.ink; font-size: 21px * root.text-scale;
                        font-weight: 760; overflow: elide;
                    }
                    if root.live-session && root.call-connected && root.active-room-id != root.native-call-room-id : Text {
                        text: "This call is in a different room. The controls and participants below still belong to that call.";
                        color: root.muted; font-size: 11px * root.text-scale;
                        wrap: word-wrap; accessible-live-region: polite;
                    }
                    Text {
                        text: root.live-session
                            ? (root.native-call-enabled
                                ? (root.native-call-joined
                                    ? (root.native-audio-failed
                                        ? "Room call joined · local audio unavailable"
                                        : (root.native-audio-ready
                                        ? "Room call joined · microphone and speaker ready"
                                        : "Room call joined · preparing local audio…"))
                                    : root.native-call-status)
                                : "Native calls are unavailable in this build")
                            : (root.call-connected ? "Call preview active · no network connection" : "Call preview · no network connection");
                        accessible-live-region: polite;
                        color: root.muted; font-size: 12px * root.text-scale;
                    }
                    if root.live-session && root.native-camera-active : Text {
                        text: "Camera · " + root.native-camera-source;
                        color: root.muted; font-size: 11px * root.text-scale;
                        overflow: elide; accessible-live-region: polite;
                    }
                    if root.live-session && root.native-screen-active : Text {
                        text: "Sharing · " + root.native-screen-source;
                        color: root.muted; font-size: 11px * root.text-scale;
                        overflow: elide; accessible-live-region: polite;
                    }
                    if root.live-session && root.native-capture-error != "" : Text {
                        text: root.native-capture-error;
                        color: #ef9da9; font-size: 11px * root.text-scale;
                        wrap: word-wrap; accessible-live-region: polite;
                    }
                    if root.live-session && root.native-camera-error != "" : Text {
                        text: "Camera: " + root.native-camera-error;
                        color: #ef9da9; font-size: 11px * root.text-scale;
                        wrap: word-wrap; accessible-live-region: polite;
                    }
                    if root.live-session && root.native-screen-error != "" : Text {
                        text: "Screen share: " + root.native-screen-error;
                        color: #ef9da9; font-size: 11px * root.text-scale;
                        wrap: word-wrap; accessible-live-region: polite;
                    }
                    if root.live-session && root.native-call-enabled : ActionRect {
                        height: 60px; border-radius: 10px;
                        background: root.element-call-compatibility ? root.hover : root.panel;
                        border-color: root.element-call-compatibility ? root.accent : root.divider;
                        border-width: 1px; focus-color: root.accent;
                        label: "Use legacy Element Call mode for this room and account";
                        accessible-checkable: true;
                        accessible-checked: root.element-call-compatibility;
                        enabled: !root.call-connected && root.active-room-id != "";
                        activated => { root.choose-element-call-legacy(!root.element-call-compatibility); }
                        VerticalLayout {
                            padding-left: 14px; padding-right: 14px; alignment: center; spacing: 3px;
                            Text {
                                text: (root.element-call-compatibility ? "✓ " : "○ ") + "Legacy Element Call for this room";
                                color: root.ink; font-size: 12px * root.text-scale; font-weight: 700;
                            }
                            Text {
                                text: "Saved for this account. Older room-state calls only; room power may be required.";
                                color: root.muted; font-size: 11px * root.text-scale; overflow: elide;
                            }
                        }
                    }
                    if root.live-session : Rectangle {
                        vertical-stretch: 1; background: root.elevated; border-radius: 14px;
                        if root.native-video-visible : Image {
                            x: 12px; y: 12px;
                            width: parent.width - 248px; height: parent.height - 24px;
                            source: root.native-video-frame;
                            image-fit: contain;
                        }
                        if root.native-video-visible : Rectangle {
                            x: 20px; y: 20px; width: 330px; height: 32px;
                            background: root.panel; border-radius: 8px;
                            Text {
                                x: 10px; width: parent.width - 20px; height: parent.height;
                                text: root.native-video-source;
                                color: root.ink; font-size: 12px * root.text-scale;
                                vertical-alignment: center; overflow: elide;
                            }
                        }
                        if !root.native-video-visible : VerticalLayout {
                            x: 28px; y: (parent.height - 132px) / 2;
                            width: parent.width - 276px; height: 132px;
                            alignment: center; spacing: 12px;
                            Text {
                                text: root.call-connected ? "Waiting for participant video" : (root.element-call-compatibility ? "Join the legacy room call" : "Join the room call");
                                color: root.ink; font-size: 19px * root.text-scale;
                                font-weight: 700; horizontal-alignment: center;
                            }
                            Text {
                                text: root.native-call-enabled
                                    ? "Remote cameras and screen shares appear here when a participant publishes them."
                                    : "This build does not include the native media backend.";
                                color: root.muted; font-size: 13px * root.text-scale; wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                        }
                        Rectangle {
                            x: parent.width - 224px; y: 12px;
                            width: 212px; height: parent.height - 24px;
                            background: root.panel; border-radius: 11px;
                            Text {
                                x: 12px; y: 10px; width: parent.width - 24px; height: 24px;
                                text: "PARTICIPANTS · " + root.native-call-participants.length;
                                color: root.muted; font-size: 10px * root.text-scale;
                                font-weight: 750; letter-spacing: 1px;
                                accessible-live-region: polite;
                            }
                            if root.native-call-participants.length == 0 : Text {
                                x: 12px; y: 44px; width: parent.width - 24px;
                                text: "Nobody is in this call yet";
                                color: root.muted; font-size: 11px * root.text-scale;
                                wrap: word-wrap;
                            }
                            call-roster := ListView {
                                x: 10px; y: 42px;
                                width: parent.width - 20px; height: parent.height - 52px;
                                horizontal-scrollbar-policy: always-off;
                                for participant in root.native-call-participants : Rectangle {
                                    width: call-roster.visible-width; height: 52px;
                                    background: transparent;
                                    VerticalLayout {
                                        padding-left: 4px; padding-right: 4px;
                                        alignment: center; spacing: 3px;
                                        Text {
                                            text: participant.is-local ? "You · " + participant.name : participant.name;
                                            color: root.ink; font-size: 11px * root.text-scale;
                                            font-weight: 700; overflow: elide;
                                        }
                                        Text {
                                            text: participant.detail;
                                            color: root.muted; font-size: 10px * root.text-scale;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                        if root.native-call-enabled && !root.call-connected && !root.element-call-compatibility : ActionRect {
                            x: (parent.width - 220px - 176px) / 2; y: parent.height - 76px;
                            width: 176px; height: 42px; border-radius: 9px;
                            background: root.hover; border-color: root.divider; border-width: 1px;
                            focus-color: root.accent;
                            label: "Open MatrixRTC call in selected room";
                            activated => { root.open-native-call-slot(); }
                            Text { text: "Open room call"; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    if !root.live-session : HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 12px;
                        Rectangle {
                            horizontal-stretch: 1; background: root.elevated; border-radius: 14px;
                            AvatarBadge { x: (parent.width - 74px) / 2; y: (parent.height - 74px) / 2 - 16px; width: 74px; height: 74px; border-radius: 24px; initials: "AM"; accent: #a88cff; }
                            Text { y: parent.height - 43px; text: "Alex"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; horizontal-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1; background: root.elevated; border-radius: 14px;
                            AvatarBadge { x: (parent.width - 74px) / 2; y: (parent.height - 74px) / 2 - 16px; width: 74px; height: 74px; border-radius: 24px; initials: "JN"; accent: #f39f78; }
                            Text { y: parent.height - 43px; text: "Jules"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; horizontal-alignment: center; }
                        }
                    }
                    if !root.live-session : HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 12px;
                        Rectangle {
                            horizontal-stretch: 1; background: root.elevated; border-radius: 14px;
                            AvatarBadge { x: (parent.width - 74px) / 2; y: (parent.height - 74px) / 2 - 16px; width: 74px; height: 74px; border-radius: 24px; initials: "SK"; accent: #78c8b1; }
                            Text { y: parent.height - 43px; text: "Sam"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; horizontal-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1; background: root.panel; border-radius: 14px;
                            Text { text: "Your camera is off"; color: root.muted; font-size: 13px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    Rectangle {
                        height: 62px; background: root.panel; border-radius: 12px;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
                            if !root.live-session : IconAction { width: 43px; height: 43px; icon: root.mic-muted ? "✕" : "♩"; label: root.mic-muted ? "Unmute microphone preview" : "Mute microphone preview"; ink: root.ink; surface: root.elevated; hover-surface: root.hover; activated => { root.mic-muted = !root.mic-muted; } }
                            if !root.live-session : IconAction { width: 43px; height: 43px; icon: "V"; label: root.camera-off ? "Turn camera preview on" : "Turn camera preview off"; ink: root.ink; surface: root.elevated; hover-surface: root.hover; activated => { root.camera-off = !root.camera-off; } }
                            if root.live-session : ActionRect {
                                width: 88px; height: 43px; border-radius: 9px;
                                background: root.native-microphone-muted && root.native-audio-ready ? root.hover : root.elevated;
                                focus-color: root.accent;
                                label: root.native-microphone-muted ? "Unmute microphone" : "Mute microphone";
                                enabled: root.native-call-enabled && root.native-audio-ready;
                                activated => { root.toggle-native-microphone(); }
                                Text {
                                    text: root.native-microphone-muted ? "Unmute mic" : "Mute mic";
                                    color: root.native-audio-ready ? root.ink : root.muted;
                                    font-size: 12px * root.text-scale; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            if root.live-session : ActionRect {
                                width: 88px; height: 43px; border-radius: 9px;
                                background: root.native-deafened && root.native-audio-ready ? root.hover : root.elevated;
                                focus-color: root.accent;
                                label: root.native-deafened ? "Undeafen speaker" : "Deafen speaker";
                                enabled: root.native-call-enabled && root.native-audio-ready;
                                activated => { root.toggle-native-deafen(); }
                                Text {
                                    text: root.native-deafened ? "Undeafen" : "Deafen";
                                    color: root.native-audio-ready ? root.ink : root.muted;
                                    font-size: 12px * root.text-scale; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            if root.live-session : ActionRect {
                                width: 96px; height: 43px; border-radius: 9px;
                                background: root.native-camera-active ? root.hover : root.elevated;
                                focus-color: root.accent;
                                label: root.native-camera-active ? "Stop camera" : "Choose camera and start video";
                                accessible-checkable: true;
                                accessible-checked: root.native-camera-active;
                                enabled: root.native-call-enabled && root.native-call-joined && !root.native-camera-busy;
                                activated => {
                                    if root.native-camera-active { root.stop-native-capture(0); }
                                    else {
                                        root.native-capture-picker-kind = 0;
                                        root.native-capture-picker-open = true;
                                        root.refresh-native-capture-sources(0);
                                    }
                                }
                                Text {
                                    text: root.native-camera-stopping ? "Stopping…" : root.native-camera-busy ? "Camera…" : root.native-camera-active ? "Stop camera" : "Camera";
                                    color: root.native-call-joined ? root.ink : root.muted;
                                    font-size: 11px * root.text-scale; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            if root.live-session : ActionRect {
                                width: 106px; height: 43px; border-radius: 9px;
                                background: root.native-screen-active ? root.hover : root.elevated;
                                focus-color: root.accent;
                                label: root.native-screen-selecting ? "Cancel system screen selection" : root.native-screen-active ? "Stop screen sharing" : "Choose a display or window to share";
                                accessible-checkable: true;
                                accessible-checked: root.native-screen-active;
                                enabled: root.native-call-enabled && root.native-call-joined && (!root.native-screen-busy || root.native-screen-selecting);
                                activated => {
                                    if root.native-screen-active || root.native-screen-selecting { root.stop-native-capture(1); }
                                    else {
                                        root.native-capture-picker-kind = 1;
                                        root.native-capture-picker-open = true;
                                        root.refresh-native-capture-sources(1);
                                    }
                                }
                                Text {
                                    text: root.native-screen-stopping ? "Stopping…" : root.native-screen-selecting ? "Cancel selection" : root.native-screen-busy ? "Starting…" : root.native-screen-active ? "Stop share" : "Share screen";
                                    color: root.native-call-joined ? root.ink : root.muted;
                                    font-size: 11px * root.text-scale; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            ActionRect {
                                width: 110px; height: 43px; border-radius: 9px; background: root.live-session && !root.native-call-enabled ? root.hover : root.call-connected ? #d65163 : root.accent;
                                focus-color: root.ink;
                                label: root.live-session ? (root.native-leave-unconfirmed ? "Review incomplete call cleanup" : (root.call-connected ? "Leave native call" : "Join native call")) : (root.call-connected ? "End call preview" : "Start call preview");
                                enabled: !root.live-session || root.native-call-enabled;
                                activated => {
                                    if root.live-session {
                                        if root.native-call-enabled {
                                            if root.native-leave-unconfirmed { root.pending-account-index = -4; root.leave-call-dialog = true; }
                                            else if root.call-connected { root.end-native-call(); }
                                            else { root.start-native-call(); }
                                        }
                                    } else { root.call-connected = !root.call-connected; }
                                }
                                Text { text: root.live-session ? (root.native-call-enabled ? (root.native-leave-unconfirmed ? "Review leave" : (root.call-connected ? "Leave call" : (root.element-call-compatibility ? "Join legacy call" : "Join call"))) : "Unavailable") : (root.call-connected ? "End preview" : "Start preview"); color: #ffffff; font-size: 13px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            IconAction { width: 40px; height: 43px; icon: "R"; label: "Return to chat"; ink: root.ink; surface: root.elevated; hover-surface: root.hover; activated => { root.page = 0; } }
                        }
                    }
                }
            }
        }

        if root.show-side-panel && root.page == 0 : Rectangle {
            width: root.details-width * 1px;
            background: root.panel;
            border-color: root.divider;
            border-width: 1px;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 62px;
                    background: root.panel;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 4px;
                        ActionRect {
                            horizontal-stretch: 1; height: 34px; border-radius: 8px;
                            background: root.side-panel-tab == 0 ? root.hover : transparent;
                            focus-color: root.accent;
                            label: "Show members";
                            accessible-checkable: true;
                            accessible-checked: root.side-panel-tab == 0;
                            activated => { root.side-panel-tab = 0; }
                            Text { text: "Members"; color: root.side-panel-tab == 0 ? root.ink : root.muted; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        ActionRect {
                            horizontal-stretch: 1; height: 34px; border-radius: 8px;
                            background: root.side-panel-tab == 1 ? root.hover : transparent;
                            focus-color: root.accent;
                            label: "Show thread";
                            accessible-checkable: true;
                            accessible-checked: root.side-panel-tab == 1;
                            activated => { root.side-panel-tab = 1; }
                            Text { text: "Thread"; color: root.side-panel-tab == 1 ? root.ink : root.muted; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        ActionRect {
                            horizontal-stretch: 1; height: 34px; border-radius: 8px;
                            background: root.side-panel-tab == 2 ? root.hover : transparent;
                            focus-color: root.accent;
                            label: "Search messages in this room";
                            accessible-checkable: true;
                            accessible-checked: root.side-panel-tab == 2;
                            enabled: root.live-session && root.active-room-id != "";
                            activated => { root.side-panel-tab = 2; }
                            Text { text: "Search"; color: root.side-panel-tab == 2 ? root.ink : root.muted; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle { height: 1px; background: root.divider; }
                if root.side-panel-tab == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;
                    HorizontalLayout {
                        height: 48px; padding-left: 12px; padding-right: 10px; spacing: 6px;
                        Text {
                            text: "ROOM MEMBERS — " + root.members.length;
                            color: root.muted; font-size: 10px * root.text-scale;
                            font-weight: 750; letter-spacing: 1px;
                            vertical-alignment: center; horizontal-stretch: 1;
                            accessible-live-region: polite;
                        }
                        if root.live-session : IconAction {
                            width: 28px; height: 28px;
                            icon: "↻"; label: "Refresh room members";
                            ink: root.muted; surface: root.panel; hover-surface: root.hover;
                            enabled: !root.member-loading && root.active-room-id != "";
                            activated => { root.refresh-room-members(); }
                        }
                    }
                    if root.live-session && root.member-loading : Text {
                        height: 32px; text: "Loading members…";
                        color: root.muted; font-size: 11px * root.text-scale;
                        horizontal-alignment: center; vertical-alignment: center;
                        accessible-live-region: polite;
                    }
                    if root.live-session && root.member-error != "" : Text {
                        height: 58px; text: root.member-error;
                        color: #d65163; font-size: 11px * root.text-scale;
                        wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
                        accessible-live-region: assertive;
                    }
                    if root.live-session && !root.member-loading && root.member-error == "" && root.members.length == 0 : Text {
                        height: 52px; text: "No members to show";
                        color: root.muted; font-size: 11px * root.text-scale;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    if root.live-session && root.active-room-id != "" : Text {
                        height: 21px; text: "INVITE BY MATRIX USER ID";
                        color: root.muted; font-size: 10px * root.text-scale;
                        font-weight: 700;
                    }
                    if root.live-session && root.active-room-id != "" : HorizontalLayout {
                        height: 42px; padding-left: 10px; padding-right: 10px; spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1; background: root.elevated;
                            border-radius: 7px; border-color: root.divider; border-width: 1px;
                            TextInput {
                                x: 7px; width: parent.width - 14px; height: parent.height;
                                text <=> root.member-invite-user-id;
                                color: root.ink; font-size: 11px * root.text-scale;
                                enabled: !root.member-action-busy;
                                accessible-label: "Matrix user ID to invite to this room";
                                accepted => {
                                    if root.member-invite-user-id != "" && !root.member-action-busy {
                                        root.submit-member-action(0, root.member-invite-user-id, "");
                                    }
                                }
                            }
                        }
                        Button {
                            width: 62px; text: "Invite";
                            enabled: !root.member-action-busy && root.member-invite-user-id != "";
                            accessible-label: "Invite Matrix user to this room";
                            clicked => { root.submit-member-action(0, root.member-invite-user-id, ""); }
                        }
                    }
                    if root.member-action-error != "" : Text {
                        height: 44px; text: root.member-action-error;
                        color: #e47483; font-size: 11px * root.text-scale;
                        wrap: word-wrap; accessible-live-region: polite;
                    }
                    if root.member-action-notice != "" : Text {
                        height: 26px; text: root.member-action-notice;
                        color: root.accent; font-size: 11px * root.text-scale;
                        overflow: elide; accessible-live-region: polite;
                    }
                    member-list := ListView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        for member in root.members : Rectangle {
                            width: member-list.visible-width; height: 55px;
                            background: transparent;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 9px;
                                AvatarBadge { width: 32px; height: 32px; border-radius: 11px; initials: member.initials; accent: member.accent; }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    Text { text: member.name; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; overflow: elide; }
                                    Text { text: member.detail; color: root.muted; font-size: 10px * root.text-scale; overflow: elide; }
                                }
                                if root.live-session : Button {
                                    width: 57px; text: "Manage";
                                    enabled: !root.member-action-busy;
                                    accessible-label: "Manage room member " + member.name;
                                    clicked => {
                                        root.member-selected-user-id = member.user-id;
                                        root.member-selected-name = member.name;
                                        root.member-selected-membership = member.membership;
                                        root.member-selected-power = member.power-level-text;
                                        root.member-selected-self = member.is-account-user;
                                        root.member-selected-creator = member.is-creator;
                                        root.member-action-error = "";
                                        root.member-action-notice = "";
                                    }
                                }
                                if !root.live-session : Rectangle { width: 7px; height: 7px; border-radius: 4px; background: member.online ? #64c9a7 : root.muted; }
                            }
                        }
                    }
                    if root.live-session && root.member-selected-user-id != "" : Rectangle {
                        height: root.member-selected-membership == "ban" ? 133px : 184px;
                        background: root.elevated; border-color: root.divider; border-width: 1px;
                        VerticalLayout {
                            padding: 9px; spacing: 5px;
                            HorizontalLayout {
                                Text {
                                    text: "Manage " + root.member-selected-name;
                                    color: root.ink; font-size: 11px * root.text-scale; font-weight: 700;
                                    horizontal-stretch: 1; overflow: elide;
                                }
                                member-manage-close := Button {
                                    width: 27px; height: 25px; text: "×";
                                    accessible-label: "Close member controls";
                                    clicked => { root.member-selected-user-id = ""; }
                                }
                            }
                            Text {
                                text: root.member-selected-user-id;
                                color: root.muted; font-size: 10px * root.text-scale;
                                overflow: elide;
                            }
                            if root.member-selected-membership != "ban" : HorizontalLayout {
                                height: 34px; spacing: 5px;
                                Rectangle {
                                    horizontal-stretch: 1; background: root.panel;
                                    border-radius: 7px; border-color: root.divider; border-width: 1px;
                                    TextInput {
                                        x: 7px; width: parent.width - 14px; height: parent.height;
                                        text <=> root.member-selected-power;
                                        color: root.ink; font-size: 11px * root.text-scale;
                                        enabled: !root.member-action-busy && !root.member-selected-creator;
                                        accessible-label: "Power level for selected room member";
                                    }
                                }
                                Button {
                                    width: 72px; text: "Set power";
                                    enabled: !root.member-action-busy && !root.member-selected-creator && root.member-selected-power != "";
                                    accessible-label: "Review power level change for " + root.member-selected-name;
                                    clicked => {
                                        root.member-confirm-kind = 4;
                                        root.member-confirm-user-id = root.member-selected-user-id;
                                        root.member-confirm-name = root.member-selected-name;
                                        root.member-confirm-value = root.member-selected-power;
                                        root.member-confirm-account-id = root.active-account-local-id;
                                        root.member-confirm-room-id = root.active-room-id;
                                        root.member-confirm-open = true;
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 34px; spacing: 6px;
                                if root.member-selected-membership == "ban" : Button {
                                    text: "Unban";
                                    enabled: !root.member-action-busy;
                                    accessible-label: "Review unban of " + root.member-selected-name;
                                    clicked => {
                                        root.member-confirm-kind = 3;
                                        root.member-confirm-user-id = root.member-selected-user-id;
                                        root.member-confirm-name = root.member-selected-name;
                                        root.member-confirm-value = "";
                                        root.member-confirm-account-id = root.active-account-local-id;
                                        root.member-confirm-room-id = root.active-room-id;
                                        root.member-confirm-open = true;
                                    }
                                }
                                if root.member-selected-membership != "ban" : Button {
                                    text: "Kick";
                                    enabled: !root.member-action-busy && !root.member-selected-self && !root.member-selected-creator;
                                    accessible-label: "Review kick of " + root.member-selected-name;
                                    clicked => {
                                        root.member-confirm-kind = 1;
                                        root.member-confirm-user-id = root.member-selected-user-id;
                                        root.member-confirm-name = root.member-selected-name;
                                        root.member-confirm-value = "";
                                        root.member-confirm-account-id = root.active-account-local-id;
                                        root.member-confirm-room-id = root.active-room-id;
                                        root.member-confirm-open = true;
                                    }
                                }
                                if root.member-selected-membership != "ban" : Button {
                                    text: "Ban";
                                    enabled: !root.member-action-busy && !root.member-selected-self && !root.member-selected-creator;
                                    accessible-label: "Review ban of " + root.member-selected-name;
                                    clicked => {
                                        root.member-confirm-kind = 2;
                                        root.member-confirm-user-id = root.member-selected-user-id;
                                        root.member-confirm-name = root.member-selected-name;
                                        root.member-confirm-value = "";
                                        root.member-confirm-account-id = root.active-account-local-id;
                                        root.member-confirm-room-id = root.active-room-id;
                                        root.member-confirm-open = true;
                                    }
                                }
                            }
                            Text {
                                text: "The homeserver checks your room permissions.";
                                color: root.muted; font-size: 10px * root.text-scale;
                            }
                        }
                    }
                }
                if root.side-panel-tab == 1 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;
                    HorizontalLayout {
                        height: 49px; padding-left: 14px; padding-right: 10px; spacing: 8px;
                        Text { text: "Thread"; color: root.ink; font-size: 17px * root.text-scale; font-weight: 750; horizontal-stretch: 1; vertical-alignment: center; }
                        if root.thread-root-id != "" : IconAction {
                            width: 28px; height: 28px; icon: "×"; label: "Close thread";
                            ink: root.muted; surface: root.panel; hover-surface: root.hover;
                            activated => {
                                root.thread-root-id = "";
                                root.thread-messages = [];
                                root.thread-composer-text = "";
                                root.close-thread();
                            }
                        }
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    if root.thread-root-id == "" : Text {
                        text: "Choose a message and open its thread.";
                        color: root.muted; font-size: 12px * root.text-scale;
                        wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
                        vertical-stretch: 1;
                    }
                    if root.thread-root-id != "" : ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: parent.width;
                            padding: 12px;
                            spacing: 10px;
                            alignment: start;
                            vertical-stretch: 0;
                            Text { text: root.thread-root-sender; color: root.ink; font-size: 12px * root.text-scale; font-weight: 750; vertical-stretch: 0; }
                            StyledText {
                                text: root.thread-root-rich-body;
                                default-color: root.ink;
                                default-font-size: 12px * root.text-scale;
                                link-color: root.accent;
                                accessible-role: text;
                                accessible-label: root.thread-root-rich-accessible-body;
                                link-clicked(url) => { root.open-message-link(url); }
                            }
                            Rectangle { height: 1px; background: root.divider; }
                            Text { text: "REPLIES · " + root.thread-messages.length; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; vertical-stretch: 0; }
                            for reply in root.thread-messages : Rectangle {
                                min-height: 43px;
                                vertical-stretch: 0;
                                background: root.elevated;
                                border-radius: 8px;
                                VerticalLayout {
                                    padding: 9px; spacing: 4px;
                                    Text { text: reply.sender + " · " + reply.time; color: root.accent; font-size: 11px * root.text-scale; font-weight: 700; }
                                    StyledText {
                                        text: reply.rich-body;
                                        default-color: root.ink;
                                        default-font-size: 12px * root.text-scale;
                                        link-color: root.accent;
                                        accessible-role: text;
                                        accessible-label: reply.rich-accessible-body;
                                        link-clicked(url) => { root.open-message-link(url); }
                                    }
                                }
                            }
                        }
                    }
                    if root.thread-root-id != "" : Rectangle {
                        height: 64px; background: root.panel;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 8px; spacing: 5px;
                            Rectangle {
                                horizontal-stretch: 1; background: root.elevated; border-radius: 8px;
                                thread-input := TextInput {
                                    x: 8px; width: parent.width - 16px; height: parent.height;
                                    text <=> root.thread-composer-text; color: root.ink; font-size: 12px * root.text-scale;
                                    accessible-label: "Reply in thread started by " + root.thread-root-sender;
                                    property <string> thread-context: root.thread-root-id;
                                    init => { self.focus(); }
                                    changed thread-context => { if self.thread-context != "" { self.focus(); } }
                                    accepted => { root.send-thread-message(root.thread-composer-text); }
                                }
                            }
                            IconAction {
                                icon: "➤"; label: "Send thread reply"; ink: root.accent;
                                surface: root.panel; hover-surface: root.hover;
                                activated => { root.send-thread-message(root.thread-composer-text); }
                            }
                        }
                    }
                }
                if root.side-panel-tab == 2 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;
                    Rectangle {
                        height: 123px;
                        background: root.panel;
                        VerticalLayout {
                            padding: 12px; spacing: 7px;
                            Text { text: "Search this room"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 750; }
                            Rectangle {
                                height: 34px; background: root.elevated; border-radius: 7px;
                                search-message-input := TextInput {
                                    x: 8px; y: 2px; width: parent.width - 16px; height: parent.height - 4px;
                                    text <=> root.room-search-query; color: root.ink; font-size: 12px * root.text-scale;
                                    enabled: root.live-session && root.active-room-id != "" && !root.room-search-loading;
                                    accessible-label: "Search terms for current room";
                                    init => { if root.live-session { self.focus(); } }
                                    accepted => { root.query-room-messages(); }
                                }
                            }
                            Button {
                                text: root.room-search-loading ? "Searching…" : "Search";
                                accessible-label: "Search messages in current room";
                                enabled: root.live-session && root.active-room-id != "" && !root.room-search-loading;
                                clicked => { root.query-room-messages(); }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    Text {
                        height: 43px; text: "Searches messages indexed on this device.";
                        color: root.muted; font-size: 11px * root.text-scale;
                        wrap: word-wrap; vertical-alignment: center;
                        x: 12px; width: parent.width - 24px;
                    }
                    if root.room-search-error != "" : Text {
                        height: 52px; text: root.room-search-error; color: #e58e9b;
                        font-size: 11px * root.text-scale; wrap: word-wrap;
                        accessible-live-region: polite;
                    }
                    if root.room-search-loading : Text {
                        height: 34px; text: "Searching this room…";
                        color: root.muted; font-size: 11px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    if root.room-search-searched && !root.room-search-loading && root.room-search-error == "" && root.room-search-results.length == 0 : Text {
                        height: 54px; text: "No indexed messages matched in this room.";
                        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                        accessible-live-region: polite;
                    }
                    if root.room-search-selected-event-id != "" : ScrollView {
                        height: 210px; horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: parent.width; padding: 12px; spacing: 8px;
                            Text { text: "MESSAGE CONTEXT"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; }
                            if root.room-search-context-loading : Text {
                                text: "Loading nearby messages…"; color: root.muted; font-size: 11px * root.text-scale;
                                accessible-live-region: polite;
                            }
                            if root.room-search-context-error != "" : Text {
                                text: root.room-search-context-error; color: #e58e9b;
                                font-size: 11px * root.text-scale; wrap: word-wrap;
                                accessible-live-region: polite;
                            }
                            if !root.room-search-context-loading && root.room-search-context-error == "" && root.room-search-context.length == 0 : Text {
                                text: root.room-search-selected-sender + " · " + root.room-search-selected-time;
                                color: root.accent; font-size: 11px * root.text-scale; wrap: word-wrap;
                            }
                            if !root.room-search-context-loading && root.room-search-context-error == "" && root.room-search-context.length == 0 : Text {
                                text: root.room-search-selected-body; color: root.ink;
                                font-size: 12px * root.text-scale; wrap: word-wrap;
                            }
                            for context in root.room-search-context : Rectangle {
                                min-height: 55px; background: context.event-id == root.room-search-selected-event-id ? root.hover : root.elevated;
                                border-radius: 7px;
                                VerticalLayout {
                                    padding: 8px; spacing: 3px;
                                    Text { text: context.sender + " · " + context.time; color: root.accent; font-size: 10px * root.text-scale; overflow: elide; }
                                    Text { text: context.body; color: root.ink; font-size: 11px * root.text-scale; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    Text {
                        height: 31px; text: "RESULTS · " + root.room-search-results.length;
                        color: root.muted; font-size: 10px * root.text-scale; font-weight: 750;
                        vertical-alignment: center;
                        x: 12px; width: parent.width - 24px;
                    }
                    search-results-list := ListView {
                        vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        for result in root.room-search-results : ActionRect {
                            width: search-results-list.visible-width; height: 94px;
                            border-radius: 8px; focus-color: root.accent;
                            background: result.event-id == root.room-search-selected-event-id ? root.hover : self.has-hover ? root.elevated : root.panel;
                            label: "Show message context from " + result.sender + " at " + result.time;
                            activated => {
                                root.room-search-selected-event-id = result.event-id;
                                root.room-search-selected-sender = result.sender;
                                root.room-search-selected-time = result.time;
                                root.room-search-selected-body = result.body;
                                root.open-search-result(result.event-id);
                            }
                            VerticalLayout {
                                padding: 9px; spacing: 4px;
                                Text { text: result.sender; color: root.accent; font-size: 11px * root.text-scale; font-weight: 700; overflow: elide; }
                                Text { text: result.time; color: root.muted; font-size: 10px * root.text-scale; overflow: elide; }
                                Text { text: result.preview; color: root.ink; font-size: 11px * root.text-scale; overflow: elide; }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.room-actions-open : FocusScope {
        focus-on-tab-navigation: false;
        init => { room-action-input.focus(); }
        capture-key-pressed(event) => {
            if root.room-action-busy && (event.text == Key.Tab || event.text == Key.Backtab) {
                accept
            } else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && room-action-close.has-focus {
                if root.live-session { room-action-submit.focus(); }
                else { room-action-cancel.focus(); }
                accept
            } else if event.text == Key.Tab && !event.modifiers.shift && (room-action-submit.has-focus || (!root.live-session && room-action-cancel.has-focus)) {
                room-action-close.focus();
                accept
            } else { reject }
        }
        key-pressed(event) => {
            if event.text == Key.Escape && !root.room-action-busy {
                root.room-actions-open = false;
                room-action-trigger.focus();
                accept
            } else { reject }
        }
        Rectangle {
            background: #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 462px) / 2;
                y: (parent.height - 342px) / 2;
                width: 462px;
                height: 342px;
                border-radius: 14px;
                border-color: root.divider;
                border-width: 1px;
                background: root.canvas;
                accessible-role: region;
                accessible-label: "Create or join a Matrix room";
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 31px;
                        Text { text: "Rooms and Spaces"; color: root.ink; font-size: 19px * root.text-scale; font-weight: 750; horizontal-stretch: 1; }
                        room-action-close := Button {
                            width: 34px; height: 31px; text: "×";
                            enabled: !root.room-action-busy;
                            accessible-label: "Close room actions";
                            clicked => { root.room-actions-open = false; room-action-trigger.focus(); }
                        }
                    }
                    HorizontalLayout {
                        height: 36px;
                        spacing: 5px;
                        for label[index] in ["Create room", "Join room", "Create Space"] : Button {
                            horizontal-stretch: 1;
                            text: label;
                            enabled: !root.room-action-busy;
                            accessible-label: label;
                            clicked => {
                                root.room-action-mode = index;
                                root.room-action-input = "";
                                root.room-action-error = "";
                            }
                        }
                    }
                    Text {
                        text: root.room-action-mode == 1 ? "Enter a room ID, alias, matrix.to link, or matrix: URI." : root.room-action-mode == 2 ? "Give your new private Space a name." : "Give your new private room a name.";
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 43px;
                        background: root.elevated;
                        border-radius: 8px;
                        room-action-input := TextInput {
                            x: 11px; width: parent.width - 22px; height: parent.height;
                            text <=> root.room-action-input;
                            color: root.ink;
                            font-size: 13px * root.text-scale;
                            enabled: !root.room-action-busy;
                            accessible-label: root.room-action-mode == 1 ? "Room ID, alias, or Matrix link" : "Room or Space name";
                            accepted => { if !root.room-action-busy { root.submit-room-action(root.room-action-mode, root.room-action-input); } }
                        }
                    }
                    Text {
                        text: root.live-session ? root.room-action-error : "Preview only · sign in to create or join rooms.";
                        accessible-live-region: polite;
                        color: root.live-session && root.room-action-error != "" ? #ff8d9d : root.muted;
                        font-size: 11px * root.text-scale;
                        wrap: word-wrap;
                        height: 40px;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        height: 38px;
                        spacing: 8px;
                        alignment: end;
                        room-action-cancel := Button {
                            width: 88px;
                            text: "Cancel";
                            enabled: !root.room-action-busy;
                            clicked => { root.room-actions-open = false; room-action-trigger.focus(); }
                        }
                        room-action-submit := Button {
                            width: 134px;
                            primary: true;
                            text: root.room-action-busy ? "Working…" : root.room-action-mode == 1 ? "Join room" : root.room-action-mode == 2 ? "Create Space" : "Create room";
                            accessible-label: root.room-action-mode == 1 ? "Join Matrix room" : root.room-action-mode == 2 ? "Create private Matrix Space" : "Create private Matrix room";
                            enabled: root.live-session && !root.room-action-busy;
                            clicked => { root.submit-room-action(root.room-action-mode, root.room-action-input); }
                        }
                    }
                }
            }
        }
    }

    if root.room-admin-open : FocusScope {
        init => { admin-close.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape && !root.room-admin-busy {
                root.room-admin-open = false;
                account-trigger.focus();
                accept
            } else { reject }
        }
        Rectangle {
            background: #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 480px) / 2;
                y: (parent.height - (root.room-admin-mode == 2 ? 325px : 430px)) / 2;
                width: 480px;
                height: root.room-admin-mode == 2 ? 325px : 430px;
                background: root.canvas;
                border-color: root.divider;
                border-width: 1px;
                border-radius: 14px;
                accessible-role: region;
                accessible-label: root.room-admin-mode == 2 ? "Confirm message redaction" : "Edit Matrix room details";
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: root.room-admin-mode == 2 ? "Redact this message?" : "Room details";
                        color: root.ink;
                        font-size: 19px * root.text-scale;
                        font-weight: 750;
                    }
                    if root.room-admin-mode == 2 : Text {
                        text: root.room-admin-event-preview;
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                        overflow: elide;
                        height: 48px;
                    }
                    if root.room-admin-mode == 2 : Text {
                        text: "This removes the message content for room members. Your homeserver decides whether you have permission.";
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                        height: 43px;
                    }
                    if root.room-admin-mode == 0 : Text {
                        text: "Room name";
                        color: root.ink;
                        font-size: 12px * root.text-scale;
                    }
                    if root.room-admin-mode == 0 : Rectangle {
                        height: 42px;
                        background: root.elevated;
                        border-radius: 8px;
                        TextInput {
                            x: 10px; width: parent.width - 20px; height: parent.height;
                            text <=> root.room-admin-name-input;
                            enabled: !root.room-admin-busy;
                            color: root.ink;
                            font-size: 13px * root.text-scale;
                            accessible-label: "Matrix room name";
                        }
                    }
                    if root.room-admin-mode == 0 : Button {
                        width: 128px; height: 35px; text: "Save name";
                        enabled: !root.room-admin-busy && root.room-admin-name-input != "";
                        clicked => {
                            if root.room-admin-account-id == root.active-account-local-id
                                && root.room-admin-room-id == root.active-room-id {
                                root.submit-room-admin(0, root.room-admin-name-input, "");
                            }
                        }
                    }
                    if root.room-admin-mode == 0 : Text {
                        text: "Room topic";
                        color: root.ink;
                        font-size: 12px * root.text-scale;
                    }
                    if root.room-admin-mode == 0 : Rectangle {
                        height: 42px;
                        background: root.elevated;
                        border-radius: 8px;
                        TextInput {
                            x: 10px; width: parent.width - 20px; height: parent.height;
                            text <=> root.room-admin-topic-input;
                            enabled: !root.room-admin-busy;
                            color: root.ink;
                            font-size: 13px * root.text-scale;
                            accessible-label: "Matrix room topic; blank clears it";
                        }
                    }
                    if root.room-admin-mode == 0 : Button {
                        width: 128px; height: 35px; text: "Save topic";
                        enabled: !root.room-admin-busy;
                        clicked => {
                            if root.room-admin-account-id == root.active-account-local-id
                                && root.room-admin-room-id == root.active-room-id {
                                root.submit-room-admin(1, root.room-admin-topic-input, "");
                            }
                        }
                    }
                    if root.room-admin-error != "" : Text {
                        text: root.room-admin-error;
                        color: #ff8d9d;
                        font-size: 11px * root.text-scale;
                        wrap: word-wrap;
                        accessible-live-region: polite;
                        height: 38px;
                    }
                    if root.room-admin-notice != "" : Text {
                        text: root.room-admin-notice;
                        color: root.accent;
                        font-size: 11px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 9px;
                        admin-close := Button {
                            width: 94px; height: 36px;
                            text: root.room-admin-mode == 2 ? "Cancel" : "Close";
                            enabled: !root.room-admin-busy;
                            clicked => { root.room-admin-open = false; account-trigger.focus(); }
                        }
                        if root.room-admin-mode == 2 : Button {
                            width: 145px; height: 36px;
                            primary: true;
                            text: root.room-admin-busy ? "Redacting…" : "Redact message";
                            enabled: !root.room-admin-busy;
                            clicked => {
                                if root.room-admin-account-id == root.active-account-local-id
                                    && root.room-admin-room-id == root.active-room-id {
                                    root.submit-room-admin(2, root.room-admin-event-id, "");
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.member-confirm-open : FocusScope {
        init => { cancel-member-action.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape && !root.member-action-busy {
                root.member-confirm-open = false;
                account-trigger.focus();
                accept
            } else { reject }
        }
        Rectangle {
            background: #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 430px) / 2;
                y: (parent.height - 220px) / 2;
                width: 430px; height: 220px;
                background: root.elevated; border-color: root.divider;
                border-width: 1px; border-radius: 14px;
                accessible-role: region;
                accessible-label: "Confirm room member action";
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    Text {
                        text: root.member-confirm-kind == 1 ? "Kick " + root.member-confirm-name + "?"
                            : root.member-confirm-kind == 2 ? "Ban " + root.member-confirm-name + "?"
                            : root.member-confirm-kind == 3 ? "Unban " + root.member-confirm-name + "?"
                            : "Change power for " + root.member-confirm-name + "?";
                        color: root.ink; font-size: 18px * root.text-scale;
                        font-weight: 750; wrap: word-wrap;
                    }
                    Text {
                        text: root.member-confirm-kind == 4
                            ? "Set this member's Matrix room power level to " + root.member-confirm-value + "."
                            : root.member-confirm-kind == 1
                            ? "Remove this member from the room. They may rejoin if room rules allow it."
                            : root.member-confirm-kind == 2
                            ? "Remove this member and prevent them from rejoining until unbanned."
                            : "Allow this member to join the room again.";
                        color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        alignment: end; spacing: 9px;
                        cancel-member-action := ActionRect {
                            width: 98px; height: 36px; border-radius: 8px;
                            background: root.panel; label: "Cancel member action";
                            trap-tab: true; cancel-on-escape: true;
                            next-focus => { confirm-member-action.focus(); }
                            previous-focus => { confirm-member-action.focus(); }
                            cancelled => { root.member-confirm-open = false; account-trigger.focus(); }
                            activated => { root.member-confirm-open = false; account-trigger.focus(); }
                            Text { text: "Cancel"; color: root.ink; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        confirm-member-action := ActionRect {
                            width: 128px; height: 36px; border-radius: 8px;
                            background: root.accent; label: "Confirm room member action";
                            trap-tab: true; cancel-on-escape: true;
                            next-focus => { cancel-member-action.focus(); }
                            previous-focus => { cancel-member-action.focus(); }
                            cancelled => { root.member-confirm-open = false; account-trigger.focus(); }
                            activated => {
                                if root.member-confirm-account-id == root.active-account-local-id
                                    && root.member-confirm-room-id == root.active-room-id {
                                    root.submit-member-action(root.member-confirm-kind, root.member-confirm-user-id, root.member-confirm-value);
                                }
                                root.member-confirm-open = false;
                                account-trigger.focus();
                            }
                            Text { text: "Confirm"; color: root.accent-ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }

    if root.native-capture-picker-open && root.page == 2 && root.live-session && root.native-call-joined : FocusScope {
        focus-on-tab-navigation: false;
        init => { capture-picker-close.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.native-capture-picker-open = false;
                accept
            } else { reject }
        }
        Rectangle {
            background: #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                width: 486px;
                height: 452px;
                x: (parent.width - 486px) / 2;
                y: (parent.height - 452px) / 2;
                background: root.canvas;
                border-color: root.divider;
                border-width: 1px;
                border-radius: 14px;
                accessible-role: region;
                accessible-label: root.native-capture-picker-kind == 0 ? "Choose a camera" : "Choose a display or window to share";
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 33px;
                        spacing: 8px;
                        Text {
                            text: root.native-capture-picker-kind == 0 ? "Choose a camera" : "Share a display or window";
                            color: root.ink;
                            font-size: 19px * root.text-scale;
                            font-weight: 750;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        capture-picker-close := Button {
                            width: 35px; height: 33px;
                            text: "×";
                            accessible-label: "Close capture source picker";
                            clicked => { root.native-capture-picker-open = false; }
                        }
                    }
                    Text {
                        text: root.native-capture-picker-kind == 0
                            ? "Your system may ask for camera access after you choose a source."
                            : "Only picture from the selected display or window is shared. Your microphone remains separate.";
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                    }
                    if root.native-capture-source-loading : Text {
                        text: "Looking for available sources…";
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    if root.native-capture-source-error != "" : Text {
                        text: root.native-capture-source-error;
                        color: #ef9da9;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                        accessible-live-region: polite;
                    }
                    capture-source-list := ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: capture-source-list.visible-width;
                            spacing: 6px;
                            for source in root.native-capture-sources : Rectangle {
                                height: ((root.native-capture-picker-kind == 0 && source.kind == 0)
                                    || (root.native-capture-picker-kind == 1 && source.kind != 0)) ? 48px : 0px;
                                background: transparent;
                                if (root.native-capture-picker-kind == 0 && source.kind == 0)
                                    || (root.native-capture-picker-kind == 1 && source.kind != 0) : ActionRect {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 8px;
                                    border-color: root.divider;
                                    border-width: 1px;
                                    background: root.elevated;
                                    focus-color: root.accent;
                                    label: source.kind == 0 ? "Use camera " + source.name
                                        : source.kind == 1 ? "Share display " + source.name
                                        : "Share window " + source.name;
                                    enabled: !root.native-capture-source-loading
                                        && !root.native-camera-busy && !root.native-screen-busy;
                                    activated => {
                                        root.native-capture-picker-open = false;
                                        root.start-native-capture(source.kind, source.id);
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        Text {
                                            text: source.kind == 0 ? "CAMERA" : source.kind == 1 ? "DISPLAY" : "WINDOW";
                                            color: root.accent;
                                            font-size: 10px * root.text-scale;
                                            font-weight: 750;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: source.name;
                                            color: root.ink;
                                            font-size: 12px * root.text-scale;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.native-capture-picker-kind == 0
                            ? "If a camera is missing, check system permissions and refresh this list."
                            : "A changed window title or display layout stops sharing. Choose the source again to resume.";
                        color: root.muted;
                        font-size: 11px * root.text-scale;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        alignment: end;
                        Button {
                            width: 105px;
                            text: "Refresh";
                            enabled: !root.native-capture-source-loading;
                            accessible-label: "Refresh available capture sources";
                            clicked => { root.refresh-native-capture-sources(root.native-capture-picker-kind); }
                        }
                        Button {
                            width: 90px;
                            text: "Cancel";
                            accessible-label: "Cancel capture source selection";
                            clicked => { root.native-capture-picker-open = false; }
                        }
                    }
                }
            }
        }
    }

    if root.leave-call-dialog : FocusScope {
        init => { cancel-leave.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape && !root.leave-call-busy {
                root.leave-call-dialog = false;
                root.pending-account-index = -1;
                account-trigger.focus();
                accept
            } else { reject }
        }
        Rectangle {
        background: #000000aa;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - 392px) / 2;
            y: (parent.height - 250px) / 2;
            width: 440px;
            height: 250px;
            background: root.elevated;
            border-color: root.divider;
            border-width: 1px;
            border-radius: 14px;
            accessible-role: region;
            accessible-label: root.native-leave-unconfirmed ? "Incomplete MatrixRTC call cleanup" : root.live-session ? "Leave call before changing accounts" : "End call preview before changing accounts";
            VerticalLayout {
                padding: 22px;
                spacing: 13px;
                Text { text: root.leave-call-busy ? (root.native-leave-unconfirmed ? "Checking call cleanup…" : "Leaving call…") : root.native-leave-unconfirmed ? "Call cleanup incomplete" : root.live-session ? "Leave call?" : "Leave call preview?"; color: root.ink; font-size: 19px * root.text-scale; font-weight: 750; }
                Text { text: root.native-leave-unconfirmed ? "Account changes remain blocked while native capture is stopping. Once it ends, you can acknowledge an uncertain server leave; the app cannot retry that leave." : root.pending-account-index == -2 ? "Leave the current call before adding another account." : root.pending-account-index == -3 ? "Leave the current call before logging out." : "Leave the current call before switching accounts."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    spacing: 9px;
                    alignment: end;
                    cancel-leave := ActionRect {
                        width: 104px; height: 36px; border-radius: 8px; background: root.panel;
                        focus-color: root.accent;
                        label: "Cancel account switch";
                        enabled: !root.leave-call-busy;
                        trap-tab: true;
                        cancel-on-escape: true;
                        next-focus => { confirm-leave.focus(); }
                        previous-focus => { confirm-leave.focus(); }
                        cancelled => { root.leave-call-dialog = false; root.pending-account-index = -1; account-trigger.focus(); }
                        activated => { root.leave-call-dialog = false; root.pending-account-index = -1; account-trigger.focus(); }
                        Text { text: "Cancel"; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    confirm-leave := ActionRect {
                        width: 182px; height: 36px; border-radius: 8px; background: root.accent;
                        focus-color: root.accent-ink;
                        label: root.native-leave-unconfirmed ? (root.pending-account-index == -4 ? "Acknowledge incomplete call cleanup" : "Continue account action after call cleanup") : root.pending-account-index == -2 ? "Leave call and add account" : root.pending-account-index == -3 ? "Leave call and log out" : "Leave call and switch account";
                        enabled: !root.leave-call-busy;
                        trap-tab: true;
                        cancel-on-escape: true;
                        next-focus => { cancel-leave.focus(); }
                        previous-focus => { cancel-leave.focus(); }
                        cancelled => { root.leave-call-dialog = false; root.pending-account-index = -1; account-trigger.focus(); }
                        activated => { root.confirm-leave-call(root.pending-account-index); }
                        Text { text: root.leave-call-busy ? "Checking…" : root.native-leave-unconfirmed ? "Continue if safe" : "Leave call"; color: root.accent-ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
        }
    }

    if root.manage-accounts-open && !root.show-sign-in : Rectangle {
        background: #000000aa;
        FocusScope {
            width: parent.width;
            height: parent.height;
            focus-on-tab-navigation: false;
            init => { done-manage.focus(); }
            capture-key-pressed(event) => {
                if event.text == Key.Tab && !event.modifiers.shift && done-manage.has-focus {
                    add-manage.focus();
                    accept
                } else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && add-manage.has-focus {
                    done-manage.focus();
                    accept
                } else { reject }
            }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.manage-accounts-open = false;
                    account-trigger.focus();
                    accept
                } else { reject }
            }
        Rectangle {
            x: (parent.width - 460px) / 2;
            y: (parent.height - 430px) / 2;
            width: 460px;
            height: 430px;
            border-radius: 14px;
            border-color: root.divider;
            border-width: 1px;
            background: root.canvas;
            accessible-role: region;
            accessible-label: "Manage Matrix accounts";
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Manage accounts"; color: root.ink; font-size: 21px * root.text-scale; font-weight: 760; }
                Text { text: "The current account appears first. Each account keeps its own rooms and session."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: parent.width;
                        spacing: 7px;
                        for account in root.account-options : Rectangle {
                            height: 56px; border-radius: 9px; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 10px;
                                AvatarBadge { width: 35px; height: 35px; border-radius: 11px; initials: account.initials; accent: account.accent; }
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    Text { text: account.name; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; }
                                    Text { text: account.handle; color: root.muted; font-size: 10px * root.text-scale; }
                                }
                                if account.index == root.active-account-index : Text { text: "CURRENT"; color: root.accent; font-size: 10px * root.text-scale; font-weight: 700; vertical-alignment: center; }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    add-manage := ActionRect {
                        width: 120px; height: 38px; background: root.elevated; border-radius: 8px;
                        focus-color: root.accent;
                        label: "Add Matrix account";
                        cancel-on-escape: true;
                        cancelled => { root.manage-accounts-open = false; account-trigger.focus(); }
                        activated => { root.manage-accounts-open = false; root.add-account(); }
                        Text { text: "Add account"; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    done-manage := ActionRect {
                        width: 80px; height: 38px; background: root.accent; border-radius: 8px;
                        focus-color: root.accent-ink;
                        label: "Close account manager";
                        cancel-on-escape: true;
                        cancelled => { root.manage-accounts-open = false; account-trigger.focus(); }
                        activated => { root.manage-accounts-open = false; account-trigger.focus(); }
                        Text { text: "Done"; color: root.accent-ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
        }
    }

    if root.show-sign-in : Rectangle {
        background: root.rail;
        Rectangle {
            x: (parent.width - 448px) / 2;
            y: (parent.height - 528px) / 2;
            width: 448px;
            height: 576px;
            border-radius: 18px;
            border-color: root.divider;
            border-width: 1px;
            background: root.canvas;
            accessible-role: form;
            accessible-label: "Sign in to Matrix";
            VerticalLayout {
                padding: 28px;
                spacing: 11px;
                Rectangle {
                    width: 48px; height: 48px; border-radius: 15px; background: root.accent;
                    Text { text: "M"; color: root.accent-ink; font-size: 22px * root.text-scale; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: "Welcome to Morpheus"; color: root.ink; font-size: 22px * root.text-scale; font-weight: 770; }
                Text { text: "Sign in with an existing Matrix account."; color: root.muted; font-size: 12px * root.text-scale; }
                Rectangle { height: 6px; background: transparent; }
                Text { text: "HOMESERVER"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; letter-spacing: 1px; }
                Rectangle {
                    height: 42px; background: root.elevated; border-radius: 8px; border-color: root.divider; border-width: 1px; clip: true;
                    TextInput { x: 11px; width: parent.width - 22px; height: parent.height; text <=> root.login-homeserver; color: root.ink; font-size: 13px * root.text-scale; vertical-alignment: center; accessible-label: "Homeserver URL"; }
                }
                Text { text: "MATRIX ID OR USERNAME"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; letter-spacing: 1px; }
                Rectangle {
                    height: 42px; background: root.elevated; border-radius: 8px; border-color: root.divider; border-width: 1px; clip: true;
                    TextInput { x: 11px; width: parent.width - 22px; height: parent.height; text <=> root.login-username; color: root.ink; font-size: 13px * root.text-scale; vertical-alignment: center; accessible-label: "Matrix ID or username"; }
                }
                Text { text: "PASSWORD"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; letter-spacing: 1px; }
                Rectangle {
                    height: 42px; background: root.elevated; border-radius: 8px; border-color: root.divider; border-width: 1px; clip: true;
                    TextInput {
                        x: 11px; width: parent.width - 22px; height: parent.height;
                        text <=> root.login-password; input-type: password;
                        color: root.ink; font-size: 13px * root.text-scale; vertical-alignment: center;
                        accessible-label: "Password";
                        accepted => {
                            if !root.login-loading {
                                let password = root.login-password;
                                root.login-password = "";
                                root.login-loading = true;
                                root.submit-login(root.login-homeserver, root.login-username, password);
                            }
                        }
                    }
                }
                if root.login-error != "" : Text { text: root.login-error; color: #e47483; font-size: 11px * root.text-scale; wrap: word-wrap; }
                if root.config-error != "" : Text { text: "Settings file: " + root.config-error; color: #e47483; font-size: 11px * root.text-scale; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle {
                    height: 43px; border-radius: 9px; background: root.accent;
                    accessible-role: button;
                    accessible-label: root.login-loading ? "Signing in" : "Sign in to Matrix";
                    accessible-enabled: !root.login-loading;
                    accessible-action-default => {
                        if !root.login-loading {
                            let password = root.login-password;
                            root.login-password = "";
                            root.login-loading = true;
                            root.submit-login(root.login-homeserver, root.login-username, password);
                        }
                    }
                    Text { text: root.login-loading ? "Signing in…" : "Sign in"; color: root.accent-ink; font-size: 13px * root.text-scale; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        enabled: !root.login-loading;
                        mouse-cursor: pointer;
                        clicked => {
                            let password = root.login-password;
                            root.login-password = "";
                            root.login-loading = true;
                            root.submit-login(root.login-homeserver, root.login-username, password);
                        }
                    }
                }
                Rectangle {
                    height: 40px; border-radius: 9px; background: root.elevated;
                    border-color: root.divider; border-width: 1px;
                    accessible-role: button;
                    accessible-label: "Sign in with browser using Matrix SSO";
                    accessible-enabled: !root.login-loading;
                    accessible-action-default => {
                        if !root.login-loading {
                            root.login-loading = true;
                            root.submit-sso(root.login-homeserver);
                        }
                    }
                    Text { text: "Sign in with browser · Matrix SSO"; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        enabled: !root.login-loading; mouse-cursor: pointer;
                        clicked => {
                            root.login-loading = true;
                            root.submit-sso(root.login-homeserver);
                        }
                    }
                }
                Rectangle {
                    height: 38px; border-radius: 8px; background: preview-hit.has-hover ? root.hover : transparent;
                    accessible-role: button; accessible-label: "Open interactive preview without signing in";
                    accessible-enabled: !root.login-loading;
                    accessible-action-default => { if !root.login-loading { root.preview-demo(); } }
                    Text { text: "Explore the interactive preview"; color: root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                    preview-hit := TouchArea { enabled: !root.login-loading; mouse-cursor: pointer; clicked => { root.preview-demo(); } }
                }
            }
        }
    }

    if root.security-recovery-key != "" : FocusScope {
        focus-on-tab-navigation: false;
        init => { reveal-recovery-key.focus(); }
        key-pressed(event) => { if event.text == Key.Escape { accept } else { reject } }
        Rectangle {
            background: #000000cc;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 520px) / 2;
                y: (parent.height - 348px) / 2;
                width: 520px; height: 348px;
                background: root.canvas; border-color: root.accent; border-width: 1px; border-radius: 14px;
                accessible-role: region;
                accessible-label: "One-time Matrix recovery key";
                VerticalLayout {
                    padding: 24px; spacing: 12px;
                    Text { text: "Save your recovery key"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                    Text { text: "Morpheus can show this new key only now. Save it in a password manager or another private place. Anyone with this key may be able to read your encrypted history."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                    Rectangle {
                        height: 75px; background: root.elevated; border-radius: 8px; border-color: root.divider; border-width: 1px;
                        if root.security-key-revealed : Text {
                            x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px;
                            text: root.security-recovery-key; color: root.ink; font-size: 14px * root.text-scale;
                            font-family: "monospace"; wrap: word-wrap;
                            accessible-label: "Recovery key shown once: " + root.security-recovery-key;
                        }
                        if !root.security-key-revealed : Text {
                            text: "Key hidden until you choose Reveal"; color: root.muted; font-size: 12px * root.text-scale;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    Text { text: root.security-notice != "" ? root.security-notice : "Copying places the key on the system clipboard; clear it after saving."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        spacing: 8px; alignment: end;
                        reveal-recovery-key := Button {
                            width: 90px; text: "Reveal"; enabled: !root.security-key-revealed;
                            accessible-label: "Reveal the new recovery key once";
                            clicked => { root.security-key-revealed = true; copy-recovery-key.focus(); }
                        }
                        copy-recovery-key := Button {
                            width: 90px; text: "Copy"; enabled: root.security-key-revealed;
                            accessible-label: "Copy recovery key to system clipboard";
                            clicked => { root.copy-recovery-key(); }
                        }
                        Button {
                            width: 154px; text: "I saved this key"; primary: true; enabled: root.security-key-revealed;
                            accessible-label: "I saved the recovery key; hide it permanently in Morpheus";
                            clicked => { root.dismiss-recovery-key(); }
                        }
                    }
                }
            }
        }
    }
}
