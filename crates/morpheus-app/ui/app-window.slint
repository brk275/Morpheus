    in-out property <string> room-settings-access-description;
    in-out property <int> room-settings-confirmation: 0;
    private property <bool> room-settings-editable: root.room-settings-loaded && !root.room-admin-busy && !root.room-settings-refresh-required && root.room-settings-confirmation == 0;

    in-out property <bool> active-voice-local: false;
    in-out property <bool> active-voice-shared: false;
    in-out property <bool> voice-designation-busy: false;
    in-out property <string> voice-designation-error;
    in-out property <string> voice-designation-notice;
    in-out property <int> voice-designation-operation: 0;
    in-out property <int> theme-mode: 0;
    // The global appearance.theme the picker edits; theme-mode is the
    // effective palette, which the active account's override can replace.
    in-out property <int> global-theme-mode: 0;
