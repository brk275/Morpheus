            root.stop-attachment-audio(); root.show-side-panel = true;
            root.stop-attachment-audio(); root.side-panel-tab = 3;
        } else if slot == 3 {
            if !RoomLeave.view.open { ThreadBrowser.show(); }
        } else if slot == 4 {
            root.show-room-media();
        } else if slot == 5 {
