    // The room header's notification panel shows only for the live account
    // and the room open now, and never over account access or security.
    property <bool> room-notifications-current: RoomNotificationState.open && root.live-session
        && !RoomLeave.view.open
        && RoomNotificationState.account-id == root.active-account-local-id
        && RoomNotificationState.room-id == root.active-room-id && root.active-room-id != ""
        && !root.show-sign-in && !root.access-open && !root.manage-accounts-open
        && root.security-recovery-key == "" && !root.account-profile-open && !SpaceExplorer.open && !SpaceRooms.open && !RoomAddresses.open
        && !root.people-open && !MemberPrivacy.inspector.open;
    // Another account or room, a lock or a detach clears the panel's rows.
    changed room-notifications-current => {
        if !root.room-notifications-current && RoomNotificationState.open {
            RoomNotificationState.close();
        }
    }
    property <int> room-notification-focus-request: 0;
    // The header bell rereads the level of each room it shows.
    property <string> notification-room-key: root.live-session ? root.active-account-local-id + "\n" + root.active-room-id : "";
    changed notification-room-key => {
        RoomNotificationState.room-shown(root.active-account-local-id, root.active-room-id);
    }
    // The person closed the panel: focus returns to what opened it.
    function close-room-notifications() {
        RoomNotificationState.close();
        if root.page == 0 {
            root.room-notification-focus-request += 1;
        } else if root.page == 1 {
            // Opened from Settings: its entry, which only reveals the panel.
            root.settings-reveal-id = "notifications.this_room";
            root.settings-reveal-serial += 1;
        }
    }

    // The conversation header (page 0) at the width it actually has: the main
    // canvas beside the details panel, whatever the pane order, details side
    // and window size, with the configured icon button size and text scale.
    // When its actions do not all fit, the lower-priority ones fold into ONE
    // flat "More room actions" menu, in their header order. Organization (the
    // room's star, itself a menu) and Search never fold; Leave, then Jump to
    // first unread, stay while the room name keeps its shortest readable width
    // beside them. The room name keeps a readable width; the topic gives way
    // first. An action runs the same way as an icon or as a More item, with
    // the same guard, label and state.
    //
    // Slots (twelve actions with Organization and Search): 0 notifications,
    // 1 room settings, 2 pins, 3 threads, 4 media, 5 transfers, 6 call stage,
    // 7 details panel, 8 Leave, drawn between room settings and Search, and
    // 9 Jump to first unread, drawn between Search and pins
    // (header-menu-slot gives the order on screen and in the menu). The
    // widths come from the canvas and the measured texts, never from the
    // header's own layout, so nothing binds to itself.
    property <length> header-width: main-area.width - main-area.panel-width;
    // One action and its gap in the header row (spacing 11 px).
    property <length> header-slot: StyleTokens.icon-button-size + 11px;
    property <length> header-glyph: header-glyph-probe.preferred-width;
    property <length> header-name-wanted: header-name-probe.preferred-width;
    // While every action fits, the name keeps at least a short readable start;
    // once actions fold, it keeps a longer one (within what the row has left
    // after the glyph and the actions that do not fold).
    property <length> header-name-floor: min(root.header-name-wanted, 48px * root.text-scale);
    // Every action, the divider and the topic's place fit: no More menu. The
    // row is the 40 px padding, the glyph, the name, twelve actions and their
    // gaps (and, unless the header is minimal, the divider with its gaps).
    out property <bool> header-full: root.header-width >= (root.conversation-header-mode == 2 ? 51px : 74px)
        + root.header-glyph + root.header-name-floor + 12 * root.header-slot;
    // Leave stays beside Organization, Search and More while the name keeps
    // its floor; only a pane too narrow for that folds it.
    out property <bool> header-leave-shown: root.header-full
        || root.header-width - 51px - root.header-glyph - root.header-name-floor >= 4 * root.header-slot;
    // Jump to first unread stays next, beside Leave, while the name still
    // keeps its floor; it folds before Leave does.
    out property <bool> header-jump-shown: root.header-full || (root.header-leave-shown
        && root.header-width - 51px - root.header-glyph - root.header-name-floor >= 5 * root.header-slot);
    // The actions that do not fold now: Organization, Search, More, and Leave
    // and Jump while they are shown.
    property <int> header-fixed: 3 + (root.header-leave-shown ? 1 : 0) + (root.header-jump-shown ? 1 : 0);
    property <length> header-name-reserve: max(0px, min(min(root.header-name-wanted, 112px * root.text-scale),
        root.header-width - 51px - root.header-glyph - root.header-fixed * root.header-slot));
    property <length> header-name-min: root.header-full ? root.header-name-floor : root.header-name-reserve;
    // How many of slots 0-7 stay in the header (by header-rank).
    out property <int> header-capacity: root.header-full ? 8
        : max(0, min(7, floor((root.header-width - 51px - root.header-glyph - root.header-name-reserve) / root.header-slot) - root.header-fixed));
    out property <bool> header-overflow: root.page == 0 && !root.header-full;
    // The foldable action that has keyboard focus, or -1.
    property <int> header-focus: -1;
    out property <bool> header-more-open: false;
    property <int> header-search-focus-request: 0;
    // Which of slots 0-7 fold last: the details panel, then notifications,
    // room settings, the call stage, threads, pins, media; transfers fold
    // first.
    pure function header-rank(slot: int) -> int {
        slot == 7 ? 0 : slot == 0 ? 1 : slot == 1 ? 2 : slot == 6 ? 3 : slot == 3 ? 4 : slot == 2 ? 5 : slot == 4 ? 6 : 7
    }
    pure function header-fits(slot: int) -> bool {
        slot == 9 ? root.header-jump-shown : slot == 8 ? root.header-leave-shown
            : root.header-rank(slot) < root.header-capacity
    }
    // Drawn in the header, else listed in More. A focused action stays until
    // focus has moved to More (changed header-layout), so folding never
    // drops focus and never acts.
    pure function header-shows(slot: int) -> bool {
        root.header-fits(slot) || root.header-focus == slot
    }
    pure function header-icon(slot: int) -> string {
        slot == 0 ? (RoomNotificationState.header-muted ? "notifications-off" : "notifications")
            : slot == 1 ? "settings" : slot == 2 ? "pin" : slot == 3 ? "thread" : slot == 4 ? "media"
            : slot == 5 ? "transfers" : slot == 6 ? "calls" : slot == 7 ? "details-panel"
            : slot == 8 ? "log-out" : "arrow-up"
    }
    pure function header-label(slot: int) -> string {
        slot == 0 ? (RoomNotificationState.header-muted ? "Room notifications, muted" : "Room notifications")
            : slot == 1 ? "Edit room settings" : slot == 2 ? "Show pinned messages"
            : slot == 3 ? "Browse threads in this room" : slot == 4 ? "Browse this room's media"
            : slot == 5 ? (root.transfer-active-count > 0 ? "Show transfers, " + root.transfer-active-count + " in progress" : "Show transfers")
            : slot == 6 ? "Open current room call stage"
            : slot == 7 ? (root.show-side-panel ? "Hide details panel" : "Show details panel")
            : slot == 8 ? "Leave this room…"
            : (UnreadNavigation.jumping ? "Loading earlier messages to your read position" : "Jump to first unread message")
    }
    pure function header-selected(slot: int) -> bool {
        slot == 0 ? root.room-notifications-current
            : slot == 2 ? root.show-side-panel && root.side-panel-tab == 3
            : slot == 3 ? ThreadBrowser.open
            : slot == 4 ? root.room-media-visible
            : slot == 5 ? root.show-side-panel && root.side-panel-tab == 4
            : slot == 7 ? root.show-side-panel
            : false
    }
    pure function header-enabled(slot: int) -> bool {
        slot == 9 ? root.live-session && root.active-room-id != "" && UnreadNavigation.can-jump
                && !UnreadNavigation.jumping && root.header-jump-allowed
            : slot == 8 ? root.live-session && root.active-room-id != "" && !root.room-leave-blocked
            : slot <= 4 ? root.live-session && root.active-room-id != "" : slot == 5 ? root.live-session : true
    }
    // unread-jump-allowed without the term for the open More menu itself, so
    // Jump listed in More stays available there: its item closes the menu
    // before UnreadNavigation.jump admits against unread-jump-allowed.
    property <bool> header-jump-allowed: root.live-session && !root.room-leave-blocked
        && !RoomLeave.view.open && !MatrixLink.open && !root.conversation-focused;
    // The header opened Leave (its drawn icon or its More item) and owns the
    // focus return when the dialog ends. Root state, so the return survives
    // the icon folding (and its subtree going) while the dialog is open.
    property <bool> header-leave-returns: false;
    // Asks the drawn Leave icon to take focus.
    property <int> header-leave-focus-request: 0;
