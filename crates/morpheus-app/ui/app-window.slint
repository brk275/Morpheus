                                    Text { text: "Timeline performance preview"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: root.stress-timeline-active ? "10,000 synthetic messages loaded" : "Test variable-height messages at scale"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                IconAction {
                                    icon: root.stress-timeline-active ? "✓" : "10k";
                                    label: root.stress-timeline-active ? "Restore preview messages" : "Load 10,000 preview messages";
                                    ink: root.accent; surface: root.panel; hover-surface: root.hover;
                                    activated => { root.toggle-stress-timeline(); }
                                }
                            }
                        }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "Notifications"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Notifications are shown for the active account while Morpheus runs. Notifications, sounds, previews, highlight words and room and sender names apply to all accounts. This account, default levels, keywords and room levels belong to the active account; levels and keywords are its Matrix push rules."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        ActionRect {
                            height: 68px; border-radius: StyleTokens.radius * 1; background: root.elevated; focus-color: root.accent;
                            property <int> reveal-request: root.reveal-request("notifications.desktop");
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
