                    summary: root.transfer-summary;
                    available: root.live-session;
                    focus-pending <=> root.transfer-focus-pending;
                    focus-request: root.transfer-focus-request;
                    text-scale: root.text-scale;
                    palette: {
                        ink: root.ink,
                        muted: root.muted,
                        panel: root.panel,
                        surface: root.elevated,
                        hover: StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover,
                        pressed: StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color
                            : StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover,
                        accent: root.accent,
                        divider: root.divider,
                        focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
                        error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b,
                    };
                    style: {
                        row-radius: StyleTokens.radius * 0.7,
                        control-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.6,
                        row-line-width: StyleTokens.high-contrast ? StyleTokens.line-width : 0px,
                        focus-width: StyleTokens.focus-width,
                        action-padding: StyleTokens.control-padding * 2 / 3,
                    };
                    action(kind, id, choice) => { root.transfer-action(kind, id, choice); }
                    clear-finished => { root.clear-finished-transfers(); }
                    revealed => { root.settings-revealed-id = "files.transfers"; }
                }
                if root.side-panel-tab == 5 : RoomMediaPanel {
                    vertical-stretch: 1;
                    room-name: root.active-room-name;
                    available: root.live-session && root.active-room-id != "";
                    text-scale: root.text-scale;
                    select-colors: root.button-colors;
                    palette: {
                        ink: root.ink,
                        muted: root.muted,
                        panel: root.panel,
                        elevated: root.elevated,
                        hover: StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover,
                        outline: root.divider,
                        focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
                        selection: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : Palette.selection-background,
                        selection-ink: StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : Palette.selection-foreground,
                        has-selection-ink: true,
                        error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b,
                        warning: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b,
                        input-surface: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.elevated,
                        input-border: StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.divider,
                    };
                    close => { root.close-room-media(); }
                }
            }
            // Collapsed (or squeezed by a narrow window): a strip that restores it.
            if root.pane-details-w <= root.pane-strip : Rectangle {
                background: root.window-panel;
                IconAction {
                    x: (parent.width - self.width) / 2; y: 12px;
                    width: max(24px, parent.width - 4px); height: 40px;
                    icon: "«";
                    label: root.pane-details-collapsed ? "Show the details panel" : "The window is too narrow for the details panel";
                    enabled: root.pane-details-collapsed;
                    ink: root.icon-ink; surface: transparent; hover-surface: root.hover;
                    activated => { root.set-pane-collapsed("details", false); }
                }
            }
        }

        // Direct pane interaction: resize edges and drag grips over the
        // panes. Elements are always present (only shown or hidden), so a
        // pane that a preview squeezes never drops the pointer mid-drag.
        rooms-edge := PaneResizeEdge {
            gesture-token: root.pane-gesture;
            x: root.pane-x(root.pane-slot-rooms) + (self.grows-right ? root.pane-rooms-w : 0px) - self.width / 2;
            y: 0px;
            height: parent.height - (root.account-column ? 0px : root.account-trigger-height + root.account-toolbar-height + StyleTokens.line-width);
            visible: root.pane-rooms-w > root.pane-strip || root.rooms-preview >= 0px;
            enabled: root.pane-gesture == 0 && root.pane-gesture-allowed && root.pane-rooms-w > root.pane-strip;
            grows-right: root.pane-slot-rooms < root.pane-slot-conversation;
            start-width: root.room-list-width * 1px;
            minimum: 180px;
            maximum: 480px;
            accent: root.accent;
            began => { return root.start-pane-gesture(); }
            previewed(width) => { if root.pane-gesture != 0 { root.rooms-preview = width; } }
            finished(width) => { root.finish-pane-width("rooms", width); }
            cancelled => { root.cancel-pane-preview(); }
        }
        details-edge := PaneResizeEdge {
            gesture-token: root.pane-gesture;
            x: root.pane-x(root.pane-slot-details) + (self.grows-right ? root.pane-details-w : 0px) - self.width / 2;
            y: 0px;
            height: parent.height;
            visible: root.pane-details-w > root.pane-strip || root.details-preview >= 0px;
            enabled: root.pane-gesture == 0 && root.pane-gesture-allowed && root.pane-details-w > root.pane-strip;
            grows-right: root.pane-slot-details < root.pane-slot-conversation;
            start-width: root.details-width * 1px;
            minimum: 200px;
            maximum: 520px;
            accent: root.accent;
            began => { return root.start-pane-gesture(); }
            previewed(width) => { if root.pane-gesture != 0 { root.details-preview = width; } }
            finished(width) => { root.finish-pane-width("details", width); }
            cancelled => { root.cancel-pane-preview(); }
        }
        // One grip per pane, centered at its top; hidden or squeezed panes
        // are arranged from Settings instead.
        for grip in [
            { id: "spaces", slot: root.pane-slot-spaces, w: root.pane-rail-w },
            { id: "rooms", slot: root.pane-slot-rooms, w: root.pane-rooms-w },
            { id: "conversation", slot: root.pane-slot-conversation, w: root.pane-conversation-w },
            { id: "details", slot: root.pane-slot-details, w: root.pane-details-w }
        ] : PaneDragGrip {
            gesture-token: root.pane-gesture;
            x: root.pane-x(grip.slot) + (grip.w - self.width) / 2;
            y: 3px;
            visible: grip.w > root.pane-strip + self.width || root.pane-dragging == grip.id;
            enabled: root.pane-gesture == 0 && root.pane-gesture-allowed;
            ink: root.muted;
            accent: root.accent;
            hover: root.hover;
            began => {
                if !root.start-pane-gesture() {
                    return false;
                }
                root.pane-dragging = grip.id;
                root.pane-drag-slot = grip.slot;
                root.pane-drop-index = root.pane-rank(grip.slot, -1);
                return true;
            }
            dragged(px) => {
                if root.pane-gesture != 0 {
                    root.pane-drop-index = root.pane-drop-at(px, root.pane-drag-slot);
                }
            }
            dropped(px) => {
                root.finish-pane-order(grip.id, root.pane-gesture != 0 ? root.pane-drop-at(px, root.pane-drag-slot) : -1);
            }
            cancelled => { root.cancel-pane-preview(); }
        }
        // While a pane is dragged: its outline, and the line where it would go.
        if root.pane-dragging != "" && root.pane-drag-slot >= 0 : Rectangle {
            x: root.pane-x(root.pane-drag-slot);
            y: 0px;
            width: root.pane-dragging == "spaces" ? root.pane-rail-w : root.pane-dragging == "rooms" ? root.pane-rooms-w
                : root.pane-dragging == "details" ? root.pane-details-w : root.pane-conversation-w;
            height: parent.height;
            background: transparent;
            border-color: root.accent;
            border-width: 2px;
        }
        if root.pane-dragging != "" && root.pane-drag-slot >= 0 && root.pane-drop-index >= 0 : Rectangle {
            x: max(0px, root.pane-insert-x(root.pane-drop-index, root.pane-drag-slot) - 2px);
            y: 0px;
            width: 4px;
            height: parent.height;
            background: root.accent;
            accessible-role: none;
        }
        if root.layout-notice != "" : Rectangle {
            x: (parent.width - self.width) / 2;
            y: 20px;
            width: min(parent.width - 40px, notice-text.preferred-width + 28px);
            height: max(32px, notice-text.preferred-height + 14px);
            border-radius: StyleTokens.radius;
            background: root.elevated;
            border-color: root.divider;
            border-width: StyleTokens.line-width;
            notice-text := Text {
                x: 14px;
                width: parent.width - 28px;
                text: root.layout-notice;
                color: root.ink;
                font-size: 12px * root.text-scale;
                wrap: word-wrap;
                vertical-alignment: center;
                accessible-live-region: polite;
            }
            TouchArea { clicked => { root.layout-notice = ""; } }
        }

        // The active account's control, always at the window's bottom left:
        // over the room list's reserved space when the room list leads the
        // arrangement at full width, otherwise in its own narrow column.
        account-corner := Rectangle {
            x: root.account-corner-x;
            y: parent.height - self.height;
            width: root.account-corner-width;
            height: root.account-toolbar-height + root.account-trigger-height + StyleTokens.line-width;
            background: root.account-column ? root.window-rail : root.window-sidebar;
            VerticalLayout {
                spacing: 0px;
                Rectangle { height: StyleTokens.line-width; background: root.divider; }
                if root.account-toolbar : HorizontalLayout {
                    padding-left: 6px; padding-right: 6px; spacing: 4px;
                    height: root.account-toolbar-height;
                    TextAction {
                        text: "Settings";
                        label: "Open settings from account controls";
                        ink: root.ink; muted: root.muted; surface: root.window-sidebar;
                        hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                        activated => { root.page = 1; root.open-security(); }
                    }
                    if root.layout-customized : TextAction {
                        text: "Restore";
                        label: "Restore layout from account controls";
                        ink: root.ink; muted: root.muted; surface: root.window-sidebar;
                        hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                        activated => { root.restore-default-layout(); }
                    }
                }
                account-trigger := ActionRect {
                    height: max(69px, 38px * root.text-scale + 24px);
                    background: root.window-rail;
                    focus-color: root.accent;
                    label: "Account menu for " + root.active-account-name + ", " + root.active-account-handle;
                    accessible-expanded: root.account-menu-open;
                    activated => { if !RoomAddresses.open { root.account-menu-open = !root.account-menu-open; } }
                    HorizontalLayout {
                        padding-left: root.account-column ? 13px : 11px;
                        padding-right: root.account-column ? 13px : 11px;
                        padding-top: 15px;
                        padding-bottom: 15px;
                        spacing: root.account-column ? 0px : 10px;
                        VerticalLayout { width: 38px; alignment: center; AvatarBadge { initials: root.active-account-initials; accent: root.active-account-accent; avatar: root.active-account-avatar; has-avatar: root.active-account-has-avatar; } }
                        if !root.account-column : VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: root.active-account-name; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; overflow: elide; }
                            Text { text: root.active-account-handle; color: root.muted; font-size: 11px * root.text-scale; overflow: elide; }
                        }
                        if !root.account-column : Text { text: "⌃"; color: root.muted; font-size: 16px * root.text-scale; vertical-alignment: center; }
                    }
                }
            }
        }
        // A restore for any customized arrangement, beside the account
        // control in its column, so a usable layout is one keypress away.
        if root.account-column && root.layout-customized : IconAction {
            x: root.account-corner-x + (root.account-column-width - self.width) / 2;
            y: account-corner.y - self.height - 6px;
            width: 44px; height: 40px;
            icon: "▣";
            label: "Restore the default pane layout";
            ink: root.icon-ink; surface: transparent; hover-surface: root.hover;
            activated => { root.restore-default-layout(); }
        }
        // Settings stays one click away when no rail shows its route button.
        if root.account-column && root.pane-rail-w == 0px : IconAction {
            x: root.account-corner-x + (root.account-column-width - self.width) / 2;
            y: account-corner.y - (root.layout-customized ? 92px : 46px);
            width: 44px; height: 40px;
            icon: "⚙";
            label: "Open settings";
            ink: root.icon-ink; surface: transparent; hover-surface: root.hover;
            activated => { root.page = 1; root.open-security(); }
        }

        // Drawn after every pane so it opens upward over them.
        if root.account-menu-open : Rectangle {
            x: root.account-corner-x + 9px;
            y: parent.height - self.height - account-trigger.height - 5px;
            width: max(root.account-corner-width, 280px) - 18px;
            height: min(parent.height - account-trigger.height - 14px, 207px + root.account-options.length * (max(42px, 30px * root.text-scale + 12px) + 2px));
            background: root.elevated;
            border-color: root.divider;
            border-width: StyleTokens.line-width;
            border-radius: StyleTokens.radius * 1.2;
            drop-shadow-color: StyleTokens.roles.shadow.present ? StyleTokens.roles.shadow.color : #00000044;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 7px;
            // Opt-in decorative fade-in: immediate at 0 ms and under reduced motion.
            property <bool> entered: false;
            // Opacity is first read here, at 0, so setting `entered` animates it;
            // `init` would set it before that first read and nothing would fade.
            Timer { interval: 1ms; running: !parent.entered && parent.opacity < 1; triggered => { parent.entered = true; } }
            opacity: StyleTokens.popup-duration == 0ms || self.entered ? 1 : 0;
            animate opacity { duration: StyleTokens.popup-duration; easing: ease-out; }
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                Text {
                    text: root.account-switch-pending ? "SWITCHING…" : "SWITCH ACCOUNT";
                    color: root.muted;
                    font-size: 10px * root.text-scale;
                    font-weight: 750;
                    letter-spacing: 1px;
                    height: 22px;
                    vertical-alignment: center;
                }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: parent.width;
                        spacing: 2px;
                for account[index] in root.account-options : account-choice := ActionRect {
                    height: max(42px, 30px * root.text-scale + 12px);
                    border-radius: StyleTokens.radius * 0.8;
                    background: account.index == root.active-account-index ? root.hover : root.control-fill(self.has-hover, self.has-pressed, transparent);
                    focus-color: root.accent;
                    cancel-on-escape: true;
                    label: "Switch to " + account.name + ", " + account.handle;
                    enabled: !root.account-switch-pending;
                    // Repeater children become focusable after initialization; defer one tick.
                    Timer {
                        interval: 1ms;
                        running: index == 0;
                        triggered => { self.running = false; account-choice.focus(); }
                    }
                    cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                    activated => {
                        if root.call-connected {
                            root.pending-account-index = account.index;
                            root.leave-call-dialog = true;
                            root.account-menu-open = false;
                        } else {
                            root.switch-account(account.index);
                            root.account-menu-open = false;
                            account-trigger.focus();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 9px;
                        VerticalLayout { width: 30px; alignment: center; AvatarBadge { width: 30px; height: 30px; built-in-radius: StyleTokens.radius * 1.0; initials: account.initials; accent: account.accent; avatar: account.avatar; has-avatar: account.has-avatar; } }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text { text: account.name; color: root.ink; font-size: 12px * root.text-scale; font-weight: 650; overflow: elide; }
                            Text { text: account.handle; color: root.muted; font-size: 10px * root.text-scale; overflow: elide; }
                        }
                        if account.index == root.active-account-index : VerticalLayout { alignment: center; MorpheusIcon { width: 16px * root.text-scale; height: 16px * root.text-scale; icon: "check"; ink: root.accent; } }
                    }
                }
                    }
                }
                Rectangle { height: StyleTokens.line-width; background: root.divider; }
                add-account-choice := ActionRect {
                    height: 35px;
                    border-radius: StyleTokens.radius * 0.8;
                    background: root.control-fill(self.has-hover, self.has-pressed, transparent);
                    focus-color: root.accent;
                    cancel-on-escape: true;
                    label: "Add another Matrix account";
                    Timer {
                        interval: 1ms;
                        running: root.account-options.length == 0;
                        triggered => { self.running = false; add-account-choice.focus(); }
                    }
                    cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                    activated => {
                        if root.call-connected {
                            root.pending-account-index = -2;
                            root.leave-call-dialog = true;
                            root.account-menu-open = false;
                        } else {
                            root.add-account();
                            root.account-menu-open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 9px; padding-right: 9px; spacing: 9px;
                        VerticalLayout { alignment: center; MorpheusIcon { width: 16px * root.text-scale; height: 16px * root.text-scale; icon: "add-account"; ink: root.ink; } }
                        Text { text: "Add an account"; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    }
                }
                ActionRect {
                    height: 35px;
                    border-radius: StyleTokens.radius * 0.8;
                    background: root.control-fill(self.has-hover, self.has-pressed, transparent);
                    focus-color: root.accent;
                    cancel-on-escape: true;
                    label: "Manage accounts";
                    cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                    activated => { RoomAddresses.context-changed(); root.manage-accounts-open = true; root.manage-accounts(); root.account-menu-open = false; }
                    HorizontalLayout {
                        padding-left: 9px; padding-right: 9px; spacing: 9px;
                        VerticalLayout { alignment: center; MorpheusIcon { width: 16px * root.text-scale; height: 16px * root.text-scale; icon: "manage-accounts"; ink: root.ink; } }
                        Text { text: "Manage accounts"; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    }
                }
                ActionRect {
                    height: 35px;
                    border-radius: StyleTokens.radius * 0.8;
                    background: root.control-fill(self.has-hover, self.has-pressed, transparent);
                    focus-color: root.accent;
                    cancel-on-escape: true;
                    label: "Edit public profile of " + root.active-account-handle;
                    enabled: root.live-session && !root.account-switch-pending;
                    cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                    activated => { root.account-menu-open = false; root.open-account-profile(); }
                    Text { x: 9px; text: "✎   Public profile"; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; }
                }
                ActionRect {
                    height: 35px;
                    border-radius: StyleTokens.radius * 0.8;
                    background: root.control-fill(self.has-hover, self.has-pressed, transparent);
                    focus-color: root.accent;
                    cancel-on-escape: true;
                    label: "Log out of current Matrix account";
                    cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                    activated => {
                        // Rust captures the exact selection before it opens
                        // a leave-call confirmation or starts async logout.
                        root.log-out(); root.account-menu-open = false;
                    }
                    HorizontalLayout {
                        padding-left: 9px; padding-right: 9px; spacing: 9px;
                        VerticalLayout { alignment: center; MorpheusIcon { width: 16px * root.text-scale; height: 16px * root.text-scale; icon: "log-out"; ink: StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : #e47483; } }
                        Text { text: "Log out"; color: StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : #e47483; font-size: 12px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    }
                }
            }
        }

    if root.image-preview-open && root.image-preview-account-id == root.active-account-local-id && root.image-preview-room-id == root.active-room-id : MediaViewer {
        image: root.image-preview-image;
        loaded: root.image-preview-loaded;
        loading: root.image-preview-loading;
        failed: root.image-preview-failed;
        title: root.image-preview-title;
        status: root.image-preview-status;
        position: root.image-preview-position;
        has-previous: root.image-preview-has-previous;
        has-next: root.image-preview-has-next;
        can-save: root.image-preview-event-id != "" && root.downloading-event-id == "";
        text-scale: root.text-scale;
        palette: {
            ink: root.ink,
            muted: root.muted,
            accent: root.accent,
            accent-ink: root.accent-ink,
            surface: root.dialog-surface,
            backdrop: StyleTokens.roles.media-backdrop.present ? StyleTokens.roles.media-backdrop.color : #11131b,
            scrim: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000cc,
            hover: StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover,
            pressed: StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color
                : StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover,
            hover-set: StyleTokens.states.control-hover.present,
            pressed-set: StyleTokens.states.control-pressed.present,
            disabled: StyleTokens.states.control-disabled.color,
            disabled-set: StyleTokens.states.control-disabled.present,
            focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
            error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b
        };
        // The viewer's built-in look at the default preferences.
        style: {
            dialog-radius: StyleTokens.radius * 1.4,
            stage-radius: StyleTokens.radius * 0.9,
            control-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.7,
            line-width: StyleTokens.line-width,
            focus-width: StyleTokens.focus-width,
            action-padding: StyleTokens.control-padding * 0.75,
            glyph-scale: StyleTokens.icon-size / 18px,
        };
        close => { root.dismiss-image-preview(); }
        previous => { root.preview-adjacent-image(-1); }
        next => { root.preview-adjacent-image(1); }
        cancel-loading => { root.cancel-image-preview-loading(); }
        retry => { root.retry-image-preview(); }
        save => { root.save-attachment(root.image-preview-event-id, root.image-preview-title); }
    }

    // An exact open Space form never survives navigation, account access,
    // a sign-in surface, or a pending/completed security/SAS presentation.
    // The Rust admission additionally keeps navigation and gate epochs so
    // an unsettled A→B→A or begin→end never revives a queued confirmation.
    property <string> space-management-context: root.active-account-local-id + "\n" + root.active-room-id
        + "\n" + root.active-space-id + "\n" + root.page + "\n" + root.navigation-mode
        + "\n" + (root.live-session ? "1" : "0") + (root.show-sign-in ? "1" : "0")
        + (root.access-open ? "1" : "0") + (root.account-switch-pending ? "1" : "0")
        + (root.manage-accounts-open ? "1" : "0") + (root.security-busy ? "1" : "0")
        + (root.security-recovery-key != "" ? "1" : "0") + (root.sas-busy ? "1" : "0")
        + "\n" + root.sas-stage
        + (MemberPrivacy.inspector.open ? "1" : "0") + (root.people-open ? "1" : "0")
        + (root.account-profile-open ? "1" : "0") + (RoomNotificationState.open ? "1" : "0")
        + (RoomActivity.seen-open ? "1" : "0") + (root.quick-switcher-open ? "1" : "0")
        + (root.room-actions-open ? "1" : "0") + (root.room-admin-open ? "1" : "0")
        + (root.member-confirm-open ? "1" : "0") + (root.native-capture-picker-open ? "1" : "0")
        + (root.leave-call-dialog ? "1" : "0") + (root.image-preview-open ? "1" : "0")
        + (root.poll-dialog-open ? "1" : "0") + (root.account-menu-open ? "1" : "0")
        + (RoomAddresses.open ? "1" : "0");
    changed space-management-context => { SpaceRooms.context-changed(); }

    // Managing a Space's rooms (space-management.slint); Rust owns its state.
    if SpaceRooms.open : SpaceRoomsPanel {
        text-scale: root.text-scale;
        button-colors: root.button-colors;
        palette: {
            ink: root.ink,
            muted: root.muted,
            accent: root.accent,
            surface: root.dialog-surface,
            elevated: root.elevated,
            hover: root.hover,
            divider: root.divider,
            error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b,
            selection: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover,
            selection-ink: StyleTokens.roles.selection-ink.color,
            has-selection-ink: StyleTokens.roles.selection-ink.present,
            focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
            scrim: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa,
        };
    }

    // The Space explorer (space-explorer.slint); Rust owns its state.
    if SpaceExplorer.open : SpaceExplorerPanel {
        text-scale: root.text-scale;
        button-colors: root.button-colors;
        palette: {
            ink: root.ink,
            muted: root.muted,
            accent: root.accent,
            surface: root.dialog-surface,
            elevated: root.elevated,
            hover: root.hover,
            divider: root.divider,
            error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b,
            selection: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover,
            selection-ink: StyleTokens.roles.selection-ink.color,
            has-selection-ink: StyleTokens.roles.selection-ink.present,
            focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
            scrim: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa,
        };
    }

    if root.quick-switcher-open : FocusScope {
        focus-on-tab-navigation: false;
        init => { quick-room-input.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-quick-switcher();
                accept
            } else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && quick-room-input.has-focus {
                close-quick-switcher.focus();
                accept
            } else if event.text == Key.Tab && !event.modifiers.shift && close-quick-switcher.has-focus {
                quick-room-input.focus();
                accept
            } else if quick-room-input.has-focus && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt && !event.modifiers.shift && root.quick-switcher-results.length > 0 && event.text == Key.DownArrow {
                root.quick-switcher-index = mod(root.quick-switcher-index + 1, root.quick-switcher-results.length);
                accept
            } else if quick-room-input.has-focus && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt && !event.modifiers.shift && root.quick-switcher-results.length > 0 && event.text == Key.UpArrow {
                root.quick-switcher-index = mod(root.quick-switcher-index + root.quick-switcher-results.length - 1, root.quick-switcher-results.length);
                accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            // Opt-in decorative fade-in: immediate at 0 ms and under reduced motion.
            property <bool> entered: false;
            // Opacity is first read here, at 0, so setting `entered` animates it;
            // `init` would set it before that first read and nothing would fade.
            Timer { interval: 1ms; running: !parent.entered && parent.opacity < 1; triggered => { parent.entered = true; } }
            opacity: StyleTokens.popup-duration == 0ms || self.entered ? 1 : 0;
            animate opacity { duration: StyleTokens.popup-duration; easing: ease-out; }
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 530px) / 2;
                y: (parent.height - self.height) / 2;
                width: 530px; height: min(580px, parent.height - 40px); background: root.dialog-surface;
                border-radius: StyleTokens.radius * 1.4; border-color: root.accent; border-width: StyleTokens.line-width;
                accessible-role: region;
                accessible-label: "Switch room in " + root.active-space-name;
                VerticalLayout {
                    padding: 20px; spacing: 6px;
                    Text { text: "Switch room · " + root.active-space-name; color: root.ink; font-size: 18px * root.text-scale; font-weight: 750; }
                    Rectangle {
                        height: 38px; background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.elevated; border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.8;
                        if root.quick-switcher-query == "" : Text { x: StyleTokens.input-padding; text: "Room name or Matrix room ID"; color: root.muted; font-size: 12px * root.text-scale; vertical-alignment: center; }
                        quick-room-input := ThemedTextInput {
                            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
                            text <=> root.quick-switcher-query; color: root.ink; font-size: 12px * root.text-scale;
                            single-line: true; accessible-label: "Filter rooms; arrows select, Enter opens, Escape closes";
                            edited => { root.filter-quick-switcher(); }
                            accepted => { root.choose-quick-room(root.quick-switcher-index); }
                        }
                    }
                    Text {
                        text: root.quick-switcher-match-count == 0 ? "No matching rooms" : root.quick-switcher-match-count > 6 ? "Showing 6 matches; type more to narrow the list" : root.quick-switcher-match-count + " matching rooms";
                        color: root.muted; font-size: 11px * root.text-scale; accessible-live-region: polite;
                    }
                    VerticalLayout {
                        spacing: 3px; alignment: start;
                        for room[index] in root.quick-switcher-results : ActionRect {
                            height: 36px; border-radius: StyleTokens.radius * 0.7;
                            background: index == root.quick-switcher-index ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover) : root.elevated;
                            focus-color: root.accent;
                            label: "Open " + room.name + " · " + room.id;
                            activated => { root.choose-quick-room(index); }
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 8px;
                                Text { text: room.name; color: index == root.quick-switcher-index && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Text { text: room.unread > 0 ? room.unread + " unread" : ""; color: index == root.quick-switcher-index && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.muted; font-size: 11px * root.text-scale; vertical-alignment: center; }
                            }
                        }
                    }
                    Text {
                        text: root.quick-switcher-index >= 0 && root.quick-switcher-index < root.quick-switcher-results.length ? "Selected: " + root.quick-switcher-results[root.quick-switcher-index].name : "";
                        color: root.muted; font-size: 11px * root.text-scale; overflow: elide;
                        accessible-live-region: polite;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    close-quick-switcher := TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                        text: "Close";
                        activated => { root.close-quick-switcher(); }
                    }
                }
            }
        }
    }

    if root.room-notifications-current : FocusScope {
        focus-on-tab-navigation: false;
        init => { room-notification-panel.focus-first(); }
        // Tab stays inside the panel while it is open.
        capture-key-pressed(event) => {
            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && room-notification-panel.at-start {
                room-notification-panel.focus-last();
                accept
            } else if event.text == Key.Tab && !event.modifiers.shift && room-notification-panel.at-end {
                room-notification-panel.focus-first();
                accept
            } else { reject }
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-room-notifications();
                accept
            } else { reject }
        }
        // A click outside the panel closes it and reaches nothing behind it.
        TouchArea {
            width: parent.width; height: parent.height;
            clicked => { root.close-room-notifications(); }
        }
        room-notification-panel := RoomNotificationPanel {
            x: max(8px, parent.width - self.width - 16px);
            y: max(64px, 40px * root.text-scale + 24px) + StyleTokens.icon-button-growth + 4px;
            // Never taller than the window below the header; the body scrolls.
            available-height: parent.height - self.y - 12px;
            palette: {
                ink: root.ink,
                muted: root.muted,
                panel: root.panel,
                elevated: root.dialog-surface,
                hover: root.hover,
                accent: root.accent,
                divider: root.divider,
                error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483,
                selection: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover,
                selection-ink: StyleTokens.roles.selection-ink.color,
                has-selection-ink: StyleTokens.roles.selection-ink.present,
                focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
            };
            text-scale: root.text-scale;
            radius: StyleTokens.radius;
            live: root.live-session;
            dismissed => { root.close-room-notifications(); }
        }
    }

    // Who has read an event (room activity). Modal; Rust fills the rows.
    if RoomActivity.seen-open : SeenByDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        ink: root.ink; muted: root.muted; accent: root.accent; surface: root.dialog-surface;
        scrim: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
        text-scale: root.text-scale;
    }
    if root.people-open : FocusScope {
        focus-on-tab-navigation: false;
        init => { people-input.focus(); }
        // Admission of a creation stops a queued search; edits are disabled
        // while it runs, and Rust refuses a search while busy too.
        property <bool> busy: root.people-busy;
        changed busy => { if self.busy { people-debounce.running = false; } }
        // Reveal the selected row (rows share one height) whenever the
        // selection or the geometry changes: text scale, the body's height,
        // the row count, or the status lines above the rows.
        property <int> selected: root.people-index;
        property <length> row-height: max(44px, 32px * root.text-scale + 12px);
        property <length> row-step: self.row-height + 3px;
        property <length> body-view: people-body.visible-height;
        property <int> row-count: root.people-items.length;
        property <length> rows-top: people-rows.absolute-position.y - people-content.absolute-position.y;
        changed selected => { self.reveal-selected(); }
        changed row-step => { self.reveal-selected(); }
        changed body-view => { self.reveal-selected(); }
        changed row-count => { self.reveal-selected(); }
        changed rows-top => { self.reveal-selected(); }
        // A chosen person or a confirmation appears below the rows: show it.
        property <string> chosen: root.people-chosen-id;
        property <bool> confirming: root.people-confirm;
        changed chosen => { self.reveal-decision(); }
        changed confirming => { self.reveal-decision(); }
        function reveal-selected() {
            if self.selected >= 0 && self.selected < root.people-items.length {
                if self.rows-top + self.selected * self.row-step < -people-body.viewport-y {
                    people-body.viewport-y = -(self.rows-top + self.selected * self.row-step);
                } else if self.rows-top + (self.selected + 1) * self.row-step > -people-body.viewport-y + people-body.visible-height {
                    people-body.viewport-y = -(self.rows-top + (self.selected + 1) * self.row-step - people-body.visible-height);
                }
            }
        }
        function reveal-decision() {
            if root.people-chosen-id != "" {
                people-body.viewport-y = min(0px, people-body.visible-height - people-content.preferred-height);
            }
        }
        // The first and last enabled controls, for the modal Tab cycle.
        function focus-first() {
            if people-input.enabled { people-input.focus(); } else { people-close.focus(); }
        }
        pure function at-first() -> bool {
            return people-input.enabled ? people-input.has-focus : people-close.has-focus;
        }
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.people-confirm { root.people-confirm = false; } else { root.dismiss-people(); }
                accept
            } else if event.text == Key.Tab && !event.modifiers.shift && people-close.has-focus {
                self.focus-first();
                accept
            } else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && self.at-first() {
                people-close.focus();
                accept
            } else if people-input.has-focus && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt && !event.modifiers.shift && root.people-items.length > 0 && event.text == Key.DownArrow {
                root.people-index = min(root.people-index + 1, root.people-items.length - 1);
                accept
            } else if people-input.has-focus && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt && !event.modifiers.shift && root.people-items.length > 0 && event.text == Key.UpArrow {
                root.people-index = max(root.people-index - 1, 0);
                accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            // The scrim takes clicks and wheel scrolling: nothing behind the
            // dialog moves or acts while it is open.
            TouchArea {
                width: parent.width; height: parent.height;
                scroll-event(event) => { accept }
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(560px, parent.width - 32px); height: min(600px, parent.height - 40px);
                background: root.dialog-surface;
                border-radius: StyleTokens.radius * 1.4; border-color: root.accent; border-width: StyleTokens.line-width;
                accessible-role: region; accessible-label: "Start a conversation";
                // A short pause after typing searches; Enter searches at once
                // or chooses the selected person.
                people-debounce := Timer {
                    interval: 350ms; running: false;
                    triggered => { self.running = false; if !root.people-busy { root.people-search(); } }
                }
                VerticalLayout {
                    padding: 20px; spacing: 8px;
                    Text { text: "Start a conversation"; color: root.ink; font-size: 18px * root.text-scale; font-weight: 750; }
                    Rectangle {
                        height: max(38px, 16px * root.text-scale + 18px);
                        background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.elevated;
                        border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.8;
                        if root.people-query == "" : Text {
                            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding;
                            text: "Name or @name:example.org"; color: root.muted; font-size: 12px * root.text-scale;
                            vertical-alignment: center; overflow: elide;
                        }
                        people-input := ThemedTextInput {
                            x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
                            text <=> root.people-query; color: root.ink; font-size: 12px * root.text-scale;
                            single-line: true; vertical-alignment: center;
                            enabled: !root.people-busy;
                            accessible-label: "Search people; arrows select, Enter chooses, Escape closes";
                            edited => {
                                people-debounce.running = false;
                                if !root.people-busy { people-debounce.running = true; }
                            }
                            accepted => {
                                people-debounce.running = false;
                                if root.people-busy {
                                } else if root.people-index >= 0 && root.people-index < root.people-items.length {
                                    root.people-choose(root.people-index);
                                } else {
                                    root.people-search();
                                }
                            }
                        }
                    }
                    // Only this body scrolls: the heading, the search field and
                    // the actions below stay in view at the smallest window and
                    // the largest text.
                    people-body := ScrollView {
                        vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        people-content := VerticalLayout {
                            width: people-body.visible-width; spacing: 8px; alignment: start;
                            Text {
                                text: "Search people on your homeserver, or enter a complete Matrix ID. A new conversation is encrypted and invites only the person you choose.";
                                color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                            }
                            if root.people-status != "" : Text {
                                text: root.people-status; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                                accessible-live-region: polite;
                            }
                            if root.people-error != "" : Text {
                                text: root.people-error;
                                color: StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : #e47483;
                                font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite;
                            }
                            // At most 21 rows (the bound in Rust), each one height.
                            people-rows := VerticalLayout {
                                spacing: 3px; alignment: start;
                                for person[index] in root.people-items : ActionRect {
                                    height: max(44px, 32px * root.text-scale + 12px);
                                    border-radius: StyleTokens.radius * 0.7;
                                    background: index == root.people-index ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover) : root.elevated;
                                    focus-color: root.accent;
                                    enabled: !root.people-busy;
                                    label: "Choose " + person.name + ", " + person.user-id;
                                    focus-state-changed(focused) => { if focused { root.people-index = index; } }
                                    activated => { root.people-choose(index); }
                                    VerticalLayout {
                                        padding-left: 10px; padding-right: 10px; padding-top: 4px; padding-bottom: 4px; spacing: 1px; alignment: center;
                                        Text { text: person.name; color: index == root.people-index && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink; font-size: 12px * root.text-scale; font-weight: 650; overflow: elide; }
                                        Text { text: person.exact ? person.user-id + " (as typed)" : person.user-id; color: index == root.people-index && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.muted; font-size: 10px * root.text-scale; overflow: elide; }
                                    }
                                }
                            }
                            if root.people-chosen-id != "" : Rectangle {
                                background: root.elevated; border-radius: StyleTokens.radius * 0.8;
                                border-color: root.divider; border-width: StyleTokens.line-width;
                                VerticalLayout {
                                    padding: 10px; spacing: 6px;
                                    Text { text: root.people-chosen-name; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; overflow: elide; }
                                    Text { text: root.people-chosen-id; color: root.muted; font-size: 11px * root.text-scale; overflow: elide; }
                                    Text {
                                        text: root.people-known == 1 ? "Checking this device's conversations…"
                                            : root.people-known == 2 ? "No direct conversation with this person is known on this device."
                                            : root.people-known == 3 ? "You already have a direct conversation with this person."
                                            : root.people-known == 4 ? root.people-known-count + " direct conversations with this person exist; Open shows the first of them."
                                            : "";
                                        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                                    }
                                    if root.people-confirm : Text {
                                        text: "Start an encrypted direct conversation with " + root.people-chosen-id + "? An invitation is sent to that account only.";
                                        color: root.ink; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: assertive;
                                    }
                                }
                            }
                        }
                    }
                    // The explicit actions are fixed below the body, always reachable.
                    // Each action on its own right-aligned row: at 200% text,
                    // the widest control padding and a narrow dialog the
                    // confirmation, Cancel and Close never need more width
                    // than the dialog has. Tab order: decision, Cancel, Close.
                    VerticalLayout {
                        spacing: 6px; alignment: end;
                        if root.people-known == 3 || root.people-known == 4 : HorizontalLayout {
                            alignment: end;
                            TokenButton { colors: root.button-colors; text-scale: root.text-scale; primary: true;
                                text: "Open conversation"; label: "Open the direct conversation with " + root.people-chosen-id;
                                enabled: !root.people-busy;
                                activated => { root.people-open-dm(); }
                            }
                        }
                        if root.people-known == 2 && !root.people-confirm : HorizontalLayout {
                            alignment: end;
                            TokenButton { colors: root.button-colors; text-scale: root.text-scale; primary: true;
                                text: "Start conversation…"; label: "Start an encrypted direct conversation with " + root.people-chosen-id;
                                enabled: !root.people-busy;
                                activated => { root.people-ask-start(); }
                            }
                        }
                        if root.people-confirm : HorizontalLayout {
                            alignment: end;
                            TokenButton { colors: root.button-colors; text-scale: root.text-scale; primary: true;
                                text: "Start encrypted conversation"; label: "Confirm starting an encrypted direct conversation with " + root.people-chosen-id;
                                enabled: !root.people-busy;
                                activated => { root.people-confirm-start(); }
                            }
                        }
                        if root.people-confirm : HorizontalLayout {
                            alignment: end;
                            TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                                text: "Cancel";
                                activated => { root.people-confirm = false; people-input.focus(); }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                        people-close := TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                            text: "Close";
                            activated => { root.dismiss-people(); }
                        }
                        }
                    }
                }
            }
        }
    }

    // A room member's details and ignore controls (member_privacy). Modal.
    if MemberPrivacy.inspector.open && root.member-inspector-allowed : MemberInspector {
        x: 0px; y: 0px; width: root.width; height: root.height;
        colors: root.button-colors; surface: root.dialog-surface;
        scrim: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
        text-scale: root.text-scale;
    }
    if root.room-actions-open : FocusScope {
        focus-on-tab-navigation: false;
        init => { room-action-input.focus(); }
        capture-key-pressed(event) => {
            if root.room-action-busy && (event.text == Key.Tab || event.text == Key.Backtab) {
                // A join stays withdrawable: Tab moves between Close and Cancel.
                if root.room-action-mode == 1 {
                    if room-action-cancel.has-focus { room-action-close.focus(); } else { room-action-cancel.focus(); }
                }
                accept
            } else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && room-action-close.has-focus {
                if root.live-session { room-action-submit.focus(); }
                else { room-action-cancel.focus(); }
                accept
            } else if event.text == Key.Tab && !event.modifiers.shift && (room-action-submit.has-focus || (!root.live-session && room-action-cancel.has-focus)) {
                room-action-close.focus();
                accept
            } else { reject }
        }
        key-pressed(event) => {
            if event.text == Key.Escape && (!root.room-action-busy || root.room-action-mode == 1) {
                if root.room-action-busy { root.cancel-room-join(); }
                root.room-actions-open = false;
                room-action-trigger.focus();
                accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 462px) / 2;
                y: (parent.height - 342px) / 2;
                width: 462px;
                height: 342px;
                border-radius: StyleTokens.radius * 1.4;
                border-color: root.divider;
                border-width: StyleTokens.line-width;
                background: root.dialog-surface;
                accessible-role: region;
                accessible-label: "Create or join a Matrix room";
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 31px;
                        Text { text: "Rooms and Spaces"; color: root.ink; font-size: 19px * root.text-scale; font-weight: 750; horizontal-stretch: 1; }
                        room-action-close := Button {
                            width: 34px; height: 31px; text: "×";
                            // A join in progress can always be withdrawn.
                            enabled: !root.room-action-busy || root.room-action-mode == 1;
                            accessible-label: root.room-action-busy ? "Cancel the join and close room actions" : "Close room actions";
                            clicked => {
                                if root.room-action-busy { root.cancel-room-join(); }
                                root.room-actions-open = false; room-action-trigger.focus();
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 36px;
                        spacing: 5px;
                        for label[index] in ["Create room", "Join room", "Create Space"] : Button {
                            horizontal-stretch: 1;
                            text: label;
                            enabled: !root.room-action-busy;
                            accessible-label: label;
                            clicked => {
                                root.room-action-mode = index;
                                root.room-action-input = "";
                                root.room-action-error = "";
                            }
                        }
                    }
                    Text {
                        text: root.room-action-mode == 1 ? "Enter a room ID, alias, matrix.to link, or matrix: URI." : root.room-action-mode == 2 ? "Give your new private Space a name." : "Give your new private room a name.";
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 43px;
                        background: root.elevated;
                        border-radius: StyleTokens.radius * 0.8;
                        room-action-input := ThemedTextInput {
                            x: 11px; width: parent.width - 22px; height: parent.height;
                            text <=> root.room-action-input;
                            color: root.ink;
                            font-size: 13px * root.text-scale;
                            enabled: !root.room-action-busy;
                            accessible-label: root.room-action-mode == 1 ? "Room ID, alias, or Matrix link" : "Room or Space name";
                            accepted => {
                                if !root.room-action-busy {
                                    root.submit-room-action(root.room-action-mode, root.room-action-input);
                                    if root.room-action-busy && root.room-action-mode == 1 { room-action-cancel.focus(); }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.live-session ? root.room-action-error : "Preview only · sign in to create or join rooms.";
                        accessible-live-region: polite;
                        color: root.live-session && root.room-action-error != "" ? (StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #ff8d9d) : root.muted;
                        font-size: 11px * root.text-scale;
                        wrap: word-wrap;
                        height: 40px;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        height: 38px;
                        spacing: 8px;
                        alignment: end;
                        room-action-cancel := Button {
                            width: 88px;
                            text: "Cancel";
                            enabled: !root.room-action-busy || root.room-action-mode == 1;
                            accessible-label: root.room-action-busy ? "Cancel the join" : "Cancel";
                            clicked => {
                                if root.room-action-busy { root.cancel-room-join(); }
                                root.room-actions-open = false; room-action-trigger.focus();
                            }
                        }
                        room-action-submit := Button {
                            width: 134px;
                            primary: true;
                            text: root.room-action-busy ? "Working…" : root.room-action-mode == 1 ? "Join room" : root.room-action-mode == 2 ? "Create Space" : "Create room";
                            accessible-label: root.room-action-mode == 1 ? "Join Matrix room" : root.room-action-mode == 2 ? "Create private Matrix Space" : "Create private Matrix room";
                            enabled: root.live-session && !root.room-action-busy
                                && (root.room-action-mode != 1 || (root.discovery-context-allowed && !SpaceExplorer.open));
                            clicked => {
                                root.submit-room-action(root.room-action-mode, root.room-action-input);
                                // The keyboard stays on a control that can withdraw the join.
                                if root.room-action-busy && root.room-action-mode == 1 { room-action-cancel.focus(); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.room-admin-open && root.room-admin-mode == 0 : FocusScope {
        focus-on-tab-navigation: false;
        init => { settings-close.focus(); }
        // The address panel closed: its opener takes the keyboard back.
        property <int> addresses-closed: RoomAddresses.closed;
        changed addresses-closed => { settings-addresses.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.room-settings-confirmation != 0 {
                    root.room-settings-action(7);
                    settings-close.focus();
                } else {
                    root.dismiss-room-settings();
                }
                accept
            } else if root.room-settings-confirmation != 0 { reject }
            else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && settings-refresh.has-focus {
                settings-close.focus(); accept
            } else if event.text == Key.Tab && !event.modifiers.shift && settings-close.has-focus {
                if !root.room-admin-busy { settings-refresh.focus(); }
                accept
            } else if root.room-admin-busy && (event.text == Key.Tab || event.text == Key.Backtab) {
                settings-close.focus(); accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                width: min(620px, parent.width - 40px);
                height: min(820px, parent.height - 40px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.dialog-surface; border-color: root.divider; border-width: StyleTokens.line-width; border-radius: StyleTokens.radius * 1.4;
                accessible-role: region;
                accessible-label: "Room settings";
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Room settings"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; vertical-alignment: center; horizontal-stretch: 1; }
                        settings-refresh := ActionRect {
                            width: 118px * root.text-scale;
                            height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: root.divider;
                            background: root.control-fill(self.enabled && self.has-hover, self.enabled && self.has-pressed, root.elevated); focus-color: root.ink;
                            label: "Refresh room settings from the homeserver";
                            enabled: !root.room-admin-busy && root.room-settings-confirmation == 0;
                            activated => { root.room-settings-action(0); }

                            Text { x: 12px; width: parent.width - 24px; text: root.room-settings-dirty ? "Refresh…" : "Refresh"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    Text { text: "Changes apply to this room for all members. Permissions are checked again when saving."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-right: 12px; spacing: 10px;
                            // Leaving for roles and permissions closes this form; with
                            // unsaved edits it waits until they are saved or refreshed away.
                            // Room addresses open over this form: while they are, this
                            // refuses both by its enabled state and in the activation itself,
                            // so a queued activation cannot switch the view under them.
                            ActionRect {
                                height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: root.divider;
                                background: root.control-fill(self.enabled && self.has-hover, self.enabled && self.has-pressed, root.elevated); focus-color: root.ink;
                                label: root.room-settings-dirty ? "Roles and permissions; save or refresh your settings edits first" : "Open this room's roles and permissions";
                                enabled: !RoomAddresses.open && !root.room-admin-busy && root.room-settings-confirmation == 0 && !root.room-settings-dirty;
                                activated => {
                                    if !RoomAddresses.open && !root.room-admin-busy && root.room-settings-confirmation == 0 && !root.room-settings-dirty {
                                        root.room-admin-mode = 3;
                                    }
                                }

                                Text { x: 12px; width: parent.width - 24px; text: "Roles and permissions…"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "Room name"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 650; }
                            Rectangle {
                                min-height: 42px * root.text-scale; background: root.elevated; border-radius: StyleTokens.radius * 0.8;
                                ThemedTextInput {
                                    x: 12px; width: parent.width - 24px; height: parent.height;
                                    text <=> root.room-admin-name-input; single-line: true;
                                    enabled: root.room-settings-editable && root.room-settings-name-allowed;
                                    color: root.ink; font-size: 13px * root.text-scale; accessible-label: "Room name; at most 1024 bytes";
                                    edited => { root.room-settings-edit(1); }
                                }
                            }
                            ActionRect {
                                height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: root.divider;
                                background: self.enabled ? root.accent : root.panel; focus-color: root.ink;
                                label: "Save room name";
                                enabled: root.room-settings-editable && root.room-settings-name-allowed && root.room-admin-name-input != "";
                                activated => { root.submit-room-admin(0, root.room-admin-name-input, ""); }

                                Text { x: 12px; width: parent.width - 24px; text: "Save name"; color: parent.enabled ? root.accent-ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "Topic"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 650; }
                            Rectangle {
                                min-height: 70px * root.text-scale; background: root.elevated; border-radius: StyleTokens.radius * 0.8;
                                ThemedTextInput {
                                    x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px;
                                    text <=> root.room-admin-topic-input; single-line: false; wrap: word-wrap;
                                    enabled: root.room-settings-editable && root.room-settings-topic-allowed;
                                    color: root.ink; font-size: 13px * root.text-scale; accessible-label: "Room topic; blank clears it; at most 16 KiB";
                                    edited => { root.room-settings-edit(2); }
                                }
                            }
                            ActionRect {
                                height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: root.divider;
                                background: self.enabled ? root.accent : root.panel; focus-color: root.ink;
                                label: "Save room topic";
                                enabled: root.room-settings-editable && root.room-settings-topic-allowed;
                                activated => { root.submit-room-admin(1, root.room-admin-topic-input, ""); }

                                Text { x: 12px; width: parent.width - 24px; text: "Save topic"; color: parent.enabled ? root.accent-ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle { height: StyleTokens.line-width; background: root.divider; }
                            Text { text: "Room avatar"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 700; }
                            Text { text: "Static PNG or baseline JPEG, up to 8 MiB and 4 megapixels. New avatars are resized to at most 512 px and stripped of metadata. Room avatars are shared metadata, even in encrypted rooms."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                            Rectangle {
                                height: 112px; background: root.elevated; border-radius: StyleTokens.radius * 1;
                                if root.room-settings-image-visible : Image {
                                    x: (parent.width - 96px) / 2; y: 8px; width: 96px; height: 96px;
                                    source: root.room-settings-image; image-fit: contain;
                                    accessible-role: image;
                                    accessible-label: root.room-settings-staged ? "Staged room avatar; not uploaded" : "Current room avatar preview";
                                }
                                if !root.room-settings-image-visible : Text {
                                    text: root.room-settings-avatar-present ? "Avatar hidden · preview is optional" : "No avatar";
                                    color: root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                ActionRect {
                                    height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: root.divider;
                                    background: root.control-fill(self.enabled && self.has-hover, self.enabled && self.has-pressed, root.elevated); focus-color: root.ink;
                                    label: "Download and preview current room avatar";
                                    enabled: root.room-settings-editable && root.room-settings-preview-available && !root.room-settings-staged;
                                    activated => { root.room-settings-action(2); }

                                    Text { x: 12px; width: parent.width - 24px; text: "Preview current"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                ActionRect {
                                    height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: root.divider;
                                    background: root.control-fill(self.enabled && self.has-hover, self.enabled && self.has-pressed, root.elevated); focus-color: root.ink;
                                    label: "Choose a new room avatar image";
                                    enabled: root.room-settings-editable && root.room-settings-avatar-allowed && !root.room-settings-staged;
                                    activated => { root.room-settings-action(1); }

                                    Text { x: 12px; width: parent.width - 24px; text: "Choose image…"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                ActionRect {
                                    height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: root.divider;
                                    background: self.enabled ? root.accent : root.panel; focus-color: root.ink;
                                    label: "Upload and save staged room avatar";
                                    enabled: root.room-settings-editable && root.room-settings-avatar-allowed && root.room-settings-staged;
                                    activated => { root.room-settings-action(3); }

                                    Text { x: 12px; width: parent.width - 24px; text: "Save avatar"; color: parent.enabled ? root.accent-ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                ActionRect {
                                    height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: root.divider;
                                    background: root.control-fill(self.enabled && self.has-hover, self.enabled && self.has-pressed, root.elevated); focus-color: root.ink;
                                    label: "Discard room avatar image from this form";
                                    enabled: !root.room-admin-busy && root.room-settings-confirmation == 0 && root.room-settings-image-visible;
                                    activated => { root.room-settings-action(4); }

                                    Text { x: 12px; width: parent.width - 24px; text: "Discard preview"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                }

                            }
                            ActionRect {
                                height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: root.divider;
                                background: root.control-fill(self.enabled && self.has-hover, self.enabled && self.has-pressed, root.elevated); focus-color: root.ink;
                                label: "Confirm removal of current room avatar";
                                enabled: root.room-settings-editable && root.room-settings-avatar-allowed && root.room-settings-avatar-present;
                                activated => { root.room-settings-action(5); }

                                Text { x: 12px; width: parent.width - 24px; text: "Remove…"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: root.room-settings-staged ? "Staged locally. Inspect orientation and colours before saving." : "Encrypted-room previews follow your Appearance privacy setting. No avatar is downloaded automatically."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                            Rectangle { height: StyleTokens.line-width; background: root.divider; }
                            Text { text: "Who can join"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 700; }
                            Text { text: root.room-settings-access-description; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                            TokenSelect {
                                model: root.room-settings-join-options; current-index <=> root.room-settings-join-index;
                                colors: root.button-colors; text-scale: root.text-scale;
                                enabled: root.room-settings-editable && root.room-settings-join-allowed;
                                accessible-label: "Room join rule; only choices supported by this room version";
                                selected(value) => { root.room-settings-action(9); }
                            }
                            if root.room-settings-restricted : Text { text: "Allowed rooms · one Matrix room ID per line (up to 32)"; color: root.ink; font-size: 12px * root.text-scale; wrap: word-wrap; }
                            if root.room-settings-restricted : Rectangle {
                                min-height: 96px * root.text-scale; background: root.elevated; border-radius: StyleTokens.radius * 0.8;
                                ThemedTextInput {
                                    x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px;
                                    text <=> root.room-settings-allow-rooms; single-line: false; wrap: word-wrap;
                                    enabled: root.room-settings-editable && root.room-settings-join-allowed;
                                    color: root.ink; font-size: 12px * root.text-scale;
                                    accessible-label: "Allowed Matrix room IDs; one per line; empty permits no automatic restricted joins";
                                    edited => { root.room-settings-edit(4); }
                                }
                            }
                            ActionRect {
                                height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: root.divider;
                                background: self.enabled ? root.accent : root.panel; focus-color: root.ink;
                                label: "Save room join rule";
                                enabled: root.room-settings-editable && root.room-settings-join-allowed && root.room-settings-join-index >= 0;
                                activated => { root.room-settings-action(8); }

                                Text { x: 12px; width: parent.width - 24px; text: "Save join rule"; color: parent.enabled ? root.accent-ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: "Public access requires confirmation. Directory listing is a separate setting and is not changed here. Unknown rules remain read-only."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                            // Room addresses (room-addresses.slint) open over this form.
                            Rectangle { height: StyleTokens.line-width; background: root.divider; }
                            Text { text: "Room addresses"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 700; }
                            Text { text: "Addresses such as #name:server lead to this room. Adding, removing and publishing are separate changes, each reviewed first."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                            settings-addresses := ActionRect {
                                height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: root.divider;
                                background: root.control-fill(self.enabled && self.has-hover, self.enabled && self.has-pressed, root.elevated); focus-color: root.ink;
                                label: "Manage the addresses of this room";
                                enabled: !root.room-admin-busy && root.room-settings-confirmation == 0
                                    && root.room-admin-account-id == root.active-account-local-id
                                    && root.room-admin-room-id == root.active-room-id;
                                activated => { RoomAddresses.show(root.room-admin-room-id, root.active-room-name); }

                                Text { x: 12px; width: parent.width - 24px; text: "Manage addresses…"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                    if root.room-admin-busy : Text { text: "Working… You can close this form to cancel pending work."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                    if root.room-admin-error != "" : Text { text: root.room-admin-error; color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : root.ink; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                    if root.room-admin-notice != "" : Text { text: root.room-admin-notice; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                    settings-close := ActionRect {
                        height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; border-width: StyleTokens.line-width; border-color: root.divider;
                        background: root.control-fill(self.enabled && self.has-hover, self.enabled && self.has-pressed, root.elevated); focus-color: root.ink;
                        label: "Close room settings and discard unsaved edits and images";
                        enabled: root.room-settings-confirmation == 0;
                        activated => { root.dismiss-room-settings(); }

                        Text { x: 12px; width: parent.width - 24px; text: "Close"; color: parent.enabled ? root.ink : root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                if root.room-settings-confirmation != 0 : FocusScope {
                    init => { settings-confirm-cancel.focus(); }
                    Rectangle {
                        background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000bb;
                        TouchArea { width: parent.width; height: parent.height; }
                        Rectangle {
                            x: 20px; y: (parent.height - self.height) / 2; width: parent.width - 40px;
                            height: confirmation-layout.preferred-height;
                            background: root.elevated; border-radius: StyleTokens.radius * 1.2; border-color: root.divider; border-width: StyleTokens.line-width;
                            accessible-role: region;
                            accessible-label: root.room-settings-confirmation == 1 ? "Confirm public room access" : root.room-settings-confirmation == 2 ? "Confirm room avatar removal" : "Confirm discard and refresh";
                            confirmation-layout := VerticalLayout {
                                padding: 20px; spacing: 16px;
                                Text { text: root.room-settings-confirmation == 1 ? "Allow anyone to join?" : root.room-settings-confirmation == 2 ? "Remove this room's avatar?" : "Discard edits and refresh?"; color: root.ink; font-size: 18px * root.text-scale; font-weight: 700; wrap: word-wrap; }
                                Text { text: root.room-settings-confirmation == 1 ? "Anyone will be able to join this room. This does not list the room in a public directory." : root.room-settings-confirmation == 2 ? "This removes the shared avatar for everyone in the room. It does not delete previously uploaded media from the homeserver." : "Unsaved name, topic, access and image edits will be discarded. Current settings will be fetched from the homeserver."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    settings-confirm-cancel := ActionRect {
                                        height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; background: root.panel; label: "Cancel room settings confirmation";
                                        trap-tab: true; cancel-on-escape: true; focus-color: root.accent;
                                        next-focus => { settings-confirm-save.focus(); } previous-focus => { settings-confirm-save.focus(); }
                                        cancelled => { root.room-settings-action(7); settings-close.focus(); }
                                        activated => { root.room-settings-action(7); settings-close.focus(); }
                                        Text { text: "Cancel"; color: root.ink; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    settings-confirm-save := ActionRect {
                                        height: 42px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; background: root.accent;
                                        label: root.room-settings-confirmation == 1 ? "Confirm public access" : root.room-settings-confirmation == 2 ? "Confirm avatar removal" : "Confirm discard edits and refresh";
                                        trap-tab: true; cancel-on-escape: true; focus-color: root.ink;
                                        next-focus => { settings-confirm-cancel.focus(); } previous-focus => { settings-confirm-cancel.focus(); }
                                        cancelled => { root.room-settings-action(7); settings-close.focus(); }
                                        activated => { root.room-settings-action(6); settings-close.focus(); }
                                        Text { text: "Confirm"; color: root.accent-ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }


    if root.room-admin-open && root.room-admin-mode == 3 : RoomPermissionsDialog {
        text-scale: root.text-scale;
        controls: root.button-colors;
        palette: {
            ink: root.ink,
            muted: root.muted,
            surface: root.dialog-surface,
            elevated: root.elevated,
            hover: StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover,
            outline: root.divider,
            focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
            selection: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : Palette.selection-background,
            selection-ink: StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : Palette.selection-foreground,
            has-selection-ink: true,
            accent: root.accent,
            error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b,
            warning: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b,
            scrim: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa,
            input-surface: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.elevated,
            input-border: StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.divider,
        };
        // Back reopens room settings, read fresh; Close ends the dialog.
        // Both end the editor synchronously first, so a held read or save
        // can no longer act for a view that is already closing.
        back => { RoomPermissions.reset(); root.room-admin-mode = 0; root.open-room-settings(); }
        close => { RoomPermissions.reset(); root.room-admin-open = false; root.dismiss-room-settings(); }
    }

    if root.room-admin-open && root.room-admin-mode == 2 : FocusScope {
        init => { admin-close.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.moderation-context-changed(3);
                root.room-admin-open = false;
                account-trigger.focus();
                accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 480px) / 2;
                y: (parent.height - (root.room-admin-mode == 2 ? 325px : 430px)) / 2;
                width: 480px;
                height: root.room-admin-mode == 2 ? 325px : 430px;
                background: root.dialog-surface;
                border-color: root.divider;
                border-width: StyleTokens.line-width;
                border-radius: StyleTokens.radius * 1.4;
                accessible-role: region;
                accessible-label: root.room-admin-mode == 2 ? "Confirm message redaction" : "Edit Matrix room details";
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: root.room-admin-mode == 2 ? "Redact this message?" : "Room details";
                        color: root.ink;
                        font-size: 19px * root.text-scale;
                        font-weight: 750;
                    }
                    if root.room-admin-mode == 2 : Text {
                        text: root.room-admin-event-preview;
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                        overflow: elide;
                        height: 48px;
                    }
                    if root.room-admin-mode == 2 : Text {
                        text: "This removes the message content for room members. Your homeserver decides whether you have permission.";
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                        height: 43px;
                    }
                    if root.room-admin-error != "" : Text {
                        text: root.room-admin-error;
                        color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #ff8d9d;
                        font-size: 11px * root.text-scale;
                        wrap: word-wrap;
                        accessible-live-region: polite;
                        height: 38px;
                    }
                    if root.room-admin-notice != "" : Text {
                        text: root.room-admin-notice;
                        color: root.accent;
                        font-size: 11px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 9px;
                        admin-close := Button {
                            width: 94px; height: 36px;
                            text: root.room-admin-mode == 2 ? "Cancel" : "Close";
                            clicked => {
                                root.moderation-context-changed(3);
                                root.room-admin-open = false;
                                account-trigger.focus();
                            }
                        }
                        if root.room-admin-mode == 2 : Button {
                            width: 145px; height: 36px;
                            primary: true;
                            text: root.room-admin-busy ? "Redacting…" : "Redact message";
                            enabled: !root.room-admin-busy;
                            clicked => {
                                if root.room-admin-account-id == root.active-account-local-id
                                    && root.room-admin-room-id == root.active-room-id {
                                    root.submit-room-admin(2, root.room-admin-event-id, "");
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Any visible-context transition withdraws pending address work. The
    // callback cancels its owner synchronously before hiding the panel.
    // Rust also keeps click-captured navigation/security epochs, so ABA
    // transitions cannot revive an old confirmation after a blocked wait.
    property <string> room-addresses-context: root.active-account-local-id + "\n" + root.active-room-id
        + "\n" + root.active-space-id + "\n" + root.page + "\n" + root.navigation-mode
        + "\n" + (root.live-session ? "1" : "0") + (root.show-sign-in ? "1" : "0")
        + (root.access-open ? "1" : "0") + (root.account-switch-pending ? "1" : "0")
        + (root.manage-accounts-open ? "1" : "0") + (root.security-busy ? "1" : "0")
        + (root.security-recovery-key != "" ? "1" : "0") + (root.sas-busy ? "1" : "0")
        + "\n" + root.sas-stage + (root.account-menu-open ? "1" : "0")
        + (root.quick-switcher-open ? "1" : "0") + (root.room-actions-open ? "1" : "0")
        + (root.room-admin-open ? "1" : "0") + "\n" + root.room-admin-mode
        + "\n" + root.room-admin-account-id + "\n" + root.room-admin-room-id
        + (root.room-admin-busy ? "1" : "0") + "\n" + root.room-settings-confirmation
        + (root.member-confirm-open ? "1" : "0") + (root.native-capture-picker-open ? "1" : "0")
        + (root.leave-call-dialog ? "1" : "0") + (root.image-preview-open ? "1" : "0")
        + (root.poll-dialog-open ? "1" : "0")
        + (MemberPrivacy.inspector.open ? "1" : "0") + (root.people-open ? "1" : "0")
        + (root.account-profile-open ? "1" : "0") + (SpaceExplorer.open ? "1" : "0")
        + (SpaceRooms.open ? "1" : "0") + (RoomNotificationState.open ? "1" : "0")
        + (RoomActivity.seen-open ? "1" : "0") + (MemberPrivacy.ignored.busy ? "1" : "0")
        + "\n" + MemberPrivacy.ignored.stage;
    changed room-addresses-context => { RoomAddresses.context-changed(); }

    // Room addresses (room-addresses.slint), over Room settings; Rust owns
    // its state.
    if RoomAddresses.open : RoomAddressesPanel {
        text-scale: root.text-scale;
        button-colors: root.button-colors;
        palette: {
            ink: root.ink,
            muted: root.muted,
            accent: root.accent,
            surface: root.dialog-surface,
            elevated: root.elevated,
            hover: root.hover,
            divider: root.divider,
            error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e58e9b,
            selection: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover,
            selection-ink: StyleTokens.roles.selection-ink.color,
            has-selection-ink: StyleTokens.roles.selection-ink.present,
            focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
            scrim: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa,
        };
    }

    if root.member-confirm-open : FocusScope {
        init => { cancel-member-action.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape && !root.member-action-busy {
                root.member-confirm-open = false;
                account-trigger.focus();
                accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 430px) / 2;
                y: (parent.height - 220px) / 2;
                width: 430px; height: 220px;
                background: root.elevated; border-color: root.divider;
                border-width: StyleTokens.line-width; border-radius: StyleTokens.radius * 1.4;
                accessible-role: region;
                accessible-label: "Confirm room member action";
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    Text {
                        text: root.member-confirm-kind == 1 ? "Kick " + root.member-confirm-name + "?"
                            : root.member-confirm-kind == 2 ? "Ban " + root.member-confirm-name + "?"
                            : root.member-confirm-kind == 3 ? "Unban " + root.member-confirm-name + "?"
                            : "Change power for " + root.member-confirm-name + "?";
                        color: root.ink; font-size: 18px * root.text-scale;
                        font-weight: 750; wrap: word-wrap;
                    }
                    Text {
                        text: root.member-confirm-kind == 4
                            ? "Set this member's Matrix room power level to " + root.member-confirm-value + "."
                            : root.member-confirm-kind == 1
                            ? "Remove this member from the room. They may rejoin if room rules allow it."
                            : root.member-confirm-kind == 2
                            ? "Remove this member and prevent them from rejoining until unbanned."
                            : "Allow this member to join the room again.";
                        color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        alignment: end; spacing: 9px;
                        cancel-member-action := ActionRect {
                            width: 98px; height: 36px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8;
                            background: root.panel; label: "Cancel member action";
                            trap-tab: true; cancel-on-escape: true;
                            next-focus => { confirm-member-action.focus(); }
                            previous-focus => { confirm-member-action.focus(); }
                            cancelled => { root.member-confirm-open = false; account-trigger.focus(); }
                            activated => { root.member-confirm-open = false; account-trigger.focus(); }
                            Text { text: "Cancel"; color: root.ink; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        confirm-member-action := ActionRect {
                            width: 128px; height: 36px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8;
                            background: root.accent; label: "Confirm room member action";
                            trap-tab: true; cancel-on-escape: true;
                            next-focus => { cancel-member-action.focus(); }
                            previous-focus => { cancel-member-action.focus(); }
                            cancelled => { root.member-confirm-open = false; account-trigger.focus(); }
                            activated => {
                                if root.member-confirm-account-id == root.active-account-local-id
                                    && root.member-confirm-room-id == root.active-room-id {
                                    root.submit-member-action(root.member-confirm-kind, root.member-confirm-user-id, root.member-confirm-value);
                                }
                                root.member-confirm-open = false;
                                account-trigger.focus();
                            }
                            Text { text: "Confirm"; color: root.accent-ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }

    if root.native-capture-picker-open && root.page == 2 && root.live-session && root.native-call-joined : FocusScope {
        focus-on-tab-navigation: false;
        init => { capture-picker-close.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.native-capture-picker-open = false;
                accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                width: 486px;
                height: 452px;
                x: (parent.width - 486px) / 2;
                y: (parent.height - 452px) / 2;
                background: root.dialog-surface;
                border-color: root.divider;
                border-width: StyleTokens.line-width;
                border-radius: StyleTokens.radius * 1.4;
                accessible-role: region;
                accessible-label: root.native-capture-picker-kind == 0 ? "Choose a camera" : "Choose a display or window to share";
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 33px;
                        spacing: 8px;
                        Text {
                            text: root.native-capture-picker-kind == 0 ? "Choose a camera" : "Share a display or window";
                            color: root.ink;
                            font-size: 19px * root.text-scale;
                            font-weight: 750;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        capture-picker-close := Button {
                            width: 35px; height: 33px;
                            text: "×";
                            accessible-label: "Close capture source picker";
                            clicked => { root.native-capture-picker-open = false; }
                        }
                    }
                    Text {
                        text: root.native-capture-picker-kind == 0
                            ? "Your system may ask for camera access after you choose a source."
                            : "Only picture from the selected display or window is shared. Your microphone remains separate.";
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                    }
                    if root.native-capture-source-loading : Text {
                        text: "Looking for available sources…";
                        color: root.muted;
                        font-size: 12px * root.text-scale;
                        accessible-live-region: polite;
                    }
                    if root.native-capture-source-error != "" : Text {
                        text: root.native-capture-source-error;
                        color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #ef9da9;
                        font-size: 12px * root.text-scale;
                        wrap: word-wrap;
                        accessible-live-region: polite;
                    }
                    capture-source-list := ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: capture-source-list.visible-width;
                            spacing: 6px;
                            for source in root.native-capture-sources : Rectangle {
                                height: ((root.native-capture-picker-kind == 0 && source.kind == 0)
                                    || (root.native-capture-picker-kind == 1 && source.kind != 0)) ? 48px : 0px;
                                background: transparent;
                                if (root.native-capture-picker-kind == 0 && source.kind == 0)
                                    || (root.native-capture-picker-kind == 1 && source.kind != 0) : ActionRect {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: StyleTokens.radius * 0.8;
                                    border-color: root.divider;
                                    border-width: StyleTokens.line-width;
                                    background: root.elevated;
                                    focus-color: root.accent;
                                    label: source.kind == 0 ? "Use camera " + source.name
                                        : source.kind == 1 ? "Share display " + source.name
                                        : "Share window " + source.name;
                                    enabled: !root.native-capture-source-loading
                                        && !root.native-camera-busy && !root.native-screen-busy;
                                    activated => {
                                        root.native-capture-picker-open = false;
                                        root.start-native-capture(source.kind, source.id);
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        Text {
                                            text: source.kind == 0 ? "CAMERA" : source.kind == 1 ? "DISPLAY" : "WINDOW";
                                            color: root.accent;
                                            font-size: 10px * root.text-scale;
                                            font-weight: 750;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: source.name;
                                            color: root.ink;
                                            font-size: 12px * root.text-scale;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.native-capture-picker-kind == 0
                            ? "If a camera is missing, check system permissions and refresh this list."
                            : "A changed window title or display layout stops sharing. Choose the source again to resume.";
                        color: root.muted;
                        font-size: 11px * root.text-scale;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        alignment: end;
                        Button {
                            width: 105px;
                            text: "Refresh";
                            enabled: !root.native-capture-source-loading;
                            accessible-label: "Refresh available capture sources";
                            clicked => { root.refresh-native-capture-sources(root.native-capture-picker-kind); }
                        }
                        Button {
                            width: 90px;
                            text: "Cancel";
                            accessible-label: "Cancel capture source selection";
                            clicked => { root.native-capture-picker-open = false; }
                        }
                    }
                }
            }
        }
    }

    if root.leave-call-dialog : FocusScope {
        init => { cancel-leave.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape && !root.leave-call-busy {
                root.cancel-pending-log-out();
                root.leave-call-dialog = false;
                root.pending-account-index = -1;
                account-trigger.focus();
                accept
            } else { reject }
        }
        Rectangle {
        background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - 392px) / 2;
            y: (parent.height - 250px) / 2;
            width: 440px;
            height: 250px;
            background: root.elevated;
            border-color: root.divider;
            border-width: StyleTokens.line-width;
            border-radius: StyleTokens.radius * 1.4;
            accessible-role: region;
            accessible-label: root.native-leave-unconfirmed ? "Incomplete MatrixRTC call cleanup" : root.live-session ? "Leave call before changing accounts" : "End call preview before changing accounts";
            VerticalLayout {
                padding: 22px;
                spacing: 13px;
                Text { text: root.leave-call-busy ? (root.native-leave-unconfirmed ? "Checking call cleanup…" : "Leaving call…") : root.native-leave-unconfirmed ? "Call cleanup incomplete" : root.live-session ? "Leave call?" : "Leave call preview?"; color: root.ink; font-size: 19px * root.text-scale; font-weight: 750; }
                Text { text: root.native-leave-unconfirmed ? "Account changes remain blocked while native capture is stopping. Once it ends, you can acknowledge an uncertain server leave; the app cannot retry that leave." : root.pending-account-index == -2 ? "Leave the current call before adding another account." : root.pending-account-index == -3 ? "Leave the current call before logging out." : "Leave the current call before switching accounts."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    spacing: 9px;
                    alignment: end;
                    cancel-leave := ActionRect {
                        width: 104px; height: 36px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; background: root.panel;
                        focus-color: root.accent;
                        label: "Cancel account switch";
                        enabled: !root.leave-call-busy;
                        trap-tab: true;
                        cancel-on-escape: true;
                        next-focus => { confirm-leave.focus(); }
                        previous-focus => { confirm-leave.focus(); }
                        cancelled => { root.cancel-pending-log-out(); root.leave-call-dialog = false; root.pending-account-index = -1; account-trigger.focus(); }
                        activated => { root.cancel-pending-log-out(); root.leave-call-dialog = false; root.pending-account-index = -1; account-trigger.focus(); }
                        Text { text: "Cancel"; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    confirm-leave := ActionRect {
                        width: 182px; height: 36px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; background: root.accent;
                        focus-color: root.accent-ink;
                        label: root.native-leave-unconfirmed ? (root.pending-account-index == -4 ? "Acknowledge incomplete call cleanup" : "Continue account action after call cleanup") : root.pending-account-index == -2 ? "Leave call and add account" : root.pending-account-index == -3 ? "Leave call and log out" : "Leave call and switch account";
                        enabled: !root.leave-call-busy;
                        trap-tab: true;
                        cancel-on-escape: true;
                        next-focus => { cancel-leave.focus(); }
                        previous-focus => { cancel-leave.focus(); }
                        cancelled => { root.cancel-pending-log-out(); root.leave-call-dialog = false; root.pending-account-index = -1; account-trigger.focus(); }
                        activated => { root.confirm-leave-call(root.pending-account-index); }
                        Text { text: root.leave-call-busy ? "Checking…" : root.native-leave-unconfirmed ? "Continue if safe" : "Leave call"; color: root.accent-ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
        }
    }

    if root.poll-dialog-open && root.live-session : PollCreateDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        palette: root.poll-palette;
        text-scale: root.text-scale;
        corner: StyleTokens.radius;
        surface: root.dialog-surface;
        scrim: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
    }

    if root.show-sign-in : FocusScope {
        focus-on-tab-navigation: false;
        in property <int> focus-request: root.account-focus-request;
        init => {
            if !root.manage-accounts-open && !root.access-open && root.saved-accounts.length == 0 { login-homeserver-input.focus(); }
        }
        changed focus-request => {
            if !root.manage-accounts-open && !root.access-open && root.saved-accounts.length == 0 { login-homeserver-input.focus(); }
        }
        capture-key-pressed(event) => {
            if event.text == Key.Tab && !event.modifiers.shift && login-preview.has-focus {
                if root.saved-accounts.length > 0 { root.return-account-focus(); }
                else { login-homeserver-input.focus(); }
                accept
            } else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) &&
                root.saved-accounts.length == 0 && login-homeserver-input.has-focus {
                if root.login-loading { login-password-input.focus(); }
                else { login-preview.focus(); }
                accept
            } else if root.login-loading && (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) &&
                (login-submit.has-focus || login-browser.has-focus || login-preview.has-focus) {
                login-password-input.focus(); accept
            } else if root.login-loading && event.text == Key.Tab && !event.modifiers.shift &&
                (login-password-input.has-focus || login-submit.has-focus || login-browser.has-focus) {
                if root.saved-accounts.length > 0 { root.return-account-focus(); }
                else { login-homeserver-input.focus(); }
                accept
            } else { reject }
        }
        Rectangle {
        background: root.sign-in-surface;
        // The sign-in surface stays inside the window at every text scale.
        // Its fields and actions scroll together; focused actions reveal their
        // complete bounds without allowing Tab into the covered conversation.
        Rectangle {
            width: min(448px * root.text-scale, parent.width - 32px);
            height: min(640px * root.text-scale, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: StyleTokens.radius * 1.8;
            border-color: root.divider;
            border-width: StyleTokens.line-width;
            background: root.dialog-surface;
            accessible-role: form;
            accessible-label: "Sign in to Matrix";
            login-body-scroll := ScrollView {
                x: 24px; y: 24px;
                width: parent.width - 48px; height: parent.height - 48px;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                width: login-body-scroll.visible-width;
                alignment: start; vertical-stretch: 0;
                spacing: 11px;
                Rectangle {
                    width: 48px * root.text-scale; height: 48px * root.text-scale; vertical-stretch: 0; border-radius: StyleTokens.radius * 1.5; background: root.accent;
                    Text { text: "M"; color: root.accent-ink; font-size: 22px * root.text-scale; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: "Welcome to Morpheus"; color: root.ink; font-size: 22px * root.text-scale; font-weight: 770; wrap: word-wrap; vertical-stretch: 0; }
                Text { text: "Sign in with an existing Matrix account."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; vertical-stretch: 0; }
                if root.saved-accounts.length > 0 : TextAction {
                    in property <int> focus-request: root.account-focus-request;
                    init => { if !root.manage-accounts-open && !root.access-open { self.focus(); } }
                    changed focus-request => {
                        if root.show-sign-in && !root.manage-accounts-open && !root.access-open && root.saved-accounts.length > 0 { self.focus(); }
                    }
                    // Resolve this conditional item's focus locally. Outer
                    // handlers request it through account-focus-request;
                    // Slint cannot address an ID across this conditional.
                    trap-tab: true;
                    next-focus => { login-homeserver-input.focus(); }
                    previous-focus => {
                        if root.login-loading { login-password-input.focus(); }
                        else { login-preview.focus(); }
                    }
                    reveal-full-control: true;
                    height: 38px * root.text-scale; vertical-stretch: 0;
                    text: "Choose a saved account"; ink: root.ink; muted: root.muted;
                    surface: root.panel; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                    activated => { root.manage-accounts-open = true; root.manage-accounts(); }
                }
                if root.account-access-notice != "" : Text {
                    text: root.account-access-notice; color: root.muted; font-size: 11px * root.text-scale;
                    wrap: word-wrap; accessible-live-region: polite;
                }

                Rectangle { height: 6px; vertical-stretch: 0; background: transparent; }
                Text { text: "HOMESERVER"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; letter-spacing: 1px; vertical-stretch: 0; }
                Rectangle {
                    height: 42px * root.text-scale; vertical-stretch: 0; background: root.input-fill(root.elevated);
                    border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.8;
                    border-color: login-homeserver-input.has-focus ? root.field-focus : root.input-border-color;
                    border-width: login-homeserver-input.has-focus ? StyleTokens.focus-width : StyleTokens.line-width; clip: true;
                    login-homeserver-input := ThemedTextInput { x: 11px; width: parent.width - 22px; height: parent.height; single-line: true; text <=> root.login-homeserver; color: root.ink; font-size: 13px * root.text-scale; vertical-alignment: center; accessible-label: "Homeserver URL"; }
                }
                Text { text: "MATRIX ID OR USERNAME"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; letter-spacing: 1px; vertical-stretch: 0; }
                Rectangle {
                    height: 42px * root.text-scale; vertical-stretch: 0; background: root.input-fill(root.elevated);
                    border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.8;
                    border-color: login-username-input.has-focus ? root.field-focus : root.input-border-color;
                    border-width: login-username-input.has-focus ? StyleTokens.focus-width : StyleTokens.line-width; clip: true;
                    login-username-input := ThemedTextInput { x: 11px; width: parent.width - 22px; height: parent.height; single-line: true; text <=> root.login-username; color: root.ink; font-size: 13px * root.text-scale; vertical-alignment: center; accessible-label: "Matrix ID or username"; }
                }
                Text { text: "PASSWORD"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750; letter-spacing: 1px; vertical-stretch: 0; }
                Rectangle {
                    height: 42px * root.text-scale; vertical-stretch: 0; background: root.input-fill(root.elevated);
                    border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.8;
                    border-color: login-password-input.has-focus ? root.field-focus : root.input-border-color;
                    border-width: login-password-input.has-focus ? StyleTokens.focus-width : StyleTokens.line-width; clip: true;
                    login-password-input := ThemedTextInput {
                        x: 11px; width: parent.width - 22px; height: parent.height;
                        text <=> root.login-password; single-line: true; input-type: password;
                        color: root.ink; font-size: 13px * root.text-scale; vertical-alignment: center;
                        accessible-label: "Password";
                        accepted => {
                            if !root.login-loading {
                                let password = root.login-password;
                                root.login-password = "";
                                root.login-loading = true;
                                root.submit-login(root.login-homeserver, root.login-username, password);
                            }
                        }
                    }
                }
                if root.login-error != "" : Text { text: root.login-error; color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483; font-size: 11px * root.text-scale; wrap: word-wrap; }
                if root.config-error != "" : Text { text: "Settings file: " + root.config-error; color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483; font-size: 11px * root.text-scale; wrap: word-wrap; }
                login-submit := ActionRect {
                    height: 43px * root.text-scale; vertical-stretch: 0;
                    border-radius: StyleTokens.radius * 0.9; background: root.accent;
                    reveal-full-control: true; focus-color: root.accent-ink;
                    label: root.login-loading ? "Signing in" : "Sign in to Matrix";
                    enabled: !root.login-loading;
                    activated => {
                        if !root.login-loading {
                            let password = root.login-password;
                            root.login-password = "";
                            root.login-loading = true;
                            root.submit-login(root.login-homeserver, root.login-username, password);
                        }
                    }
                    Text { text: root.login-loading ? "Signing in…" : "Sign in"; color: root.accent-ink; font-size: 13px * root.text-scale; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
                }
                login-browser := ActionRect {
                    height: 40px * root.text-scale; vertical-stretch: 0;
                    border-radius: StyleTokens.radius * 0.9; background: root.elevated;
                    border-color: root.divider; border-width: StyleTokens.line-width;
                    reveal-full-control: true; focus-color: root.accent;
                    label: "Sign in with browser using Matrix SSO";
                    enabled: !root.login-loading;
                    activated => {
                        if !root.login-loading {
                            root.login-loading = true;
                            root.submit-sso(root.login-homeserver);
                        }
                    }
                    Text { text: "Sign in with browser · Matrix SSO"; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                login-preview := ActionRect {
                    height: 38px * root.text-scale; vertical-stretch: 0;
                    border-radius: StyleTokens.radius * 0.8; background: root.control-fill(self.has-hover, self.has-pressed, transparent);
                    reveal-full-control: true; focus-color: root.accent;
                    label: "Open interactive preview without signing in";
                    enabled: !root.login-loading;
                    activated => { if !root.login-loading { root.preview-demo(); } }
                    Text { text: "Explore the interactive preview"; color: root.muted; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                }
                }
            }
        }
        }
    }

    if root.security-recovery-key != "" : FocusScope {
        focus-on-tab-navigation: false;
        init => { reveal-recovery-key.focus(); }
        key-pressed(event) => { if event.text == Key.Escape { accept } else { reject } }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000cc;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 520px) / 2;
                y: (parent.height - 348px) / 2;
                width: 520px; height: 348px;
                background: root.dialog-surface; border-color: root.accent; border-width: StyleTokens.line-width; border-radius: StyleTokens.radius * 1.4;
                accessible-role: region;
                accessible-label: "One-time Matrix recovery key";
                VerticalLayout {
                    padding: 24px; spacing: 12px;
                    Text { text: "Save your recovery key"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                    Text { text: "Morpheus can show this new key only now. Save it in a password manager or another private place. Anyone with this key may be able to read your encrypted history."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                    Rectangle {
                        height: 75px; background: root.elevated; border-radius: StyleTokens.radius * 0.8; border-color: root.divider; border-width: StyleTokens.line-width;
                        if root.security-key-revealed : Text {
                            x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px;
                            text: root.security-recovery-key; color: root.ink; font-size: 14px * root.text-scale;
                            font-family: root.monospace-font-family; wrap: word-wrap;
                            accessible-label: "Recovery key shown once: " + root.security-recovery-key;
                        }
                        if !root.security-key-revealed : Text {
                            text: "Key hidden until you choose Reveal"; color: root.muted; font-size: 12px * root.text-scale;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    Text { text: root.security-notice != "" ? root.security-notice : "Copying places the key on the system clipboard; clear it after saving."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        spacing: 8px; alignment: end;
                        reveal-recovery-key := Button {
                            width: 90px; text: "Reveal"; enabled: !root.security-key-revealed;
                            accessible-label: "Reveal the new recovery key once";
                            clicked => { root.security-key-revealed = true; copy-recovery-key.focus(); }
                        }
                        copy-recovery-key := Button {
                            width: 90px; text: "Copy"; enabled: root.security-key-revealed;
                            accessible-label: "Copy recovery key to system clipboard";
                            clicked => { root.copy-recovery-key(); }
                        }
                        Button {
                            width: 154px; text: "I saved this key"; primary: true; enabled: root.security-key-revealed;
                            accessible-label: "I saved the recovery key; hide it permanently in Morpheus";
                            clicked => { root.dismiss-recovery-key(); }
                        }
                    }
                }
            }
        }
    }
    } // shortcut-scope
    if root.manage-accounts-open : FocusScope {
        in property <int> focus-request: root.account-focus-request;
        focus-on-tab-navigation: false;
        // Search can request a control before this conditional subtree exists.
        // Apply it on creation as well as later focus requests.
        init => { self.focus-requested-control(); }
        changed focus-request => { self.focus-requested-control(); }
        function focus-requested-control() {
            if root.manage-accounts-open && !root.access-open {
                if root.manage-accounts-focus == "add" {
                    manage-add.focus();
                } else if root.manage-accounts-focus == "protection" {
                    manage-protection.focus();
                } else if root.manage-accounts-focus == "profile" {
                    manage-profile.focus();
                } else {
                    manage-close.focus();
                }
                if root.manage-accounts-focus != "" {
                    root.settings-revealed-id = root.settings-reveal-id;
                    root.manage-accounts-focus = "";
                }
            }
        }
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.manage-accounts-open = false; accept }
            else if event.text == Key.Tab && !event.modifiers.shift && manage-close.has-focus { manage-add.focus(); accept }
            else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && manage-add.has-focus { manage-close.focus(); accept }
            else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            TouchArea { }
            Rectangle {
                width: min(620px * root.text-scale, parent.width - 32px);
                height: min(680px * root.text-scale, parent.height - 32px);
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                background: root.dialog-surface; border-radius: StyleTokens.radius * 1.4; border-width: StyleTokens.line-width; border-color: root.divider;
                accessible-role: region; accessible-label: "Manage saved Matrix accounts";
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    Text { text: "Your accounts"; color: root.ink; font-size: 22px * root.text-scale; font-weight: 750; vertical-stretch: 0; }
                    // Only the body grows. At short heights or large text, both
                    // the account list and protection controls remain scrollable.
                    manage-body-scroll := ScrollView {
                        vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: manage-body-scroll.visible-width; spacing: 12px; alignment: start; vertical-stretch: 0;
                            Text { text: "Separate aliases, one app. Open an account or remove it directly from this device."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; vertical-stretch: 0; }
                            manage-add := TextAction {
                                reveal-full-control: true;
                                height: 40px * root.text-scale; vertical-stretch: 0;
                                text: "Add account"; ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                                activated => { root.manage-accounts-open = false; root.add-account(); }
                            }
                            // The current account's public display name and avatar.
                            manage-profile := TextAction {
                                reveal-full-control: true;
                                height: 40px * root.text-scale; vertical-stretch: 0;
                                text: "Edit public profile of the current account";
                                label: "Edit public profile of " + root.active-account-handle;
                                enabled: root.live-session && !root.account-switch-pending;
                                ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                                activated => { root.manage-accounts-open = false; root.open-account-profile(); }
                            }
                            VerticalLayout {
                                spacing: 8px; alignment: start; vertical-stretch: 0;
                                for account in root.saved-accounts : Rectangle {
                                    min-height: 88px * root.text-scale; vertical-stretch: 0; background: root.elevated; border-radius: StyleTokens.radius * 0.9;
                                    VerticalLayout {
                                        padding: 10px; spacing: 7px; alignment: start;
                                        HorizontalLayout {
                                            spacing: 8px; vertical-stretch: 0;
                                            VerticalLayout { width: 24px * root.text-scale; alignment: center; AvatarBadge { width: 24px * root.text-scale; height: 24px * root.text-scale; built-in-radius: StyleTokens.radius * 0.8; initials-size: 10px * root.text-scale; initials: account.initials; accent: account.accent; avatar: account.avatar; has-avatar: account.has-avatar; } }
                                            Text { text: account.handle; color: root.ink; font-size: 13px * root.text-scale; overflow: elide; vertical-alignment: center; accessible-label: account.handle; horizontal-stretch: 1; }
                                        }
                                        HorizontalLayout {
                                            height: 36px * root.text-scale; vertical-stretch: 0; spacing: 8px;
                                            Text { text: account.removal-pending ? "Removal pending" : account.active ? "Current account" : "Paused"; color: root.muted; font-size: 11px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; }
                                            TextAction {
                                reveal-full-control: true;
                                                height: 36px * root.text-scale; vertical-stretch: 0;
                                                text: root.app-password-enabled ? "Unlock" : "Open"; enabled: !account.removal-pending && !root.account-switch-pending;
                                                label: "Open " + account.handle;
                                                ink: root.ink; muted: root.muted; surface: root.panel; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                                                activated => { root.activate-saved-account(account.id); }
                                            }
                                            TextAction {
                                reveal-full-control: true;
                                                height: 36px * root.text-scale; vertical-stretch: 0;
                                                text: account.removal-pending ? "Retry removal" : "Remove"; label: "Remove " + account.handle + " from this app";
                                                enabled: !root.account-switch-pending;
                                                ink: root.ink; muted: root.muted; surface: root.panel; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                                                activated => { root.remove-saved-account(account.id); }
                                            }
                                        }
                                    }
                                }
                                if root.saved-accounts.length == 0 : Text { text: "No saved accounts. Add a Matrix account to get started."; color: root.muted; wrap: word-wrap; font-size: 12px * root.text-scale; vertical-stretch: 0; }
                            }
                            Rectangle { height: 1px; vertical-stretch: 0; background: root.divider; }
                            Text { text: root.app-password-enabled ? "Switch protection is on" : "Switch protection is off"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 650; vertical-stretch: 0; }
                            Text { text: "One local app password for every account switch and startup restore. Works with SSO accounts too."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; vertical-stretch: 0; }
                            HorizontalLayout {
                                height: 40px * root.text-scale; vertical-stretch: 0; spacing: 8px;
                                manage-protection := TextAction {
                                reveal-full-control: true;
                                    height: 40px * root.text-scale; vertical-stretch: 0;
                                    text: root.app-password-enabled ? "Change password" : "Set app password";
                                    ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                                    activated => { root.open-app-password(root.app-password-enabled ? 2 : 1); }
                                }
                                if root.app-password-enabled : TextAction {
                                reveal-full-control: true;
                                    height: 40px * root.text-scale; vertical-stretch: 0;
                                    text: "Turn off"; label: "Turn off account switch protection";
                                    ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                                    activated => { root.open-app-password(3); }
                                }
                            }
                            if root.saved-accounts.length == 0 && root.app-password-enabled : TextAction {
                                reveal-full-control: true;
                                height: 40px * root.text-scale; vertical-stretch: 0;
                                text: "Reset password after removing all accounts";
                                ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                                activated => { root.open-app-password(5); }
                            }
                            Text { text: root.account-access-notice; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; vertical-stretch: 0; }
                        }
                    }
                    manage-close := TextAction {
                                reveal-full-control: true;
                        height: 40px * root.text-scale; vertical-stretch: 0;
                        text: "Done"; ink: root.accent-ink; muted: root.muted; surface: root.accent; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                        activated => { root.manage-accounts-open = false; }
                    }
                }
            }
        }
    }

    if root.account-profile-open : FocusScope {
        focus-on-tab-navigation: false;
        // The name field is disabled until the profile has loaded; start on
        // the first enabled control (Close at worst) and move to the first
        // editable control once the profile arrives.
        init => { self.focus-first(); }
        property <bool> profile-loaded: root.account-profile-loaded;
        changed profile-loaded => { if self.profile-loaded { self.focus-first(); } }
        capture-key-pressed(event) => {
            if event.text == Key.Escape && root.account-profile-confirm-clear {
                root.account-profile-confirm-clear = false;
                accept
            } else if event.text == Key.Escape {
                root.close-account-profile();
                account-trigger.focus();
                accept
            } else if event.text == Key.Tab && !event.modifiers.shift && self.at-last() {
                // Keep keyboard focus inside the dialog.
                self.focus-first();
                accept
            } else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && self.at-first() {
                self.focus-last();
                accept
            } else { reject }
        }
        // The first and last enabled controls, for the Tab trap. Close is
        // always enabled, so focus always has somewhere to stay.
        function focus-first() {
            if profile-choose.enabled { profile-choose.focus(); }
            else if root.account-profile-loaded { profile-name-input.focus(); }
            else if profile-refresh.enabled { profile-refresh.focus(); }
            else { profile-close.focus(); }
        }
        function focus-last() {
            if profile-save.enabled { profile-save.focus(); } else { profile-close.focus(); }
        }
        pure function at-first() -> bool {
            return profile-choose.enabled ? profile-choose.has-focus
                : root.account-profile-loaded ? profile-name-input.has-focus
                : profile-refresh.enabled ? profile-refresh.has-focus
                : profile-close.has-focus;
        }
        pure function at-last() -> bool {
            return profile-save.enabled ? profile-save.has-focus : profile-close.has-focus;
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                width: min(520px * root.text-scale, parent.width - 32px);
                height: min(560px * root.text-scale, parent.height - 32px);
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                background: root.dialog-surface; border-radius: StyleTokens.radius * 1.4; border-width: StyleTokens.line-width; border-color: root.divider;
                accessible-role: region; accessible-label: "Public Matrix profile of " + root.account-profile-user-id;
                VerticalLayout {
                    padding: 20px; spacing: 10px;
                    // Only the body scrolls, so every control stays reachable at
                    // the smallest window and the largest text; the actions stay
                    // fixed below it.
                    profile-body := ScrollView {
                        vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: profile-body.visible-width; spacing: 10px; alignment: start;
                            Text { text: "Public profile"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; vertical-stretch: 0; }
                            // Exactly which identity this changes.
                            Text { text: root.account-profile-user-id; color: root.ink; font-size: 13px * root.text-scale; font-weight: 650; overflow: elide; vertical-stretch: 0; accessible-label: "Matrix account " + root.account-profile-user-id; }
                            if root.account-profile-homeserver != "" : Text { text: "on " + root.account-profile-homeserver; color: root.muted; font-size: 11px * root.text-scale; overflow: elide; vertical-stretch: 0; }
                            Text {
                                text: "Anyone who can see this Matrix account sees its display name and avatar. Your local account entry, device name, sign-in and app password are not changed here.";
                                color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; vertical-stretch: 0;
                            }
                            HorizontalLayout {
                                spacing: 12px; vertical-stretch: 0; height: 72px * root.text-scale;
                                Rectangle {
                                    width: 64px * root.text-scale; height: 64px * root.text-scale;
                                    border-radius: StyleTokens.radius; clip: true; background: root.elevated;
                                    if root.account-profile-image-visible : Image {
                                        width: parent.width; height: parent.height; source: root.account-profile-image; image-fit: cover;
                                        accessible-role: image;
                                        accessible-label: root.account-profile-avatar-state == 1 ? "New avatar preview, not saved" : "Current avatar";
                                    }
                                    if !root.account-profile-image-visible : Text {
                                        text: root.account-profile-avatar-state == 2 ? "None" : root.active-account-initials;
                                        color: root.muted; font-size: 18px * root.text-scale; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px; alignment: center; horizontal-stretch: 1;
                                    HorizontalLayout {
                                        spacing: 6px; alignment: start;
                                        profile-choose := TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                                            text: "Choose image…"; label: "Choose a new public avatar image";
                                            enabled: root.account-profile-loaded && !root.account-profile-busy;
                                            activated => { root.account-profile-choose-avatar(); }
                                        }
                                        if root.account-profile-server-has-avatar && root.account-profile-avatar-state != 2 : TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                                            text: "Remove avatar"; label: "Remove the public avatar when saving";
                                            enabled: root.account-profile-loaded && !root.account-profile-busy;
                                            activated => { root.account-profile-stage-remove-avatar(); }
                                        }
                                        if root.account-profile-avatar-state != 0 : TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                                            text: "Keep current"; label: "Discard the avatar change";
                                            enabled: !root.account-profile-busy;
                                            activated => { root.account-profile-keep-avatar(); }
                                        }
                                    }
                                    Text {
                                        text: root.account-profile-avatar-state == 1 ? "New image, not public until you Save" : root.account-profile-avatar-state == 2 ? "Avatar will be removed when you Save" : root.account-profile-server-has-avatar ? "Current avatar" : "No avatar";
                                        color: root.muted; font-size: 11px * root.text-scale; overflow: elide;
                                    }
                                }
                            }
                            Text { text: "Display name"; color: root.ink; font-size: 12px * root.text-scale; font-weight: 650; vertical-stretch: 0; }
                            Rectangle {
                                height: 38px * root.text-scale; vertical-stretch: 0;
                                background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.elevated;
                                border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.8;
                                border-width: profile-name-input.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
                                border-color: profile-name-input.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent) : root.divider;
                                profile-name-input := ThemedTextInput {
                                    x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
                                    text <=> root.account-profile-name-input; color: root.ink; font-size: 13px * root.text-scale;
                                    single-line: true; vertical-alignment: center;
                                    enabled: root.account-profile-loaded;
                                    accessible-label: "Public display name of " + root.account-profile-user-id;
                                    edited => { root.account-profile-name-edited(); }
                                    accepted => {
                                        if !root.account-profile-busy && (root.account-profile-name-dirty || root.account-profile-avatar-state != 0) {
                                            root.account-profile-save();
                                        }
                                    }
                                }
                            }
                            if root.account-profile-server-has-name : HorizontalLayout {
                                spacing: 8px; vertical-stretch: 0;
                                Text {
                                    text: root.account-profile-server-name != "" ? "Saved name: " + root.account-profile-server-name : "Saved name: blank or not confirmed"; color: root.muted; font-size: 11px * root.text-scale;
                                    overflow: elide; vertical-alignment: center; horizontal-stretch: 1;
                                }
                                if !root.account-profile-confirm-clear : TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                                    text: "Remove display name…"; label: "Remove the display name from the public profile of " + root.account-profile-user-id;
                                    enabled: root.account-profile-loaded && !root.account-profile-busy;
                                    activated => { root.account-profile-confirm-clear = true; }
                                }
                            }
                            if root.account-profile-confirm-clear : Rectangle {
                                vertical-stretch: 0;
                                background: root.elevated; border-radius: StyleTokens.radius * 0.8;
                                border-color: root.accent; border-width: StyleTokens.line-width;
                                init => { profile-clear-keep.focus(); }
                                VerticalLayout {
                                    padding: 10px; spacing: 8px;
                                    Text {
                                        text: "Remove the display name from the public profile of " + root.account-profile-user-id + "? It will have no display name until you set one.";
                                        color: root.ink; font-size: 12px * root.text-scale; wrap: word-wrap;
                                        accessible-live-region: assertive;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px; alignment: end;
                                        profile-clear-keep := TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                                            text: "Keep the name";
                                            activated => { root.account-profile-confirm-clear = false; profile-name-input.focus(); }
                                        }
                                        TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                                            text: "Remove display name"; label: "Confirm removing the display name of " + root.account-profile-user-id;
                                            enabled: !root.account-profile-busy;
                                            activated => { root.account-profile-clear-name(); profile-name-input.focus(); }
                                        }
                                    }
                                }
                            }
                            if root.account-profile-status != "" : Text {
                                text: root.account-profile-status; color: root.ink; font-size: 12px * root.text-scale; wrap: word-wrap; vertical-stretch: 0;
                                accessible-live-region: polite;
                            }
                            if root.account-profile-error != "" : Text {
                                text: root.account-profile-error;
                                color: StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : #e47483;
                                font-size: 12px * root.text-scale; wrap: word-wrap; vertical-stretch: 0;
                                accessible-live-region: polite;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px; vertical-stretch: 0;
                        profile-refresh := TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                            text: "Refresh"; label: "Read the public profile again from the homeserver";
                            enabled: !root.account-profile-busy;
                            activated => { root.account-profile-refresh(); }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        profile-close := TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                            text: "Close";
                            activated => { root.close-account-profile(); account-trigger.focus(); }
                        }
                        profile-save := TokenButton { colors: root.button-colors; text-scale: root.text-scale; primary: true;
                            text: "Save to public profile"; label: "Save to the public profile of " + root.account-profile-user-id;
                            enabled: root.account-profile-loaded && !root.account-profile-busy && (root.account-profile-name-dirty || root.account-profile-avatar-state != 0);
                            activated => { root.account-profile-save(); }
                        }
                    }
                }
            }
        }
    }

    if root.access-open : FocusScope {
        focus-on-tab-navigation: false;
        init => { access-cancel.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if !root.access-busy || root.access-mode == 0 { root.cancel-account-access(); }
                accept
            } else if root.access-busy && (event.text == Key.Tab || event.text == Key.Backtab) { accept }
            else if event.text == Key.Tab && !event.modifiers.shift && access-submit.has-focus {
                if root.access-mode >= 4 { access-cancel.focus(); }
                else if root.access-mode == 1 { access-new.focus(); }
                else { access-current.focus(); }
                accept
            } else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) &&
                ((root.access-mode >= 4 && access-cancel.has-focus) || (root.access-mode == 1 && access-new.has-focus) || ((root.access-mode == 0 || root.access-mode == 2 || root.access-mode == 3) && access-current.has-focus)) {
                access-submit.focus(); accept
            } else { reject }
        }
        Rectangle {
            background: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000bb;
            TouchArea { }
            Rectangle {
                width: min(540px * root.text-scale, parent.width - 32px);
                height: min(610px * root.text-scale, parent.height - 32px);
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                background: root.dialog-surface; border-radius: StyleTokens.radius * 1.4; border-width: StyleTokens.line-width; border-color: root.divider;
                accessible-role: form; accessible-label: root.access-mode == 4 ? "Remove saved account" : "Local app password";
                VerticalLayout {
                    padding: 22px; spacing: 12px;
                    Text {
                        text: root.access-mode == 0 ? "Unlock account" : root.access-mode == 1 ? "Set app password" : root.access-mode == 2 ? "Change app password" : root.access-mode == 3 ? "Turn off protection?" : root.access-mode == 5 ? "Reset app password?" : "Remove from this app?";
                        color: root.ink; font-size: 21px * root.text-scale; font-weight: 750; wrap: word-wrap; vertical-stretch: 0;
                    }
                    access-body-scroll := ScrollView {
                        vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: access-body-scroll.visible-width; spacing: 12px; alignment: start; vertical-stretch: 0;
                            Text {
                                text: root.access-mode == 5 ? "Reset is available only after every saved account and its local credentials and history have been removed. You can then set a new password and sign in again. This cannot unlock an existing account."
                                    : root.access-mode == 4 ? "This removes the saved session and local history for this account. It works offline. It does not log out the homeserver device; revoke that device from another client if needed. Keep your recovery key before removing your last verified device."
                                    : root.access-mode == 0 ? "Enter your local app password to open this account."
                                    : root.access-mode == 3 ? "Your current app password is required. Saved accounts will then open without this prompt."
                                    : "Choose one password for protected switches on this device. Use at least 12 characters. Keep it in your password manager; Morpheus cannot recover it. This protects access through Morpheus, not access by someone who controls your operating system.";
                                color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; vertical-stretch: 0;
                            }
                            if root.access-target != "" : Text { text: root.access-target; color: root.ink; font-size: 13px * root.text-scale; wrap: word-wrap; vertical-stretch: 0; }
                            if root.access-mode == 0 || root.access-mode == 2 || root.access-mode == 3 : Text { text: "Current app password"; color: root.ink; font-size: 12px * root.text-scale; vertical-stretch: 0; }
                            Rectangle {
                                visible: root.access-mode == 0 || root.access-mode == 2 || root.access-mode == 3;
                                height: self.visible ? 42px * root.text-scale : 0px; vertical-stretch: 0; background: root.input-fill(root.elevated);
                                border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.8;
                                border-color: root.field-focus; border-width: access-current.has-focus ? StyleTokens.focus-width : 0px;
                                access-current := ThemedTextInput {
                                    x: 12px; width: parent.width - 24px; height: parent.height; single-line: true; input-type: password;
                                    enabled: parent.visible && !root.access-busy; text <=> root.access-current-password;
                                    color: root.ink; font-size: 14px * root.text-scale; vertical-alignment: center; accessible-label: "Current local app password";
                                    accepted => { if !root.access-busy && root.access-mode != 2 { root.submit-account-access(); } }
                                }
                            }
                            if root.access-mode == 1 || root.access-mode == 2 : Text { text: "New app password"; color: root.ink; font-size: 12px * root.text-scale; vertical-stretch: 0; }
                            Rectangle {
                                visible: root.access-mode == 1 || root.access-mode == 2;
                                height: self.visible ? 42px * root.text-scale : 0px; vertical-stretch: 0; background: root.input-fill(root.elevated);
                                border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.8;
                                border-color: root.field-focus; border-width: access-new.has-focus ? StyleTokens.focus-width : 0px;
                                access-new := ThemedTextInput {
                                    x: 12px; width: parent.width - 24px; height: parent.height; single-line: true; input-type: password;
                                    enabled: parent.visible && !root.access-busy; text <=> root.access-new-password;
                                    color: root.ink; font-size: 14px * root.text-scale; vertical-alignment: center; accessible-label: "New local app password";
                                }
                            }
                            if root.access-mode == 1 || root.access-mode == 2 : Text { text: "Confirm new password"; color: root.ink; font-size: 12px * root.text-scale; vertical-stretch: 0; }
                            Rectangle {
                                visible: root.access-mode == 1 || root.access-mode == 2;
                                height: self.visible ? 42px * root.text-scale : 0px; vertical-stretch: 0; background: root.input-fill(root.elevated);
                                border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.8;
                                border-color: root.field-focus; border-width: access-confirm.has-focus ? StyleTokens.focus-width : 0px;
                                access-confirm := ThemedTextInput {
                                    x: 12px; width: parent.width - 24px; height: parent.height; single-line: true; input-type: password;
                                    enabled: parent.visible && !root.access-busy; text <=> root.access-confirm-password;
                                    color: root.ink; font-size: 14px * root.text-scale; vertical-alignment: center; accessible-label: "Confirm new local app password";
                                    accepted => { if !root.access-busy { root.submit-account-access(); } }
                                }
                            }
                            Text { text: root.access-error; color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : root.ink; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; vertical-stretch: 0; }
                        }
                    }
                    // The fixed footer must not compete with the scrollable form.
                    HorizontalLayout {
                        height: 40px * root.text-scale; vertical-stretch: 0;
                        spacing: 10px; alignment: end;
                        access-cancel := TextAction {
                                reveal-full-control: true;
                            height: 40px * root.text-scale; vertical-stretch: 0;
                            text: "Cancel"; enabled: !root.access-busy || root.access-mode == 0;
                            ink: root.ink; muted: root.muted; surface: root.panel; hover-surface: root.hover; outline: root.divider; text-scale: root.text-scale;
                            activated => { root.cancel-account-access(); }
                        }
                        access-submit := TextAction {
                                reveal-full-control: true;
                            height: 40px * root.text-scale; vertical-stretch: 0;
                            text: root.access-busy ? "Working…" : root.access-mode == 0 ? "Unlock" : root.access-mode == 3 ? "Turn off" : root.access-mode == 4 ? "Remove account" : root.access-mode == 5 ? "Reset password" : "Save password";
                            enabled: !root.access-busy;
                            ink: root.access-mode >= 3 && StyleTokens.roles.destructive-ink.present ? StyleTokens.roles.destructive-ink.color : root.accent-ink; muted: root.muted; surface: root.access-mode >= 3 && StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : root.accent; hover-surface: root.access-mode >= 3 && StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : root.hover; outline: root.divider; text-scale: root.text-scale;
                            activated => { root.submit-account-access(); }
                        }
                    }
                }
            }
        }
    }

}
