import { AboutSlint, Button, ListView, Palette, ScrollView } from "std-widgets.slint";

export struct AccountItem {
    name: string,
    handle: string,
    initials: string,
    status: string,
    accent: color,
}

export struct AccountOption {
    index: int,
    name: string,
    handle: string,
    initials: string,
    accent: color,
}

export struct SpaceItem {
    id: string,
    name: string,
    initials: string,
    accent: color,
}

export struct RoomItem {
    id: string,
    name: string,
    unread: int,
    private-room: bool,
    voice-space: bool,
    voice-local: bool,
    voice-shared: bool,
}

export struct MessageItem {
    event-id: string,
    is-own: bool,
    sender: string,
    initials: string,
    time: string,
    body: string,
    rich-body: styled-text,
    rich-accessible-body: string,
    edit-source: string,
    edit-markdown: bool,
    reply-to: string,
    attachment: string,
    reaction: string,
    accent: color,
}

export struct MemberItem {
    user-id: string,
    name: string,
    initials: string,
    detail: string,
    membership: string,
    power-level-text: string,
    is-account-user: bool,
    is-creator: bool,
    accent: color,
    online: bool,
}

export struct CallParticipantItem {
    name: string,
    detail: string,
    is-local: bool,
}

export struct CallCaptureSourceItem {
    kind: int, // 0 camera, 1 display, 2 window
    id: string,
    name: string,
}

export struct PublicRoomItem {
    id: string,
    title: string,
    alias: string,
    canonical-alias: string,
    topic: string,
    members: string,
    is-space: bool,
    route-server: string,
}

export struct MessageSearchItem {
    room-id: string,
    event-id: string,
    sender: string,
    time: string,
    body: string,
    preview: string,
}

component AvatarBadge inherits Rectangle {
    in property <string> initials;
    in property <color> accent;
    in property <color> ink: #ffffff;
    width: 38px;
    height: 38px;
    border-radius: 13px;
    background: accent;
    Text {
        text: root.initials;
        color: root.ink;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component IconAction inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> ink;
    in property <color> surface;
    in property <color> hover-surface;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback activated();
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: area.has-hover || selected ? hover-surface : surface;
    forward-focus: keyboard-focus;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    if root.icon != "✎" && root.icon != "☷" : Text {
        text: root.icon;
        color: root.ink;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon == "✎" : Path {
        x: (parent.width - 18px) / 2;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: "M 4 16 L 8 15 L 16 7 L 13 4 L 5 12 Z M 12 5 L 15 8";
        stroke: root.ink;
        stroke-width: 1.7px;
        fill: transparent;
    }
    if root.icon == "☷" : Path {
        x: (parent.width - 18px) / 2;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: "M 3 4 L 17 4 L 17 13 L 10 13 L 6 17 L 6 13 L 3 13 Z M 6 7 L 14 7 M 6 10 L 12 10";
        stroke: root.ink;
        stroke-width: 1.7px;
        fill: transparent;
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
    keyboard-focus := FocusScope {
        x: 0px;
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.activated();
                accept
            } else { reject }
        }
    }
    if keyboard-focus.has-focus : Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: root.ink;
        background: transparent;
    }
}

// A custom action keeps its visual children while using the same keyboard path as Slint Button.
component ActionRect inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> focus-color: #a88cff;
    in property <bool> trap-tab: false;
    in property <bool> cancel-on-escape: false;
    out property <bool> has-hover: hit.has-hover;
    out property <bool> has-focus: keyboard-focus.has-focus;
    callback activated();
    callback next-focus();
    callback previous-focus();
    callback cancelled();
    forward-focus: keyboard-focus;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    @children
    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
    keyboard-focus := FocusScope {
        x: 0px;
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.activated();
                accept
            } else if root.trap-tab && event.text == Key.Tab && !event.modifiers.shift {
                root.next-focus();
                accept
            } else if root.trap-tab && (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) {
                root.previous-focus();
                accept
            } else if root.cancel-on-escape && event.text == Key.Escape {
                root.cancelled();
                accept
            } else { reject }
        }
    }
    if keyboard-focus.has-focus : Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: root.focus-color;
        background: transparent;
    }
}

