                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus();
                                    if self.has-focus { root.settings-revealed-id = "appearance.message_layout"; }
                                }
                            }
                            height: 40px * root.text-scale;
                            label: name + (root.message-layout == index ? ", selected" : "");
                            background: root.message-layout == index ? root.hover : root.control-fill(self.has-hover, self.has-pressed, root.elevated);
                            border-radius: StyleTokens.radius * 0.8; border-width: root.message-layout == index ? 1px : 0px; border-color: root.accent;
                            focus-color: root.accent; activated => { root.choose-message-layout(index); }
                            Text { x: 12px; width: parent.width - 24px; height: parent.height;
                                text: name; color: root.ink; font-size: 11px * root.text-scale; vertical-alignment: center; overflow: elide; }
                        }
                        Text { text: "Columns use a compact header when the conversation is too narrow. Text scale and room density continue to apply.";
                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                        for name[index] in ["Message avatars", "Message timestamps", "Colored sender names"] : style-toggle := ActionRect {
                            property <int> reveal-request: index == 0 ? root.reveal-request("appearance.message_details") : 0;
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus();
                                    if self.has-focus { root.settings-revealed-id = "appearance.message_details"; }
                                }
                            }
                            property <bool> selected: index == 0 ? root.show-message-avatars : index == 1 ? root.show-message-timestamps : root.color-message-senders;
                            height: 42px * root.text-scale;
                            label: name + (self.selected ? ", on" : ", off");
                            background: root.control-fill(self.has-hover, self.has-pressed, root.elevated); border-radius: StyleTokens.radius * 0.8; focus-color: root.accent;
                            activated => { root.set-style-flag(index, !self.selected); }
                            HorizontalLayout { padding: 12px; spacing: 8px;
                                Text { text: name; color: root.ink; font-size: 12px * root.text-scale; horizontal-stretch: 1; }
                                Text { text: style-toggle.selected ? "On" : "Off"; color: root.accent; font-size: 12px * root.text-scale; }
                            }
                        }
                        Text { text: "Timestamp style"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 650; }
                        for name[index] in ["12-hour · 3:04 PM", "24-hour · 15:04", "24-hour with seconds · 15:04:05"] : ActionRect {
                            property <int> reveal-request: index == 0 ? root.reveal-request("appearance.timestamps") : 0;
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
