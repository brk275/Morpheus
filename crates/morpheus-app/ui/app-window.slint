                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Message previews"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: "May show decrypted text on your desktop"; color: root.muted; font-size: 11px * root.text-scale; }
                                }
                                Text { text: root.notification-show-preview ? "✓" : "○"; color: root.accent; font-size: 20px * root.text-scale; vertical-alignment: center; }
                            }
                        }
                        Text { text: "Highlight words and phrases"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                        Text { text: "Local matches mark an approved notification as a highlight. They do not override muted rooms."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                        HorizontalLayout {
                            height: 38px; spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1; background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.panel; border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.8; border-color: root.input-border-color; border-width: StyleTokens.line-width;
                                ThemedTextInput {
                                    x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
                                    text <=> root.notification-highlight-input;
                                    color: root.ink; font-size: 12px * root.text-scale;
                                    property <int> reveal-request: root.reveal-request("notifications.highlights");
                                    // Keyboard focus and search share the same bounded reveal.
                                    changed has-focus => {
                                        if self.has-focus {
                                            settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        }
                                    }
                                    changed reveal-request => {
                                        if self.reveal-request > 0 {
                                            settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                            self.focus();
                                            if self.has-focus { root.settings-revealed-id = "notifications.highlights"; }
                                        }
                                    }
                                    accessible-label: "New highlight word or phrase";
                                    edited => { root.notification-highlight-error = ""; }
                                    accepted => { root.add-highlight-word(root.notification-highlight-input); }
                                }
                            }
                            Button {
                                width: 78px; text: "Add"; enabled: root.notification-highlight-input != "";
                                accessible-label: "Add highlight word or phrase";
                                clicked => { root.add-highlight-word(root.notification-highlight-input); }
                            }
                        }
                        if root.notification-highlight-error != "" : Text {
                            text: root.notification-highlight-error; color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483;
                            font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite;
                        }
                        for word in root.notification-highlight-words : Rectangle {
                            height: 36px + StyleTokens.icon-button-growth; border-radius: StyleTokens.radius * 0.8; background: root.elevated;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 8px; spacing: 8px;
                                Text { text: word; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                IconAction {
                                    icon: "×"; label: "Remove highlight " + word;
                                    ink: root.muted; surface: root.elevated; hover-surface: root.hover;
                                    activated => { root.remove-highlight-word(word); }
                                }
                            }
                        }
                        NotificationRules {
                            palette: {
                                ink: root.ink,
                                muted: root.muted,
                                panel: root.panel,
                                elevated: root.elevated,
                                hover: root.hover,
                                accent: root.accent,
                                divider: root.divider,
                                error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483,
                                selection: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover,
                                selection-ink: StyleTokens.roles.selection-ink.color,
                                has-selection-ink: StyleTokens.roles.selection-ink.present,
                                focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
                            };
                            text-scale: root.text-scale;
                            radius: StyleTokens.radius;
                            live: root.live-session;
                            account-key: root.active-account-local-id;
                            account-handle: root.active-account-handle;
                            all-enabled: root.notifications-enabled;
                            account-reveal: root.reveal-request("notifications.account");
                            identity-reveal: root.reveal-request("notifications.identity");
                            defaults-reveal: root.reveal-request("notifications.defaults");
                            keywords-reveal: root.reveal-request("notifications.keywords");
                            rooms-reveal: root.reveal-request("notifications.rooms");
                            room-open: root.live-session && root.active-room-id != "";
                            room-name: root.active-room-name;
                            room-panel-reveal: root.reveal-request("notifications.this_room");
                            open-room-panel => { RoomNotificationState.request-open(root.active-account-local-id, root.active-room-id); }
                            reveal(offset) => { settings-scroll.reveal(offset - settings-content.absolute-position.y); }
                            revealed(id) => { root.settings-revealed-id = id; }
                        }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "Typing and read receipts"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Nothing here is shared until you turn it on. Typing indicators and public read receipts are seen by everyone in the room. Read tracking and Mark as read (in a room's menu) move your own read position on your server, privately unless public read receipts are on, so unread counts match on your other devices."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        ActionRect {
                            height: 68px; border-radius: StyleTokens.radius * 1; background: root.elevated; focus-color: root.accent;
                            property <int> reveal-request: root.reveal-request("privacy.activity");
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus();
                                    if self.has-focus { root.settings-revealed-id = "privacy.activity"; }
                                }
                            }
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            label: "Send typing indicators";
                            accessible-checkable: true; accessible-checked: RoomActivity.send-typing;
                            activated => { RoomActivity.set-preference(0, !RoomActivity.send-typing); }
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Send typing indicators"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: RoomActivity.send-typing ? "On · people in the room see when you are typing" : "Off"; color: root.muted; font-size: 11px * root.text-scale; overflow: elide; }
                                }
                                Text { text: RoomActivity.send-typing ? "✓" : "○"; color: root.accent; font-size: 20px * root.text-scale; vertical-alignment: center; }
                            }
                        }
                        ActionRect {
                            height: 68px; border-radius: StyleTokens.radius * 1; background: root.elevated; focus-color: root.accent;
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            label: "Send public read receipts";
                            accessible-checkable: true; accessible-checked: RoomActivity.public-receipts;
                            activated => { RoomActivity.set-preference(1, !RoomActivity.public-receipts); }
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Send public read receipts"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: RoomActivity.public-receipts ? "On · people in the room see how far you have read" : "Off · read receipts stay private to your server"; color: root.muted; font-size: 11px * root.text-scale; overflow: elide; }
                                }
                                Text { text: RoomActivity.public-receipts ? "✓" : "○"; color: root.accent; font-size: 20px * root.text-scale; vertical-alignment: center; }
                            }
                        }
                        ActionRect {
                            height: 68px; border-radius: StyleTokens.radius * 1; background: root.elevated; focus-color: root.accent;
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            label: "Mark messages read as I view them";
                            accessible-checkable: true; accessible-checked: RoomActivity.read-tracking;
                            activated => { RoomActivity.set-preference(2, !RoomActivity.read-tracking); }
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: "Mark messages read as I view them"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: RoomActivity.read-tracking ? "On · the newest message you view in an active window" : "Off · only Mark as read moves your read position"; color: root.muted; font-size: 11px * root.text-scale; overflow: elide; }
                                }
                                Text { text: RoomActivity.read-tracking ? "✓" : "○"; color: root.accent; font-size: 20px * root.text-scale; vertical-alignment: center; }
                            }
                        }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "Accounts"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Select your account in the bottom-left corner to switch instantly."; color: root.muted; font-size: 13px * root.text-scale; wrap: word-wrap; }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "Security & recovery"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: root.live-session ? "Security for " + root.active-account-handle : "Sign in to inspect device verification and recovery."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        if root.live-session : VerticalLayout {
                            spacing: 11px;
                            Rectangle {
                                // Grows with the wrapped status and identity lines.
                                height: max(116px, security-status-card.preferred-height);
                                border-radius: StyleTokens.radius * 1; background: root.elevated;
                                security-status-card := VerticalLayout {
                                    padding: 14px; spacing: 5px;
                                    HorizontalLayout {
                                        Text { text: "Account security"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; horizontal-stretch: 1; }
                                        Button {
                                            property <int> reveal-request: root.reveal-request("security.recovery");
                                            // Keyboard focus and search share the same bounded reveal.
                                            changed has-focus => {
                                                if self.has-focus {
                                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                                }
                                            }
                                            changed reveal-request => {
                                                if self.reveal-request > 0 {
                                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                                    if self.enabled {
                                                        self.focus();
                                                        if self.has-focus { root.settings-revealed-id = "security.recovery"; }
                                                    } else {
                                                        // Unavailable now: focus the status that explains why, and
                                                        // report that rather than the disabled control.
                                                        security-status-field.focus();
                                                        if security-status-field.has-focus { root.settings-revealed-id = "security.recovery:status"; }
                                                    }
                                                }
                                            }
                                            text: root.security-loading ? "Loading…" : "Refresh"; enabled: !root.security-loading && !root.security-busy; accessible-label: "Refresh account security status"; clicked => { root.refresh-security(); } }
                                    }
                                    // Read-only and focusable, so search can reveal it while Refresh is busy.
                                    security-status-field := ThemedTextInput {
                                        text: "This device: " + root.security-device-status; read-only: true; single-line: false; wrap: word-wrap;
                                        color: root.muted; font-size: 12px * root.text-scale;
                                        accessible-label: "Device security status: " + root.security-device-status;
                                    }
                                    Text { text: "Recovery: " + root.security-recovery-status + "  ·  Key backup: " + root.security-backup-status; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                                    if root.security-identity-status != "" : Text { text: root.security-identity-status; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                                    // A read in progress is said, so the lines above are not taken as current.
                                    if root.security-loading : Text { text: "Reading the current status…"; color: root.muted; font-size: 12px * root.text-scale; accessible-live-region: polite; }
                                }
                            }
                            if root.security-progress != "" : Text { text: root.security-progress; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                            if root.security-error != "" : Text { text: root.security-error; color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                            if root.security-outcome != "" : HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.security-outcome; horizontal-stretch: 1; wrap: word-wrap;
                                    color: root.security-outcome-error ? (StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483) : (StyleTokens.roles.success.present ? StyleTokens.roles.success.color : root.accent);
                                    font-size: 12px * root.text-scale; accessible-live-region: polite;
                                }
                                Button {
                                    text: "Dismiss"; accessible-label: "Dismiss this recovery outcome";
                                    clicked => { root.dismiss-security-outcome(); }
                                }
                            }
                            if root.security-notice != "" : Text { text: root.security-notice; color: StyleTokens.roles.success.present ? StyleTokens.roles.success.color : root.accent; font-size: 12px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                            Timer {
                                interval: 3s;
                                running: root.page == 1 && !root.sas-protected && !root.sas-busy && (root.sas-stage == 1 || root.sas-stage == 3 || root.sas-stage == 5);
                                triggered => { root.refresh-sas-verification(); }
                            }
                            Timer {
                                interval: 3s;
                                running: root.page == 1 && !root.sas-protected && root.sas-stage == 0 && !root.sas-incoming-loading && !root.security-busy;
                                triggered => { root.refresh-incoming-verification(); }
                            }
                            Rectangle {
                                height: root.sas-stage == 4 ? 380px * root.text-scale
                                    : root.sas-stage == 0 ? 160px * root.text-scale + (root.sas-request-uncertain ? 96px * root.text-scale : 0px) + (root.sas-inbox-items.length == 0 ? 0px
                                        : 76px * root.text-scale + min(4, root.sas-inbox-items.length) * root.sas-inbox-row-h
                                            + (root.sas-inbox-note == "" ? 0px : 34px * root.text-scale))
                                    : 250px * root.text-scale;
                                border-radius: StyleTokens.radius * 1; background: root.elevated;
                                VerticalLayout {
                                    padding: 14px; spacing: 7px;
                                    Text { text: "Verify this device"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    if root.sas-stage == 0 : Text {
                                        text: "Start here, then approve on another signed-in, verified device of this account. Compare the values on both devices before confirming.";
                                        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                                    }
                                    // ---- Verification inbox (src/verification.rs) ----
                                    // Requests from this account's other devices: select one, then
                                    // review or decline it. Rows are plain text built in Rust.
                                    if root.sas-stage == 0 && root.sas-inbox-items.length > 0 : VerticalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: root.sas-inbox-items.length == 1 ? "1 request from another device of this account"
                                                : root.sas-inbox-items.length + " requests from other devices of this account";
                                            color: root.accent; font-size: 11px * root.text-scale;
                                            wrap: word-wrap; accessible-live-region: polite;
                                        }
                                        if root.sas-inbox-note != "" : Text {
                                            text: root.sas-inbox-note; color: root.muted;
                                            font-size: 10px * root.text-scale; wrap: word-wrap;
                                        }
                                        sas-inbox-list := ListView {
                                            height: min(4, root.sas-inbox-items.length) * root.sas-inbox-row-h;
                                            horizontal-scrollbar-policy: always-off;
                                            for item[index] in root.sas-inbox-items : ActionRect {
                                                width: sas-inbox-list.visible-width; height: root.sas-inbox-row-h - 4px;
                                                border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.7;
                                                background: index == root.sas-inbox-index ? root.hover : root.panel;
                                                border-width: StyleTokens.line-width;
                                                border-color: index == root.sas-inbox-index ? root.accent : root.divider;
                                                focus-color: root.accent;
                                                label: "Verification request from " + item.title + ". " + item.detail;
                                                accessible-checkable: true; accessible-checked: index == root.sas-inbox-index;
                                                enabled: !root.sas-busy;
                                                activated => { root.sas-inbox-index = index; }
                                                VerticalLayout {
                                                    padding-left: 8px; padding-right: 8px; alignment: center; spacing: 2px;
                                                    Text { text: item.title; color: root.ink; font-size: 11px * root.text-scale; font-weight: 700; overflow: elide; }
                                                    Text { text: item.detail; color: root.muted; font-size: 10px * root.text-scale; overflow: elide; }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px; alignment: start;
                                            Button {
                                                text: root.sas-busy ? "Working…" : "Review selected";
                                                enabled: !root.sas-busy && !root.security-busy
                                                    && root.sas-inbox-index >= 0 && root.sas-inbox-index < root.sas-inbox-items.length
                                                    && root.sas-inbox-items[root.sas-inbox-index].can-review;
                                                accessible-label: "Review the selected verification request";
                                                clicked => { root.accept-incoming-verification(root.sas-inbox-items[root.sas-inbox-index].flow-id); }
                                            }
                                            Button {
                                                text: "Decline";
                                                enabled: !root.sas-busy
                                                    && root.sas-inbox-index >= 0 && root.sas-inbox-index < root.sas-inbox-items.length;
                                                accessible-label: "Decline the selected verification request";
                                                clicked => { root.decline-incoming-verification(root.sas-inbox-items[root.sas-inbox-index].flow-id); }
                                            }
                                        }
                                    }
                                    // ---- end verification inbox ----
                                    if root.sas-stage == 0 && root.sas-request-uncertain : VerticalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "A verification request may already have reached your other devices. Check them first; send a new request only if none arrived.";
                                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                                        }
                                        Button {
                                            text: root.sas-busy ? "Starting…" : "I checked; send a new request";
                                            enabled: !root.sas-busy && !root.security-busy && root.security-recovery-key == "" && root.security-device-status == "Unverified";
                                            accessible-label: "I checked my other devices; send a new verification request";
                                            clicked => { root.request-own-verification-anyway(); }
                                        }
                                    }
                                    if root.sas-stage == 0 : Button {
                                        width: 178px; text: root.sas-busy ? "Starting…" : "Verify with another device";
                                        enabled: !root.sas-busy && !root.security-busy && !root.sas-request-uncertain && root.security-recovery-key == "" && root.security-device-status == "Unverified";
                                        accessible-label: "Request SAS verification from another device on this Matrix account";
                                        clicked => { root.request-own-verification(); }
                                    }
                                    if root.sas-stage != 0 : Text {
                                        text: root.sas-stage == 1 ? (root.sas-request-initiator
                                            ? "Approve the verification request on your other device. Morpheus checks for its response while Settings is open."
                                            : "Request accepted. Waiting for the requesting device to start the comparison.")
                                            : root.sas-stage == 2 ? "The other device accepted. Start the short authentication string comparison."
                                            : root.sas-stage == 3 ? "Waiting for the other device to accept the comparison. Keep both devices open."
                                            : root.sas-stage == 4 ? "Compare every shown emoji or all three numbers with the other device. Confirm only if they match exactly."
                                            : root.sas-stage == 6 ? "The other device moved this verification to a method Morpheus does not support, such as a QR code. Cancel it here, then start again with emoji comparison."
                                            : "Your confirmation was sent. Waiting for the other device to finish.";
                                        color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite;
                                    }
                                    if root.sas-stage == 4 && root.sas-emoji != "" : Text {
                                        text: root.sas-emoji; color: root.ink; font-size: 14px * root.text-scale;
                                        wrap: word-wrap; accessible-label: "SAS emoji comparison: " + root.sas-emoji;
                                    }
                                    if root.sas-stage == 4 && root.sas-decimals != "" : Text {
                                        text: "Numbers: " + root.sas-decimals; color: root.ink;
                                        font-family: root.monospace-font-family; font-size: 14px * root.text-scale;
                                        accessible-label: "SAS number comparison: " + root.sas-decimals;
                                    }
                                    if root.sas-stage == 4 : ActionRect {
                                        height: 38px; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.7;
                                        background: root.sas-compared ? root.hover : root.panel;
                                        border-color: root.sas-compared ? root.accent : root.divider;
                                        border-width: StyleTokens.line-width; focus-color: root.accent;
                                        label: "I compared these values on both devices and they match exactly";
                                        accessible-checkable: true; accessible-checked: root.sas-compared;
                                        enabled: !root.sas-busy;
                                        activated => { root.sas-compared = !root.sas-compared; }
                                        Text {
                                            x: 10px; width: parent.width - 20px; height: parent.height;
                                            text: (root.sas-compared ? "✓ " : "○ ") + "I compared both devices; the values match";
                                            color: root.ink; font-size: 11px * root.text-scale; vertical-alignment: center;
                                        }
                                    }
                                    if root.sas-error != "" : Text { text: root.sas-error; color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483; font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                                    if root.sas-notice != "" : Text { text: root.sas-notice; color: StyleTokens.roles.success.present ? StyleTokens.roles.success.color : root.accent; font-size: 11px * root.text-scale; wrap: word-wrap; accessible-live-region: polite; }
                                    if root.sas-stage != 0 : HorizontalLayout {
                                        spacing: 8px;
                                        if root.sas-stage == 1 || root.sas-stage == 3 || root.sas-stage == 5 : Button {
                                            text: root.sas-busy ? "Checking…" : "Check status";
                                            enabled: !root.sas-busy;
                                            accessible-label: "Check device verification progress";
                                            clicked => { root.refresh-sas-verification(); }
                                        }
                                        if root.sas-stage == 2 : Button {
                                            text: root.sas-busy ? "Starting…" : "Start comparison";
                                            enabled: !root.sas-busy;
                                            accessible-label: "Start or accept SAS comparison on this device";
                                            clicked => { root.start-sas-verification(); }
                                        }
                                        if root.sas-stage == 4 : Button {
                                            text: root.sas-busy ? "Confirming…" : "Confirm match";
                                            primary: true; enabled: root.sas-compared && !root.sas-busy;
                                            accessible-label: "Confirm that SAS values match on both devices";
                                            clicked => { root.confirm-sas-verification(); }
                                        }
                                        Button {
                                            text: root.sas-stage == 4 ? "Values differ / cancel" : "Cancel verification";
                                            enabled: !root.sas-busy;
                                            accessible-label: root.sas-stage == 4 ? "The SAS values differ; cancel verification" : "Cancel this verification request";
                                            clicked => { root.cancel-sas-verification(); }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 108px; border-radius: StyleTokens.radius * 1; background: root.elevated;
                                VerticalLayout {
                                    padding: 14px; spacing: 8px;
                                    Text { text: "Set up recovery"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: "Creates a recovery key for encrypted history. Save it in a password manager or another private place; Morpheus shows it only once."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                                    Button {
                                        width: 170px; text: root.security-busy ? "Working…" : "Create recovery key";
                                        primary: true; enabled: root.security-can-enable && !root.security-busy && !root.security-loading && root.security-recovery-key == "" && root.sas-stage == 0 && !root.sas-busy;
                                        accessible-label: "Create and reveal a one-time Matrix recovery key";
                                        clicked => { root.enable-recovery(); }
                                    }
                                }
                            }
                            Text { text: "If recovery is incomplete, use your existing recovery key below. Setup is available when recovery is disabled."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                            Rectangle {
                                height: 128px; border-radius: StyleTokens.radius * 1; background: root.elevated;
                                VerticalLayout {
                                    padding: 14px; spacing: 8px;
                                    Text { text: "Recover this device"; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; }
                                    Text { text: "Enter a recovery key or passphrase from your existing account. The input is cleared when submitted or when you leave Settings."; color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            height: 38px; horizontal-stretch: 1; background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.panel; border-radius: StyleTokens.input-radius >= 0px ? StyleTokens.input-radius : StyleTokens.radius * 0.8; border-color: root.input-border-color; border-width: StyleTokens.line-width;
                                            ThemedTextInput {
                                                x: StyleTokens.input-padding; width: parent.width - 2 * StyleTokens.input-padding; height: parent.height;
                                                text <=> root.security-recovery-input; input-type: password;
                                                enabled: root.sas-stage == 0 && !root.sas-busy && !root.security-busy;
                                                color: root.ink; font-size: 12px * root.text-scale;
                                                accessible-label: "Recovery key or passphrase";
                                                accepted => {
                                                    if !root.security-busy && root.security-recovery-input != "" {
                                                        let secret = root.security-recovery-input;
                                                        root.security-recovery-input = "";
                                                        root.recover-account(secret);
                                                    }
                                                }
                                            }
                                        }
                                        Button {
                                            width: 96px; text: root.security-busy ? "Working…" : "Recover";
                                            enabled: root.sas-stage == 0 && !root.sas-busy && !root.security-busy && !root.security-loading && root.security-recovery-input != "";
                                            accessible-label: "Recover this Matrix device with the entered key or passphrase";
                                            clicked => {
                                                let secret = root.security-recovery-input;
                                                root.security-recovery-input = "";
                                                root.recover-account(secret);
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                border-radius: StyleTokens.radius * 1; background: root.elevated;
                                VerticalLayout {
                                    padding: 14px;
                                    DeviceSessionsPanel {
                                        view: root.device-sessions-view;
                                        rows: root.device-session-rows;
                                        colors: root.button-colors;
                                        surface: root.panel;
                                        divider: root.divider;
                                        text-scale: root.text-scale;
                                        scope-key: root.live-session ? root.active-account-local-id : "";
                                        reveal-request: root.reveal-request("security.devices");
                                        security-busy: root.security-busy || root.sas-busy || root.sas-stage != 0 || root.security-recovery-key != "";
                                        query <=> root.device-sessions-query;
                                        scope-changed => { root.device-sessions-scope-changed(); }
                                        refresh => { root.device-sessions-refresh(); }
                                        search(text) => { root.device-sessions-search(text); }
                                        select(key) => { root.device-sessions-select(key); }
                                        rename(key, name) => { root.device-sessions-rename(key, name); }
                                        verify(key) => { root.device-sessions-verify(key); }
                                        sign-out(key) => { root.device-sessions-sign-out(key); }
                                        confirm-sign-out => { root.device-sessions-confirm-sign-out(); }
                                        submit-password(secret) => { root.device-sessions-password(secret); }
                                        open-page => { root.device-sessions-open-page(); }
                                        continue-sign-out => { root.device-sessions-continue(); }
                                        cancel-sign-out => { root.device-sessions-cancel(); }
                                        reveal-at(y) => { settings-scroll.reveal(y - settings-content.absolute-position.y); }
                                        revealed(id) => { root.settings-revealed-id = id; }
                                    }
                                }
                            }
                            Rectangle {
                                border-radius: StyleTokens.radius * 1; background: root.elevated;
                                VerticalLayout {
                                    padding: 14px;
                                    IgnoredUsersPanel {
                                        colors: root.button-colors;
                                        text-scale: root.text-scale;
                                        scope-key: root.live-session ? root.active-account-local-id : "";
                                        reveal-request: root.reveal-request("privacy.ignored_users");
                                        reveal-at(y) => { settings-scroll.reveal(y - settings-content.absolute-position.y); }
                                        revealed(id) => { root.settings-revealed-id = id; }
                                    }
                                }
                            }
                        }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "Room addresses"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Addresses such as #name:server lead to a room. The open room's addresses are listed here and under Room settings; adding, removing and publishing are separate changes, each reviewed first. Only addresses on your homeserver are added or removed."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        // Read-only and focusable: search reveals this row whether or
                        // not a room is open, and never claims the button below.
                        room-addresses-status := ThemedTextInput {
                            property <int> reveal-request: root.reveal-request("rooms.addresses");
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus();
                                    if self.has-focus { root.settings-revealed-id = "rooms.addresses"; }
                                }
                            }
                            text: root.live-session && root.active-room-id != "" ? "Open room: " + root.active-room-name : "Open a room first to see its addresses.";
                            read-only: true; single-line: false; wrap: word-wrap;
                            color: root.muted; font-size: 12px * root.text-scale;
                            accessible-label: "Room addresses status: " + self.text;
                        }
                        HorizontalLayout {
                            alignment: start;
                            TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                                // The address panel closed over this page: the keyboard
                                // comes back here.
                                property <int> addresses-closed: RoomAddresses.closed;
                                changed addresses-closed => {
                                    if root.page == 1 && !root.room-admin-open && self.enabled { self.focus(); }
                                }
                                changed has-focus => {
                                    if self.has-focus {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    }
                                }
                                text: "Manage addresses…";
                                label: "Manage the addresses of the open room, " + root.active-room-name;
                                enabled: root.live-session && root.active-room-id != "";
                                activated => { RoomAddresses.show(root.active-room-id, root.active-room-name); }
                            }
                        }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "Image previews"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Images load only when clicked and stay in memory. Closing the viewer or switching rooms/accounts clears them. PNG and baseline JPEG only; animation, WebP, audio and video previews are not available yet."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        ActionRect {
                            height: 40px * root.text-scale; border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.8; background: root.control-fill(self.has-hover, self.has-pressed, root.elevated);
                            focus-color: root.accent;
                            property <int> reveal-request: root.reveal-request("media.image_previews");
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus();
                                    if self.has-focus { root.settings-revealed-id = "media.image_previews"; }
                                }
                            }
                            label: "Allow image previews in encrypted rooms";
                            accessible-checkable: true; accessible-checked: root.image-previews-encrypted-enabled;
                            activated => { root.set-encrypted-image-previews(!root.image-previews-encrypted-enabled); }
                            Text { x: 12px; width: parent.width - 24px; text: (root.image-previews-encrypted-enabled ? "✓  " : "□  ") + "Allow previews in encrypted rooms"; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; }
                        }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "Call audio devices"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Saved for your next call. Your current call keeps its selection until you leave. An unavailable selected device shows an error. System default follows your operating system's audio routing."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        Text { text: "Microphone"; color: root.ink; font-size: 13px * root.text-scale; }
                        TokenSelect {
                            model: root.audio-microphone-choices;
                            current-index <=> root.audio-microphone-index;
                            colors: root.button-colors;
                            text-scale: root.text-scale;
                            enabled: root.audio-devices-enabled && !root.audio-devices-busy;
                            property <int> reveal-request: root.reveal-request("media.audio_devices");
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    if self.enabled {
                                        self.focus();
                                        if self.has-focus { root.settings-revealed-id = "media.audio_devices"; }
                                    } else {
                                        // Unavailable now: focus the status that explains why, and
                                        // report that rather than the disabled control.
                                        audio-status-field.focus();
                                        if audio-status-field.has-focus { root.settings-revealed-id = "media.audio_devices:status"; }
                                    }
                                }
                            }
                            accessible-label: "Microphone for the next call";
                            selected(value) => { root.select-audio-microphone(value); }
                        }
                        Text { text: "Speaker"; color: root.ink; font-size: 13px * root.text-scale; }
                        TokenSelect {
                            model: root.audio-speaker-choices;
                            current-index <=> root.audio-speaker-index;
                            colors: root.button-colors;
                            text-scale: root.text-scale;
                            enabled: root.audio-devices-enabled && !root.audio-devices-busy;
                            accessible-label: "Speaker for the next call";
                            selected(value) => { root.select-audio-speaker(value); }
                        }
                        TokenButton { colors: root.button-colors; text-scale: root.text-scale; text: root.audio-devices-busy ? "Finding devices…" : "Refresh audio devices"; enabled: root.audio-devices-enabled && !root.audio-devices-busy; activated => { root.refresh-audio-devices(); } }
                        // Read-only and focusable, so search can reveal it while devices are unavailable.
                        audio-status-field := ThemedTextInput {
                            text: root.audio-device-notice != "" ? root.audio-device-notice : "Choose Refresh audio devices to list devices.";
                            read-only: true; single-line: false; wrap: word-wrap;
                            color: root.muted; font-size: 12px * root.text-scale;
                            accessible-label: "Audio device status: " + self.text;
                        }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "Keyboard shortcuts"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text {
                            text: "Mod is Command on macOS and Ctrl elsewhere. Meta is Command on macOS and Windows/Super elsewhere. Combine Mod, Ctrl, Meta, Alt, or Shift with A–Z, 0–9, arrows, Home, End, PageUp, PageDown, or F1–F12. Include a modifier other than Shift. Record a combination, or type one and press Enter; Disable turns an action off. Shift+digits, Alt+letters/digits, and editing or window shortcuts are reserved.";
                            color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap;
                        }
                        shortcut-editor := ShortcutEditor {
                            property <int> reveal-request: root.reveal-request("shortcuts");
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus();
                                    if self.has-focus { root.settings-revealed-id = "shortcuts"; }
                                }
                            }
                            items: root.shortcut-items;
                            filter <=> root.shortcut-filter;
                            recording: root.shortcut-recording;
                            message: root.shortcut-message;
                            message-error: root.shortcut-message-error;
                            can-undo: root.shortcut-can-undo;
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            accent: root.accent; outline: root.divider; text-scale: root.text-scale;
                            filter-edited(text) => { root.shortcut-filter-changed(text); }
                            record(action) => { root.shortcut-record(action); }
                            cancel-recording => { root.shortcut-cancel-recording(); }
                            recorded(action, text, control, alt, shift, meta) => { root.shortcut-recorded(action, text, control, alt, shift, meta) }
                            typed(action, value) => { root.shortcut-typed(action, value); }
                            disable(action) => { root.shortcut-disable(action); }
                            use-default(action) => { root.shortcut-use-default(action); }
                            undo => { root.shortcut-undo(); }
                            restore-defaults => { root.reset-shortcuts(); }
                        }
                        Text {
                            text: "Room switching and unread navigation use the current Home or Space; room cycling only opens conversations. Shortcuts pause in Settings, while recording and in dialogs, and text editing keys keep priority. No shortcut can send, remove an account, log out or switch accounts; the account menu shortcut only opens the menu.";
                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap;
                        }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "Advanced customization"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Edit your settings and theme pack files. Valid changes appear here automatically."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        // Read-only and selectable, so the path can be copied into an editor.
                        ThemedTextInput {
                            property <int> reveal-request: root.reveal-request("advanced.config_file");
                            // Keyboard focus and search share the same bounded reveal.
                            changed has-focus => {
                                if self.has-focus {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                }
                            }
                            changed reveal-request => {
                                if self.reveal-request > 0 {
                                    settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    self.focus();
                                    if self.has-focus { root.settings-revealed-id = "advanced.config_file"; }
                                }
                            }
                            text: root.config-path; read-only: true; wrap: word-wrap;
                            color: root.muted; font-size: 11px * root.text-scale;
                            accessible-label: "Settings file location";
                        }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "Application updates"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Updates are checked only when you ask. Downloading verifies the application signature; restarting installs the update. Leave any call and finish recovery before restarting."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        if root.update-version != "" : Text { text: "Available version: " + root.update-version; color: root.ink; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        // Read-only and focusable, so search can reveal it when checking is unavailable.
                        update-status-field := ThemedTextInput {
                            text: root.update-status != "" ? root.update-status : "No update status yet.";
                            read-only: true; single-line: false; wrap: word-wrap;
                            color: root.muted; font-size: 12px * root.text-scale;
                            accessible-label: "Application update status: " + self.text;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            TokenButton { colors: root.button-colors; text-scale: root.text-scale;
                                property <int> reveal-request: root.reveal-request("updates");
                                // Keyboard focus and search share the same bounded reveal.
                                changed has-focus => {
                                    if self.has-focus {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                    }
                                }
                                changed reveal-request => {
                                    if self.reveal-request > 0 {
                                        settings-scroll.reveal(self.absolute-position.y - settings-content.absolute-position.y);
                                        if self.enabled {
                                            self.focus();
                                            if self.has-focus { root.settings-revealed-id = "updates"; }
                                        } else {
                                            // Unavailable now: focus the status that explains why, and
                                            // report that rather than the disabled control.
                                            update-status-field.focus();
                                            if update-status-field.has-focus { root.settings-revealed-id = "updates:status"; }
                                        }
                                    }
                                }
                                text: "Check for updates"; enabled: root.update-can-check; activated => { root.check-for-updates(); } }
                            TokenButton { colors: root.button-colors; text-scale: root.text-scale; text: "Download update"; enabled: root.update-can-download; activated => { root.download-update(); } }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            TokenButton { colors: root.button-colors; text-scale: root.text-scale; text: "Discard update"; enabled: root.update-can-discard; activated => { root.discard-update(); } }
                            TokenButton { colors: root.button-colors; text-scale: root.text-scale; text: "Restart to update"; primary: true; enabled: root.update-can-restart && !root.call-connected && !root.security-busy && root.security-recovery-key == ""; activated => { root.restart-to-update(); } }
                        }
                        Rectangle { height: StyleTokens.line-width; background: root.divider; }
                        Text { text: "About"; color: root.ink; font-size: 20px * root.text-scale; font-weight: 750; }
                        Text { text: "Morpheus is an open-source Matrix desktop client."; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        Text { text: "Interface powered by Slint · slint.dev"; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; }
                        AboutSlint { }
                    }
                }

                if root.page == 2 : VerticalLayout {
                    vertical-stretch: 1;
                    padding: 24px;
                    spacing: 16px;
                    Text {
                        text: root.live-session
                            ? (root.call-connected ? "Call · " + root.native-call-room-display : (root.active-voice-local || root.active-voice-shared ? "Voice space · " : "Room call · ") + root.active-room-name)
                            : "The Workshop · Lounge";
                        color: root.ink; font-size: 21px * root.text-scale;
                        font-weight: 760; overflow: elide;
                    }
                    if root.live-session && root.call-connected && root.active-room-id != root.native-call-room-id : Text {
                        text: "This call is in a different room. The controls and participants below still belong to that call.";
                        color: root.muted; font-size: 11px * root.text-scale;
                        wrap: word-wrap; accessible-live-region: polite;
                    }
                    Text {
                        text: root.live-session
                            ? (root.native-call-enabled
                                ? (root.native-call-joined
                                    ? (root.native-audio-failed
