                        Text { text: "Columns use a compact header when the conversation is too narrow. Text scale and room density continue to apply.";
                            color: root.muted; font-size: 11px * root.text-scale; wrap: word-wrap; }
                        for name[index] in ["Message avatars", "Message timestamps", "Colored sender names"] : style-toggle := ActionRect {
                            property <int> reveal-request: index == 0 ? root.reveal-request("appearance.message_details") : 0;
