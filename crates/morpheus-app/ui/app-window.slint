    property <string> login-password;

    // A picker snapshot never survives a change of account or Space.
    changed image-previews-encrypted-enabled => {
        if !root.image-previews-encrypted-enabled { root.cancel-room-settings(); }
    }
    changed room-admin-open => {
        if !root.room-admin-open { root.cancel-room-settings(); }
    }
    changed room-admin-mode => {
        if root.room-admin-mode != 0 { root.cancel-room-settings(); }
    }
    changed active-account-local-id => {
        root.cancel-room-settings(); root.close-image-preview(); root.quick-switcher-open = false; root.incoming-call-notice = ""; root.mention-context-changed(); }
    changed active-account-index => { root.quick-switcher-open = false; root.mention-context-changed(); }
    changed active-room-id => {
        root.cancel-room-settings(); root.close-image-preview(); root.mention-context-changed(); }
    changed thread-root-id => { root.close-image-preview(); root.mention-context-changed(); }
    changed active-space-id => { root.quick-switcher-open = false; }
    // Conditional dialog subtrees do not retain a usable keyboard focus target
    // after dismissal. Return to an account control on the visible surface.
    property <int> account-focus-request: 0;
    function return-account-focus() {
        if !root.access-open {
            // Each conditional subtree resolves its own local focus target.
            root.account-focus-request += 1;
            if !root.manage-accounts-open && !root.show-sign-in { account-trigger.focus(); }
        }
    }
    changed access-open => {
        if !root.access-open { root.return-account-focus(); }
    }
    changed manage-accounts-open => {
        if !root.manage-accounts-open { root.return-account-focus(); }
    }
    // A completed final-account removal may refresh the saved rows after its
    // dialog closes. Do not leave focus on the now-removed sign-in shortcut.
    property <int> saved-account-count: root.saved-accounts.length;
    changed saved-account-count => {
        if root.saved-account-count == 0 && root.show-sign-in && !root.manage-accounts-open && !root.access-open {
            root.return-account-focus();
        }
    }
    changed show-sign-in => {
        if root.show-sign-in { root.cancel-room-settings(); } if root.show-sign-in { root.close-image-preview(); } if !root.show-sign-in { shortcut-scope.focus(); } }

    property <bool> light-palette: root.theme-mode == 1 || (root.theme-mode == 3 && Palette.color-scheme == ColorScheme.light);
    property <float> text-scale: root.font-scale-percent / 100.0;
    property <length> message-font-px: root.message-font-size * 1px * root.text-scale;
    property <length> message-row-gap: root.message-gap-px * 1px * (root.density-mode == 0 ? 0.5 : root.density-mode == 2 ? 1.333 : 1);
    property <length> content-inset: root.content-padding-px * 1px;

    property <color> rail: StyleTokens.base.rail.present ? StyleTokens.base.rail.color : custom-theme-active ? custom-rail : light-palette ? #e7ebf3 : theme-mode == 2 ? #000000 : #10131b;
    property <color> sidebar: StyleTokens.base.sidebar.present ? StyleTokens.base.sidebar.color : custom-theme-active ? custom-sidebar : light-palette ? #f1f3f8 : theme-mode == 2 ? #101010 : #171b26;
    property <color> canvas: StyleTokens.base.canvas.present ? StyleTokens.base.canvas.color : custom-theme-active ? custom-canvas : light-palette ? #ffffff : theme-mode == 2 ? #000000 : #1e2330;
    property <color> panel: StyleTokens.base.panel.present ? StyleTokens.base.panel.color : custom-theme-active ? custom-panel : light-palette ? #f8f9fc : theme-mode == 2 ? #101010 : #191e2a;
    property <color> elevated: StyleTokens.base.elevated.present ? StyleTokens.base.elevated.color : custom-theme-active ? custom-elevated : light-palette ? #ffffff : theme-mode == 2 ? #181818 : #272d3b;
    property <color> hover: StyleTokens.base.hover.present ? StyleTokens.base.hover.color : custom-theme-active ? custom-hover : light-palette ? #e3e8f2 : theme-mode == 2 ? #333333 : #32394b;
    property <color> ink: StyleTokens.base.ink.present ? StyleTokens.base.ink.color : custom-theme-active ? custom-ink : light-palette ? #182132 : #ffffff;
    property <color> muted: StyleTokens.base.muted.present ? StyleTokens.base.muted.color : custom-theme-active ? custom-muted : light-palette ? #596579 : theme-mode == 2 ? #ffffff : #a7afc1;
    property <color> divider: StyleTokens.base.divider.present ? StyleTokens.base.divider.color : custom-theme-active ? custom-divider : light-palette ? #dfe4ee : theme-mode == 2 ? #ffffff : #303747;
    property <color> accent: StyleTokens.base.accent.present ? StyleTokens.base.accent.color : custom-theme-active ? custom-accent : light-palette ? #6545b5 : theme-mode == 2 ? #ffff00 : #ad91ff;
    property <color> accent-ink: StyleTokens.base.accent-ink.present ? StyleTokens.base.accent-ink.color : custom-theme-active ? custom-accent-ink : light-palette ? #ffffff : theme-mode == 2 ? #000000 : #10131b;
    // Theme roles for room administration, resolved once for room-admin.slint.
    property <RosterPalette> roster-palette: {
        ink: root.ink,
        muted: root.muted,
        elevated: root.elevated,
        hover: root.hover,
        accent: root.accent,
        accent-ink: root.accent-ink,
        divider: root.divider,
        error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483,
        destructive: StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : #e47483,
        destructive-ink: StyleTokens.roles.destructive-ink.present ? StyleTokens.roles.destructive-ink.color : #10131b,
        selection: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover,
        selection-ink: StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink,
        text-selection: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : Palette.selection-background,
        text-selection-ink: StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : Palette.selection-foreground,
        focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
        avatar-ink: StyleTokens.roles.avatar-ink.present ? StyleTokens.roles.avatar-ink.color : #ffffff,
        scrim: StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa,
    };
    // Surfaces painted directly on the native window. Below 100% their own
    // alpha is scaled and the window's background is cleared, so the desktop
    // shows through only these panes; text, icons, inputs, cards, popups,
    // sign-in and dialogs keep their own colors. At 100% nothing changes.
    // The color each registry token shows now, for swatches and the editor.
    // A role without a value shows the built-in color it falls back to.
    public pure function token-color(id: string) -> color {
        if id == "rail" { return root.rail; }
        if id == "sidebar" { return root.sidebar; }
        if id == "canvas" { return root.canvas; }
        if id == "panel" { return root.panel; }
        if id == "elevated" { return root.elevated; }
        if id == "hover" { return root.hover; }
        if id == "ink" { return root.ink; }
        if id == "muted" { return root.muted; }
        if id == "divider" { return root.divider; }
        if id == "accent" { return root.accent; }
        if id == "accent_ink" { return root.accent-ink; }
        if id == "selection" { return StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover; }
        if id == "own_surface" { return StyleTokens.roles.own-surface.present ? StyleTokens.roles.own-surface.color : transparent; }
        if id == "scrim" { return StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa; }
        if id == "shadow" { return StyleTokens.roles.shadow.present ? StyleTokens.roles.shadow.color : #00000044; }
        if id == "media_backdrop" { return StyleTokens.roles.media-backdrop.present ? StyleTokens.roles.media-backdrop.color : #11131b; }
        if id == "message" { return StyleTokens.roles.message.present ? StyleTokens.roles.message.color : root.ink; }
        if id == "sender" { return StyleTokens.roles.sender.present ? StyleTokens.roles.sender.color : root.ink; }
        if id == "own_message" {
            return StyleTokens.roles.own-message.present ? StyleTokens.roles.own-message.color
                : StyleTokens.roles.sender.present ? StyleTokens.roles.sender.color
                : StyleTokens.roles.message.present ? StyleTokens.roles.message.color : root.ink;
        }
        if id == "timestamp" { return StyleTokens.roles.timestamp.present ? StyleTokens.roles.timestamp.color : root.muted; }
        if id == "link" { return StyleTokens.roles.link.present ? StyleTokens.roles.link.color : root.accent; }
        if id == "focus" { return StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent; }
        if id == "unread" { return StyleTokens.roles.unread.present ? StyleTokens.roles.unread.color : root.accent; }
        if id == "unread_ink" { return StyleTokens.roles.unread-ink.present ? StyleTokens.roles.unread-ink.color : root.accent-ink; }
        if id == "selection_ink" { return StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink; }
        if id == "error" { return StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483; }
        if id == "error_surface" { return StyleTokens.roles.error-surface.present ? StyleTokens.roles.error-surface.color : #9f3f50; }
        if id == "error_ink" { return StyleTokens.roles.error-ink.present ? StyleTokens.roles.error-ink.color : #ffffff; }
        if id == "success" { return StyleTokens.roles.success.present ? StyleTokens.roles.success.color : #78c8b1; }
        if id == "success_surface" { return StyleTokens.roles.success-surface.present ? StyleTokens.roles.success-surface.color : #214a46; }
        if id == "success_ink" { return StyleTokens.roles.success-ink.present ? StyleTokens.roles.success-ink.color : #ffffff; }
        if id == "destructive" { return StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : #e47483; }
        if id == "destructive_ink" { return StyleTokens.roles.destructive-ink.present ? StyleTokens.roles.destructive-ink.color : #10131b; }
        if id == "presence_online" { return StyleTokens.roles.presence-online.present ? StyleTokens.roles.presence-online.color : #64c9a7; }
        if id == "voice" { return StyleTokens.roles.voice.present ? StyleTokens.roles.voice.color : #78c8b1; }
        if id == "avatar_ink" { return StyleTokens.roles.avatar-ink.present ? StyleTokens.roles.avatar-ink.color : #ffffff; }
        return transparent;
    }
    // Whether `token-color` knows the ID; the registry coverage test uses it.
    public pure function token-known(id: string) -> bool {
        return id == "rail" || id == "sidebar" || id == "canvas" || id == "panel" || id == "elevated"
            || id == "hover" || id == "ink" || id == "muted" || id == "divider" || id == "accent"
            || id == "accent_ink" || id == "selection" || id == "own_surface" || id == "scrim"
            || id == "shadow" || id == "media_backdrop" || id == "message" || id == "sender"
            || id == "own_message" || id == "timestamp" || id == "link" || id == "focus"
            || id == "unread" || id == "unread_ink" || id == "selection_ink" || id == "error"
            || id == "error_surface" || id == "error_ink" || id == "success" || id == "success_surface"
            || id == "success_ink" || id == "destructive" || id == "destructive_ink"
            || id == "presence_online" || id == "voice" || id == "avatar_ink";
    }
    // Any pane color with its own alpha also clears the window background, so
    // each pane is painted exactly once at every opacity, including 100%.
    property <bool> window-translucent: StyleTokens.window-opacity < 1 || root.rail.alpha < 255
        || root.sidebar.alpha < 255 || root.canvas.alpha < 255 || root.panel.alpha < 255;
    // Whether the native window background is cleared for translucent panes.
    out property <bool> window-background-cleared: root.window-translucent;
    property <color> window-rail: root.rail.transparentize(1 - StyleTokens.window-opacity);
    property <color> window-sidebar: root.sidebar.transparentize(1 - StyleTokens.window-opacity);
    property <color> window-canvas: root.canvas.transparentize(1 - StyleTokens.window-opacity);
    property <color> window-panel: root.panel.transparentize(1 - StyleTokens.window-opacity);
    // Dialogs, sign-in, account unlock and recovery paint opaque versions of
    // their colors, whatever alpha a token or the window setting has.
    property <color> dialog-surface: root.canvas.with-alpha(1);
    property <color> sign-in-surface: root.rail.with-alpha(1);
    default-font-family: root.ui-font-family;
    background: root.window-translucent ? transparent : canvas;

    shortcut-scope := FocusScope {
    width: parent.width;
    height: parent.height;
    focus-on-tab-navigation: false;
    init => { self.focus(); }
    // Bubble after child controls: cursor movement, selection, IME, and text
    // editing take precedence over application commands. Never capture Tab/Escape.
    key-pressed(event) => {
        if root.dispatch-shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) { accept } else { reject }
    }

    HorizontalLayout {
        spacing: 0px;

        // Space and navigation rail (the default presentation).
        if root.navigation-mode == 0 : Rectangle {
            width: root.rail-width-px * 1px;
            background: root.window-rail;
            VerticalLayout {
                padding: 6px;
                spacing: 10px;
                Rectangle {
                    height: 48px;
                    border-radius: StyleTokens.radius * 1.5;
                    background: root.accent;
                    Text {
                        text: "M";
                        color: root.accent-ink;
                        font-size: 23px * root.text-scale;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 1px; background: root.divider; }
                IconAction {
                    width: root.rail-width-px * 1px - 12px;
                    height: 48px;
                    icon: "⌂";
                    focus-state-changed(focused) => { root.navigation-focus-changed(0, "route:home", focused); }
                    label: "Home and all rooms";
                    ink: root.page == 0 && root.active-space-id == "" ? root.accent : root.muted;
                    surface: transparent;
                    hover-surface: root.hover;
                    selected: root.page == 0 && root.active-space-id == "";
                    activated => { root.active-space-id = ""; root.active-space-name = "Home"; root.select-space(""); root.page = 0; }
                }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: parent.width;
                        spacing: 8px;
                        for space in root.spaces : ActionRect {
                            width: root.rail-width-px * 1px - 12px;
                            height: root.show-space-labels ? 52px + 14px * root.text-scale : 48px;
                            focus-state-changed(focused) => { root.navigation-focus-changed(0, "space:" + space.id, focused); }
                            border-radius: StyleTokens.radius * 1.2;
                            background: root.active-space-id == space.id && root.page == 0 ? (StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover) : self.has-hover ? root.hover : transparent;
                            focus-color: root.accent;
                            label: "Select space " + space.name;
                            activated => {
                                root.active-space-id = space.id;
                                root.active-space-name = space.name;
                                root.select-space(space.id);
                                root.page = 0;
                            }
                            AvatarBadge {
                                x: (parent.width - 38px) / 2;
                                y: 5px;
                                initials: space.initials;
                                accent: space.accent;
                            }
                            if root.show-space-labels : Text {
                                x: 2px; y: 48px; width: parent.width - 4px; height: 14px * root.text-scale;
                                text: space.name; font-size: 10px * root.text-scale; overflow: elide;
                                color: root.active-space-id == space.id && root.page == 0 && StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.muted;
                                horizontal-alignment: center; accessible-label: space.name;
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: root.divider; }
                IconAction {
                    width: root.rail-width-px * 1px - 12px;
                    height: 48px;
                    icon: "S";
                    focus-state-changed(focused) => { root.navigation-focus-changed(0, "route:discover", focused); }
                    label: "Explore public Matrix rooms";
                    ink: root.page == 3 ? root.accent : root.muted;
                    surface: transparent;
                    hover-surface: root.hover;
                    selected: root.page == 3;
                    activated => { root.page = 3; root.open-discovery(); }
                }
                IconAction {
                    width: root.rail-width-px * 1px - 12px;
                    height: 48px;
                    icon: "C";
                    focus-state-changed(focused) => { root.navigation-focus-changed(0, "route:calls", focused); }
                    label: "Open call stage";
                    ink: root.page == 2 ? root.accent : root.muted;
                    surface: transparent;
                    hover-surface: root.hover;
                    selected: root.page == 2;
                    activated => { root.page = 2; }
                }
                IconAction {
                    width: root.rail-width-px * 1px - 12px;
                    height: 48px;
                    icon: "⚙";
                    focus-state-changed(focused) => { root.navigation-focus-changed(0, "route:settings", focused); }
                    label: "Open settings";
                    ink: root.page == 1 ? root.accent : root.muted;
                    surface: transparent;
                    hover-surface: root.hover;
                    selected: root.page == 1;
                    activated => { root.page = 1; root.open-security(); }
                }
            }
        }

        // Room list and bottom-left account control.
        Rectangle {
            width: root.room-list-width * 1px;
            background: root.window-sidebar;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: max(64px, 40px * root.text-scale + 24px);
                    background: transparent;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 14px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center; spacing: 3px;
                            Text { text: "Morpheus"; color: root.ink; font-size: 17px * root.text-scale; font-weight: 750; }
                            if root.preview-session : Text {
                                text: "Offline preview"; color: root.muted;
                                font-size: 10px * root.text-scale; font-weight: 500;
                                accessible-label: "Offline preview with fictional accounts";
                            }
                        }
                        VerticalLayout { width: 34px; alignment: center;
                            room-action-trigger := IconAction {
                            width: 34px;
                            height: 34px;
                            icon: "+";
                            label: "Create or join a Matrix room";
                            ink: root.muted; surface: transparent; hover-surface: root.hover;
                            activated => {
                                root.room-action-mode = 0;
                                root.room-action-input = "";
                                root.room-action-error = "";
                                root.room-actions-open = true;
                            }
                        }
                        }
                    }
                }
                Rectangle { height: 1px; background: root.divider; }
                Rectangle {
                    height: max(62px, 22px * root.text-scale + 40px);
                    background: transparent;
                    quick-switch-trigger := ActionRect {
                        x: 12px; y: 12px;
                        width: parent.width - 24px; height: parent.height - 24px;
                        border-radius: StyleTokens.radius * 0.8;
                        background: self.has-hover ? root.hover : root.elevated;
                        focus-color: root.accent;
                        enabled: root.page != 1 && !root.show-sign-in;
                        label: "Switch between rooms in the current Home or Space";
                        activated => { root.open-quick-switcher(); }
                        HorizontalLayout {
                            padding-left: 11px; padding-right: 11px;
                            padding-top: 10px; padding-bottom: 10px; spacing: 9px;
                            Rectangle { width: 17px; background: transparent; InterfaceGlyph { y: (parent.height - self.height) / 2; width: 17px; height: 17px; icon: "S"; ink: root.muted; } }
                            Text { text: "Find a conversation"; color: root.muted; font-size: 12px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: parent.width;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 18px;
                        spacing: 3px;
                        if root.navigation-mode == 1 : VerticalLayout {
                            spacing: 3px; alignment: start; vertical-stretch: 0;
                            for route[index] in ["Home", "Discover", "Calls", "Settings"] : NavigationTextAction {
                                text: route; text-scale: root.text-scale;
                                ink: root.ink; muted: root.muted; hover: root.hover; accent: root.accent;
                                selected: index == 0 ? root.page == 0 && root.active-space-id == "" : root.page == (index == 1 ? 3 : index == 2 ? 2 : 1);
                                label: index == 0 ? "Home and all rooms" : index == 1 ? "Explore public Matrix rooms" : index == 2 ? "Open call stage" : "Open settings";
                                focus-state-changed(focused) => { root.navigation-focus-changed(1, "route:" + index, focused); }
                                activated => {
                                    if index == 0 { root.active-space-id = ""; root.active-space-name = "Home"; root.select-space(""); root.page = 0; }
                                    else if index == 1 { root.page = 3; root.open-discovery(); }
                                    else if index == 2 { root.page = 2; }
                                    else { root.page = 1; root.open-security(); }
                                }
                            }
                            if root.spaces.length > 0 : Text {
                                text: "SPACES"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750;
                                height: max(29px, 18px * root.text-scale); vertical-alignment: bottom;
                            }
                            for space in root.spaces : NavigationTextAction {
                                text: space.name; text-scale: root.text-scale;
                                ink: root.ink; muted: root.muted; hover: root.hover; accent: root.accent;
                                selected: root.page == 0 && root.active-space-id == space.id;
                                label: "Select space " + space.name;
                                focus-state-changed(focused) => { root.navigation-focus-changed(1, "space:" + space.id, focused); }
                                activated => {
                                    root.active-space-id = space.id; root.active-space-name = space.name;
                                    root.select-space(space.id); root.page = 0;
                                }
                            }
                            Rectangle { height: 1px; vertical-stretch: 0; background: root.divider; }
                        }
                        Text {
                            text: root.group-direct-messages ? (root.active-space-id == "" ? "YOUR ROOMS" : "SPACE ROOMS") : "CONVERSATIONS";
                            color: root.muted;
                            font-size: 10px * root.text-scale;
                            font-weight: 750;
                            letter-spacing: 1px;
                            height: 29px;
                            vertical-alignment: bottom;
                        }
                        Rectangle {
                            height: 30px;
                            background: transparent;
                            Text {
                                x: 8px;
                                width: parent.width - 16px - (root.live-session && root.active-space-id != "" ? 80px * root.text-scale : 0px);
                                text: "v   " + (root.active-space-id == "" ? "Home" : root.active-space-name);
                                color: root.ink;
                                font-size: 13px * root.text-scale;
                                font-weight: 650;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if root.live-session && root.active-space-id != "" : TextAction {
                                x: parent.width - self.width - 4px;
                                y: (parent.height - self.height) / 2;
                                width: 76px * root.text-scale;
                                height: 26px;
                                ink: root.ink; muted: root.muted; surface: transparent; hover-surface: root.hover;
                                outline: root.divider; text-scale: root.text-scale;
                                text: "Manage";
                                accessible-label: "Manage Space " + root.active-space-name + ": its rooms, order and links";
                                activated => { root.page = 4; }
                            }
                        }
                        if root.invitations.length > 0 : Text {
                            text: "INVITATIONS · " + root.invitations.length;
                            color: root.accent;
                            font-size: 10px * root.text-scale;
                            font-weight: 750;
                            letter-spacing: 1px;
                            height: 29px;
                            vertical-alignment: bottom;
                        }
                        if root.invite-error != "" : Text {
                            text: root.invite-error;
                            color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #ff8d9d;
                            font-size: 11px * root.text-scale;
                            wrap: word-wrap;
                            height: 40px;
                        }
                        for invite in root.invitations : Rectangle {
                            height: 58px;
                            border-radius: StyleTokens.radius * 0.8;
                            background: root.elevated;
                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 7px;
                                spacing: 4px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: invite.name; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; overflow: elide; }
                                    Text { text: "Room invitation"; color: root.muted; font-size: 10px * root.text-scale; }
                                }
                                Button {
                                    width: 30px; height: 30px;
                                    text: "✓";
                                    accessible-label: "Accept invitation to " + invite.name;
                                    enabled: !root.room-action-busy;
                                    clicked => { root.respond-invite(invite.id, true); }
                                }
                                Button {
                                    width: 30px; height: 30px;
                                    text: "×";
                                    accessible-label: "Decline invitation to " + invite.name;
                                    enabled: !root.room-action-busy;
                                    clicked => { root.respond-invite(invite.id, false); }
                                }
                            }
                        }
                        if root.group-direct-messages : VerticalLayout {
                            spacing: 3px; alignment: start; vertical-stretch: 0;
                            for channel in root.channels : NavigationRoomRow {
                                room: channel; direct: false;
                                selected: channel.id == root.active-room-id && root.page == 0;
                                density-mode: root.density-mode; text-scale: root.text-scale;
                                ink: root.ink; muted: root.muted; elevated: root.elevated; hover: root.hover; accent: root.accent; accent-ink: root.accent-ink;
                                open(id, voice) => {
                                    if voice && root.live-session { root.open-voice-space(id); }
                                    else { root.page = 0; root.open-room(id); }
                                }
                            }
                            Text {
                                text: "DIRECT MESSAGES"; color: root.muted; font-size: 10px * root.text-scale;
                                font-weight: 750; letter-spacing: 1px; height: 40px; vertical-alignment: bottom;
                            }
                            for dm in root.direct-messages : NavigationRoomRow {
                                room: dm; direct: true;
                                selected: dm.id == root.active-room-id && root.page == 0;
                                density-mode: root.density-mode; text-scale: root.text-scale;
                                ink: root.ink; muted: root.muted; elevated: root.elevated; hover: root.hover; accent: root.accent; accent-ink: root.accent-ink;
                                open(id, voice) => {
                                    if voice && root.live-session { root.open-voice-space(id); }
                                    else { root.page = 0; root.open-room(id); }
                                }
                            }
                        }
                        if !root.group-direct-messages : VerticalLayout {
                            spacing: 3px; alignment: start; vertical-stretch: 0;
                            for entry in root.combined-rooms : NavigationRoomRow {
                                room: entry.room; direct: entry.direct;
                                selected: entry.room.id == root.active-room-id && root.page == 0;
                                density-mode: root.density-mode; text-scale: root.text-scale;
                                ink: root.ink; muted: root.muted; elevated: root.elevated; hover: root.hover; accent: root.accent; accent-ink: root.accent-ink;
                                open(id, voice) => {
                                    if voice && root.live-session { root.open-voice-space(id); }
                                    else { root.page = 0; root.open-room(id); }
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: root.divider; }
                account-trigger := ActionRect {
                    height: max(69px, 38px * root.text-scale + 24px);
                    background: root.window-rail;
                    focus-color: root.accent;
                    label: "Account menu for " + root.active-account-name + ", " + root.active-account-handle;
                    accessible-expanded: root.account-menu-open;
                    activated => { root.account-menu-open = !root.account-menu-open; }
                    HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 11px;
                        padding-top: 15px;
                        padding-bottom: 15px;
                        spacing: 10px;
                        VerticalLayout { width: 38px; alignment: center; AvatarBadge { initials: root.active-account-initials; accent: root.active-account-accent; } }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: root.active-account-name; color: root.ink; font-size: 13px * root.text-scale; font-weight: 700; overflow: elide; }
                            Text { text: root.active-account-handle; color: root.muted; font-size: 11px * root.text-scale; overflow: elide; }
                        }
                        Text { text: "⌃"; color: root.muted; font-size: 16px * root.text-scale; vertical-alignment: center; }
                    }
                }
            }

            // Drawn after the sidebar so it opens upward over the room list.
            if root.account-menu-open : Rectangle {
                x: 9px;
                y: parent.height - self.height - account-trigger.height - 5px;
                width: parent.width - 18px;
                height: min(parent.height - account-trigger.height - 14px, 170px + root.account-options.length * (max(42px, 30px * root.text-scale + 12px) + 2px));
                background: root.elevated;
                border-color: root.divider;
                border-width: 1px;
                border-radius: StyleTokens.radius * 1.2;
                drop-shadow-color: StyleTokens.roles.shadow.present ? StyleTokens.roles.shadow.color : #00000044;
                drop-shadow-blur: 18px;
                drop-shadow-offset-y: 7px;
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    Text {
                        text: root.account-switch-pending ? "SWITCHING…" : "SWITCH ACCOUNT";
                        color: root.muted;
                        font-size: 10px * root.text-scale;
                        font-weight: 750;
                        letter-spacing: 1px;
                        height: 22px;
                        vertical-alignment: center;
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: parent.width;
                            spacing: 2px;
                    for account[index] in root.account-options : account-choice := ActionRect {
                        height: max(42px, 30px * root.text-scale + 12px);
                        border-radius: StyleTokens.radius * 0.8;
                        background: account.index == root.active-account-index ? root.hover : self.has-hover ? root.hover : transparent;
                        focus-color: root.accent;
                        cancel-on-escape: true;
                        label: "Switch to " + account.name + ", " + account.handle;
                        enabled: !root.account-switch-pending;
                        // Repeater children become focusable after initialization; defer one tick.
                        Timer {
                            interval: 1ms;
                            running: index == 0;
                            triggered => { self.running = false; account-choice.focus(); }
                        }
                        cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                        activated => {
                            if root.call-connected {
                                root.pending-account-index = account.index;
                                root.leave-call-dialog = true;
                                root.account-menu-open = false;
                            } else {
                                root.switch-account(account.index);
                                root.account-menu-open = false;
                                account-trigger.focus();
                            }
                        }
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 9px;
                            VerticalLayout { width: 30px; alignment: center; AvatarBadge { width: 30px; height: 30px; border-radius: StyleTokens.radius * 1.0; initials: account.initials; accent: account.accent; } }
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                horizontal-stretch: 1;
                                Text { text: account.name; color: root.ink; font-size: 12px * root.text-scale; font-weight: 650; overflow: elide; }
                                Text { text: account.handle; color: root.muted; font-size: 10px * root.text-scale; overflow: elide; }
                            }
                            if account.index == root.active-account-index : Text { text: "✓"; color: root.accent; font-size: 15px * root.text-scale; vertical-alignment: center; }
                        }
                    }
                        }
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    add-account-choice := ActionRect {
                        height: 35px;
                        border-radius: StyleTokens.radius * 0.8;
                        background: self.has-hover ? root.hover : transparent;
                        focus-color: root.accent;
                        cancel-on-escape: true;
                        label: "Add another Matrix account";
                        Timer {
                            interval: 1ms;
                            running: root.account-options.length == 0;
                            triggered => { self.running = false; add-account-choice.focus(); }
                        }
                        cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                        activated => {
                            if root.call-connected {
                                root.pending-account-index = -2;
                                root.leave-call-dialog = true;
                                root.account-menu-open = false;
                            } else {
                                root.add-account();
                                root.account-menu-open = false;
                            }
                        }
                        Text { x: 9px; text: "+   Add an account"; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; }
                    }
                    ActionRect {
                        height: 35px;
                        border-radius: StyleTokens.radius * 0.8;
                        background: self.has-hover ? root.hover : transparent;
                        focus-color: root.accent;
                        cancel-on-escape: true;
                        label: "Manage accounts";
                        cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                        activated => { root.manage-accounts-open = true; root.manage-accounts(); root.account-menu-open = false; }
                        Text { x: 9px; text: "⚙   Manage accounts"; color: root.ink; font-size: 12px * root.text-scale; vertical-alignment: center; }
                    }
                    ActionRect {
                        height: 35px;
                        border-radius: StyleTokens.radius * 0.8;
                        background: self.has-hover ? root.hover : transparent;
                        focus-color: root.accent;
                        cancel-on-escape: true;
                        label: "Log out of current Matrix account";
                        cancelled => { root.account-menu-open = false; account-trigger.focus(); }
                        activated => {
                            // Rust captures the exact selection before it opens
                            // a leave-call confirmation or starts async logout.
                            root.log-out(); root.account-menu-open = false;
                        }
                        Text { x: 9px; text: "↪   Log out"; color: StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : #e47483; font-size: 12px * root.text-scale; vertical-alignment: center; }
                    }
                }
            }
        }

        // Conversation, settings, and call stage share the main canvas.
        Rectangle {
            horizontal-stretch: 1;
            // Match the independent conversation minimum used by the Window.
            // Long room content must not push the fixed details pane offscreen.
            min-width: 360px;
            background: root.window-canvas;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: max(64px, 40px * root.text-scale + 24px);
                    background: transparent;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 11px;
                        Text {
                            text: root.page == 1 ? "⚙" : root.page == 2 ? "☏" : root.page == 3 ? "⌕" : root.page == 4 ? "◇" : "#";
                            color: root.muted;
                            font-size: 20px * root.text-scale;
                            vertical-alignment: center;
                        }
                        if root.page != 0 || root.conversation-header-mode != 2 : Text {
                            text: root.page == 1 ? "Settings" : root.page == 2 ? "Voice & video" : root.page == 3 ? "Discover rooms" : root.page == 4 ? "Manage Space" : root.active-room-name;
                            color: root.ink;
                            font-size: 16px * root.text-scale;
                            font-weight: 750;
                            vertical-alignment: center;
                            min-width: 0px;
                            overflow: elide;
                            accessible-label: root.page == 0 ? "Current room: " + root.active-room-name : self.text;
                        }
                        if root.page == 0 && root.conversation-header-mode == 2 : Text {
                            text: root.active-room-name;
                            color: root.ink;
                            font-size: 16px * root.text-scale;
                            font-weight: 750;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            overflow: elide;
                            accessible-label: "Current room: " + root.active-room-name;
                        }
                        if root.page != 0 || root.conversation-header-mode != 2 : Rectangle { width: 1px; height: 24px; background: root.divider; }
                        if root.page != 0 || root.conversation-header-mode != 2 : Text {
                            text: root.page == 0 ? root.active-room-topic : root.page == 1 ? "Make Morpheus yours" : root.page == 3 ? "Public rooms on your Matrix homeserver" : root.page == 4 ? root.active-space-name : "The Workshop";
                            color: root.muted;
                            font-size: 12px * root.text-scale;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            overflow: elide;
                        }
                        if root.page == 0 : VerticalLayout {
                            width: 34px; alignment: center;
                            IconAction {
                            icon: "⚙"; label: "Edit room settings"; ink: root.muted; surface: transparent; hover-surface: root.hover;
                            enabled: root.live-session && root.active-room-id != "";
                            activated => {
                                root.open-room-settings();
                            }
                        }
                        }
                        if root.page == 0 : VerticalLayout {
                            width: 34px; alignment: center;
                            IconAction {
                            icon: "S"; label: "Search messages in this room"; ink: root.muted; surface: transparent; hover-surface: root.hover;
                            selected: root.show-side-panel && root.side-panel-tab == 2;
                            enabled: root.live-session && root.active-room-id != "";
                            activated => { root.show-side-panel = true; root.side-panel-tab = 2; }
                        }
                        }
                        if root.page == 0 : VerticalLayout {
                            width: 34px; alignment: center;
                            IconAction {
                            icon: "C"; label: "Open current room call stage"; ink: root.muted; surface: transparent; hover-surface: root.hover;
                            activated => { root.page = 2; }
                        }
                        }
                        if root.page == 0 : VerticalLayout {
                            width: 34px; alignment: center;
                            IconAction {
                            icon: "P"; label: root.show-side-panel ? "Hide details panel" : "Show details panel";
                            ink: root.muted; surface: transparent; hover-surface: root.hover;
                            selected: root.show-side-panel;
                            activated => { root.set-side-panel(!root.show-side-panel); }
                        }
                        }
                    }
                }
                Rectangle { height: 1px; background: root.divider; }
                if root.native-call-enabled && root.live-session && root.incoming-call-account-id == root.active-account-local-id && root.incoming-call-offers.length > 0 : ScrollView {
                    height: min(220px, root.incoming-call-offers.length * (102px * root.text-scale));
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 1px;
                        for offer in root.incoming-call-offers : Rectangle {
                            height: 102px * root.text-scale;
                            background: root.panel;
                            border-width: 1px;
                            border-color: root.accent;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 3px;
                                Text {
                                    text: "Incoming call · " + offer.caller;
                                    accessible-live-region: polite;
                                    color: root.ink;
                                    font-size: 13px * root.text-scale;
                                    font-weight: 650;
                                    overflow: elide;
                                }
                                Text {
                                    text: offer.room + " · " + offer.account;
                                    color: root.muted;
                                    font-size: 11px * root.text-scale;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionRect {
                                        width: 110px;
                                        height: 32px * root.text-scale;
                                        border-radius: 6px;
                                        background: self.has-hover ? root.accent : root.hover;
                                        focus-color: root.accent;
                                        enabled: !root.incoming-call-answering && !root.call-connected && !root.native-call-request-pending;
                                        label: "Answer call from " + offer.caller + " in " + offer.room + " for " + offer.account;
                                        activated => { root.answer-incoming-call(offer.token); }
                                        Text { text: "Answer"; color: root.ink; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    ActionRect {
                                        width: 110px;
                                        height: 32px * root.text-scale;
                                        border-radius: 6px;
                                        background: self.has-hover ? root.hover : root.canvas;
                                        focus-color: root.accent;
                                        label: "Dismiss call from " + offer.caller + " in " + offer.room;
                                        activated => { root.dismiss-incoming-call(offer.token); }
                                        Text { text: "Dismiss"; color: root.ink; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }
                if root.incoming-call-sound-status != "" && root.live-session && root.incoming-call-account-id == root.active-account-local-id && root.incoming-call-offers.length > 0 : Text {
                    text: root.incoming-call-sound-status;
                    accessible-label: "Incoming call sound: " + root.incoming-call-sound-status;
                    accessible-live-region: polite;
                    color: root.muted; font-size: 11px * root.text-scale;
                    wrap: word-wrap;
                }
                if root.incoming-call-notice != "" && root.live-session : Rectangle {
                    height: 32px * root.text-scale;
                    background: root.panel;
                    Text {
                        x: 12px; width: parent.width - 24px;
                        text: root.incoming-call-notice;
                        accessible-live-region: polite;
                        color: root.muted;
                        font-size: 11px * root.text-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.config-error != "" : Rectangle {
                    height: 39px;
                    background: StyleTokens.roles.error-surface.present ? StyleTokens.roles.error-surface.color : #9f3f50;
                    Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: "Settings file: " + root.config-error;
                        color: StyleTokens.roles.error-ink.present ? StyleTokens.roles.error-ink.color : #ffffff;
                        font-size: 11px * root.text-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.session-error != "" : Rectangle {
                    height: 34px;
                    background: StyleTokens.roles.error-surface.present ? StyleTokens.roles.error-surface.color : #613743;
                    Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: root.session-error;
                        accessible-live-region: polite;
                        color: StyleTokens.roles.error-ink.present ? StyleTokens.roles.error-ink.color : #ffffff;
                        font-size: 11px * root.text-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.transfer-notice != "" : Rectangle {
                    height: 30px;
                    background: StyleTokens.roles.success-surface.present ? StyleTokens.roles.success-surface.color : #214a46;
                    Text {
                        x: 16px; width: parent.width - 32px;
                        text: root.transfer-notice;
                        accessible-live-region: polite;
                        color: StyleTokens.roles.success-ink.present ? StyleTokens.roles.success-ink.color : #ffffff;
                        font-size: 11px * root.text-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if root.page == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;
                    if root.conversation-header-mode == 0 : Rectangle {
                        height: root.message-layout == 0 ? max(110px, 54px * root.text-scale + 56px) : max(48px, 24px * root.text-scale + 24px);
                        background: transparent;
                        VerticalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: root.message-layout == 0 ? 23px : 8px;
                            padding-bottom: root.message-layout == 0 ? 20px : 8px;
                            spacing: 8px;
                            if root.message-layout == 0 : Text {
                                text: "Welcome to #" + root.active-room-name;
                                color: root.ink; font-size: 24px * root.text-scale; font-weight: 780;
                                min-width: 0px; overflow: elide;
                                accessible-label: self.text;
                            }
                            Text { text: root.active-room-topic; color: root.muted; font-size: 12px * root.text-scale; wrap: word-wrap; min-width: 0px; }
                        }
                    }
                    if root.live-session && root.active-room-id != "" : HorizontalLayout {
                        height: max(39px, 32px * root.text-scale);
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 8px;
                        Text {
                            text: root.active-voice-local || root.active-voice-shared ? "◖ VOICE" : "Voice";
                            color: root.active-voice-local || root.active-voice-shared ? (StyleTokens.roles.voice.present ? StyleTokens.roles.voice.color : #78c8b1) : root.muted;
                            font-size: 11px * root.text-scale;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        TextAction {
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            text: root.active-voice-local ? "✓ Mine" : "Mine";
                            enabled: !root.voice-designation-busy;
                            accessible-label: root.active-voice-local ? "Remove this room from my local voice spaces" : "Mark this room as a voice space only for my account";
                            activated => { root.set-local-voice-space(!root.active-voice-local); }
                        }
                        if root.native-call-enabled : TextAction {
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            text: root.active-voice-shared ? "✓ Shared" : "Share";
                            enabled: !root.voice-designation-busy;
                            accessible-label: root.active-voice-shared ? "Remove shared voice-space marker from this Matrix room" : "Share a voice-space marker with this Matrix room";
                            activated => { root.set-shared-voice-space(!root.active-voice-shared); }
                        }
                        if root.active-voice-local || root.active-voice-shared : TextAction {
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            text: "Join";
                            enabled: !root.voice-designation-busy;
                            accessible-label: "Join this room's MatrixRTC voice space without ringing members";
                            activated => { root.open-voice-space(root.active-room-id); }
                        }
                    }
                    if root.voice-designation-error != "" || root.voice-designation-notice != "" : Text {
                        height: 25px;
                        text: root.voice-designation-error != "" ? root.voice-designation-error : root.voice-designation-notice;
                        color: root.voice-designation-error != "" ? (StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #ff8d9d) : (StyleTokens.roles.success.present ? StyleTokens.roles.success.color : #78c8b1);
                        font-size: 11px * root.text-scale;
                        accessible-live-region: polite;
                        overflow: elide;
                    }
                    if root.live-session && root.active-room-id != "" : HorizontalLayout {
                        height: max(36px, 32px * root.text-scale);
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 10px;
                        TextAction {
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            text: root.history-loading ? "Loading earlier messages…" : root.history-at-start ? "Start of room history" : "Load earlier messages";
                            enabled: !root.history-loading && !root.history-at-start;
                            accessible-label: root.history-at-start ? "Start of room history reached" : "Load earlier messages in this Matrix room";
                            activated => { root.load-older-messages(); }
                        }
                        if root.history-error != "" : Text {
                            text: root.history-error;
                            color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483;
                            font-size: 11px * root.text-scale;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                            accessible-live-region: polite;
                        }
                    }
                    timeline-list := ListView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        for message[index] in root.messages : message-row := Rectangle {
                            width: timeline-list.visible-width;
                            // The timeline uses time for local delivery status too. Hiding
                            // optional timestamps must keep pending and failed sends visible.
                            property <bool> show-time: root.show-message-timestamps || message.time == "Sending…" || message.time == "Failed to send";
                            property <string> time-label: root.message-time-label(message);
                            // A wider clock gutter requires the same additional room before
                            // choosing columns; keep the existing message/action space intact.
                            property <bool> columns: root.message-layout == 2 && self.width >= max(640px, 640px * root.text-scale)
                                + (self.show-time ? max(0px, (root.timestamp-width-px - 72) * 1px * root.text-scale) : 0px);
                            property <bool> selected-message: root.room-search-selected-event-id != "" && message.event-id == root.room-search-selected-event-id;
                            property <length> avatar-size: root.message-layout == 0 ? 38px : 26px;
                            property <length> action-width: message.event-id == "" ? 0px : (message.is-own && message.attachment == "" ? 172px : 136px);
                            property <length> column-width: self.columns ? min(root.nickname-width-px * 1px, self.width * 0.2) : 0px;
                            property <bool> tight-header: !self.columns && self.body-width < self.action-width + 180px * root.text-scale;
                            property <length> body-width: max(0px, self.width - 2 * root.content-inset
                                - (root.show-message-avatars ? self.avatar-size + (root.message-layout == 0 ? 10px : 7px) : 0px)
                                - (self.columns ? self.column-width + 7px + (message-row.show-time ? root.timestamp-width-px * 1px * root.text-scale + 7px : 0px) : 0px));
                            min-height: max(28px + 2 * root.message-row-gap, root.show-message-avatars ? self.avatar-size + 2 * root.message-row-gap : 0px);
                            background: root.row-surface(message-row.selected-message, message-hover.has-hover, message.is-own, transparent);
                            message-hover := TouchArea { mouse-cursor: default; }
                            message-flow := HorizontalLayout {
                                padding-left: root.content-inset; padding-right: root.content-inset;
                                padding-top: root.message-row-gap; padding-bottom: root.message-row-gap;
                                spacing: root.message-layout == 0 ? 10px : 7px;
                                cross-axis-alignment: start;
                                if root.show-message-avatars : AvatarBadge {
                                    width: message-row.avatar-size; height: message-row.avatar-size;
                                    border-radius: StyleTokens.radius * 1.3;
                                    initials: message.initials; accent: message.accent;
                                }
                                if message-row.columns && message-row.show-time : Text {
                                    width: root.timestamp-width-px * 1px * root.text-scale; text: message-row.time-label;
                                    color: root.clock-ink(message-row.selected-message); font-family: root.monospace-font-family;
                                    font-size: 10px * root.text-scale; overflow: elide;
                                    accessible-label: message-row.time-label;
                                }
                                if message-row.columns : Text {
                                    width: message-row.column-width; text: root.nickname-column-label(message.sender);
                                    color: root.sender-ink(message-row.selected-message, message.is-own, message.sender-palette-index, message.accent);
                                    font-family: root.message-font-family; font-size: root.message-font-px;
                                    font-weight: root.sender-font-weight > 0 ? root.sender-font-weight : 650;
                                    horizontal-alignment: root.nickname-alignment == 0 ? TextHorizontalAlignment.left : TextHorizontalAlignment.right; overflow: elide;
                                    accessible-label: message.sender;
                                }
                                message-content := VerticalLayout {
                                    width: message-row.body-width;
                                    spacing: root.message-layout == 0 ? 5px : 2px;
                                    padding-right: message-row.columns ? message-row.action-width + 8px : 0px;
                                    if !message-row.columns : HorizontalLayout {
                                        min-height: message-row.tight-header ? max(26px, root.message-font-px * 1.4) + 26px : max(26px, root.message-font-px * 1.4);
                                        padding-right: message-row.tight-header ? 0px : message-row.action-width + 8px;
                                        spacing: 8px;
                                        if message-row.tight-header : Text {
                                            text: message.sender;
                                            color: root.sender-ink(message-row.selected-message, message.is-own, message.sender-palette-index, message.accent);
                                            font-family: root.message-font-family; font-size: root.message-font-px;
                                            font-weight: root.sender-font-weight > 0 ? root.sender-font-weight : 650; overflow: elide; vertical-alignment: top;
                                            horizontal-stretch: 0; min-width: 0px;
                                            accessible-label: message.sender;
                                        }
                                        // The compact clock keeps the timestamp role and the pending or
                                        // failed delivery status beside the name on narrow rows.
                                        if message-row.tight-header && message-row.show-time && message-row.time-label != "" : Text {
                                            text: "· " + message-row.time-label; color: root.clock-ink(message-row.selected-message);
                                            font-family: root.monospace-font-family; font-size: 10px * root.text-scale; vertical-alignment: top;
                                            horizontal-stretch: 0; accessible-label: message-row.time-label;
                                        }
                                        if !message-row.tight-header : Text {
                                            text: message.sender; color: root.sender-ink(message-row.selected-message, message.is-own, message.sender-palette-index, message.accent);
                                            font-family: root.message-font-family;
                                            font-size: root.message-layout == 0 ? root.message-font-px : max(10px, root.message-font-px - 2px);
                                            font-weight: root.sender-font-weight > 0 ? root.sender-font-weight : 650; overflow: elide;
