                        Text { text: "Conversation style"; color: root.ink; font-size: 15px * root.text-scale; font-weight: 650; }
                        for name[index] in ["Stacked · names above messages", "Compact · smaller names and avatars", "Columns · aligned timestamps and nicknames"] : ActionRect {
