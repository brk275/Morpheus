        RoomNotificationState.room-shown(root.active-account-local-id, root.active-room-id);
    }
    // The person closed the panel: focus returns to what opened it.
    function close-room-notifications() {
        RoomNotificationState.close();
        if root.page == 0 {
            root.room-notification-focus-request += 1;
        } else if root.page == 1 {
            // Opened from Settings: its entry, which only reveals the panel.
            root.settings-reveal-id = "notifications.this_room";
            root.settings-reveal-serial += 1;
        }
    }

    in-out property <bool> room-actions-open: false;
    in-out property <int> room-action-mode: 0; // 0 private room, 1 join, 2 Space
    in-out property <string> room-action-input;
