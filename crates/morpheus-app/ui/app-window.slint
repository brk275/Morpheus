    property <string> sticker-scope: root.active-account-local-id + "\n" + root.active-room-id + "\n" + root.thread-root-id + "\n" + root.composer-mode + "\n" + root.side-panel-tab;
    changed sticker-scope => { root.sticker-context-changed(); }
