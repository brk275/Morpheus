                    }
                    Rectangle {
                        property <length> status-height: root.composer-status-visible ? composer-status.height + 10px : 0px;
                        height: (root.composer-mode == 0 ? max(78px, 1.5 * root.message-font-px + 48px) : max(109px, 1.5 * root.message-font-px + 79px)) + (root.attachment-busy ? 29px : 0px) + self.status-height;
                        background: transparent;
                        composer-status := PendingSendStrip {
                            x: 22px; y: (root.composer-mode == 0 ? 2px : 33px) + (root.attachment-busy ? 29px : 0px);
                            width: parent.width - 44px;
                            items: root.composer-pending-items; blocked-notice: root.composer-blocked-notice;
                            composer-empty: root.composer-text == "";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            cancel(key) => { root.cancel-pending-send(false, key); }
                            retry(key) => { root.retry-pending-send(false, key); }
                            review(key, sent) => { root.review-unconfirmed-send(false, key, sent); }
                            restore(key) => { root.restore-record-text(false, key); }
                            copy(key) => { root.copy-record-text(false, key); }
                            discard(key) => { root.discard-record-text(false, key); }
                            discard-unreadable => { root.discard-unreadable-status(false); }
