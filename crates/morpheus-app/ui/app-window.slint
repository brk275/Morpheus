        && RoomNotificationState.room-id == root.active-room-id && root.active-room-id != ""
        && !root.show-sign-in && !root.access-open && !root.manage-accounts-open
        && root.security-recovery-key == "" && !root.account-profile-open && !SpaceExplorer.open && !SpaceRooms.open && !RoomAddresses.open
        && !root.people-open && !MemberPrivacy.inspector.open;
