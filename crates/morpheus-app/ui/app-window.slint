                        vertical-stretch: 1;
                    }
                    if root.live-session && root.page == 0 && root.thread-root-id != "" && root.thread-recovery-serial > 0 : TimelineRecoveryNotice {
                        action-enabled: root.viewport-seek-allowed && !root.settings-reveal-protected;
                        ink: root.ink; muted: root.muted; surface: root.elevated;
