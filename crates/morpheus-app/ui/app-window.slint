                            }
                            root.thread-seek-moved-id = id;
                            root.thread-seek-moved-top = top;
                            root.thread-seek-moved-y = goal;
                            root.thread-seek-waits = 0;
                            root.thread-seek-seen-y = goal;
                            self.content-y = goal;
                        }
                        // The keeper's one move: put the anchor reply, now laid out at
                        // `row-y`, back at its measured offset (clamped at the ends) once
                        // Rust admits it. Refused, the reader's place moves with the layout
                        // and the reply across the top reports the anchor again.
                        function keep-anchor(row-y: length) {
                            let goal = -max(0px, min(max(0px, self.content-height - self.visible-height), row-y - root.thread-anchor-offset));
                            if abs(self.content-y - goal) <= 0.5px {
