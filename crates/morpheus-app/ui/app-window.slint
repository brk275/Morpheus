    in-out property <int> composer-pending-count: 0;
    in-out property <bool> composer-pending-blocked: false;
    in-out property <bool> composer-unconfirmed: false;
    in-out property <[PendingSendItem]> composer-pending-items;
    in-out property <string> composer-blocked-notice;
    in-out property <bool> thread-pending-blocked: false;
    in-out property <bool> thread-unconfirmed: false;
    in-out property <[PendingSendItem]> thread-pending-items;
    in-out property <string> thread-blocked-notice;
    property <bool> composer-status-visible: root.composer-blocked-notice != "" || root.composer-pending-items.length > 0;
    property <bool> thread-status-visible: root.thread-blocked-notice != "" || root.thread-pending-items.length > 0;
    in-out property <string> login-homeserver: "https://matrix.org";
    property <string> login-username;
    property <string> login-password;

    // A picker snapshot never survives a change of account or Space.
    changed image-previews-encrypted-enabled => {
        if !root.image-previews-encrypted-enabled { root.stop-attachment-audio(); root.cancel-room-settings(); }
    }
    changed room-admin-open => {
        if !root.room-admin-open { root.cancel-room-settings(); root.moderation-context-changed(2); }
    }
    changed room-admin-mode => {
        if root.room-admin-mode != 0 { root.cancel-room-settings(); }
        if root.room-admin-mode != 2 { root.moderation-context-changed(2); }
    }
    changed active-account-local-id => {
        root.clear-room-key-file-inputs();
        root.room-key-file-context-changed();
        root.close-people();
        MemberPrivacy.close-inspector();
        root.moderation-context-changed(0);
        root.details-reveal-open = false;
        root.cancel-room-settings(); root.close-image-preview(); root.stop-attachment-audio(); root.quick-switcher-open = false; root.incoming-call-notice = ""; root.mention-context-changed(); root.attachment-context-changed(); ThreadBrowser.context-changed(); }
    changed active-account-index => { root.quick-switcher-open = false; root.mention-context-changed(); }
    changed active-room-id => {
        MemberPrivacy.close-inspector();
        root.moderation-context-changed(0);
        root.cancel-room-settings(); root.close-image-preview(); root.stop-attachment-audio(); root.mention-context-changed(); root.attachment-context-changed(); RoomOrganizationState.active-room-changed();
        root.appearance-room-changed(); ThreadBrowser.context-changed(); }
    changed thread-root-id => {
        root.close-image-preview(); root.stop-attachment-audio(); root.mention-context-changed();
        // A page request for the previous thread can no longer publish here.
        root.thread-history-operation += 1; root.thread-history-loading = false;
        root.thread-history-at-start = false; root.thread-history-error = "";
    }
    changed active-space-id => { root.quick-switcher-open = false; }
    // Conditional dialog subtrees do not retain a usable keyboard focus target
    // after dismissal. Return to an account control on the visible surface.
    property <int> account-focus-request: 0;
    function return-account-focus() {
        if !root.access-open {
            // Each conditional subtree resolves its own local focus target.
            root.account-focus-request += 1;
            if !root.manage-accounts-open && !root.show-sign-in { account-trigger.focus(); }
        }
    }
    changed access-open => {
        ThreadBrowser.context-changed();
        if !root.access-open { root.return-account-focus(); }
    }
    changed manage-accounts-open => {
        if root.manage-accounts-open {
            root.account-profile-label-refresh();
        } else {
            root.return-account-focus();
        }
    }
    // A completed final-account removal may refresh the saved rows after its
    // dialog closes. Do not leave focus on the now-removed sign-in shortcut.
    property <int> saved-account-count: root.saved-accounts.length;
    changed saved-account-count => {
        if root.saved-account-count == 0 && root.show-sign-in && !root.manage-accounts-open && !root.access-open {
            root.return-account-focus();
        }
    }
    changed show-sign-in => {
        if root.show-sign-in { root.cancel-room-settings(); } if root.show-sign-in { root.close-image-preview(); } if !root.show-sign-in { shortcut-scope.focus(); } ThreadBrowser.context-changed(); }

    property <bool> light-palette: root.theme-mode == 1 || (root.theme-mode == 3 && Palette.color-scheme == ColorScheme.light);
    property <float> text-scale: root.font-scale-percent / 100.0;
    property <length> message-font-px: root.message-font-size * 1px * root.text-scale;
    property <length> message-row-gap: root.message-gap-px * 1px * (root.message-density-mode == 0 ? 0.5 : root.message-density-mode == 2 ? 1.333 : 1);
    property <length> content-inset: root.content-padding-px * 1px;
    // Typography metrics as scaled logical pixels. A zero sender size keeps
    // each layout's message-based name size.
    property <length> sender-font-px: StyleTokens.sender-font-size * root.text-scale;
    property <length> timestamp-font-px: StyleTokens.timestamp-font-size * root.text-scale;
    property <length> composer-font-px: StyleTokens.composer-font-size > 0px ? StyleTokens.composer-font-size * root.text-scale : root.message-font-px;
    // The tallest name or message text in a timeline header.
    property <length> header-font-px: max(root.message-font-px, root.sender-font-px);
    // The room composer box fits its text and its default-size icon buttons
    // inside the fixed 11 px vertical padding; the thread composer's row has
    // 8 px. Both equal their built-in heights at the default metrics.
    property <length> composer-box-height: max(58px, 1.5 * root.composer-font-px + 28px, StyleTokens.icon-button-size + 22px);
    property <length> thread-composer-height: max(64px, 1.5 * root.composer-font-px + 24px, StyleTokens.icon-button-size + 16px);

    property <color> rail: StyleTokens.base.rail.present ? StyleTokens.base.rail.color : custom-theme-active ? custom-rail : light-palette ? #e7ebf3 : theme-mode == 2 ? #000000 : #10131b;
    property <color> sidebar: StyleTokens.base.sidebar.present ? StyleTokens.base.sidebar.color : custom-theme-active ? custom-sidebar : light-palette ? #f1f3f8 : theme-mode == 2 ? #101010 : #171b26;
    property <color> canvas: StyleTokens.base.canvas.present ? StyleTokens.base.canvas.color : custom-theme-active ? custom-canvas : light-palette ? #ffffff : theme-mode == 2 ? #000000 : #1e2330;
    property <color> panel: StyleTokens.base.panel.present ? StyleTokens.base.panel.color : custom-theme-active ? custom-panel : light-palette ? #f8f9fc : theme-mode == 2 ? #101010 : #191e2a;
    property <color> elevated: StyleTokens.base.elevated.present ? StyleTokens.base.elevated.color : custom-theme-active ? custom-elevated : light-palette ? #ffffff : theme-mode == 2 ? #181818 : #272d3b;
    property <color> hover: StyleTokens.base.hover.present ? StyleTokens.base.hover.color : custom-theme-active ? custom-hover : light-palette ? #e3e8f2 : theme-mode == 2 ? #333333 : #32394b;
    property <color> ink: StyleTokens.base.ink.present ? StyleTokens.base.ink.color : custom-theme-active ? custom-ink : light-palette ? #182132 : #ffffff;
    property <color> muted: StyleTokens.base.muted.present ? StyleTokens.base.muted.color : custom-theme-active ? custom-muted : light-palette ? #596579 : theme-mode == 2 ? #ffffff : #a7afc1;
    property <color> divider: StyleTokens.base.divider.present ? StyleTokens.base.divider.color : custom-theme-active ? custom-divider : light-palette ? #dfe4ee : theme-mode == 2 ? #ffffff : #303747;
    property <color> accent: StyleTokens.base.accent.present ? StyleTokens.base.accent.color : custom-theme-active ? custom-accent : light-palette ? #6545b5 : theme-mode == 2 ? #ffff00 : #ad91ff;
    property <color> accent-ink: StyleTokens.base.accent-ink.present ? StyleTokens.base.accent-ink.color : custom-theme-active ? custom-accent-ink : light-palette ? #ffffff : theme-mode == 2 ? #000000 : #10131b;
    // Surfaces painted directly on the native window. Below 100% their own
    // alpha is scaled and the window's background is cleared, so the desktop
    // shows through only these panes; text, icons, inputs, cards, popups,
    // sign-in and dialogs keep their own colors. At 100% nothing changes.
    // Interaction states. Each unset state follows the color its registry
    // entry names, so the built-in look is unchanged until a theme or
    // config.toml sets it.
    property <color> message-hover-surface: StyleTokens.states.message-hover.present ? StyleTokens.states.message-hover.color : root.elevated;
    property <color> composer-surface: StyleTokens.states.composer-surface.present ? StyleTokens.states.composer-surface.color : root.elevated;
    property <color> composer-border: StyleTokens.states.composer-border.present ? StyleTokens.states.composer-border.color : root.divider;
    property <color> composer-focus-border: StyleTokens.states.composer-focus.present ? StyleTokens.states.composer-focus.color : root.composer-border;
    property <color> icon-ink: StyleTokens.states.icon.present ? StyleTokens.states.icon.color : root.muted;
    property <color> icon-active-ink: StyleTokens.states.icon-active.present ? StyleTokens.states.icon-active.color : root.accent;
    // Per-control icon colors. Each follows `icon` until set; switched-on
    // and primary icons keep `icon_active`.
    property <color> icon-navigation-ink: StyleTokens.states.icon-navigation.present ? StyleTokens.states.icon-navigation.color : root.icon-ink;
    property <color> icon-header-ink: StyleTokens.states.icon-header.present ? StyleTokens.states.icon-header.color : root.icon-ink;
    property <color> icon-composer-ink: StyleTokens.states.icon-composer.present ? StyleTokens.states.icon-composer.color : root.icon-ink;
    property <color> icon-message-ink: StyleTokens.states.icon-message.present ? StyleTokens.states.icon-message.color : root.icon-ink;
    property <color> input-border-color: StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.divider;
    property <color> mention-badge: StyleTokens.states.mention.present ? StyleTokens.states.mention.color
        : StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : #e47483;
    property <color> mention-badge-ink: StyleTokens.states.mention-ink.present ? StyleTokens.states.mention-ink.color
        : StyleTokens.roles.destructive-ink.present ? StyleTokens.roles.destructive-ink.color : #10131b;
    // The fill of an ordinary action: a theme's pressed state while pressed,
    // its control hover state (else the built-in hover color) while hovered,
    // otherwise the action's own surface.
    // Text fields: a theme's input surface, else the field's own surface.
    // While focused a field's outline uses the focus role and width.
    pure function input-fill(idle: color) -> color {
        return StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : idle;
    }
    property <color> field-focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent;
    // A disabled control's label: the theme's disabled state, else muted.
    property <color> control-disabled-ink: StyleTokens.states.control-disabled.present ? StyleTokens.states.control-disabled.color : root.muted;
    pure function control-fill(hovered: bool, pressed: bool, idle: color) -> color {
        return pressed && StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color
            : hovered ? (StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover)
            : idle;
    }
    // The color each registry token shows now, for swatches and the editor.
    // A role without a value shows the built-in color it falls back to.
    public pure function token-color(id: string) -> color {
        if id == "rail" { return root.rail; }
        if id == "sidebar" { return root.sidebar; }
        if id == "canvas" { return root.canvas; }
        if id == "panel" { return root.panel; }
        if id == "elevated" { return root.elevated; }
        if id == "hover" { return root.hover; }
        if id == "ink" { return root.ink; }
        if id == "muted" { return root.muted; }
        if id == "divider" { return root.divider; }
        if id == "accent" { return root.accent; }
        if id == "accent_ink" { return root.accent-ink; }
        if id == "selection" { return StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover; }
        if id == "own_surface" { return StyleTokens.roles.own-surface.present ? StyleTokens.roles.own-surface.color : transparent; }
        if id == "scrim" { return StyleTokens.roles.scrim.present ? StyleTokens.roles.scrim.color : #000000aa; }
        if id == "shadow" { return StyleTokens.roles.shadow.present ? StyleTokens.roles.shadow.color : #00000044; }
        if id == "media_backdrop" { return StyleTokens.roles.media-backdrop.present ? StyleTokens.roles.media-backdrop.color : #11131b; }
        if id == "message" { return StyleTokens.roles.message.present ? StyleTokens.roles.message.color : root.ink; }
        if id == "sender" { return StyleTokens.roles.sender.present ? StyleTokens.roles.sender.color : root.ink; }
        if id == "own_message" {
            return StyleTokens.roles.own-message.present ? StyleTokens.roles.own-message.color
                : StyleTokens.roles.sender.present ? StyleTokens.roles.sender.color
                : StyleTokens.roles.message.present ? StyleTokens.roles.message.color : root.ink;
        }
        if id == "timestamp" { return StyleTokens.roles.timestamp.present ? StyleTokens.roles.timestamp.color : root.muted; }
        if id == "link" { return StyleTokens.roles.link.present ? StyleTokens.roles.link.color : root.accent; }
        if id == "focus" { return StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent; }
        if id == "unread" { return StyleTokens.roles.unread.present ? StyleTokens.roles.unread.color : root.accent; }
        if id == "unread_ink" { return StyleTokens.roles.unread-ink.present ? StyleTokens.roles.unread-ink.color : root.accent-ink; }
        if id == "selection_ink" { return StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink; }
        if id == "error" { return StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483; }
        if id == "error_surface" { return StyleTokens.roles.error-surface.present ? StyleTokens.roles.error-surface.color : #9f3f50; }
        if id == "error_ink" { return StyleTokens.roles.error-ink.present ? StyleTokens.roles.error-ink.color : #ffffff; }
        if id == "success" { return StyleTokens.roles.success.present ? StyleTokens.roles.success.color : #78c8b1; }
        if id == "success_surface" { return StyleTokens.roles.success-surface.present ? StyleTokens.roles.success-surface.color : #214a46; }
        if id == "success_ink" { return StyleTokens.roles.success-ink.present ? StyleTokens.roles.success-ink.color : #ffffff; }
        if id == "destructive" { return StyleTokens.roles.destructive.present ? StyleTokens.roles.destructive.color : #e47483; }
        if id == "destructive_ink" { return StyleTokens.roles.destructive-ink.present ? StyleTokens.roles.destructive-ink.color : #10131b; }
        if id == "presence_online" { return StyleTokens.roles.presence-online.present ? StyleTokens.roles.presence-online.color : #64c9a7; }
        if id == "voice" { return StyleTokens.roles.voice.present ? StyleTokens.roles.voice.color : #78c8b1; }
        if id == "avatar_ink" { return StyleTokens.roles.avatar-ink.present ? StyleTokens.roles.avatar-ink.color : #ffffff; }
        if id == "message_hover" { return root.message-hover-surface; }
        if id == "control_hover" { return StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover; }
        if id == "control_pressed" { return StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color : transparent; }
        if id == "control_disabled" { return StyleTokens.states.control-disabled.present ? StyleTokens.states.control-disabled.color : root.muted; }
        if id == "input_surface" { return StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.elevated; }
        if id == "input_border" { return root.input-border-color; }
        if id == "composer_surface" { return root.composer-surface; }
        if id == "composer_border" { return root.composer-border; }
        if id == "composer_focus" { return root.composer-focus-border; }
        if id == "icon" { return root.icon-ink; }
        if id == "icon_active" { return root.icon-active-ink; }
        if id == "icon_navigation" { return root.icon-navigation-ink; }
        if id == "icon_header" { return root.icon-header-ink; }
        if id == "icon_composer" { return root.icon-composer-ink; }
        if id == "icon_message" { return root.icon-message-ink; }
        if id == "nav_hover" { return StyleTokens.states.nav-hover.present ? StyleTokens.states.nav-hover.color : root.elevated; }
        if id == "nav_selected" {
            return StyleTokens.states.nav-selected.present ? StyleTokens.states.nav-selected.color
                : StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover;
        }
        if id == "nav_selected_ink" {
            return StyleTokens.states.nav-selected-ink.present ? StyleTokens.states.nav-selected-ink.color
                : StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.ink;
        }
        if id == "mention" { return root.mention-badge; }
        if id == "mention_ink" { return root.mention-badge-ink; }
        return transparent;
    }
    // Whether `token-color` knows the ID; the registry coverage test uses it.
    public pure function token-known(id: string) -> bool {
        return id == "rail" || id == "sidebar" || id == "canvas" || id == "panel" || id == "elevated"
            || id == "hover" || id == "ink" || id == "muted" || id == "divider" || id == "accent"
            || id == "accent_ink" || id == "selection" || id == "own_surface" || id == "scrim"
            || id == "shadow" || id == "media_backdrop" || id == "message" || id == "sender"
            || id == "own_message" || id == "timestamp" || id == "link" || id == "focus"
            || id == "unread" || id == "unread_ink" || id == "selection_ink" || id == "error"
            || id == "error_surface" || id == "error_ink" || id == "success" || id == "success_surface"
            || id == "success_ink" || id == "destructive" || id == "destructive_ink"
            || id == "presence_online" || id == "voice" || id == "avatar_ink"
            || id == "message_hover" || id == "control_hover" || id == "control_pressed"
            || id == "control_disabled" || id == "input_surface" || id == "input_border"
            || id == "composer_surface" || id == "composer_border" || id == "composer_focus"
            || id == "icon" || id == "icon_active" || id == "icon_navigation" || id == "icon_header"
            || id == "icon_composer" || id == "icon_message" || id == "nav_hover" || id == "nav_selected"
            || id == "nav_selected_ink" || id == "mention" || id == "mention_ink";
    }
    // Any pane color with its own alpha also clears the window background, so
    // each pane is painted exactly once at every opacity, including 100%.
    property <bool> window-translucent: StyleTokens.window-opacity < 1 || root.rail.alpha < 255
        || root.sidebar.alpha < 255 || root.canvas.alpha < 255 || root.panel.alpha < 255;
    // Whether the native window background is cleared for translucent panes.
    out property <bool> window-background-cleared: root.window-translucent;
    property <color> window-rail: root.rail.transparentize(1 - StyleTokens.window-opacity);
    property <color> window-sidebar: root.sidebar.transparentize(1 - StyleTokens.window-opacity);
    property <color> window-canvas: root.canvas.transparentize(1 - StyleTokens.window-opacity);
    property <color> window-panel: root.panel.transparentize(1 - StyleTokens.window-opacity);
    // Dialogs, sign-in, account unlock and recovery paint opaque versions of
    // their colors, whatever alpha a token or the window setting has.
    property <color> dialog-surface: root.canvas.with-alpha(1);
    property <color> sign-in-surface: root.rail.with-alpha(1);
    property <PollPalette> poll-palette: {
        ink: root.ink,
        muted: root.muted,
        panel: root.panel,
        elevated: root.elevated,
        hover: root.hover,
        accent: root.accent,
        accent-ink: root.accent-ink,
        divider: root.divider,
        focus: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.accent,
        error: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #e47483,
        success: StyleTokens.roles.success.present ? StyleTokens.roles.success.color : #78c8b1
    };
    // StyledText resolves an omitted font weight from its enclosing window.
    // Explicit sender, heading and Markdown span weights remain their own.
    // Zero preserves the platform default when the preference is unset.
    default-font-weight: StyleTokens.body-font-weight;
    default-font-family: root.ui-font-family;
    background: root.window-translucent ? transparent : canvas;

    shortcut-scope := FocusScope {
    visible: !root.application-closing;
    width: parent.width;
    height: parent.height;
    focus-on-tab-navigation: false;
    init => { self.focus(); }
    // Bubble after child controls: cursor movement, selection, IME, and text
    // editing take precedence over application commands. Never capture Tab/Escape.
    key-pressed(event) => {
        if root.dispatch-shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) { accept } else { reject }
    }
    // Only while a pane gesture runs: Escape discards its preview. Nothing
    // else is observed or consumed here, and focus is never moved.
    capture-key-pressed(event) => {
        if root.pane-gesture != 0 && event.text == Key.Escape {
            root.cancel-pane-preview();
            return accept;
        }
        reject
    }

    // Workspace panes. Each pane is one element placed by the arrangement
    // (pane-x, pane-*-w below), never re-created by reordering, resizing,
    // hiding or collapsing, so timelines, drafts, scroll and focus stay.

        // The account control's own column, when the room list does not lead.
        if root.account-column : Rectangle {
            x: 0px; y: 0px; width: root.account-column-width; height: parent.height;
            background: root.window-rail;
            border-color: root.divider; border-width: StyleTokens.line-width;
        }

        // Space and navigation rail (the default presentation).
        if root.navigation-mode == 0 : Rectangle {
            x: root.pane-x(root.pane-slot-spaces);
            y: 0px;
            width: root.pane-rail-w;
            height: parent.height;
            visible: root.pane-rail-w > 0px;
            clip: true;
            background: root.window-rail;
            VerticalLayout {
                padding: 6px;
                spacing: 10px;
                Rectangle {
                    height: 48px;
                    border-radius: StyleTokens.radius * 1.5;
                    background: root.accent;
                    Text {
                        text: "M";
                        color: root.accent-ink;
                        font-size: 23px * root.text-scale;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: StyleTokens.line-width; background: root.divider; }
                IconAction {
                    width: root.rail-width-px * 1px - 12px;
                    height: 48px;
                    icon: "home";
                    focus-state-changed(focused) => { root.navigation-focus-changed(0, "route:home", focused); }
                    label: "Home and all rooms";
                    ink: root.page == 0 && root.active-space-id == "" ? root.icon-active-ink : root.icon-navigation-ink;
                    surface: transparent;
                    hover-surface: root.hover;
                    selected: root.page == 0 && root.active-space-id == "";
                    activated => { root.active-space-id = ""; root.active-space-name = "Home"; root.select-space(""); root.navigate-page(0); }
                }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: parent.width;
                        spacing: 8px;
                        for space in root.spaces : ActionRect {
                            width: root.rail-width-px * 1px - 12px;
                            height: root.show-space-labels ? 52px + 14px * root.text-scale : 48px;
                            focus-state-changed(focused) => { root.navigation-focus-changed(0, "space:" + space.id, focused); }
                            border-radius: StyleTokens.radius * 1.2;
                            background: root.active-space-id == space.id && root.page == 0
                                ? (StyleTokens.states.nav-selected.present ? StyleTokens.states.nav-selected.color : StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.hover)
                                : self.has-pressed && StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color
                                : self.has-hover ? (StyleTokens.states.nav-hover.present ? StyleTokens.states.nav-hover.color : root.hover) : transparent;
                            focus-color: root.accent;
                            label: "Select space " + space.name;
                            activated => {
                                root.active-space-id = space.id;
                                root.active-space-name = space.name;
                                root.select-space(space.id);
                                root.navigate-page(0);
                            }
                            AvatarBadge {
                                x: (parent.width - 38px) / 2;
                                y: 5px;
                                initials: space.initials;
                                accent: space.accent;
                            }
                            if root.show-space-labels : Text {
                                x: 2px; y: 48px; width: parent.width - 4px; height: 14px * root.text-scale;
                                text: space.name; font-size: 10px * root.text-scale; overflow: elide;
                                color: root.active-space-id != space.id || root.page != 0 ? root.muted
                                    : StyleTokens.states.nav-selected-ink.present ? StyleTokens.states.nav-selected-ink.color
                                    : StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.muted;
                                horizontal-alignment: center; accessible-label: space.name;
                            }
                        }
                    }
                }
                Rectangle { height: StyleTokens.line-width; background: root.divider; }
                IconAction {
                    width: root.rail-width-px * 1px - 12px;
                    height: 48px;
                    icon: "explore";
                    focus-state-changed(focused) => { root.navigation-focus-changed(0, "route:discover", focused); }
                    label: "Explore public Matrix rooms";
                    ink: root.page == 3 ? root.icon-active-ink : root.icon-navigation-ink;
                    surface: transparent;
                    hover-surface: root.hover;
                    selected: root.page == 3;
                    activated => { if RoomLeave.view.open { return; } MatrixLink.withdraw(); UnreadNavigation.withdraw-jump(); IdentityWarnings.withdraw(); ThreadBrowser.withdraw(); root.navigate-page(3); root.open-discovery(); }
                }
                IconAction {
                    width: root.rail-width-px * 1px - 12px;
                    height: 48px;
                    icon: "calls";
                    focus-state-changed(focused) => { root.navigation-focus-changed(0, "route:calls", focused); }
                    label: "Open call stage";
                    ink: root.page == 2 ? root.icon-active-ink : root.icon-navigation-ink;
                    surface: transparent;
                    hover-surface: root.hover;
                    selected: root.page == 2;
                    activated => { if RoomLeave.view.open { return; } MatrixLink.withdraw(); UnreadNavigation.withdraw-jump(); IdentityWarnings.withdraw(); ThreadBrowser.withdraw(); root.navigate-page(2); }
                }
                IconAction {
                    width: root.rail-width-px * 1px - 12px;
                    height: 48px;
                    icon: "settings";
                    focus-state-changed(focused) => { root.navigation-focus-changed(0, "route:settings", focused); }
                    label: "Open settings";
                    ink: root.page == 1 ? root.icon-active-ink : root.icon-navigation-ink;
                    surface: transparent;
                    hover-surface: root.hover;
                    selected: root.page == 1;
                    activated => { if RoomLeave.view.open { return; } MatrixLink.withdraw(); UnreadNavigation.withdraw-jump(); IdentityWarnings.withdraw(); ThreadBrowser.withdraw(); root.navigate-page(1); root.open-security(); }
                }
            }
        }

        // Room list. The account control is drawn at the window's bottom left.
        Rectangle {
            x: root.pane-x(root.pane-slot-rooms);
            y: 0px;
            width: root.pane-rooms-w;
            height: parent.height;
            visible: root.pane-rooms-w > 0px;
            clip: true;
            background: root.window-sidebar;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: max(64px, 40px * root.text-scale + 24px);
                    background: transparent;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 14px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center; spacing: 3px;
                            Text { text: "Morpheus"; color: root.ink; font-size: 17px * root.text-scale; font-weight: 750; }
                            if root.preview-session : Text {
                                text: "Offline preview"; color: root.muted;
                                font-size: 10px * root.text-scale; font-weight: 500;
                                accessible-label: "Offline preview with fictional accounts";
                            }
                        }
                        VerticalLayout { width: 34px; alignment: center;
                            people-trigger := IconAction {
                                width: 34px; height: 34px;
                                icon: "direct-messages";
                                label: "Start a direct conversation";
                                enabled: root.live-session;
                                ink: root.icon-ink; surface: transparent; hover-surface: root.hover;
                                activated => { root.open-people(""); }
                            }
                        }
                        VerticalLayout { width: 34px; alignment: center;
                            room-action-trigger := IconAction {
                            width: 34px;
                            height: 34px;
                            icon: "+";
                            label: "Create or join a Matrix room";
                            // Not admitted: disabled for pointer, keys and the
                            // accessibility default action alike.
                            enabled: !root.room-creation-entry-blocked;
                            ink: root.icon-navigation-ink; surface: transparent; hover-surface: root.hover;
                            activated => {
                                // Refused first: nothing is reset, withdrawn
                                // or begun (room-creation-entry-blocked).
                                if root.room-creation-entry-blocked { return; }
                                // Admitted: latent peers end before this
                                // entry's own values change.
                                CallBar.withdraw();
                                MatrixLink.withdraw(); UnreadNavigation.withdraw-jump();
                                IdentityWarnings.withdraw(); ThreadBrowser.withdraw();
                                root.room-action-mode = 0;
                                root.room-action-input = "";
                                root.room-action-error = "";
                                RoomCreation.begin(0);
                                root.room-actions-open = true;
                            }
                        }
                        }
                    }
                }
                Rectangle { height: StyleTokens.line-width; background: root.divider; }
                Rectangle {
                    height: max(62px, 22px * root.text-scale + 40px);
                    background: transparent;
                    quick-switch-trigger := ActionRect {
                        x: 12px; y: 12px;
                        width: parent.width - 24px; height: parent.height - 24px;
                        border-radius: StyleTokens.radius * 0.8;
                        background: root.control-fill(self.has-hover, self.has-pressed, root.elevated);
                        focus-color: root.accent;
                        enabled: root.page != 1 && !root.show-sign-in;
                        label: "Switch between rooms in the current Home or Space";
                        activated => { root.open-quick-switcher(); }
                        HorizontalLayout {
                            padding-left: 11px; padding-right: 11px;
                            padding-top: 10px; padding-bottom: 10px; spacing: 9px;
                            Rectangle { width: 17px; background: transparent; MorpheusIcon { y: (parent.height - self.height) / 2; width: 17px; height: 17px; icon: "search"; ink: root.muted; } }
                            Text { text: "Find a conversation"; color: root.muted; font-size: 12px * root.text-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: parent.width;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 18px;
                        spacing: 3px;
                        if root.navigation-mode == 1 : VerticalLayout {
                            spacing: 3px; alignment: start; vertical-stretch: 0;
                            for route[index] in ["Home", "Discover", "Calls", "Settings"] : NavigationTextAction {
                                text: route; text-scale: root.text-scale;
                                ink: root.ink; muted: root.muted; hover: root.hover; accent: root.accent;
                                selected: index == 0 ? root.page == 0 && root.active-space-id == "" : root.page == (index == 1 ? 3 : index == 2 ? 2 : 1);
                                label: index == 0 ? "Home and all rooms" : index == 1 ? "Explore public Matrix rooms" : index == 2 ? "Open call stage" : "Open settings";
                                focus-state-changed(focused) => { root.navigation-focus-changed(1, "route:" + index, focused); }
                                activated => {
                                    if RoomLeave.view.open { return; }
                                    if index == 0 { root.active-space-id = ""; root.active-space-name = "Home"; root.select-space(""); root.navigate-page(0); }
                                    else if index == 1 { MatrixLink.withdraw(); UnreadNavigation.withdraw-jump(); IdentityWarnings.withdraw(); ThreadBrowser.withdraw(); root.navigate-page(3); root.open-discovery(); }
                                    else if index == 2 { MatrixLink.withdraw(); UnreadNavigation.withdraw-jump(); IdentityWarnings.withdraw(); ThreadBrowser.withdraw(); root.navigate-page(2); }
                                    else { MatrixLink.withdraw(); UnreadNavigation.withdraw-jump(); IdentityWarnings.withdraw(); ThreadBrowser.withdraw(); root.navigate-page(1); root.open-security(); }
                                }
                            }
                            if root.spaces.length > 0 : Text {
                                text: "SPACES"; color: root.muted; font-size: 10px * root.text-scale; font-weight: 750;
                                height: max(29px, 18px * root.text-scale); vertical-alignment: bottom;
                            }
                            for space in root.spaces : NavigationTextAction {
                                text: space.name; text-scale: root.text-scale;
                                ink: root.ink; muted: root.muted; hover: root.hover; accent: root.accent;
                                selected: root.page == 0 && root.active-space-id == space.id;
                                label: "Select space " + space.name;
                                focus-state-changed(focused) => { root.navigation-focus-changed(1, "space:" + space.id, focused); }
                                activated => {
                                    root.active-space-id = space.id; root.active-space-name = space.name;
                                    root.select-space(space.id); root.navigate-page(0);
                                }
                            }
                            Rectangle { height: 1px; vertical-stretch: 0; background: root.divider; }
                        }
                        Text {
                            text: root.group-direct-messages ? (root.active-space-id == "" ? "YOUR ROOMS" : "SPACE ROOMS") : "CONVERSATIONS";
                            color: root.muted;
                            font-size: 10px * root.text-scale;
                            font-weight: 750;
                            letter-spacing: 1px;
                            height: 29px;
                            vertical-alignment: bottom;
                        }
                        Rectangle {
                            height: max(30px, 30px + (StyleTokens.sidebar-font-size - 13px) * root.text-scale);
                            background: transparent;
                            Text {
                                x: 8px;
                                width: parent.width - 8px - (space-explore.enabled ? space-explore.width + 4px : 0px);
                                text: "v   " + (root.active-space-id == "" ? "Home" : root.active-space-name);
                                color: root.ink;
                                font-size: StyleTokens.sidebar-font-size * root.text-scale;
                                font-weight: 650;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            // Browse the shown Space's rooms and nested Spaces (space-explorer.slint).
                            space-explore := TextAction {
                                x: parent.width - self.width - 4px;
                                y: (parent.height - self.height) / 2;
                                width: 76px * root.text-scale;
                                height: 26px;
                                enabled: root.live-session && root.active-space-id != "";
                                visible: self.enabled;
                                ink: root.ink; muted: root.muted; surface: transparent; hover-surface: root.hover;
                                outline: root.divider; text-scale: root.text-scale;
                                text: "Explore";
                                accessible-label: "Explore the rooms and Spaces in " + root.active-space-name;
                                activated => { SpaceExplorer.show(root.active-space-id, root.active-space-name, "", ""); }
                            }
                        }
                        if root.invitations.length > 0 : HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "INVITATIONS · " + root.invitations.length;
                                color: root.accent;
                                font-size: 10px * root.text-scale;
                                font-weight: 750;
                                letter-spacing: 1px;
                                min-height: 29px;
                                vertical-alignment: bottom;
                                horizontal-stretch: 1;
                            }
                            // The invitations center: all of them, searchable.
                            TextAction {
                                property <int> focus-request: root.invitations-focus-request;
                                changed focus-request => { self.focus(); }
                                text: root.invitations.length > root.home-invitations.length ? "All " + root.invitations.length : "Manage";
                                ink: root.ink; muted: root.muted; surface: transparent; hover-surface: root.hover;
                                outline: root.divider; text-scale: root.text-scale;
                                accessible-label: "Open all " + root.invitations.length + " invitations";
                                enabled: root.live-session;
                                activated => { root.open-invitations(); }
                            }
                        }
                        if root.invite-error != "" : Text {
                            text: root.invite-error;
                            color: StyleTokens.roles.error.present ? StyleTokens.roles.error.color : #ff8d9d;
                            font-size: 11px * root.text-scale;
                            wrap: word-wrap;
                            height: 40px;
                        }
                        for invite in root.home-invitations : Rectangle {
                            height: 58px;
                            border-radius: StyleTokens.radius * 0.8;
                            background: root.elevated;
                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 7px;
                                spacing: 4px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: invite.name; color: root.ink; font-size: 12px * root.text-scale; font-weight: 700; overflow: elide; }
                                    Text { text: "Room invitation"; color: root.muted; font-size: 10px * root.text-scale; }
                                }
                                Button {
                                    width: 30px; height: 30px;
                                    text: "✓";
                                    accessible-label: "Accept invitation to " + invite.name;
                                    enabled: !InvitationsState.answering;
                                    clicked => { root.respond-invite(invite.id, true); }
                                }
                                Button {
                                    width: 30px; height: 30px;
                                    text: "×";
                                    accessible-label: "Decline invitation to " + invite.name;
                                    enabled: !InvitationsState.answering;
                                    clicked => { root.respond-invite(invite.id, false); }
                                }
                            }
                        }
                        if root.favourite-rooms.length > 0 : RoomSectionHeader {
                            title: "FAVORITES"; count: root.favourite-rooms.length;
                            collapsed: RoomOrganizationState.favourites-collapsed;
                            text-scale: root.text-scale; muted: root.muted; focus-color: root.accent;
                            toggle => { RoomOrganizationState.favourites-collapsed = !RoomOrganizationState.favourites-collapsed; }
                        }
                        if root.favourite-rooms.length > 0 && !RoomOrganizationState.favourites-collapsed : VerticalLayout {
                            spacing: 3px; alignment: start; vertical-stretch: 0;
                            for entry[index] in root.favourite-rooms : OrganizableRoomRow {
                                organizable: root.live-session;
                                can-move-up: index > 0;
                                can-move-down: index < root.favourite-rooms.length - 1;
                                room: entry.room; direct: entry.direct;
                                selected: entry.room.id == root.active-room-id && root.page == 0;
                                density-mode: root.room-density-mode; text-scale: root.text-scale;
                                ink: root.ink; muted: root.muted; elevated: root.elevated; hover: root.hover; accent: root.accent; accent-ink: root.accent-ink;
                                mention-surface: root.mention-badge; mention-ink: root.mention-badge-ink;
                                open(id, voice) => {
                                    if voice && root.live-session { root.open-voice-space(id); }
                                    else { root.navigate-page(0); root.open-room(id); }
                                }
                            }
                        }
                        if root.group-direct-messages : VerticalLayout {
                            spacing: 3px; alignment: start; vertical-stretch: 0;
                            // Direct messages first, when chosen; keyboard order follows.
                            if root.direct-messages-first : Text {
                                text: "DIRECT MESSAGES"; color: root.muted; font-size: 10px * root.text-scale;
                                font-weight: 750; letter-spacing: 1px; height: 29px; vertical-alignment: bottom;
                            }
                            if root.direct-messages-first : VerticalLayout {
                                spacing: 3px; alignment: start;
                                for dm in root.direct-messages : OrganizableRoomRow {
                                    organizable: root.live-session;
                                    room: dm; direct: true;
                                    selected: dm.id == root.active-room-id && root.page == 0;
                                    density-mode: root.room-density-mode; text-scale: root.text-scale;
                                    ink: root.ink; muted: root.muted; elevated: root.elevated; hover: root.hover; accent: root.accent; accent-ink: root.accent-ink;
                                    mention-surface: root.mention-badge; mention-ink: root.mention-badge-ink;
                                    open(id, voice) => {
                                        if voice && root.live-session { root.open-voice-space(id); }
                                        else { root.navigate-page(0); root.open-room(id); }
                                    }
                                }
                            }
                            if root.direct-messages-first : Text {
                                text: "ROOMS"; color: root.muted; font-size: 10px * root.text-scale;
                                font-weight: 750; letter-spacing: 1px; height: 40px; vertical-alignment: bottom;
                            }
                            for channel in root.channels : OrganizableRoomRow {
                                organizable: root.live-session;
                                room: channel; direct: false;
                                selected: channel.id == root.active-room-id && root.page == 0;
                                density-mode: root.room-density-mode; text-scale: root.text-scale;
                                ink: root.ink; muted: root.muted; elevated: root.elevated; hover: root.hover; accent: root.accent; accent-ink: root.accent-ink;
                                mention-surface: root.mention-badge; mention-ink: root.mention-badge-ink;
                                open(id, voice) => {
                                    if voice && root.live-session { root.open-voice-space(id); }
                                    else { root.navigate-page(0); root.open-room(id); }
                                }
                            }
                            if !root.direct-messages-first : Text {
                                text: "DIRECT MESSAGES"; color: root.muted; font-size: 10px * root.text-scale;
                                font-weight: 750; letter-spacing: 1px; height: 40px; vertical-alignment: bottom;
                            }
                            if !root.direct-messages-first : VerticalLayout {
                                spacing: 3px; alignment: start;
                                for dm in root.direct-messages : OrganizableRoomRow {
                                    organizable: root.live-session;
                                    room: dm; direct: true;
                                    selected: dm.id == root.active-room-id && root.page == 0;
                                    density-mode: root.room-density-mode; text-scale: root.text-scale;
                                    ink: root.ink; muted: root.muted; elevated: root.elevated; hover: root.hover; accent: root.accent; accent-ink: root.accent-ink;
                                    mention-surface: root.mention-badge; mention-ink: root.mention-badge-ink;
                                    open(id, voice) => {
                                        if voice && root.live-session { root.open-voice-space(id); }
                                        else { root.navigate-page(0); root.open-room(id); }
                                    }
                                }
                            }
                        }
                        if !root.group-direct-messages : VerticalLayout {
                            spacing: 3px; alignment: start; vertical-stretch: 0;
                            for entry in root.combined-rooms : OrganizableRoomRow {
                                organizable: root.live-session;
                                room: entry.room; direct: entry.direct;
                                selected: entry.room.id == root.active-room-id && root.page == 0;
                                density-mode: root.room-density-mode; text-scale: root.text-scale;
                                ink: root.ink; muted: root.muted; elevated: root.elevated; hover: root.hover; accent: root.accent; accent-ink: root.accent-ink;
                                mention-surface: root.mention-badge; mention-ink: root.mention-badge-ink;
                                open(id, voice) => {
                                    if voice && root.live-session { root.open-voice-space(id); }
                                    else { root.navigate-page(0); root.open-room(id); }
                                }
                            }
                        }
                        if root.low-priority-rooms.length > 0 : RoomSectionHeader {
                            title: "LOW PRIORITY"; count: root.low-priority-rooms.length;
                            collapsed: RoomOrganizationState.low-priority-collapsed;
                            text-scale: root.text-scale; muted: root.muted; focus-color: root.accent;
                            toggle => { RoomOrganizationState.low-priority-collapsed = !RoomOrganizationState.low-priority-collapsed; }
                        }
                        if root.low-priority-rooms.length > 0 && !RoomOrganizationState.low-priority-collapsed : VerticalLayout {
                            spacing: 3px; alignment: start; vertical-stretch: 0;
                            for entry in root.low-priority-rooms : OrganizableRoomRow {
                                organizable: root.live-session;
                                room: entry.room; direct: entry.direct;
                                selected: entry.room.id == root.active-room-id && root.page == 0;
                                density-mode: root.room-density-mode; text-scale: root.text-scale;
                                ink: root.ink; muted: root.muted; elevated: root.elevated; hover: root.hover; accent: root.accent; accent-ink: root.accent-ink;
                                mention-surface: root.mention-badge; mention-ink: root.mention-badge-ink;
                                open(id, voice) => {
                                    if voice && root.live-session { root.open-voice-space(id); }
                                    else { root.navigate-page(0); root.open-room(id); }
                                }
                            }
                        }
                    }
                }
                // The account control is drawn at the window's bottom left
                // (see account-corner); in the default arrangement it sits
                // here, over this reserved space.
                Rectangle { height: root.account-column ? 0px : root.account-toolbar-height + root.account-trigger-height + StyleTokens.line-width; }
            }
            // Collapsed (or squeezed by a narrow window): a strip that restores it.
            if root.pane-rooms-w > 0px && root.pane-rooms-w <= root.pane-strip : Rectangle {
                background: root.window-sidebar;
                border-color: root.divider;
                border-width: StyleTokens.line-width;
                IconAction {
                    x: (parent.width - self.width) / 2; y: 12px;
                    width: max(24px, parent.width - 4px); height: 40px;
                    icon: "»";
                    label: root.pane-rooms-collapsed ? "Show the room list" : "The window is too narrow for the room list";
                    enabled: root.pane-rooms-collapsed;
                    ink: root.icon-ink; surface: transparent; hover-surface: root.hover;
                    activated => { root.set-pane-collapsed("rooms", false); }
                }
            }
        }

        // The conversation's place in the arrangement. The conversation and
        // the details panel are drawn over their own places below, so tab and
        // reading order stay the same whatever the order on screen.
        main-area := Rectangle {
            x: root.pane-x(root.pane-slot-conversation);
            y: 0px;
            width: root.pane-conversation-w;
            height: parent.height;
            property <length> panel-width: 0px;
        }

        // Conversation, settings, and call stage share the main canvas.
        Rectangle {
            x: main-area.x + (root.details-side == 1 ? main-area.panel-width : 0px);
            y: main-area.y;
            width: main-area.width - main-area.panel-width;
            height: main-area.height;
            background: root.window-canvas;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: max(64px, 40px * root.text-scale + 24px) + StyleTokens.icon-button-growth;
                    background: transparent;
                    // Measured only, never drawn or read out: the page 0 glyph
                    // and the whole room name in the header's fonts
                    // (header-glyph, header-name-wanted).
                    Rectangle {
                        width: 0px; height: 0px; clip: true;
                        header-glyph-probe := Text { text: "#"; font-size: 20px * root.text-scale; accessible-role: none; }
                        header-name-probe := Text { text: root.active-room-name; font-size: 16px * root.text-scale; font-weight: 750; accessible-role: none; }
                    }
                    HorizontalLayout {
                        padding-left: 24px;
                        // More keeps its place at the end of the row, zero wide
                        // unless actions fold; its 11 px gap counts toward the
                        // 16 px edge.
                        padding-right: root.header-overflow ? 16px : 5px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 11px;
                        Text {
                            text: root.page == 1 ? "⚙" : root.page == 2 ? "☏" : root.page == 3 ? "⌕" : "#";
                            color: root.muted;
                            font-size: 20px * root.text-scale;
                            vertical-alignment: center;
                        }
                        if root.page != 0 || root.conversation-header-mode != 2 : Text {
                            text: root.page == 1 ? "Settings" : root.page == 2 ? "Voice & video" : root.page == 3 ? "Discover rooms" : root.active-room-name;
                            color: root.ink;
                            font-size: 16px * root.text-scale;
                            font-weight: 750;
                            vertical-alignment: center;
                            // On the conversation page the name keeps a readable
                            // start, and takes the topic's place once actions fold.
                            horizontal-stretch: root.page == 0 && !root.header-full ? 1 : 0;
                            min-width: root.page == 0 ? root.header-name-min : 0px;
                            overflow: elide;
                            accessible-label: root.page == 0 ? "Current room: " + root.active-room-name : self.text;
                        }
                        if root.page == 0 && root.conversation-header-mode == 2 : Text {
                            text: root.active-room-name;
                            color: root.ink;
                            font-size: 16px * root.text-scale;
                            font-weight: 750;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: root.header-name-min;
                            overflow: elide;
                            accessible-label: "Current room: " + root.active-room-name;
                        }
                        // The topic gives way first: it elides, and leaves once
                        // actions fold.
                        if root.page != 0 || (root.conversation-header-mode != 2 && root.header-full) : Rectangle { width: 1px; height: 24px; background: root.divider; }
                        if root.page != 0 || (root.conversation-header-mode != 2 && root.header-full) : Text {
                            text: root.page == 0 ? root.active-room-topic : root.page == 1 ? "Make Morpheus yours" : root.page == 3 ? "Public rooms on your Matrix homeserver" : "The Workshop";
                            color: root.muted;
                            font-size: 12px * root.text-scale;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            overflow: elide;
                        }
                        if root.page == 0 : VerticalLayout {
                            width: StyleTokens.icon-button-size; alignment: center;
                            RoomOrganizationButton {
                                width: StyleTokens.icon-button-size; height: StyleTokens.icon-button-size;
                                room-id: root.active-room-id; room-name: root.active-room-name;
                                account-context: root.active-account-local-id;
                                enabled: root.live-session && root.active-room-id != "";
                                ink: root.icon-header-ink; hover: root.hover; radius: StyleTokens.radius * 0.9;
                                focus-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.ink;
                            }
                        }
                        // Each foldable action below is drawn while it fits
                        // (header-shows) and is otherwise a More item; both run
                        // header-action with the same label, state and guard.
                        if root.page == 0 && root.header-shows(0) : VerticalLayout {
                            width: StyleTokens.icon-button-size; alignment: center;
                            IconAction {
                            // A panel the person closed returns focus here.
                            property <int> focus-request: root.room-notification-focus-request;
                            changed focus-request => { self.focus(); }
                            // Stable IDs of the native icon set, which draws them once merged.
                            icon: root.header-icon(0);
                            label: root.header-label(0);
                            ink: root.icon-header-ink; surface: transparent; hover-surface: root.hover;
                            selected: root.header-selected(0);
                            enabled: root.header-enabled(0);
                            focus-state-changed(focused) => { root.header-focus-changed(0, focused); }
                            activated => { root.header-action(0); }
                        }
                        }
                        if root.page == 0 && root.header-shows(1) : VerticalLayout {
                            width: StyleTokens.icon-button-size; alignment: center;
                            IconAction {
                            icon: root.header-icon(1); label: root.header-label(1); ink: root.icon-header-ink; surface: transparent; hover-surface: root.hover;
                            enabled: root.header-enabled(1);
                            focus-state-changed(focused) => { root.header-focus-changed(1, focused); }
                            activated => { root.header-action(1); }
                        }
                        }
                        // Review and leave only the exact room shown now. It
                        // stays while the name keeps its floor (slot 8).
                        if root.page == 0 && root.header-shows(8) : VerticalLayout {
                            width: StyleTokens.icon-button-size; alignment: center;
                            IconAction {
                            icon: "log-out"; label: "Leave this room…"; ink: root.icon-header-ink; surface: transparent; hover-surface: root.hover;
                            enabled: root.live-session && root.active-room-id != "" && !root.room-leave-blocked;
                            focus-state-changed(focused) => { root.header-focus-changed(8, focused); }
                            // The dialog's end returns focus here through the
                            // header (header-leave-returns), even if this icon
                            // folded and came back meanwhile.
                            property <int> focus-request: root.header-leave-focus-request;
                            changed focus-request => { self.focus(); }
                            activated => {
                                // Withdraw held link navigation before the dialog flag.
                                if root.room-leave-blocked || RoomLeave.view.open { return; }
                                MatrixLink.withdraw(); UnreadNavigation.withdraw-jump();
                                IdentityWarnings.withdraw(); ThreadBrowser.withdraw();
                                RoomLeave.start();
                                root.header-leave-returns = RoomLeave.view.open;
                            }
                        }
                        }
                        // Search never folds; it also takes the focus More gives
                        // up when nothing is folded any more.
                        if root.page == 0 : VerticalLayout {
                            width: StyleTokens.icon-button-size; alignment: center;
                            IconAction {
                            property <int> focus-request: root.header-search-focus-request;
                            changed focus-request => { self.focus(); }
                            icon: "search"; label: "Search messages"; ink: root.icon-header-ink; surface: transparent; hover-surface: root.hover;
                            selected: root.show-side-panel && root.side-panel-tab == 2;
                            enabled: root.live-session;
                            activated => { root.focus-room-search(); }
                        }
                        }
                        // Unread navigation: back to this account's read position.
                        // It stays beside Leave while the name keeps its floor
                        // (slot 9), else it is a More item.
                        if root.page == 0 && root.header-shows(9) : VerticalLayout {
                            width: StyleTokens.icon-button-size; alignment: center;
                            IconAction {
                            icon: root.header-icon(9); label: root.header-label(9);
                            ink: root.icon-header-ink; surface: transparent; hover-surface: root.hover;
                            enabled: root.header-enabled(9);
                            focus-state-changed(focused) => { root.header-focus-changed(9, focused); }
                            activated => { root.header-action(9); }
                        }
                        }
                        if root.page == 0 && root.header-shows(2) : VerticalLayout {
                            width: StyleTokens.icon-button-size; alignment: center;
                            IconAction {
                            icon: root.header-icon(2); label: root.header-label(2); ink: root.icon-header-ink; surface: transparent; hover-surface: root.hover;
                            selected: root.header-selected(2);
                            enabled: root.header-enabled(2);
                            focus-state-changed(focused) => { root.header-focus-changed(2, focused); }
                            activated => { root.header-action(2); }
                        }
                        }
                        // The thread browser (thread-browser.slint) opens here
                        // and gives focus back here when it closes itself (to
                        // More while this action is folded).
                        if root.page == 0 && root.header-shows(3) : VerticalLayout {
                            width: StyleTokens.icon-button-size; alignment: center;
                            property <int> thread-browser-return: ThreadBrowser.return-focus;
                            changed thread-browser-return => { thread-browser-trigger.focus(); }
                            thread-browser-trigger := IconAction {
                            icon: root.header-icon(3); label: root.header-label(3); ink: root.icon-header-ink; surface: transparent; hover-surface: root.hover;
                            selected: root.header-selected(3);
                            enabled: root.header-enabled(3);
                            focus-state-changed(focused) => { root.header-focus-changed(3, focused); }
                            activated => { root.header-action(3); }
                        }
                        }
                        if root.page == 0 && root.header-shows(4) : VerticalLayout {
                            width: StyleTokens.icon-button-size; alignment: center;
                            IconAction {
                            icon: root.header-icon(4); label: root.header-label(4); ink: root.icon-header-ink; surface: transparent; hover-surface: root.hover;
                            selected: root.header-selected(4);
                            enabled: root.header-enabled(4);
                            focus-state-changed(focused) => { root.header-focus-changed(4, focused); }
                            activated => { root.header-action(4); }
                        }
                        }
                        if root.page == 0 && root.header-shows(5) : VerticalLayout {
                            width: StyleTokens.icon-button-size; alignment: center;
                            IconAction {
                            icon: root.header-icon(5); label: root.header-label(5); ink: root.icon-header-ink; surface: transparent; hover-surface: root.hover;
                            selected: root.header-selected(5);
                            enabled: root.header-enabled(5);
                            focus-state-changed(focused) => { root.header-focus-changed(5, focused); }
                            activated => { root.header-action(5); }
                        }
                        }
                        if root.page == 0 && root.header-shows(6) : VerticalLayout {
                            width: StyleTokens.icon-button-size; alignment: center;
                            IconAction {
                            icon: root.header-icon(6); label: root.header-label(6); ink: root.icon-header-ink; surface: transparent; hover-surface: root.hover;
                            focus-state-changed(focused) => { root.header-focus-changed(6, focused); }
                            activated => { root.header-action(6); }
                        }
                        }
                        if root.page == 0 && root.header-shows(7) : VerticalLayout {
                            width: StyleTokens.icon-button-size; alignment: center;
                            IconAction {
                            icon: root.header-icon(7); label: root.header-label(7);
                            ink: root.icon-header-ink; surface: transparent; hover-surface: root.hover;
                            selected: root.header-selected(7);
                            focus-state-changed(focused) => { root.header-focus-changed(7, focused); }
                            activated => { root.header-action(7); }
                        }
                        }
                        // "More room actions": the actions that do not fit, in
                        // one flat menu (drawn over the panes, below). For a
                        // menu whose listed actions are all unavailable focus
                        // stays on More: Escape there closes the menu, and Tab
                        // and Shift+Tab stay on More.
                        VerticalLayout {
                            width: root.header-overflow ? StyleTokens.icon-button-size : 0px; alignment: center;
                            FocusScope {
                                width: root.header-overflow ? StyleTokens.icon-button-size : 0px;
                                height: StyleTokens.icon-button-size;
                                focus-on-click: false;
                                focus-on-tab-navigation: false;
                                key-pressed(event) => {
                                    if root.header-more-open && event.text == Key.Escape {
                                        root.close-header-more(true);
                                        return accept;
                                    }
                                    // While the menu is open Tab and Shift+Tab never
                                    // leave it: to an available item, or with none
                                    // focus stays on More.
                                    if root.header-more-open && (event.text == Key.Tab || event.text == Key.Backtab) {
                                        root.header-menu-move(event.text == Key.Backtab || event.modifiers.shift ? 9 : 1);
                                        return accept;
                                    }
                                    reject
                                }
                                header-more := IconAction {
                                    width: parent.width;
                                    // Zero wide but kept while it has focus, so the
                                    // window does not drop that focus before
                                    // header-layout hands it to Search.
                                    visible: root.header-overflow || self.has-focus;
                                    icon: "more"; label: root.header-overflow ? "More room actions" : "";
                                    ink: root.icon-header-ink; surface: transparent; hover-surface: root.hover;
                                    selected: root.header-more-open;
                                    enabled: root.header-overflow;
                                    activated => { root.toggle-header-more(); }
                                }
                            }
                        }
                    }
                }
                Rectangle { height: StyleTokens.line-width; background: root.divider; }
                // This device's native call on every page but the call page
                // (call-bar.slint); never on a protected surface.
                if root.call-bar-visible : CallBarStrip {
                    text-scale: root.text-scale;
                    palette: root.call-bar-palette;
                    room: root.native-call-room-display;
                    participants: root.native-call-participants.length;
                    capture: root.call-capture;
                    joined: root.native-call-joined;
                    leave-unconfirmed: root.native-leave-unconfirmed;
                }
                if root.native-call-enabled && root.live-session && root.incoming-call-account-id == root.active-account-local-id && root.incoming-call-offers.length > 0 : ScrollView {
                    height: min(220px, root.incoming-call-offers.length * (102px * root.text-scale));
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 1px;
                        for offer in root.incoming-call-offers : Rectangle {
                            height: 102px * root.text-scale;
                            background: root.panel;
                            border-width: StyleTokens.line-width;
                            border-color: root.accent;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 3px;
                                Text {
                                    text: "Incoming call · " + offer.caller;
                                    accessible-live-region: polite;
                                    color: root.ink;
                                    font-size: 13px * root.text-scale;
                                    font-weight: 650;
                                    overflow: elide;
                                }
                                Text {
                                    text: offer.room + " · " + offer.account;
                                    color: root.muted;
                                    font-size: 11px * root.text-scale;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionRect {
                                        width: 110px;
                                        height: 32px * root.text-scale;
                                        border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.6;
                                        background: self.has-hover ? root.accent : root.hover;
                                        focus-color: root.accent;
                                        enabled: !root.incoming-call-answering && !root.call-connected && !root.native-call-request-pending;
                                        label: "Answer call from " + offer.caller + " in " + offer.room + " for " + offer.account;
                                        activated => { root.answer-incoming-call(offer.token); }
                                        Text { text: "Answer"; color: root.ink; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    ActionRect {
                                        width: 110px;
                                        height: 32px * root.text-scale;
                                        border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.6;
                                        background: root.control-fill(self.has-hover, self.has-pressed, root.canvas);
                                        focus-color: root.accent;
                                        label: "Decline call from " + offer.caller + " in " + offer.room + "; tells the caller";
                                        enabled: !root.incoming-call-declining && !root.incoming-call-answering;
                                        activated => { root.decline-incoming-call(offer.token); }
                                        Text { text: "Decline"; color: root.ink; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    ActionRect {
                                        width: 110px;
                                        height: 32px * root.text-scale;
                                        border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.6;
                                        background: root.control-fill(self.has-hover, self.has-pressed, root.canvas);
                                        focus-color: root.accent;
                                        label: "Dismiss call from " + offer.caller + " in " + offer.room + " on this device only";
                                        activated => { root.dismiss-incoming-call(offer.token); }
                                        Text { text: "Dismiss"; color: root.ink; font-size: 12px * root.text-scale; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }
                if root.incoming-call-sound-status != "" && root.live-session && root.incoming-call-account-id == root.active-account-local-id && root.incoming-call-offers.length > 0 : Text {
                    text: root.incoming-call-sound-status;
                    accessible-label: "Incoming call sound: " + root.incoming-call-sound-status;
                    accessible-live-region: polite;
                    color: root.muted; font-size: 11px * root.text-scale;
                    wrap: word-wrap;
                }
                if root.incoming-call-notice != "" && root.live-session : Rectangle {
                    height: 32px * root.text-scale;
                    background: root.panel;
                    Text {
                        x: 12px; width: parent.width - 24px;
                        text: root.incoming-call-notice;
                        accessible-live-region: polite;
                        color: root.muted;
                        font-size: 11px * root.text-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.config-error != "" : Rectangle {
                    height: 39px;
                    background: StyleTokens.roles.error-surface.present ? StyleTokens.roles.error-surface.color : #9f3f50;
                    Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: "Settings file: " + root.config-error;
                        color: StyleTokens.roles.error-ink.present ? StyleTokens.roles.error-ink.color : #ffffff;
                        font-size: 11px * root.text-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.session-error != "" : Rectangle {
                    height: 34px;
                    background: StyleTokens.roles.error-surface.present ? StyleTokens.roles.error-surface.color : #613743;
                    Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: root.session-error;
                        accessible-live-region: polite;
                        color: StyleTokens.roles.error-ink.present ? StyleTokens.roles.error-ink.color : #ffffff;
                        font-size: 11px * root.text-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.transfer-notice != "" : Rectangle {
                    property <color> notice-ink: StyleTokens.roles.success-ink.present ? StyleTokens.roles.success-ink.color : #ffffff;
                    height: max(30px, transfer-copy.preferred-height + 8px,
                        root.downloading-event-id != "" ? save-cancel.min-height + 6px : 0px);
                    background: StyleTokens.roles.success-surface.present ? StyleTokens.roles.success-surface.color : #214a46;
                    transfer-copy := Text {
                        x: 16px; width: parent.width - 32px - (root.downloading-event-id != "" ? save-cancel.width + 8px : 0px);
                        text: root.transfer-notice;
                        accessible-live-region: polite;
                        color: parent.notice-ink;
                        font-size: 11px * root.text-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    save-cancel := TextAction {
                        visible: root.downloading-event-id != "";
                        enabled: root.downloading-event-id != "";
                        x: parent.width - self.width - 12px;
                        y: (parent.height - self.height) / 2;
                        width: self.preferred-width; height: self.min-height;
                        text: "Cancel"; label: "Cancel saving the attachment";
                        ink: parent.notice-ink; muted: parent.notice-ink; surface: transparent;
                        hover-surface: root.hover; outline: parent.notice-ink; text-scale: root.text-scale;
                        activated => { root.cancel-attachment-save(); }
                    }
                }
                // A style profile preview stays visible on every page until it
                // is applied or cancelled; it saves nothing on its own.
                if root.style-preview-active : Rectangle {
                    height: max(44px, 32px * root.text-scale + 12px);
                    background: root.elevated;
                    border-width: StyleTokens.line-width; border-color: root.accent;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 12px; padding-top: 6px; padding-bottom: 6px; spacing: 10px;
                        Text {
                            text: "Previewing " + root.style-preview-name + ". Nothing is saved until you apply it.";
                            color: root.ink; font-size: 12px * root.text-scale;
                            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                        }
                        TextAction {
                            text: "Apply";
                            label: "Apply the previewed style profile " + root.style-preview-name;
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.accent; text-scale: root.text-scale;
                            // The bar closes: keep keyboard focus in the window.
                            activated => { shortcut-scope.focus(); root.style-preview-apply(); }
                        }
                        TextAction {
                            text: "Cancel";
                            label: "Cancel the preview and restore your look";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            activated => { shortcut-scope.focus(); root.style-profile-cancel-preview(); }
                        }
                    }
                }
                // A theme pack preview stays visible on every page until it is
                // applied or cancelled; it installs and saves nothing on its own.
                if root.studio-pack-preview-name != "" : Rectangle {
                    height: max(44px, 32px * root.text-scale + 12px);
                    background: root.elevated;
                    border-width: StyleTokens.line-width; border-color: root.accent;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 12px; padding-top: 6px; padding-bottom: 6px; spacing: 10px;
                        Text {
                            text: "Previewing the " + root.studio-pack-preview-name + " theme pack. "
                                + (root.studio-pack-replaces ? "That name is already installed. Change the imported TOML file's name field and import it again to keep both packs." : "Nothing is installed until you apply it.");
                            color: root.ink; font-size: 12px * root.text-scale;
                            vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide;
                            accessible-live-region: polite;
                        }
                        TextAction {
                            text: "Install and apply";
                            enabled: !root.studio-pack-replaces;
                            label: root.studio-pack-replaces ? "Give the imported pack a different name and import it again; the installed pack is kept" : "Install and apply the " + root.studio-pack-preview-name + " theme pack";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.accent; text-scale: root.text-scale;
                            activated => { shortcut-scope.focus(); root.studio-pack-apply(); }
                        }
                        TextAction {
                            text: "Cancel";
                            label: "Cancel the theme pack preview and restore your look";
                            ink: root.ink; muted: root.muted; surface: root.elevated; hover-surface: root.hover;
                            outline: root.divider; text-scale: root.text-scale;
                            activated => { shortcut-scope.focus(); root.studio-pack-cancel(); }
                        }
                    }
                }
                // Unsaved theme studio changes stay visible on every page until
                // they are applied or discarded; nothing in the draft is saved.
                if root.studio-pending > 0 : Rectangle {
                    height: max(44px, 32px * root.text-scale + 12px);
                    background: root.elevated;
                    border-width: StyleTokens.line-width; border-color: root.accent;
                    accessible-role: region;
                    accessible-label: "Unsaved appearance changes";
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 12px; padding-top: 6px; padding-bottom: 6px; spacing: 8px;
                        Text {
                            text: root.studio-conflicts > 0
                                ? (root.studio-conflicts == 1 ? "1 of these settings" : root.studio-conflicts + " of these settings")
                                    + " also changed in the settings file (" + root.studio-conflict-summary + "). Keep which values?"
                                : (root.studio-pending == 1 ? "1 appearance change is" : root.studio-pending + " appearance changes are")
                                    + " shown but not saved.";
