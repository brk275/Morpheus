// Native multi-participant call stage. Rust decides which tiles exist, which
// one is featured, which streams are decoded and which frame slot each live
// tile reads; this file only lays tiles out and reports pin, page and focus
// choices. The window passes its resolved semantic colors and motion
// duration in; geometry and interaction states come from StyleTokens.

import { ListView } from "std-widgets.slint";
import { StyleTokens } from "style-tokens.slint";

export struct CallParticipantItem {
    name: string,
    detail: string,
    is-local: bool,
}

export struct CallTileItem {
    // Stable while this tile stays in the call; zero is never a tile.
    id: int,
    name: string,
    initials: string,
    accent: color,
    // Shown whenever the tile has no picture.
    status: string,
    // Index into the stage's frames, or -1 when nothing is decoded.
    frame-slot: int,
    live: bool,
    // A pinned participant left or a pinned screen share ended.
    departed: bool,
    screen: bool,
    pinned: bool,
    is-local: bool,
    mic-muted: bool,
    speaking: bool,
    hand-raised: bool,
}

export struct CallStagePalette {
    ink: color,
    muted: color,
    panel: color,
    elevated: color,
    hover: color,
    accent: color,
    accent-ink: color,
    divider: color,
    // Letterbox behind decoded video.
    backdrop: color,
    focus: color,
    // Speaking indicator.
    voice: color,
    avatar-ink: color,
}

// A keyboard and pointer action with caller-supplied visuals.
component StageAction inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> focus-color;
    out property <bool> has-hover: hit.has-hover;
    out property <bool> has-pressed: hit.pressed;
    callback activated();
    forward-focus: keyboard-focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.activated(); }
    }
    @children
    keyboard-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if root.enabled { root.activated(); }
                accept
            } else {
                reject
            }
        }
    }
    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            keyboard-focus.focus();
            root.activated();
        }
    }
    if keyboard-focus.has-focus : Rectangle {
        border-radius: parent.border-radius;
        border-width: StyleTokens.focus-width;
        border-color: root.focus-color;
        background: transparent;
    }
}

// One camera, screen share or placeholder. Enter, Space or a double click
// pins it; Escape unpins; arrows move between tiles; Page Up/Down pages.
component StageTile inherits Rectangle {
    in property <CallTileItem> tile;
    in property <image> frame;
    in property <CallStagePalette> palette;
    in property <float> text-scale: 1;
    in property <length> corner: 10px;
    in property <duration> motion: 0ms;
    in property <bool> featured: false;
    in property <bool> focus-requested: false;
    callback toggle-pin();
    callback escape-pressed() -> bool;
    callback page(int);
    callback navigate(int, int);
    callback focused(bool);

    // The slot check matters: a tile without a slot reads slot zero's image.
    property <bool> has-frame: root.tile.live && root.tile.frame-slot >= 0 && root.frame.width > 0;
    property <bool> can-pin: root.tile.pinned || !root.tile.is-local;
    property <bool> compact: root.height < 120px;
    property <length> avatar-size: clamp(min(root.width, root.height) * 0.3, 26px, 96px);
    // Labels and the pin control keep their built-in share of the corner.
    property <length> label-corner: root.corner * 0.6;

    background: root.has-frame ? root.palette.backdrop : root.palette.panel;
    border-radius: root.corner;
    clip: true;
    forward-focus: keyboard-focus;
    accessible-role: button;
    accessible-label: (root.tile.screen ? "Screen share from " : "") + root.tile.name
        + (root.has-frame ? ", video" : ", " + root.tile.status)
        + (root.tile.pinned ? ", pinned" : "")
        + (root.tile.mic-muted ? ", microphone muted" : "")
        + (root.tile.hand-raised ? ", hand raised" : "")
        + (root.tile.speaking ? ", speaking" : "");
    accessible-enabled: root.can-pin;
    accessible-action-default => {
        if root.can-pin { root.toggle-pin(); }
    }

    // A pin change or tile rebuild recreates elements; the stage asks the
    // new element for the tile that had focus.
    init => {
        if root.focus-requested { keyboard-focus.focus(); }
    }
    changed focus-requested => {
        if root.focus-requested { keyboard-focus.focus(); }
    }

    if root.has-frame : Image {
        width: parent.width;
        height: parent.height;
        source: root.frame;
        image-fit: root.tile.screen || root.featured ? ImageFit.contain : ImageFit.cover;
        accessible-role: none;
    }
    if !root.has-frame : VerticalLayout {
        padding: 8px;
        spacing: root.compact ? 4px : 10px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.avatar-size;
                height: root.avatar-size;
                // Avatar roundness, when set, applies to call avatars too.
                border-radius: StyleTokens.avatar-roundness >= 0 ? self.width * StyleTokens.avatar-roundness / 100 : self.width / 2;
                background: root.tile.departed ? root.palette.hover : root.tile.accent;
                Text {
                    text: root.tile.initials;
                    color: root.tile.departed ? root.palette.muted : root.palette.avatar-ink;
                    font-size: root.avatar-size * 0.36;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
        if !root.compact : Text {
            text: root.tile.status;
            color: root.palette.muted;
            font-size: 12px * root.text-scale;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
        }
    }
    HorizontalLayout {
        x: 8px;
        y: parent.height - self.height - 8px;
        width: parent.width - 16px;
        height: max(22px, 18px * root.text-scale);
        alignment: start;
        Rectangle {
            background: root.palette.panel;
            border-radius: root.label-corner;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: (root.tile.screen ? "Screen · " : "") + root.tile.name
                        + (root.tile.mic-muted ? " · mic muted" : "")
                        + (root.tile.hand-raised ? " · hand raised" : "");
                    color: root.palette.ink;
                    font-size: 11px * root.text-scale;
                    font-weight: 650;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
            }
        }
    }
    if root.tile.pinned : Rectangle {
        x: 8px;
        y: 8px;
        width: pinned-text.preferred-width + 14px;
        height: 22px;
        border-radius: root.label-corner;
        background: root.palette.accent;
        pinned-text := Text {
            text: "Pinned";
            color: root.palette.accent-ink;
            font-size: 10px * root.text-scale;
            font-weight: 750;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    keyboard-focus := FocusScope {
        focus-gained(reason) => { root.focused(true); }
        focus-lost(reason) => { root.focused(false); }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if root.can-pin { root.toggle-pin(); }
                accept
            } else if event.text == Key.Escape {
                if root.escape-pressed() { accept } else { reject }
            } else if event.text == Key.PageDown {
                root.page(1);
                accept
            } else if event.text == Key.PageUp {
                root.page(-1);
                accept
            } else if event.text == Key.LeftArrow {
                root.navigate(-1, 0);
                accept
            } else if event.text == Key.RightArrow {
                root.navigate(1, 0);
                accept
            } else if event.text == Key.UpArrow {
                root.navigate(0, -1);
                accept
            } else if event.text == Key.DownArrow {
                root.navigate(0, 1);
                accept
            } else {
                reject
            }
        }
    }
    area := TouchArea {
        clicked => { keyboard-focus.focus(); }
        double-clicked => {
            if root.can-pin { root.toggle-pin(); }
        }
    }
    // Pointer pin control. Keyboard and assistive technology use the tile's
    // own action, so this stays out of the tab order.
    Rectangle {
        visible: root.can-pin && (area.has-hover || pin-area.has-hover || keyboard-focus.has-focus || root.tile.pinned);
        x: parent.width - self.width - 8px;
        y: 8px;
        width: pin-label.preferred-width + 16px;
        height: 24px;
        border-radius: root.label-corner;
        background: pin-area.pressed && StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color
            : pin-area.has-hover ? (StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.palette.hover)
            : root.palette.panel;
        pin-label := Text {
            text: root.tile.pinned ? "Unpin" : "Pin";
            color: root.palette.ink;
            font-size: 11px * root.text-scale;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        pin-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                keyboard-focus.focus();
                root.toggle-pin();
            }
        }
    }
    Rectangle {
        border-radius: root.corner;
        border-width: 2px;
        border-color: root.tile.speaking ? root.palette.voice : transparent;
        animate border-color { duration: root.motion; }
    }
    if keyboard-focus.has-focus : Rectangle {
        border-radius: root.corner;
        border-width: StyleTokens.focus-width;
        border-color: root.palette.focus;
        background: transparent;
    }
}

// The featured tile above a filmstrip, or an adaptive 16:9 grid, beside the
// participant roster.
export component CallStage inherits Rectangle {
    in property <[CallTileItem]> tiles;
    in property <CallTileItem> featured;
    in property <bool> featured-visible: false;
    in property <[image]> frames;
    in property <int> page: 0;
    in property <int> pages: 1;
    in property <int> tile-count: 0;
    in property <bool> media-degraded: false;
    in property <[CallParticipantItem]> participants;
    in property <bool> call-connected: false;
    in property <bool> calls-enabled: false;
    in property <bool> legacy-mode: false;
    in property <bool> can-open-slot: false;
    in property <CallStagePalette> palette;
    in property <float> text-scale: 1;
    in property <length> corner: 10px;
    in property <duration> motion: 0ms;
    in-out property <bool> show-roster: true;
    callback pin-tile(int);
    callback page-tiles(int);
    callback open-slot();

    property <length> inset: 12px;
    property <length> gap: 10px;
    property <length> roster-width: 212px;
    property <bool> roster-fits: root.width >= 700px;
    property <bool> roster-shown: root.show-roster && root.roster-fits;
    // Paging controls and, while the roster is hidden, its "People" button.
    property <length> pager-height: root.pages > 1 || (root.roster-fits && !root.show-roster) ? 40px : 0px;
    property <length> controls-height: root.can-open-slot ? 64px : 0px;
    property <length> stage-x: root.inset;
    property <length> stage-y: root.inset;
    property <length> stage-width: max(0px, root.width - 2 * root.inset - (root.roster-shown ? root.roster-width + root.inset : 0px));
    property <length> stage-height: max(0px, root.height - 2 * root.inset - root.pager-height - root.controls-height);
    property <int> count: root.tiles.length;
    // Stage buttons: an explicit control radius wins, otherwise each keeps
    // its built-in share of the stage corner. States follow the window's.
    property <length> button-corner: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : root.corner * 0.8;
    property <color> button-hover: StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.palette.hover;
    property <bool> pressed-set: StyleTokens.states.control-pressed.present;
    property <color> disabled-ink: StyleTokens.states.control-disabled.present ? StyleTokens.states.control-disabled.color : root.palette.muted;
    property <float> glyph-scale: root.text-scale * StyleTokens.icon-size / 18px;
    // The tile that should hold keyboard focus; tiles report focus changes.
    property <int> focus-target: -1;
    // The tile to refocus after a pin change rebuilds the stage.
    property <int> restore-focus: -1;

    // Featured mode: the featured tile above a row of page tiles, or beside
    // a column of them when the stage is much wider than it is tall.
    property <bool> strip-beside: root.count > 0 && root.stage-width > root.stage-height * 2;
    property <length> strip-height: root.count > 0 && !root.strip-beside ? min(120px, root.stage-height * 0.26) : 0px;
    property <length> strip-tile-width: root.count == 0 ? 0px
        : root.strip-beside ? min(240px, root.stage-width * 0.22)
        : max(0px, min(root.strip-height * 16 / 9, (root.stage-width - (root.count - 1) * root.gap) / root.count));
    property <length> strip-tile-height: root.count == 0 ? 0px
        : root.strip-beside ? max(0px, min(root.strip-tile-width * 9 / 16, (root.stage-height - (root.count - 1) * root.gap) / root.count))
        : root.strip-height;
    property <length> strip-x: root.strip-beside
        ? root.stage-x + root.stage-width - root.strip-tile-width
        : root.stage-x + max(0px, (root.stage-width - root.count * root.strip-tile-width - (root.count - 1) * root.gap) / 2);
    property <length> strip-y: root.strip-beside
        ? root.stage-y + max(0px, (root.stage-height - root.count * root.strip-tile-height - (root.count - 1) * root.gap) / 2)
        : root.stage-y + root.stage-height - root.strip-height;
    property <length> featured-width: max(0px, root.stage-width - (root.strip-beside ? root.strip-tile-width + root.gap : 0px));
    property <length> featured-height: max(0px, root.stage-height - (root.count > 0 && !root.strip-beside ? root.strip-height + root.gap : 0px));

    // Grid mode: the column count that gives the largest 16:9 tiles.
    property <length> fit-one: root.fit(1);
    property <length> fit-two: root.count > 1 ? root.fit(2) : 0px;
    property <length> fit-three: root.count > 2 ? root.fit(3) : 0px;
    property <int> columns: root.fit-three > root.fit-two && root.fit-three > root.fit-one ? 3 : (root.fit-two > root.fit-one ? 2 : 1);
    property <int> rows: max(1, ceil(root.count / root.columns));
    property <length> cell-width: max(0px, root.fit(root.columns));
    property <length> cell-height: root.cell-width * 9 / 16;
    property <length> grid-x: root.stage-x + max(0px, (root.stage-width - root.columns * root.cell-width - (root.columns - 1) * root.gap) / 2);
    property <length> grid-y: root.stage-y + max(0px, (root.stage-height - root.rows * root.cell-height - (root.rows - 1) * root.gap) / 2);
    property <int> last-row-count: root.count - (root.rows - 1) * root.columns;

    // The widest 16:9 tile when the page uses `column-count` columns.
    pure function fit(column-count: int) -> length {
        let row-count = max(1, ceil(root.count / column-count));
        min((root.stage-width - (column-count - 1) * root.gap) / column-count, (root.stage-height - (row-count - 1) * root.gap) / row-count * 16 / 9)
    }

    // Pin or unpin `id`, keeping keyboard focus on that tile once it moves.
    function toggle(id: int) {
        root.restore-focus = id;
        root.pin-tile(id);
    }

    // Escape unpins; it is left to other handlers when nothing is pinned.
    function escape-from(id: int) -> bool {
        let pinned = root.featured-visible && root.featured.pinned;
        if pinned {
            root.restore-focus = id;
            root.pin-tile(root.featured.id);
        }
        pinned
    }

    function tile-focus(id: int, on: bool) {
        if on {
            root.focus-target = id;
            root.restore-focus = -1;
        } else if root.focus-target == id {
            root.focus-target = -1;
        }
    }

    // Arrow keys: index -1 is the featured tile, then the page in order.
    // Along the strip moves between page tiles; back across it returns to
    // the featured tile.
    function navigate(origin: int, dx: int, dy: int) {
        if root.featured-visible {
            let along = root.strip-beside ? dy : dx;
            let across = root.strip-beside ? dx : dy;
            if origin < 0 {
                if (along > 0 || across > 0) && root.count > 0 {
                    root.focus-target = root.tiles[0].id;
                }
            } else if across < 0 {
                root.focus-target = root.featured.id;
            } else if origin + along >= 0 && origin + along < root.count {
                root.focus-target = root.tiles[origin + along].id;
            }
        } else {
            let target = origin + dx + dy * root.columns;
            if target >= 0 && target < root.count {
                root.focus-target = root.tiles[target].id;
            }
        }
    }

    background: root.palette.elevated;
    border-radius: root.corner * 1.4;

    if root.count == 0 && !root.featured-visible : VerticalLayout {
        x: root.stage-x;
        y: root.stage-y;
        width: root.stage-width;
        height: root.stage-height;
        alignment: center;
        spacing: 12px;
        Text {
            text: root.call-connected ? "Waiting for participants" : (root.legacy-mode ? "Join the legacy room call" : "Join the room call");
            color: root.palette.ink;
            font-size: 19px * root.text-scale;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.calls-enabled
                ? "Participants appear here with their cameras and screen shares. Pin a tile to keep it on the stage."
                : "This build does not include the native media backend.";
            color: root.palette.muted;
            font-size: 13px * root.text-scale;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }

    if root.featured-visible : StageTile {
        x: root.stage-x;
        y: root.stage-y;
        width: root.featured-width;
        height: root.featured-height;
        tile: root.featured;
        frame: root.frames[max(0, root.featured.frame-slot)];
        palette: root.palette;
        text-scale: root.text-scale;
        corner: root.corner;
        motion: root.motion;
        featured: true;
        focus-requested: root.focus-target == root.featured.id || root.restore-focus == root.featured.id;
        toggle-pin => { root.toggle(root.featured.id); }
        escape-pressed => { root.escape-from(root.featured.id) }
        page(delta) => { root.page-tiles(delta); }
        navigate(dx, dy) => { root.navigate(-1, dx, dy); }
        focused(on) => { root.tile-focus(root.featured.id, on); }
    }

    for item[index] in root.tiles : StageTile {
        property <int> tile-grid-row: floor(index / root.columns);
        x: root.featured-visible
            ? root.strip-x + (root.strip-beside ? 0px : index * (root.strip-tile-width + root.gap))
            : root.grid-x + mod(index, root.columns) * (root.cell-width + root.gap)
                + (self.tile-grid-row == root.rows - 1 ? (root.columns - root.last-row-count) * (root.cell-width + root.gap) / 2 : 0px);
        y: root.featured-visible
            ? root.strip-y + (root.strip-beside ? index * (root.strip-tile-height + root.gap) : 0px)
            : root.grid-y + self.tile-grid-row * (root.cell-height + root.gap);
        width: root.featured-visible ? root.strip-tile-width : root.cell-width;
        height: root.featured-visible ? root.strip-tile-height : root.cell-height;
        tile: item;
        frame: root.frames[max(0, item.frame-slot)];
        palette: root.palette;
        text-scale: root.text-scale;
        corner: root.corner;
        motion: root.motion;
        focus-requested: root.focus-target == item.id || root.restore-focus == item.id;
        toggle-pin => { root.toggle(item.id); }
        escape-pressed => { root.escape-from(item.id) }
        page(delta) => { root.page-tiles(delta); }
        navigate(dx, dy) => { root.navigate(index, dx, dy); }
        focused(on) => { root.tile-focus(item.id, on); }
    }

    if root.pages > 1 : HorizontalLayout {
        x: root.stage-x;
        y: root.stage-y + root.stage-height + 6px;
        width: root.stage-width;
        height: 32px;
        alignment: center;
        spacing: 8px;
        StageAction {
            width: StyleTokens.icon-button-size;
            border-radius: root.button-corner;
            background: self.enabled && self.has-pressed && root.pressed-set ? StyleTokens.states.control-pressed.color
                : self.has-hover && self.enabled ? root.button-hover : root.palette.panel;
            label: "Previous participants";
            enabled: root.page > 0;
            focus-color: root.palette.focus;
            activated => { root.page-tiles(-1); }
            Text {
                text: "‹";
                color: root.page > 0 ? root.palette.ink : root.disabled-ink;
                font-size: 16px * root.glyph-scale;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        Text {
            text: "Page " + (root.page + 1) + " of " + root.pages + " · " + root.tile-count + " tiles";
            color: root.palette.muted;
            font-size: 11px * root.text-scale;
            vertical-alignment: center;
            accessible-live-region: polite;
        }
        StageAction {
            width: StyleTokens.icon-button-size;
            border-radius: root.button-corner;
            background: self.enabled && self.has-pressed && root.pressed-set ? StyleTokens.states.control-pressed.color
                : self.has-hover && self.enabled ? root.button-hover : root.palette.panel;
            label: "Next participants";
            enabled: root.page + 1 < root.pages;
            focus-color: root.palette.focus;
            activated => { root.page-tiles(1); }
            Text {
                text: "›";
                color: root.page + 1 < root.pages ? root.palette.ink : root.disabled-ink;
                font-size: 16px * root.glyph-scale;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }

    if root.roster-shown : Rectangle {
        x: root.width - root.roster-width - root.inset;
        y: root.inset;
        width: root.roster-width;
        height: root.height - 2 * root.inset;
        background: root.palette.panel;
        border-radius: root.corner * 1.1;
        Text {
            x: 12px;
            y: 10px;
            width: parent.width - 76px;
            height: 24px;
            text: "PARTICIPANTS · " + root.participants.length;
            color: root.palette.muted;
            font-size: 10px * root.text-scale;
            font-weight: 750;
            letter-spacing: 1px;
            overflow: elide;
            accessible-live-region: polite;
        }
        StageAction {
            x: parent.width - self.width - 8px;
            y: 8px;
            width: 48px;
            height: 26px;
            border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : root.corner * 0.7;
            background: self.has-pressed && root.pressed-set ? StyleTokens.states.control-pressed.color
                : self.has-hover ? root.button-hover : root.palette.panel;
            label: "Hide participant list";
            focus-color: root.palette.focus;
            activated => { root.show-roster = false; }
            Text {
                text: "Hide";
                color: root.palette.muted;
                font-size: 11px * root.text-scale;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        if root.participants.length == 0 : Text {
            x: 12px;
            y: 44px;
            width: parent.width - 24px;
            text: "Nobody is in this call yet";
            color: root.palette.muted;
            font-size: 11px * root.text-scale;
            wrap: word-wrap;
        }
        call-roster := ListView {
            x: 10px;
            y: 42px;
            width: parent.width - 20px;
            height: parent.height - 52px;
            horizontal-scrollbar-policy: always-off;
            for participant in root.participants : Rectangle {
                width: call-roster.visible-width;
                height: 52px;
                background: transparent;
                VerticalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: participant.is-local ? "You · " + participant.name : participant.name;
                        color: root.palette.ink;
                        font-size: 11px * root.text-scale;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: participant.detail;
                        color: root.palette.muted;
                        font-size: 10px * root.text-scale;
                        overflow: elide;
                    }
                }
            }
        }
    }

    if root.roster-fits && !root.show-roster : StageAction {
        x: root.stage-x + root.stage-width - self.width;
        y: root.stage-y + root.stage-height + 7px;
        width: people-text.preferred-width + 20px;
        height: 30px;
        border-radius: root.button-corner;
        background: self.has-pressed && root.pressed-set ? StyleTokens.states.control-pressed.color
            : self.has-hover ? root.button-hover : root.palette.panel;
        label: "Show participant list, " + root.participants.length + " in call";
        focus-color: root.palette.focus;
        activated => { root.show-roster = true; }
        people-text := Text {
            text: "People · " + root.participants.length;
            color: root.palette.ink;
            font-size: 11px * root.text-scale;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    // MatrixRTC reports a degraded media connection while a transport
    // reconnects; pictures can freeze until it recovers.
    if root.media-degraded : Rectangle {
        x: root.stage-x + (root.stage-width - self.width) / 2;
        y: root.stage-y + 8px;
        width: min(root.stage-width - 16px, degraded-text.preferred-width + 24px);
        height: 28px;
        border-radius: root.corner * 0.8;
        background: root.palette.panel;
        border-color: root.palette.divider;
        border-width: StyleTokens.line-width;
        degraded-text := Text {
            text: "Media connection interrupted · reconnecting";
            color: root.palette.ink;
            font-size: 11px * root.text-scale;
            font-weight: 650;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-live-region: polite;
        }
    }

    if root.can-open-slot : StageAction {
        x: root.stage-x + (root.stage-width - self.width) / 2;
        y: root.height - root.inset - 50px;
        width: 176px;
        height: 42px;
        border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : root.corner * 0.9;
        background: self.has-pressed && root.pressed-set ? StyleTokens.states.control-pressed.color
            : self.has-hover ? root.button-hover : root.palette.hover;
        border-color: root.palette.divider;
        border-width: StyleTokens.line-width;
        focus-color: root.palette.focus;
        label: "Open MatrixRTC call in selected room";
        activated => { root.open-slot(); }
        Text {
            text: "Open room call";
            color: root.palette.ink;
            font-size: 12px * root.text-scale;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
