// Reusable themed controls shared by the window, the native screen files and
// the Settings preview. They read only StyleTokens and caller colors, never
// a setting store, and report activation through callbacks.

import { Palette, ScrollView } from "std-widgets.slint";
import { StyleTokens } from "style-tokens.slint";

// Animate only the decorative hover layer. Selection colors, content, focus
// outlines and hit geometry change immediately. The direct reduced-motion
// branch also hides an in-flight transition as soon as the preference changes.
export component HoverSurface inherits Rectangle {
    in property <bool> highlighted;
    property <float> intensity: root.highlighted ? 1 : 0;
    animate intensity { duration: StyleTokens.interaction-duration; easing: ease-out; }
    opacity: StyleTokens.reduced-motion ? (root.highlighted ? 1 : 0) : root.intensity;
}

// A custom action keeps its visual children while using the same keyboard path as Slint Button.
export component ActionRect inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> focus-color: #a88cff;
    in property <bool> trap-tab: false;
    in property <bool> cancel-on-escape: false;
    // Zero-sized targets can round outside a scroll clip and lose focus on release.
    in property <bool> reveal-full-control: true;
    // False draws the control unchanged (its enabled look included) but makes
    // it inert: no keyboard focus, pointer input, accessibility action,
    // activation or cancellation. For preview samples that must never act.
    in property <bool> interactive: true;
    // Every path that acts goes through this.
    property <bool> can-act: root.enabled && root.interactive;
    out property <bool> has-hover: hit.has-hover;
    out property <bool> has-pressed: hit.pressed;
    out property <bool> has-focus: keyboard-focus.has-focus;
    callback activated();
    callback focus-state-changed(bool);
    callback next-focus();
    callback previous-focus();
    callback cancelled();
    forward-focus: keyboard-focus;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: root.can-act;
    accessible-action-default => { if root.can-act { root.activated(); } }
    @children
    keyboard-focus := FocusScope {
        x: 0px;
        width: root.reveal-full-control ? root.width : 0px;
        height: root.reveal-full-control ? root.height : 0px;
        // Accessible focus uses the same reason as a pointer focus request.
        focus-on-click: true;
        enabled: root.can-act;
        focus-gained(reason) => { root.focus-state-changed(true); }
        focus-lost(reason) => { root.focus-state-changed(false); }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if root.can-act { root.activated(); }
                accept
            } else if root.trap-tab && event.text == Key.Tab && !event.modifiers.shift {
                root.next-focus();
                accept
            } else if root.trap-tab && (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) {
                root.previous-focus();
                accept
            } else if root.cancel-on-escape && event.text == Key.Escape {
                if root.can-act { root.cancelled(); }
                accept
            } else { reject }
        }
    }
    hit := TouchArea {
        enabled: root.can-act;
        mouse-cursor: pointer;
        clicked => {
            if root.can-act {
                keyboard-focus.focus();
                root.activated();
            }
        }
    }
    if keyboard-focus.has-focus : Rectangle {
        border-radius: parent.border-radius;
        border-width: StyleTokens.focus-width;
        border-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.focus-color;
        background: transparent;
    }
}

export component TextAction inherits ActionRect {
    in property <string> text;
    in property <color> ink;
    in property <color> muted;
    in property <color> surface;
    in property <color> hover-surface;
    in property <color> outline;
    in property <float> text-scale: 1;
    in property <bool> wrap-caption: false;
    label: text;
    // Stacked actions must accept the pane's width rather than exporting an
    // unbroken caption's intrinsic width into the surrounding layout.
    min-width: root.wrap-caption ? 32px : max(32px, caption.preferred-width + 2 * StyleTokens.control-padding * root.text-scale);
    preferred-width: root.wrap-caption ? 32px : self.min-width;
    min-height: root.wrap-caption ? max(32px * root.text-scale, caption.preferred-height + 16px * root.text-scale) : 32px * root.text-scale;
    horizontal-stretch: root.wrap-caption ? 1 : 0;
    border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : StyleTokens.radius * 0.7;
    border-width: StyleTokens.line-width;
    border-color: outline;
    background: surface;
    focus-color: ink;
    HoverSurface {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        highlighted: root.enabled && root.has-hover;
        background: StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover-surface;
    }
    Rectangle {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        background: root.enabled && root.has-pressed && StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color : transparent;
    }
    caption := Text {
        x: StyleTokens.control-padding * root.text-scale;
        width: parent.width - 2 * StyleTokens.control-padding * root.text-scale;
        height: root.wrap-caption ? self.preferred-height : parent.height;
        y: (parent.height - self.height) / 2;
        text: root.text;
        color: root.enabled ? root.ink : StyleTokens.states.control-disabled.present ? StyleTokens.states.control-disabled.color : root.muted;
        font-size: 12px * root.text-scale;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: root.wrap-caption ? word-wrap : no-wrap;
        overflow: root.wrap-caption ? clip : elide;
    }
}

// The resolved colors a TokenButton draws with. Callers pass their own
// palette's values, so a screen keeps its surfaces while geometry and
// interaction states follow StyleTokens.
export struct ControlColors {
    ink: color,
    muted: color,
    surface: color,
    hover: color,
    outline: color,
    accent: color,
    accent-ink: color,
}

// A text button drawn from StyleTokens with the window's keyboard path
// (Tab, Return, Space; a click focuses it). Primary buttons sit on the accent
// color; their hover and pressed layers tint with the accent ink so the
// label stays readable whatever control states a theme sets.
export component TokenButton inherits ActionRect {
    in property <string> text;
    in property <bool> primary: false;
    in property <ControlColors> colors;
    in property <float> text-scale: 1;
    // Preview samples only: 1 draws hover, 2 pressed, 3 the focus ring,
    // whatever the pointer and keyboard do. Live buttons keep 0.
    in property <int> sample-state: 0;
    label: root.text;
    min-width: max(32px, caption.preferred-width + 2 * StyleTokens.control-padding * root.text-scale);
    min-height: max(30px, 16px * root.text-scale + 12px);
    preferred-width: self.min-width;
    preferred-height: self.min-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: StyleTokens.control-corner;
    border-width: root.primary ? 0px : StyleTokens.line-width;
    border-color: root.colors.outline;
    background: root.primary ? (root.enabled ? root.colors.accent : root.colors.accent.transparentize(0.45)) : root.colors.surface;
    focus-color: root.primary ? root.colors.accent-ink : root.colors.ink;
    HoverSurface {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        highlighted: root.enabled && (root.has-hover || root.sample-state == 1);
        background: root.primary ? root.colors.accent-ink.transparentize(0.85)
            : StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.colors.hover;
    }
    // Drawn only when pressed; a secondary button needs a theme's pressed state.
    Rectangle {
        width: parent.width; height: parent.height; border-radius: parent.border-radius;
        background: !root.enabled || !(root.has-pressed || root.sample-state == 2) ? transparent
            : root.primary ? root.colors.accent-ink.transparentize(0.75)
            : StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color : transparent;
    }
    caption := Text {
        x: StyleTokens.control-padding * root.text-scale;
        width: parent.width - 2 * StyleTokens.control-padding * root.text-scale;
        height: parent.height;
        text: root.text;
        color: root.primary ? (root.enabled ? root.colors.accent-ink : root.colors.accent-ink.transparentize(0.35))
            : root.enabled ? root.colors.ink
            : StyleTokens.states.control-disabled.present ? StyleTokens.states.control-disabled.color : root.colors.muted;
        font-size: 12px * root.text-scale;
        font-weight: root.primary ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.sample-state == 3 : Rectangle {
        border-radius: parent.border-radius;
        border-width: StyleTokens.focus-width;
        border-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.focus-color;
        background: transparent;
    }
}

// A single-line text field drawn from StyleTokens: input surface, border and
// corner, the focus role at the focus width while focused, and the input
// padding. It keeps LineEdit's text, placeholder, enabled and edited API.
export component TokenField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <string> label;
    in property <bool> enabled: true;
    in property <ControlColors> colors;
    in property <float> text-scale: 1;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);
    forward-focus: input;
    min-height: max(32px, 16px * root.text-scale + 14px);
    preferred-height: self.min-height;
    min-width: 48px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    // TextInput clips its own glyphs, selection and cursor. An extra Clip
    // here would hide offscreen fields from native Tab before a surrounding
    // Flickable can scroll them into view.
    background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.colors.surface;
    border-radius: StyleTokens.input-corner;
    border-width: input.has-focus ? StyleTokens.focus-width : StyleTokens.line-width;
    border-color: input.has-focus ? (StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.colors.accent)
        : StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.colors.outline;
    if root.text == "" : Text {
        x: StyleTokens.input-padding;
        width: max(0px, parent.width - 2 * StyleTokens.input-padding);
        height: parent.height;
        text: root.placeholder-text;
        color: root.colors.muted;
        font-size: 12px * root.text-scale;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    input := TextInput {
        x: StyleTokens.input-padding;
        width: max(0px, parent.width - 2 * StyleTokens.input-padding);
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        single-line: true;
        color: root.enabled ? root.colors.ink
            : StyleTokens.states.control-disabled.present ? StyleTokens.states.control-disabled.color : root.colors.muted;
        font-size: 12px * root.text-scale;
        vertical-alignment: center;
        selection-background-color: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : Palette.selection-background;
        selection-foreground-color: StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : Palette.selection-foreground;
        accessible-label: root.label;
        accessible-placeholder-text: root.placeholder-text;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
}

// A checkbox drawn from StyleTokens with CheckBox's text, checked, enabled
// and toggled API: Space or Return toggles it, a click focuses and toggles.
export component TokenCheck inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <ControlColors> colors;
    in property <float> text-scale: 1;
    out property <bool> has-focus: scope.has-focus;
    callback toggled();
    function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled();
        }
    }
    forward-focus: scope;
    min-height: max(28px, caption.preferred-height + 8px);
    vertical-stretch: 0;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.toggle(); }
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px * root.text-scale;
                height: self.width;
                border-radius: StyleTokens.control-radius >= 0px ? min(StyleTokens.control-radius, self.width / 2) : StyleTokens.radius * 0.3;
                border-width: max(2px, StyleTokens.line-width);
                border-color: root.checked ? root.colors.accent : root.colors.muted;
                background: root.checked ? root.colors.accent : transparent;
                if root.checked : Text {
                    text: "✓";
                    color: root.colors.accent-ink;
                    font-size: 12px * root.text-scale;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
        caption := Text {
            text: root.text;
            color: root.enabled ? root.colors.ink
                : StyleTokens.states.control-disabled.present ? StyleTokens.states.control-disabled.color : root.colors.muted;
            font-size: 12px * root.text-scale;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
            accessible-role: none;
        }
    }
    scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggle();
                accept
            } else {
                reject
            }
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            scope.focus();
            root.toggle();
        }
    }
    if scope.has-focus : Rectangle {
        border-radius: StyleTokens.control-corner;
        border-width: StyleTokens.focus-width;
        border-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.colors.accent;
        background: transparent;
    }
}

// A compact dropdown drawn from StyleTokens with ComboBox's contract:
// `current-index` stays clamped to the model, Up and Down choose the
// previous or next entry directly (each choice reports `selected`), Return
// or Space (or a click) opens the list, and the wheel moves the choice while
// the control has focus. In the open list Up, Down, Home, End, Page Up and
// Page Down choose live; Return, Space, Escape and Tab close it; a click
// chooses and closes; a click outside, disabling the control or losing it
// closes the list without choosing.
export component TokenSelect inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    out property <string> current-value: root.current-index >= 0 && root.current-index < root.model.length
        ? root.model[root.current-index] : "";
    in property <ControlColors> colors;
    in property <float> text-scale: 1;
    out property <bool> has-focus: (scope.has-focus || root.popup-has-focus) && root.enabled;
    callback selected(string);

    property <bool> popup-has-focus: false;
    property <length> item-height: max(30px, 16px * root.text-scale + 14px);
    property <int> visible-items: min(6, root.model.length);
    property <length> popup-padding: 4px;
    // Selection and hover colors of the list, from the theme's roles and
    // states, else the control's own surfaces.
    property <color> chosen-surface: StyleTokens.roles.selection.present ? StyleTokens.roles.selection.color : root.colors.hover;
    property <color> chosen-ink: StyleTokens.roles.selection-ink.present ? StyleTokens.roles.selection-ink.color : root.colors.ink;
    property <color> row-hover: StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.colors.hover;
    property <color> disabled-ink: StyleTokens.states.control-disabled.present ? StyleTokens.states.control-disabled.color : root.colors.muted;

    function choose(index: int) {
        if root.enabled && index >= 0 && index < root.model.length {
            root.current-index = index;
            root.selected(root.model[index]);
        }
    }
    function step(delta: int) {
        if root.model.length > 0 {
            root.choose(clamp(root.current-index + delta, 0, root.model.length - 1));
        }
    }
    function open() {
        if root.enabled && root.model.length > 0 {
            popup.show();
        }
    }

    changed model => {
        root.current-index = root.model.length == 0 ? 0 : clamp(root.current-index, 0, root.model.length - 1);
    }
    changed enabled => {
        if !root.enabled { popup.close(); }
    }

    // Remote pack names and device labels must not determine the panel's
    // minimum width. Reserve space for the arrow and padding; elide text
    // inside whatever width the containing layout gives us.
    min-width: max(160px, 24px * root.text-scale + 2 * StyleTokens.input-padding + 24px);
    min-height: max(32px, 16px * root.text-scale + 14px);
    preferred-height: self.min-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: scope;
    border-radius: StyleTokens.input-corner;
    border-width: StyleTokens.line-width;
    border-color: StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.colors.outline;
    background: !root.enabled ? root.colors.surface
        : touch.pressed && StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color
        : touch.has-hover ? root.row-hover
        : StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.colors.surface;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.popup-has-focus;
    accessible-value: root.current-value;
    accessible-action-expand => { root.open(); }

    caption := Text {
        x: StyleTokens.input-padding;
        width: max(0px, parent.width - 2 * StyleTokens.input-padding - 18px * root.text-scale);
        height: parent.height;
        text: root.current-value;
        color: root.enabled ? root.colors.ink : root.disabled-ink;
        font-size: 12px * root.text-scale;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    Path {
        x: parent.width - StyleTokens.input-padding - self.width;
        y: (parent.height - self.height) / 2;
        width: 10px * root.text-scale;
        height: 6px * root.text-scale;
        viewbox-width: 10;
        viewbox-height: 6;
        commands: "M 1 1 L 5 5 L 9 1";
        stroke: root.enabled ? root.colors.muted : root.disabled-ink;
        stroke-width: 1.5px;
        fill: transparent;
        accessible-role: none;
    }
    scope := FocusScope {
        enabled: root.enabled;
        changed has-focus => {
            // Focus comes back here when the list closes.
            if self.has-focus { root.popup-has-focus = false; }
        }
        key-pressed(event) => {
            if !root.enabled {
                return reject;
            }
            if event.text == Key.UpArrow {
                root.step(-1);
                return accept;
            } else if event.text == Key.DownArrow {
                root.step(1);
                return accept;
            } else if event.text == Key.Return || event.text == Key.Space {
                root.open();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            scope.focus();
            root.open();
        }
        scroll-event(event) => {
            if !root.has-focus {
                return reject;
            }
            if event.delta-y < -2px {
                root.step(1);
                return accept;
            }
            if event.delta-y > 2px {
                root.step(-1);
                return accept;
            }
            reject
        }
    }
    if scope.has-focus : Rectangle {
        border-radius: parent.border-radius;
        border-width: StyleTokens.focus-width;
        border-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.colors.accent;
        background: transparent;
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: root.width;
        height: root.visible-items * root.item-height + 2 * root.popup-padding;
        close-policy: close-on-click-outside;
        forward-focus: list-scope;
        Rectangle {
            background: StyleTokens.states.input-surface.present ? StyleTokens.states.input-surface.color : root.colors.surface;
            border-radius: StyleTokens.input-corner;
            border-width: max(1px, StyleTokens.line-width);
            border-color: StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.colors.outline;
            clip: true;
            list-scope := FocusScope {
                focus-changed-event => { root.popup-has-focus = self.has-focus; }
                key-pressed(event) => {
                    if event.text == Key.UpArrow {
                        root.step(-1);
                    } else if event.text == Key.DownArrow {
                        root.step(1);
                    } else if event.text == Key.Home {
                        root.choose(0);
                    } else if event.text == Key.End {
                        root.choose(root.model.length - 1);
                    } else if event.text == Key.PageUp {
                        root.step(-max(1, root.visible-items - 1));
                    } else if event.text == Key.PageDown {
                        root.step(max(1, root.visible-items - 1));
                    } else if event.text == Key.Return || event.text == Key.Space
                        || event.text == Key.Escape || event.text == Key.Tab || event.text == Key.Backtab {
                        popup.close();
                    } else {
                        return reject;
                    }
                    accept
                }
                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    // Keep the chosen entry in view.
                    content-y: -max(0, root.current-index - root.visible-items + 1) * root.item-height;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        padding: root.popup-padding;
                        for value[index] in root.model : Rectangle {
                            height: root.item-height;
                            border-radius: StyleTokens.control-corner;
                            background: index == root.current-index ? root.chosen-surface
                                : row.pressed && StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color
                                : row.has-hover ? root.row-hover : transparent;
                            accessible-role: list-item;
                            accessible-label: value;
                            accessible-enabled: root.enabled;
                            accessible-item-selectable: true;
                            accessible-item-selected: index == root.current-index;
                            accessible-item-index: index;
                            accessible-item-count: root.model.length;
                            accessible-action-default => {
                                if root.enabled {
                                    root.choose(index);
                                    popup.close();
                                }
                            }
                            Text {
                                x: StyleTokens.input-padding;
                                width: max(0px, parent.width - 2 * StyleTokens.input-padding);
                                height: parent.height;
                                text: value;
                                color: index == root.current-index ? root.chosen-ink : root.colors.ink;
                                font-size: 12px * root.text-scale;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                            row := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.choose(index);
                                    popup.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// A horizontal slider drawn from StyleTokens with Slider's exact contract.
// `changed` reports every actual value change: a press away from the thumb,
// a drag, Left, Right, Home and End, and accessibility set, increment and
// decrement. `released` reports the end of a pointer press that began on
// the control, and the release of Left, Right, Home or End, even when the
// value did not change. Values are clamped to the range; setting the
// current value reports nothing.
export component TokenSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <bool> enabled: true;
    in-out property <float> value: root.minimum;
    in property <ControlColors> colors;
    in property <float> text-scale: 1;
    out property <bool> has-focus: scope.has-focus;
    callback changed(float);
    callback released(float);

    property <bool> thumb-pressed: false;
    property <float> pressed-value: 0;
    property <length> thumb-size: max(20px, 12px * root.text-scale + 8px);
    property <length> travel: max(0px, root.width - root.thumb-size);
    property <float> span: root.maximum - root.minimum;
    property <length> thumb-x: root.span <= 0 ? 0px
        : root.travel * (clamp(root.value, root.minimum, root.maximum) - root.minimum) / root.span;
    property <bool> thumb-hover: touch.has-hover && touch.mouse-x >= root.thumb-x
        && touch.mouse-x <= root.thumb-x + root.thumb-size;
    property <color> track-color: !root.enabled
        ? (StyleTokens.states.control-disabled.present ? StyleTokens.states.control-disabled.color : root.colors.muted)
        : root.colors.accent;

    public function set-value(new-value: float) {
        let clamped = max(root.minimum, min(root.maximum, new-value));
        if root.value == clamped {
            return;
        }
        root.value = clamped;
        root.changed(root.value);
    }
    // The value at a pointer position along the track, centered on the thumb.
    pure function value-at(x: length) -> float {
        root.travel <= 0px ? root.minimum : root.minimum + (x - root.thumb-size / 2) / root.travel * root.span
    }

    min-width: 2 * root.thumb-size;
    min-height: root.thumb-size + 8px;
    preferred-height: self.min-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: scope;
    accessible-role: slider;
    accessible-enabled: root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: min(root.step, (root.maximum - root.minimum) / 100);
    accessible-action-set-value(text) => {
        if root.enabled && text.is-float() {
            root.set-value(text.to-float());
        }
    }
    accessible-action-increment => {
        if root.enabled { root.set-value(root.value + root.step); }
    }
    accessible-action-decrement => {
        if root.enabled { root.set-value(root.value - root.step); }
    }

    rail := Rectangle {
        x: root.thumb-size / 2;
        y: (root.height - self.height) / 2;
        width: max(0px, root.width - root.thumb-size);
        height: 4px;
        border-radius: self.height / 2;
        background: StyleTokens.states.input-border.present ? StyleTokens.states.input-border.color : root.colors.outline;
    }
    Rectangle {
        x: rail.x;
        y: rail.y;
        width: root.thumb-x;
        height: rail.height;
        border-radius: rail.border-radius;
        background: root.track-color;
    }
    thumb := Rectangle {
        x: root.thumb-x;
        y: (root.height - self.height) / 2;
        width: root.thumb-size;
        height: self.width;
        border-radius: StyleTokens.control-radius >= 0px ? min(StyleTokens.control-radius, self.width / 2) : self.width / 2;
        background: root.enabled && root.thumb-pressed && StyleTokens.states.control-pressed.present
            ? StyleTokens.states.control-pressed.color
            : root.enabled && root.thumb-hover && StyleTokens.states.control-hover.present
            ? StyleTokens.states.control-hover.color : root.colors.surface;
        border-width: max(1px, StyleTokens.line-width);
        border-color: root.enabled ? root.colors.outline : root.track-color;
        Rectangle {
            width: parent.width * (root.thumb-pressed ? 0.4 : root.thumb-hover ? 0.6 : 0.5);
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: StyleTokens.control-radius >= 0px ? min(StyleTokens.control-radius, self.width / 2) : self.width / 2;
            background: root.track-color;
        }
    }
    if scope.has-focus : Rectangle {
        x: thumb.x - 3px;
        y: thumb.y - 3px;
        width: thumb.width + 6px;
        height: thumb.height + 6px;
        border-radius: thumb.border-radius + 3px;
        border-width: StyleTokens.focus-width;
        border-color: StyleTokens.roles.focus.present ? StyleTokens.roles.focus.color : root.colors.accent;
        background: transparent;
    }
    scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if !root.enabled || root.step <= 0 {
                return reject;
            }
            if event.text == Key.RightArrow {
                root.set-value(root.value + root.step);
                return accept;
            } else if event.text == Key.LeftArrow {
                root.set-value(root.value - root.step);
                return accept;
            } else if event.text == Key.Home {
                root.set-value(root.minimum);
                return accept;
            } else if event.text == Key.End {
                root.set-value(root.maximum);
                return accept;
            }
            reject
        }
        key-released(event) => {
            if !root.enabled {
                return reject;
            }
            if event.text == Key.RightArrow || event.text == Key.LeftArrow
                || event.text == Key.Home || event.text == Key.End {
                root.released(root.value);
            }
            accept
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button != PointerEventButton.left {
                return;
            }
            if event.kind == PointerEventKind.up {
                if root.thumb-pressed {
                    root.released(root.value);
                }
                root.thumb-pressed = false;
                return;
            }
            if event.kind == PointerEventKind.cancel {
                root.thumb-pressed = false;
                return;
            }
            if event.kind != PointerEventKind.down {
                return;
            }
            // A press away from the thumb moves it there first.
            if !root.thumb-hover {
                root.set-value(root.value-at(self.mouse-x));
            }
            root.pressed-value = root.value;
            scope.focus();
            root.thumb-pressed = true;
        }
        moved => {
            if !self.enabled || !root.thumb-pressed || root.travel <= 0px {
                return;
            }
            root.set-value(root.pressed-value + (self.mouse-x - self.pressed-x) / root.travel * root.span);
        }
    }
}
