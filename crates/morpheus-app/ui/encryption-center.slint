// Encryption center: SAS verification of this device and this account's
// signed-in devices with their trust. Rust owns every state transition and
// decides which actions are allowed; this file only lays them out and reports
// the person's explicit choices. It cannot import the window's globals, so
// the window passes resolved colors.

import { Button, LineEdit } from "std-widgets.slint";

export struct EncryptionPalette {
    ink: color,
    muted: color,
    panel: color,
    elevated: color,
    hover: color,
    accent: color,
    divider: color,
    focus: color,
    error: color,
    success: color,
}

// A keyboard and pointer toggle with caller-supplied visuals.
component CompareToggle inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> checked;
    in property <color> focus-color;
    callback toggled();
    forward-focus: keyboard-focus;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(); } }
    @children
    keyboard-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if root.enabled { root.toggled(); }
                accept
            } else {
                reject
            }
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            keyboard-focus.focus();
            root.toggled();
        }
    }
    if keyboard-focus.has-focus : Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: root.focus-color;
        background: transparent;
    }
}

// Stages: 0 idle, 1 waiting for the request, 2 ready to start, 3 waiting for
// values, 4 comparing, 5 waiting for the other device to finish.
export component SasVerificationPanel inherits Rectangle {
    in property <EncryptionPalette> palette;
    in property <float> text-scale: 1;
    in property <string> number-font;
    // Settings is showing; incoming-request details load only then.
    in property <bool> active;
    in property <int> stage;
    in property <bool> busy;
    in property <bool> request-initiator;
    // Set only by the person, after comparing both devices.
    in-out property <bool> compared;
    in property <string> emoji;
    in property <string> decimals;
    in property <string> error;
    in property <string> notice;
    in property <bool> incoming-pending;
    in property <bool> incoming-loading;
    // Newest pending request seen by the app-wide watcher (an opaque flow
    // ID, never shown). Each change reloads the request details here.
    in property <string> incoming-flow-id;
    // Another security operation owns this account.
    in property <bool> blocked;
    // This device is unverified and no new recovery key is waiting.
    in property <bool> can-request;
    callback poll-incoming();
    callback accept-incoming();
    callback request-own();
    callback refresh();
    callback start();
    callback confirm();
    callback mismatch();
    callback cancel();

    border-radius: 10px;
    background: root.palette.elevated;
    height: content.preferred-height;

    // Flow progress arrives from the SDK's change streams (see
    // src/verification.rs). Incoming requests follow the app-wide watcher:
    // a change seen while a load runs is replayed when it finishes.
    property <bool> incoming-stale;
    function check-incoming() {
        if root.active && root.stage == 0 && !root.blocked {
            if root.incoming-loading {
                root.incoming-stale = true;
            } else {
                root.incoming-stale = false;
                root.poll-incoming();
            }
        }
    }
    changed incoming-flow-id => { root.check-incoming(); }
    changed incoming-loading => {
        if !root.incoming-loading && root.incoming-stale { root.check-incoming(); }
    }
    changed stage => { if root.stage == 0 { root.check-incoming(); } }
    changed blocked => { if !root.blocked { root.check-incoming(); } }
    // Slow fallback in case the watcher is resubscribing.
    Timer {
        interval: 30s;
        running: root.active && root.stage == 0 && !root.incoming-loading && !root.blocked;
        triggered => { root.poll-incoming(); }
    }

    content := VerticalLayout {
        padding: 14px;
        spacing: 7px;
        Text {
            text: "Verify this device";
            color: root.palette.ink;
            font-size: 13px * root.text-scale;
            font-weight: 700;
        }
        if root.stage == 0 : Text {
            text: "Start here, then approve on another signed-in, verified device of this account. Compare the values on both devices before confirming.";
            color: root.palette.muted;
            font-size: 11px * root.text-scale;
            wrap: word-wrap;
        }
        if root.stage == 0 && root.incoming-pending : HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Another device on this account requested verification.";
                color: root.palette.accent;
                font-size: 11px * root.text-scale;
                wrap: word-wrap;
                horizontal-stretch: 1;
                accessible-live-region: polite;
            }
            Button {
                text: root.busy ? "Accepting…" : "Review request";
                enabled: !root.busy && !root.blocked;
                accessible-label: "Accept incoming verification request from another device on this account";
                clicked => { root.accept-incoming(); }
            }
        }
        if root.stage == 0 : HorizontalLayout {
            alignment: start;
            Button {
                text: root.busy ? "Starting…" : "Verify with another device";
                enabled: !root.busy && root.can-request;
                accessible-label: "Request SAS verification from another device on this Matrix account";
                clicked => { root.request-own(); }
            }
        }
        if root.stage != 0 : Text {
            text: root.stage == 1 ? (root.request-initiator
                ? "Approve the verification request on your other device. Morpheus shows its response as soon as it arrives."
                : "Request accepted. Waiting for the requesting device to start the comparison.")
                : root.stage == 2 ? "The other device accepted. Start the short authentication string comparison."
                : root.stage == 3 ? "Waiting for the other device to accept the comparison. Keep both devices open."
                : root.stage == 4 ? "Compare every shown emoji or all three numbers with the other device. Confirm only if they match exactly."
                : "Your confirmation was sent. Waiting for the other device to finish.";
            color: root.palette.muted;
            font-size: 11px * root.text-scale;
            wrap: word-wrap;
            accessible-live-region: polite;
        }
        if root.stage == 4 && root.emoji != "" : Text {
            text: root.emoji;
            color: root.palette.ink;
            font-size: 14px * root.text-scale;
            wrap: word-wrap;
            accessible-label: "SAS emoji comparison: " + root.emoji;
        }
        if root.stage == 4 && root.decimals != "" : Text {
            text: "Numbers: " + root.decimals;
            color: root.palette.ink;
            font-family: root.number-font;
            font-size: 14px * root.text-scale;
            accessible-label: "SAS number comparison: " + root.decimals;
        }
        if root.stage == 4 : CompareToggle {
            height: 38px;
            border-radius: 7px;
            background: root.compared ? root.palette.hover : root.palette.panel;
            border-color: root.compared ? root.palette.accent : root.palette.divider;
            border-width: 1px;
            focus-color: root.palette.focus;
            label: "I compared these values on both devices and they match exactly";
            checked: root.compared;
            enabled: !root.busy;
            toggled => { root.compared = !root.compared; }
            Text {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text: (root.compared ? "✓ " : "○ ") + "I compared both devices; the values match";
                color: root.palette.ink;
                font-size: 11px * root.text-scale;
                vertical-alignment: center;
            }
        }
        if root.error != "" : Text {
            text: root.error;
            color: root.palette.error;
            font-size: 11px * root.text-scale;
            wrap: word-wrap;
            accessible-live-region: polite;
        }
        if root.notice != "" : Text {
            text: root.notice;
            color: root.palette.success;
            font-size: 11px * root.text-scale;
            wrap: word-wrap;
            accessible-live-region: polite;
        }
        if root.stage != 0 : HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if root.stage == 1 || root.stage == 3 || root.stage == 5 : Button {
                text: root.busy ? "Checking…" : "Check status";
                enabled: !root.busy;
                accessible-label: "Check device verification progress";
                clicked => { root.refresh(); }
            }
            if root.stage == 2 : Button {
                text: root.busy ? "Starting…" : "Start comparison";
                enabled: !root.busy;
                accessible-label: "Start or accept SAS comparison on this device";
                clicked => { root.start(); }
            }
            if root.stage == 4 : Button {
                text: root.busy ? "Confirming…" : "Confirm match";
                primary: true;
                enabled: root.compared && !root.busy;
                accessible-label: "Confirm that SAS values match on both devices";
                clicked => { root.confirm(); }
            }
            if root.stage == 4 : Button {
                text: root.busy ? "Reporting…" : "They don't match";
                enabled: !root.busy;
                accessible-label: "The values differ: stop verification on both devices without trusting either";
                clicked => { root.mismatch(); }
            }
            Button {
                text: "Cancel verification";
                enabled: !root.busy;
                accessible-label: "Cancel this verification request";
                clicked => { root.cancel(); }
            }
        }
    }
}

// Shown outside Settings when another device of this account asks to
// verify this one. Reviewing opens the verification panel; nothing is
// accepted or trusted from here.
export component VerificationRequestBanner inherits Rectangle {
    in property <EncryptionPalette> palette;
    in property <float> text-scale: 1;
    callback review();
    callback dismiss();

    background: root.palette.panel;
    height: row.preferred-height;

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;
        Text {
            text: "Another of your devices asked to verify this one.";
            color: root.palette.ink;
            font-size: 11px * root.text-scale;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
            accessible-live-region: polite;
        }
        Button {
            text: "Review";
            accessible-label: "Review the verification request in Security settings";
            clicked => { root.review(); }
        }
        Button {
            text: "Not now";
            accessible-label: "Hide this verification request notice";
            clicked => { root.dismiss(); }
        }
    }
}

// Warns that a member of the open room has a changed identity. Accepting a
// changed identity or withdrawing a lost verification is the person's
// explicit choice; there is no dismiss, because the warning stays until the
// identity is resolved.
export component IdentityWarningBanner inherits Rectangle {
    in property <EncryptionPalette> palette;
    in property <float> text-scale: 1;
    // Display name, or the user ID when the member has none.
    in property <string> name;
    // 1: the identity changed; 2: a verified identity changed.
    in property <int> kind;
    // Further members with a warning in this room.
    in property <int> others;
    in property <bool> busy;
    in property <string> error;
    callback acknowledge();

    background: root.palette.panel;
    height: row.preferred-height;

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: (root.kind == 2
                    ? root.name + "'s verified identity has changed. Messages stay encrypted, but confirm the change with them before trusting it."
                    : root.name + "'s identity has changed. Messages stay encrypted, but confirm the change with them another way before sharing anything sensitive.")
                    + (root.others == 1 ? " One more member's identity also changed." : root.others > 1 ? " " + root.others + " more members' identities also changed." : "");
                color: root.kind == 2 ? root.palette.error : root.palette.ink;
                font-size: 11px * root.text-scale;
                wrap: word-wrap;
                accessible-live-region: polite;
            }
            if root.error != "" : Text {
                text: root.error;
                color: root.palette.error;
                font-size: 11px * root.text-scale;
                wrap: word-wrap;
                accessible-live-region: polite;
            }
        }
        Button {
            text: root.busy ? "Saving…" : root.kind == 2 ? "Withdraw verification" : "Accept change";
            enabled: !root.busy;
            accessible-label: (root.kind == 2 ? "Withdraw the lost verification of " : "Accept the changed identity of ") + root.name;
            clicked => { root.acknowledge(); }
        }
    }
}

export struct TrustedDeviceItem {
    // Opaque Matrix device ID; it only names the Verify target.
    device-id: string,
    // Display form of the device ID.
    shown-id: string,
    name: string,
    trust: string,
    detail: string,
    verified: bool,
    current: bool,
    can-verify: bool,
}

// Rename and sign-out are explicit per-row actions. Rust validates every
// target against the loaded list and owns the authentication challenge; the
// password field here is cleared before it is handed over. This device's row
// only offers the normal logout.
export component EncryptionDevices inherits Rectangle {
    in property <EncryptionPalette> palette;
    in property <float> text-scale: 1;
    in property <[TrustedDeviceItem]> devices;
    in property <bool> loading;
    // Another security operation owns this account; Verify waits for it.
    in property <bool> busy;
    in property <string> error;
    in property <string> notice;
    // The row being renamed (its device ID) and the draft name.
    in property <string> rename-id;
    in-out property <string> rename-input;
    in property <bool> rename-busy;
    // Sign-out stages: 0 closed, 1 confirm, 2 working, 3 password, 4 browser
    // confirmation, 5 provider's device page, 6 blocked, 7 this device.
    in property <int> signout-stage;
    in property <string> signout-name;
    in property <string> signout-shown-id;
    in-out property <string> signout-password;
    in property <string> signout-message;
    in property <bool> signout-page-opened;
    // Settings search: each new positive value reveals and focuses Refresh,
    // or the status line while Refresh is unavailable.
    in property <int> reveal-request;
    callback refresh();
    callback verify-device(string);
    callback start-rename(string);
    callback save-rename(string, string);
    callback cancel-rename();
    callback open-signout(string);
    callback confirm-signout();
    callback submit-signout-password(string);
    callback open-signout-page();
    callback continue-signout();
    callback cancel-signout();
    // Hands this device to the window's normal guarded logout.
    callback logout-this-device();
    // Asks the settings page to scroll an absolute y position into view.
    callback reveal-at(length);
    callback revealed(string);

    border-radius: 10px;
    background: root.palette.elevated;
    height: content.preferred-height;

    changed reveal-request => {
        if root.reveal-request > 0 {
            root.reveal-at(refresh-button.absolute-position.y);
            if refresh-button.enabled {
                refresh-button.focus();
                if refresh-button.has-focus { root.revealed("security.devices"); }
            } else {
                status-field.focus();
                if status-field.has-focus { root.revealed("security.devices:status"); }
            }
        }
    }

    content := VerticalLayout {
        padding: 14px;
        spacing: 7px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Devices on this account";
                color: root.palette.ink;
                font-size: 13px * root.text-scale;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            refresh-button := Button {
                text: root.loading ? "Loading…" : "Refresh";
                enabled: !root.loading;
                accessible-label: "Refresh this account's device list";
                clicked => { root.refresh(); }
                changed has-focus => {
                    if self.has-focus { root.reveal-at(self.absolute-position.y); }
                }
            }
        }
        // Read-only and focusable, so search can reveal it while Refresh is busy.
        status-field := TextInput {
            text: root.loading ? "Loading this account's devices…"
                : root.devices.length == 0 ? "No device list loaded yet. Choose Refresh."
                : "Verify only devices you recognize and sign out any you don't. Compare the emoji or numbers on both devices before confirming.";
            read-only: true;
            single-line: false;
            wrap: word-wrap;
            color: root.palette.muted;
            font-size: 11px * root.text-scale;
            accessible-label: "Device list status: " + self.text;
        }
        if root.error != "" : Text {
            text: root.error;
            color: root.palette.error;
            font-size: 11px * root.text-scale;
            wrap: word-wrap;
            accessible-live-region: polite;
        }
        if root.notice != "" : Text {
            text: root.notice;
            color: root.palette.ink;
            font-size: 11px * root.text-scale;
            wrap: word-wrap;
            accessible-live-region: polite;
        }
        if root.signout-stage != 0 : Rectangle {
            border-radius: 8px;
            background: root.palette.panel;
            border-width: 1px;
            border-color: root.palette.accent;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Text {
                    text: root.signout-stage == 7 ? "Log out of this device" : "Sign out " + root.signout-name;
                    color: root.palette.ink;
                    font-size: 12px * root.text-scale;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                // The confirmation always names the exact target.
                Text {
                    text: root.signout-name + "  ·  Device ID " + root.signout-shown-id;
                    color: root.palette.muted;
                    font-size: 11px * root.text-scale;
                    wrap: word-wrap;
                }
                Text {
                    text: root.signout-stage == 1 ? "That device will be signed out of your account and must sign in again. It can read encrypted messages again only after it recovers its keys or is verified."
                        : root.signout-stage == 2 ? "Asking your homeserver to sign out that device…"
                        : root.signout-stage == 3 ? "Your homeserver asks for your account password to confirm. Morpheus uses it only for this request and never saves it."
                        : root.signout-stage == 4 ? "Your homeserver asks you to confirm in your web browser. Open its page, finish there, then continue here."
                        : root.signout-stage == 5 ? "Your account provider manages devices on its own page. Sign the device out there, then refresh the list here to see the result."
                        : root.signout-stage == 6 ? "Morpheus cannot sign out that device from here."
                        : "Morpheus does not sign out the device you are using from this list. Log out instead; it runs the usual checks first.";
                    color: root.palette.ink;
                    font-size: 11px * root.text-scale;
                    wrap: word-wrap;
                    accessible-live-region: polite;
                }
                if root.signout-message != "" : Text {
                    text: root.signout-message;
                    color: root.palette.error;
                    font-size: 11px * root.text-scale;
                    wrap: word-wrap;
                    accessible-live-region: polite;
                }
                if root.signout-stage == 3 : LineEdit {
                    text <=> root.signout-password;
                    input-type: password;
                    placeholder-text: "Account password";
                    accessible-label: "Account password to confirm signing out " + root.signout-name;
                    init => { self.focus(); }
                    accepted => {
                        if root.signout-password != "" {
                            let secret = root.signout-password;
                            root.signout-password = "";
                            root.submit-signout-password(secret);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    if root.signout-stage == 1 : Button {
                        text: "Sign out device";
                        enabled: !root.busy;
                        accessible-label: "Sign out " + root.signout-name + " from this account";
                        clicked => { root.confirm-signout(); }
                    }
                    if root.signout-stage == 3 : Button {
                        text: "Confirm";
                        enabled: !root.busy && root.signout-password != "";
                        accessible-label: "Confirm signing out " + root.signout-name + " with your password";
                        clicked => {
                            let secret = root.signout-password;
                            root.signout-password = "";
                            root.submit-signout-password(secret);
                        }
                    }
                    if root.signout-stage == 4 || root.signout-stage == 5 : Button {
                        text: root.signout-page-opened ? "Open page again" : "Open page in browser";
                        accessible-label: "Open the confirmation page in your web browser";
                        clicked => { root.open-signout-page(); }
                    }
                    if root.signout-stage == 4 : Button {
                        text: "Continue";
                        enabled: root.signout-page-opened;
                        accessible-label: "Continue after confirming in your web browser";
                        clicked => { root.continue-signout(); }
                    }
                    if root.signout-stage == 5 : Button {
                        text: "Refresh list";
                        enabled: root.signout-page-opened;
                        accessible-label: "Close this and refresh the device list";
                        clicked => { root.continue-signout(); }
                    }
                    if root.signout-stage == 7 : Button {
                        text: "Log out";
                        accessible-label: "Log out of Morpheus on this device";
                        clicked => { root.logout-this-device(); }
                    }
                    Button {
                        text: root.signout-stage == 6 ? "Close" : "Cancel";
                        accessible-label: root.signout-stage == 6 ? "Close this message" : "Do not sign out the device";
                        clicked => {
                            root.signout-password = "";
                            root.cancel-signout();
                        }
                    }
                }
            }
        }
        for device in root.devices : Rectangle {
            border-radius: 8px;
            background: root.palette.panel;
            border-width: device.verified ? 0px : 1px;
            border-color: root.palette.divider;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: device.current ? device.name + " · this device" : device.name;
                            color: root.palette.ink;
                            font-size: 12px * root.text-scale;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        Text {
                            text: device.trust + "  ·  " + device.shown-id;
                            color: device.verified ? root.palette.success : root.palette.muted;
                            font-size: 11px * root.text-scale;
                            wrap: word-wrap;
                        }
                        Text {
                            text: device.detail;
                            color: root.palette.muted;
                            font-size: 11px * root.text-scale;
                            wrap: word-wrap;
                        }
                    }
                    if device.can-verify : Button {
                        text: "Verify";
                        enabled: !root.busy && !root.loading;
                        accessible-label: "Verify " + device.name + " by comparing emoji or numbers";
                        clicked => { root.verify-device(device.device-id); }
                    }
                }
                if root.rename-id == device.device-id : VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text: root.rename-input;
                            enabled: !root.rename-busy;
                            placeholder-text: "Device name";
                            accessible-label: "New name for " + device.name;
                            init => { self.focus(); }
                            edited(text) => { root.rename-input = text; }
                            accepted(text) => { root.save-rename(device.device-id, text); }
                        }
                        Button {
                            text: root.rename-busy ? "Saving…" : "Save";
                            enabled: !root.rename-busy && root.rename-input != "";
                            accessible-label: "Save the new name for " + device.name;
                            clicked => { root.save-rename(device.device-id, root.rename-input); }
                        }
                        Button {
                            text: "Cancel";
                            enabled: !root.rename-busy;
                            accessible-label: "Keep the current name of " + device.name;
                            clicked => { root.cancel-rename(); }
                        }
                    }
                    Text {
                        text: "Up to 64 characters. People you talk to may be able to see device names.";
                        color: root.palette.muted;
                        font-size: 11px * root.text-scale;
                        wrap: word-wrap;
                    }
                }
                if root.rename-id != device.device-id : HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Rename";
                        enabled: !root.loading && !root.rename-busy && root.signout-stage == 0;
                        accessible-label: "Rename " + device.name;
                        clicked => { root.start-rename(device.device-id); }
                    }
                    Button {
                        text: device.current ? "Log out…" : "Sign out…";
                        enabled: !root.loading && !root.busy && !root.rename-busy && root.signout-stage == 0;
                        accessible-label: device.current ? "Log out of Morpheus on this device" : "Sign out " + device.name + " from this account";
                        clicked => { root.open-signout(device.device-id); }
                    }
                }
            }
        }
    }
}
