// Create a native Matrix poll in the current room. Rust owns the draft and
// its validation; opening the dialog or editing it never sends anything, only
// Send does. It cannot import the window's globals, so the window passes
// resolved colors and surfaces.

import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";
import { PollPalette, PollUiState } from "poll-card.slint";

export component PollCreateDialog inherits FocusScope {
    in property <PollPalette> palette;
    in property <float> text-scale: 1;
    in property <length> corner: 10px;
    in property <color> surface;
    in property <color> scrim;

    focus-on-tab-navigation: false;
    init => { question.focus(); }
    // Keep Tab inside the dialog: the question field is first, Send (or
    // Cancel while Send is unavailable) is last.
    capture-key-pressed(event) => {
        if PollUiState.dialog-busy && (event.text == Key.Tab || event.text == Key.Backtab) {
            accept
        } else if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && question.has-focus {
            if send.enabled {
                send.focus();
            } else {
                cancel.focus();
            }
            accept
        } else if event.text == Key.Tab && !event.modifiers.shift && (send.has-focus || (cancel.has-focus && !send.enabled)) {
            question.focus();
            accept
        } else {
            reject
        }
    }
    key-pressed(event) => {
        if event.text == Key.Escape && !PollUiState.dialog-busy {
            PollUiState.cancel-poll();
            accept
        } else {
            reject
        }
    }

    Rectangle {
        background: root.scrim;
        TouchArea { }
        Rectangle {
            width: min(520px * root.text-scale, parent.width - 32px);
            height: min(620px * root.text-scale, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.surface;
            border-radius: root.corner * 1.4;
            border-width: 1px;
            border-color: root.palette.divider;
            accessible-role: region;
            accessible-label: "Create a poll";
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text {
                    text: "Create a poll";
                    color: root.palette.ink;
                    font-size: 21px * root.text-scale;
                    font-weight: 750;
                }
                Text {
                    text: "In " + PollUiState.dialog-room + ". Nothing is sent until you choose Send poll.";
                    color: root.palette.muted;
                    font-size: 11px * root.text-scale;
                    wrap: word-wrap;
                }
                body := ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: body.visible-width;
                        spacing: 8px;
                        Text {
                            text: "Question";
                            color: root.palette.ink;
                            font-size: 12px * root.text-scale;
                            font-weight: 650;
                            accessible-role: none;
                        }
                        question := LineEdit {
                            text: PollUiState.dialog-question;
                            placeholder-text: "Ask a question";
                            enabled: !PollUiState.dialog-busy;
                            accessible-label: "Poll question";
                            edited(text) => { PollUiState.question-edited(text); }
                        }
                        Text {
                            text: "Options";
                            color: root.palette.ink;
                            font-size: 12px * root.text-scale;
                            font-weight: 650;
                            accessible-role: none;
                        }
                        for answer[index] in PollUiState.dialog-answers : HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                text: answer;
                                placeholder-text: "Option " + (index + 1);
                                enabled: !PollUiState.dialog-busy;
                                accessible-label: "Poll option " + (index + 1);
                                edited(text) => { PollUiState.answer-edited(index, text); }
                            }
                            Button {
                                text: "Remove";
                                enabled: !PollUiState.dialog-busy && PollUiState.dialog-answers.length > 2;
                                accessible-label: "Remove poll option " + (index + 1);
                                clicked => { PollUiState.remove-answer(index); }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Add option";
                                enabled: !PollUiState.dialog-busy && PollUiState.dialog-answers.length < 20;
                                accessible-label: "Add a poll option";
                                clicked => { PollUiState.add-answer(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "People can choose up to";
                                color: root.palette.ink;
                                font-size: 12px * root.text-scale;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                            Button {
                                text: "−";
                                enabled: !PollUiState.dialog-busy && PollUiState.dialog-max > 1;
                                accessible-label: "Allow fewer choices per person";
                                clicked => { PollUiState.change-max(-1); }
                            }
                            Text {
                                text: PollUiState.dialog-max == 1 ? "1 option" : PollUiState.dialog-max + " options";
                                color: root.palette.ink;
                                font-size: 12px * root.text-scale;
                                vertical-alignment: center;
                                accessible-label: "People can choose up to " + self.text;
                                accessible-live-region: polite;
                            }
                            Button {
                                text: "+";
                                enabled: !PollUiState.dialog-busy && PollUiState.dialog-max < PollUiState.dialog-answers.length;
                                accessible-label: "Allow more choices per person";
                                clicked => { PollUiState.change-max(1); }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                        CheckBox {
                            text: "Show results while the poll is open";
                            checked: PollUiState.dialog-disclosed;
                            enabled: !PollUiState.dialog-busy;
                            toggled => { PollUiState.set-disclosed(self.checked); }
                        }
                        Text {
                            text: PollUiState.dialog-disclosed
                                ? "Everyone in the room sees the votes as they arrive."
                                : "Morpheus keeps the results hidden until you end the poll. Other apps may show them sooner.";
                            color: root.palette.muted;
                            font-size: 11px * root.text-scale;
                            wrap: word-wrap;
                        }
                    }
                }
                if PollUiState.dialog-error != "" : Text {
                    text: PollUiState.dialog-error;
                    color: root.palette.error;
                    font-size: 11px * root.text-scale;
                    wrap: word-wrap;
                    accessible-live-region: polite;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    cancel := Button {
                        text: "Cancel";
                        enabled: !PollUiState.dialog-busy;
                        accessible-label: "Cancel and close the poll dialog";
                        clicked => { PollUiState.cancel-poll(); }
                    }
                    send := Button {
                        text: PollUiState.dialog-busy ? "Sending…" : "Send poll";
                        primary: true;
                        enabled: !PollUiState.dialog-busy && PollUiState.dialog-ready;
                        accessible-label: "Send this poll to the room";
                        clicked => { PollUiState.submit-poll(); }
                    }
                }
            }
        }
    }
}
