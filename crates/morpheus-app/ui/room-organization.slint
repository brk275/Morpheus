import { StyleTokens } from "style-tokens.slint";
import { HoverSurface } from "controls.slint";

// Matrix room organization (Favorites and Low priority) for the visible
// account. Rust (room_organization) owns every value in
// RoomOrganizationState; this file only presents it and reports choices.

// Menu actions: 0 add to Favorites, 1 remove from Favorites, 2 mark as low
// priority, 3 normal priority, 4 move up in Favorites, 5 move down.
export global RoomOrganizationState {
    // Section presentation for this session only; nothing is saved.
    in-out property <bool> favourites-collapsed: false;
    in-out property <bool> low-priority-collapsed: false;
    // The room whose change waits for the homeserver, for the visible
    // account; while set, every organization menu is disabled.
    in-out property <string> pending-room;
    // The open room, for the room header menu.
    in-out property <bool> active-favourite: false;
    in-out property <bool> active-low-priority: false;
    in-out property <bool> active-can-move-up: false;
    in-out property <bool> active-can-move-down: false;
    // Room ID and action.
    callback organize(string, int);
    // Header menus capture a one-use capability for their account selection.
    callback capture-header-menu(string) -> string;
    callback organize-header(string, int, string);
    // The open room changed; the header menu state is republished.
    callback active-room-changed();
}

// A collapsible section title in the room list.
export component RoomSectionHeader inherits Rectangle {
    in property <string> title;
    in property <int> count;
    in property <bool> collapsed;
    in property <float> text-scale: 1;
    in property <color> muted;
    in property <color> focus-color;
    callback toggle();

    height: max(29px, 18px * root.text-scale);
    forward-focus: section-focus;
    accessible-role: button;
    accessible-label: root.title + ", " + root.count + (root.count == 1 ? " room" : " rooms");
    accessible-expandable: true;
    accessible-expanded: !root.collapsed;
    accessible-action-default => {
        root.toggle();
    }
    accessible-action-expand => {
        if root.collapsed {
            root.toggle();
        }
    }

    Text {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text: (root.collapsed ? "▸  " : "▾  ") + root.title + " · " + root.count;
        color: root.muted;
        font-size: 10px * root.text-scale;
        font-weight: 750;
        letter-spacing: 1px;
        vertical-alignment: bottom;
        overflow: elide;
        accessible-role: none;
    }
    section-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        focus-on-click: true;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggle();
                accept
            } else {
                reject
            }
        }
    }
    TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        mouse-cursor: pointer;
        clicked => {
            section-focus.focus();
            root.toggle();
        }
    }
    if section-focus.has-focus: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        border-radius: 6px;
        border-width: 2px;
        border-color: root.focus-color;
        background: transparent;
    }
}

// The open room's organization menu in the room header. Return, Space,
// the Menu key, Shift+F10, a click or a right click opens it; the menu
// itself is keyboard navigable.
export component RoomOrganizationButton inherits Rectangle {
    in property <string> room-id;
    in property <string> room-name;
    in property <string> account-context;
    in property <bool> enabled: true;
    in property <color> ink;
    in property <color> hover;
    in property <color> focus-color;
    in property <length> radius: 9px;

    property <bool> choosable: root.enabled && RoomOrganizationState.pending-room == "";
    // The room the open menu was shown for; its choices act on that room
    // even if another room opens meanwhile.
    property <string> menu-room;
    property <string> menu-token;

    changed account-context => {
        root.menu-room = ""; root.menu-token = ""; room-menu.close();
    }
    changed enabled => {
        if !root.enabled { root.menu-room = ""; root.menu-token = ""; room-menu.close(); }
    }

    function open-menu(position: Point) {
        room-menu.close();
        root.menu-room = root.room-id;
        root.menu-token = RoomOrganizationState.capture-header-menu(root.menu-room);
        if root.menu-token != "" { room-menu.show(position); }
    }

    function activate-menu(action: int) {
        if root.choosable && root.menu-room != "" && root.menu-token != "" {
            let token = root.menu-token;
            root.menu-token = "";
            RoomOrganizationState.organize-header(root.menu-room, action, token);
        }
    }

    width: 34px;
    height: 34px;
    property <length> glyph-size: min(StyleTokens.icon-size, max(18px, min(root.width, root.height) - 6px));
    border-radius: StyleTokens.control-radius >= 0px ? StyleTokens.control-radius : root.radius;
    background: transparent;
    HoverSurface {
        width: root.width; height: root.height; border-radius: root.border-radius;
        highlighted: root.enabled && button-hit.has-hover;
        background: StyleTokens.states.control-hover.present ? StyleTokens.states.control-hover.color : root.hover;
    }
    Rectangle {
        width: root.width; height: root.height; border-radius: root.border-radius;
        background: root.enabled && button-hit.pressed && StyleTokens.states.control-pressed.present ? StyleTokens.states.control-pressed.color : transparent;
    }
    forward-focus: button-focus;
    accessible-role: button;
    accessible-label: "Organize " + root.room-name + (RoomOrganizationState.active-favourite ? ", in Favorites" : (RoomOrganizationState.active-low-priority ? ", low priority" : ""));
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.choosable {
            root.open-menu({ x: 0px, y: root.height });
        }
    }

    room-menu := ContextMenuArea {
        enabled: root.choosable;
        // Each item sends only the action its title states, for the room
        // the menu was shown for. The menu keeps the items it was shown
        // with: if the room's tags change meanwhile, an outdated item still
        // sends its action, which changes nothing when the room already has
        // that result.
        Menu {
            if !RoomOrganizationState.active-favourite: MenuItem {
                title: "Add to Favorites";
                activated => {
                    root.activate-menu(0);
                }
            }
            if RoomOrganizationState.active-favourite: MenuItem {
                title: "Remove from Favorites";
                activated => {
                    root.activate-menu(1);
                }
            }
            if !RoomOrganizationState.active-low-priority: MenuItem {
                title: "Mark as low priority";
                activated => {
                    root.activate-menu(2);
                }
            }
            if RoomOrganizationState.active-low-priority: MenuItem {
                title: "Normal priority";
                activated => {
                    root.activate-menu(3);
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Move up in Favorites";
                enabled: RoomOrganizationState.active-favourite && RoomOrganizationState.active-can-move-up;
                activated => {
                    root.activate-menu(4);
                }
            }
            MenuItem {
                title: "Move down in Favorites";
                enabled: RoomOrganizationState.active-favourite && RoomOrganizationState.active-can-move-down;
                activated => {
                    root.activate-menu(5);
                }
            }
        }
        Text {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            text: RoomOrganizationState.active-favourite ? "★" : "☆";
            color: !root.enabled && StyleTokens.states.control-disabled.present ? StyleTokens.states.control-disabled.color : root.ink;
            font-size: root.glyph-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        button-focus := FocusScope {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            focus-on-click: true;
            enabled: root.enabled;
            key-pressed(event) => {
                if event.text == Key.Space || event.text == Key.Return || event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10) {
                    if root.choosable {
                        root.open-menu({ x: 0px, y: root.height });
                    }
                    accept
                } else {
                    reject
                }
            }
        }
        button-hit := TouchArea {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                button-focus.focus();
                if root.choosable {
                    root.open-menu({ x: 0px, y: root.height });
                }
            }
            // This area takes every button, so the menu area under it never
            // sees a right click; open the menu here instead.
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.choosable {
                    root.open-menu({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
        if button-focus.has-focus: Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            border-radius: root.radius;
            border-width: 2px;
            border-color: root.focus-color;
            background: transparent;
        }
    }
}
