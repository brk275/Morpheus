+namespace {
+
+struct KeyLogObservation {
+  bool rendered_material = false;
+  int hkdf_size_records = 0;
+  int pbkdf2_size_records = 0;
+};
+
+class KeyDerivationTestLogSink : public LogSink {
+ public:
+  KeyDerivationTestLogSink() { LogMessage::AddLogToStream(this, LS_VERBOSE); }
+  ~KeyDerivationTestLogSink() override { Close(); }
+  void Close() {
+    if (!closed_) {
+      LogMessage::RemoveLogToStream(this);
+      closed_ = true;
+    }
+  }
+  void OnLogMessage(const std::string& message, LoggingSeverity severity) override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    observed_.rendered_material |=
+        message.find("secret [") != std::string::npos ||
+        message.find("raw_key [") != std::string::npos ||
+        message.find("derived_key [") != std::string::npos;
+    if (severity == LS_VERBOSE) {
+      observed_.hkdf_size_records +=
+          message.find("Derived HKDF-SHA256 key, secret len ") != std::string::npos;
+      observed_.pbkdf2_size_records +=
+          message.find("Derived PBKDF2 key, raw key len ") != std::string::npos;
+    }
+  }
+  void OnLogMessage(const std::string& message) override {}
+  KeyLogObservation observed() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return observed_;
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  bool closed_ = false;
+  KeyLogObservation observed_;
+};
+
+}  // namespace
+
+TEST(KeyProvider, DerivationLogsOnlySizesForBothAlgorithms) {
+  KeyDerivationTestLogSink sink;
+  bool imported = true;
+  for (auto algorithm : {kHKDF, kPBKDF2}) {
+    KeyProviderOptions options;
+    options.key_derivation_algorithm = algorithm;
+    auto provider = make_ref_counted<DefaultKeyProviderImpl>(options);
+    imported &= provider->SetKey("synthetic", 0, std::vector<uint8_t>(32, 0x42));
+  }
+  // RemoveLogToStream guarantees callbacks have ceased. No log message text
+  // or synthetic key bytes are stored or printed by this test sink.
+  sink.Close();
+  const auto observed = sink.observed();
+  EXPECT_TRUE(imported);
+  EXPECT_FALSE(observed.rendered_material);
+  EXPECT_EQ(observed.hkdf_size_records, 1);
+  EXPECT_EQ(observed.pbkdf2_size_records, 1);
+}
+
 }  // namespace webrtc
