+// End-to-end through the same private native decrypt path as real receivers.
+// Frames own their mock data; callbacks own synchronized observations. No
+// asynchronous SetData writes into test-stack vectors or pre-wait copies.
+using Direction = TransformableFrameInterface::Direction;
+using MediaType = FrameCryptorTransformer::MediaType;
+
+class Sink : public TransformedFrameCallback {
+ public:
+  void OnTransformedFrame(
+      std::unique_ptr<TransformableFrameInterface> frame) override {
+    auto data = frame->GetData();
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      frames_.emplace_back(data.begin(), data.end());
+    }
+    event.Set();
+  }
+  void StartShortCircuiting() override {}
+  std::vector<std::vector<uint8_t>> frames() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return frames_;
+  }
+  Event event;
+
+ private:
+  mutable std::mutex mutex_;
+  std::vector<std::vector<uint8_t>> frames_;
+};
+
+class Observer : public FrameCryptorTransformerObserver {
+ public:
+  void OnFrameCryptionStateChanged(const std::string participant_id,
+                                  FrameCryptionState state) override {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      states_.push_back(state);
+    }
+    event.Set();
+  }
+  std::vector<FrameCryptionState> states() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return states_;
+  }
+  Event event;
+
+ private:
+  mutable std::mutex mutex_;
+  std::vector<FrameCryptionState> states_;
+};
+
+struct Observation {
+  bool started;
+  std::vector<std::vector<uint8_t>> frames;
+  std::vector<FrameCryptionState> states;
+};
+
+// Retains both native threads and their actual frame/callback owners until
+// Finish. Every test calls Finish before checking its observations; the
+// destructor also closes the exact same owners after an early return.
+class NativeTransform {
+ public:
+  explicit NativeTransform(MediaType media, bool with_key = false,
+                           bool enabled = true, bool discard = false)
+      : media_(media),
+        signaling_thread_(Thread::Create()),
+        sink_(make_ref_counted<Sink>()),
+        observer_(make_ref_counted<Observer>()) {
+    video_header_.codec = VideoCodecType::kVideoCodecVP8;
+    KeyProviderOptions options;
+    options.shared_key = true;
+    options.discard_frame_when_cryptor_not_ready = discard;
+    options.key_derivation_algorithm = kHKDF;
+    provider_ = make_ref_counted<DefaultKeyProviderImpl>(options);
+    provider_->SetSifTrailer(trailer_);
+    if (with_key) provider_->SetSharedKey(0, std::vector<uint8_t>(32, 0x42));
+    started_ = signaling_thread_->Start();
+    if (!started_) return;
+    transformer_ = scoped_refptr<FrameCryptorTransformer>(
+        new FrameCryptorTransformer(signaling_thread_.get(), "remote", media_,
+                                   FrameCryptorTransformer::Algorithm::kAesGcm,
+                                   provider_));
+    transformer_->SetEnabled(enabled);
+    transformer_->RegisterFrameCryptorTransformerObserver(observer_);
+    interface_ = transformer_;
+    if (media_ == MediaType::kAudioFrame) {
+      interface_->RegisterTransformedFrameCallback(sink_);
+    } else {
+      interface_->RegisterTransformedFrameSinkCallback(sink_, kSsrc);
+    }
+  }
+
+  ~NativeTransform() { Finish(); }
+
+  bool Submit(std::vector<uint8_t> data, bool with_trailer = true,
+              Direction direction = Direction::kReceiver) {
+    if (!started_ || !interface_) return false;
+    if (with_trailer) data.insert(data.end(), trailer_.begin(), trailer_.end());
+    completed_ = std::make_shared<Event>();
+    // Only frame actions retain this buffer after Submit returns. Its final
+    // release proves the real native operation consumed/dropped the frame,
+    // including branches which deliberately produce no callback.
+    auto owned_data = std::shared_ptr<std::vector<uint8_t>>(
+        new std::vector<uint8_t>(std::move(data)),
+        [completed = completed_](std::vector<uint8_t>* bytes) {
+          delete bytes;
+          completed->Set();
+        });
+    if (media_ == MediaType::kAudioFrame) {
+      auto frame = std::make_unique<NiceMock<MockTransformableAudioFrame>>();
+      SetDefaults(*frame, owned_data, direction);
+      interface_->Transform(std::move(frame));
+    } else {
+      auto frame = std::make_unique<NiceMock<MockTransformableVideoFrame>>();
+      SetDefaults(*frame, owned_data, direction);
+      ON_CALL(*frame, IsKeyFrame()).WillByDefault(Return(true));
+      ON_CALL(*frame, header()).WillByDefault(ReturnRef(video_header_));
+      interface_->Transform(std::move(frame));
+    }
+    return true;
+  }
+
+  bool WaitForRetirement() {
+    return completed_ && completed_->Wait(TimeDelta::Seconds(5));
+  }
+  bool WaitForFrame() { return sink_->event.Wait(TimeDelta::Seconds(5)); }
+  bool WaitForState() { return observer_->event.Wait(TimeDelta::Seconds(5)); }
+
+  Observation Finish() {
+    // Keep the registered sink/observer alive until the crypto worker has
+    // joined, including timeout failure paths with a still-pending frame.
+    interface_ = nullptr;
+    transformer_ = nullptr;
+    // Retire posted observer callbacks and then their queue-owned captures.
+    if (signaling_thread_) {
+      signaling_thread_->Stop();
+      signaling_thread_.reset();
+    }
+    provider_ = nullptr;
+    return Observation{started_, sink_->frames(), observer_->states()};
+  }
+
+ private:
+  template <typename Frame>
+  void SetDefaults(Frame& frame,
+                   std::shared_ptr<std::vector<uint8_t>> data,
+                   Direction direction) {
+    ON_CALL(frame, GetDirection()).WillByDefault(Return(direction));
+    ON_CALL(frame, GetSsrc()).WillByDefault(Return(kSsrc));
+    ON_CALL(frame, GetTimestamp()).WillByDefault(Return(123456));
+    ON_CALL(frame, GetData()).WillByDefault([data] {
+      return ArrayView<const uint8_t>(*data);
+    });
+    ON_CALL(frame, SetData(::testing::_))
+        .WillByDefault([data](ArrayView<const uint8_t> bytes) {
+          data->assign(bytes.begin(), bytes.end());
+        });
+  }
+
+  static constexpr uint32_t kSsrc = 1234;
+  const std::vector<uint8_t> trailer_ = {'s', 'i', 'f', 0xaa};
+  MediaType media_;
+  bool started_ = false;
+  RTPVideoHeader video_header_;
+  std::unique_ptr<Thread> signaling_thread_;
+  scoped_refptr<DefaultKeyProviderImpl> provider_;
+  scoped_refptr<FrameCryptorTransformer> transformer_;
+  scoped_refptr<FrameTransformerInterface> interface_;
+  std::shared_ptr<Event> completed_;
+  scoped_refptr<Sink> sink_;
+  scoped_refptr<Observer> observer_;
+};
+
+TEST(SifTransform, ForwardsKnownAudioAndVideoWithoutKeyAndStripsTrailer) {
+  const std::vector<std::pair<MediaType, std::vector<uint8_t>>> cases = {
+      {MediaType::kVideoFrame, kVp8KeyFrame8x8},
+      {MediaType::kVideoFrame,
+       Concat({kStartCode4, kH264Sps, kStartCode4, kH264Pps, kStartCode4, kH264Idr})},
+      {MediaType::kVideoFrame, Concat({kStartCode4, kH264Idr})},
+      {MediaType::kAudioFrame, OpusSilence()},
+      {MediaType::kAudioFrame, Concat({{0x6f}, OpusSilence()})},
+      {MediaType::kAudioFrame, std::vector<uint8_t>(160, 0xff)},
+      {MediaType::kAudioFrame, std::vector<uint8_t>(160, 0xd5)},
+  };
+  for (const auto& entry : cases) {
+    NativeTransform transform(entry.first);
+    const bool submitted = transform.Submit(entry.second);
+    const bool returned = transform.WaitForFrame();
+    const bool retired = transform.WaitForRetirement();
+    const auto observed = transform.Finish();
+    EXPECT_TRUE(observed.started);
+    EXPECT_TRUE(submitted);
+    EXPECT_TRUE(retired);
+    EXPECT_TRUE(returned);
+    EXPECT_EQ(observed.frames,
+              std::vector<std::vector<uint8_t>>{entry.second});
+  }
+}
+
+TEST(SifTransform, RejectsForeignTrailerPayloadWithAndWithoutKeyOnBothMediaPaths) {
+  for (auto media : {MediaType::kAudioFrame, MediaType::kVideoFrame}) {
+    for (bool key : {false, true}) {
+      NativeTransform transform(media, key);
+      const bool submitted = transform.Submit(std::vector<uint8_t>(500, 0x7a));
+      const bool failed = transform.WaitForState();
+      const bool retired = transform.WaitForRetirement();
+      const auto observed = transform.Finish();
+      EXPECT_TRUE(observed.started);
+      EXPECT_TRUE(submitted);
+      EXPECT_TRUE(retired);
+      EXPECT_TRUE(failed);
+      EXPECT_TRUE(observed.frames.empty());
+      EXPECT_EQ(observed.states,
+                std::vector<FrameCryptionState>{kDecryptionFailed});
+    }
+  }
+}
+
+TEST(SifTransform, KeepsDisabledAndEmptyBehaviorForBothDiscardPolicies) {
+  for (auto media : {MediaType::kAudioFrame, MediaType::kVideoFrame}) {
+    for (bool discard : {false, true}) {
+      for (bool empty : {false, true}) {
+        NativeTransform transform(media, false, false, discard);
+        const auto input = empty ? std::vector<uint8_t>() : kVp8KeyFrame8x8;
+        const bool submitted = transform.Submit(input, false);
+        // Wait for actual frame retirement even when no callback is expected;
+        // do not unregister the sink before the branch has run.
+        const bool returned = discard ? false : transform.WaitForFrame();
+        const bool retired = transform.WaitForRetirement();
+        const auto observed = transform.Finish();
+        EXPECT_TRUE(observed.started);
+        EXPECT_TRUE(submitted);
+        EXPECT_TRUE(retired);
+        if (discard) {
+          EXPECT_TRUE(observed.frames.empty());
+        } else {
+          EXPECT_TRUE(returned);
+          EXPECT_EQ(observed.frames, std::vector<std::vector<uint8_t>>{input});
+        }
+      }
+    }
+  }
+}
+
+TEST(SifTransform, OrdinaryAuthenticatedMediaStillRoundTripsOnBothMediaPaths) {
+  for (auto media : {MediaType::kAudioFrame, MediaType::kVideoFrame}) {
+    NativeTransform sender(media, true);
+    const bool sent = sender.Submit(kVp8KeyFrame8x8, false, Direction::kSender);
+    const bool encrypted = sender.WaitForFrame();
+    const bool sender_retired = sender.WaitForRetirement();
+    const auto encrypted_observed = sender.Finish();
+    EXPECT_TRUE(encrypted_observed.started);
+    EXPECT_TRUE(sent);
+    EXPECT_TRUE(sender_retired);
+    EXPECT_TRUE(encrypted);
+    if (encrypted_observed.frames.size() != 1) {
+      ADD_FAILURE() << "expected one synthetic encrypted frame";
+      continue;
+    }
+    NativeTransform receiver(media, true);
+    const bool submitted = receiver.Submit(encrypted_observed.frames.front(), false);
+    const bool returned = receiver.WaitForFrame();
+    const bool state_returned = receiver.WaitForState();
+    const bool retired = receiver.WaitForRetirement();
+    const auto observed = receiver.Finish();
+    EXPECT_TRUE(observed.started);
+    EXPECT_TRUE(submitted);
+    EXPECT_TRUE(retired);
+    EXPECT_TRUE(returned);
+    EXPECT_TRUE(state_returned);
+    EXPECT_EQ(observed.frames,
+              std::vector<std::vector<uint8_t>>{kVp8KeyFrame8x8});
+    EXPECT_EQ(observed.states, std::vector<FrameCryptionState>{kOk});
+  }
+}
