+TEST(KeyProvider, CopiesPreserveDiscardFrameWhenCryptorNotReady) {
+  KeyProviderOptions original;
+  EXPECT_FALSE(original.discard_frame_when_cryptor_not_ready);
+  for (bool discard : {false, true}) {
+    original.discard_frame_when_cryptor_not_ready = discard;
+    KeyProviderOptions copied(original);
+    KeyProviderOptions copied_again(copied);
+    auto provider = make_ref_counted<DefaultKeyProviderImpl>(copied_again);
+    EXPECT_EQ(copied.discard_frame_when_cryptor_not_ready, discard);
+    EXPECT_EQ(copied_again.discard_frame_when_cryptor_not_ready, discard);
+    EXPECT_EQ(provider->options().discard_frame_when_cryptor_not_ready, discard);
+  }
+}
