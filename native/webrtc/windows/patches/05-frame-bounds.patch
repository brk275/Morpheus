+TEST(SifTransform, RejectsShortEncryptedHeadersIvAndTags) {
+  for (auto media : {MediaType::kAudioFrame, MediaType::kVideoFrame}) {
+    const size_t header = media == MediaType::kAudioFrame ? 1 : 10;
+    std::vector<std::vector<uint8_t>> cases = {{0}, {12, 0}};
+    for (size_t encrypted_bytes : {size_t{7}, size_t{29}}) {
+      std::vector<uint8_t> data(header + encrypted_bytes, 0x42);
+      data[data.size() - 2] = 12;
+      data[data.size() - 1] = 0;
+      cases.push_back(std::move(data));
+    }
+    for (auto data : cases) {
+      NativeTransform transform(media, true);
+      const bool submitted = transform.Submit(std::move(data), false);
+      const bool failed = transform.WaitForState();
+      const bool retired = transform.WaitForRetirement();
+      const auto observed = transform.Finish();
+      EXPECT_TRUE(observed.started);
+      EXPECT_TRUE(submitted);
+      EXPECT_TRUE(failed);
+      EXPECT_TRUE(retired);
+      EXPECT_TRUE(observed.frames.empty());
+      EXPECT_EQ(observed.states,
+                std::vector<FrameCryptionState>{kDecryptionFailed});
+    }
+  }
+}
