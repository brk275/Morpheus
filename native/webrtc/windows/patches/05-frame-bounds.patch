+TEST(SifTransform, RejectsRbspWhichShrinksBelowTheAuthenticatedRecord) {
+  std::vector<VideoCodecType> codecs = {VideoCodecType::kVideoCodecH264};
+#ifdef RTC_ENABLE_H265
+  codecs.push_back(VideoCodecType::kVideoCodecH265);
+#endif
+  for (auto codec : codecs) {
+    auto data = Concat({kStartCode4,
+                       codec == VideoCodecType::kVideoCodecH264
+                           ? std::vector<uint8_t>{0x65, 0x88}
+                           : std::vector<uint8_t>{0x00, 0x01}});
+    for (int i = 0; i < 10; ++i) {
+      data.insert(data.end(), {0x00, 0x00, 0x03});
+    }
+    data.insert(data.end(), {12, 0});
+    NativeTransform transform(MediaType::kVideoFrame, true, true, false, codec);
+    const bool submitted = transform.Submit(std::move(data), false);
+    const bool failed = transform.WaitForState();
+    const bool retired = transform.WaitForRetirement();
+    const auto observed = transform.Finish();
+    EXPECT_TRUE(observed.started);
+    EXPECT_TRUE(submitted);
+    EXPECT_TRUE(failed);
+    EXPECT_TRUE(retired);
+    EXPECT_TRUE(observed.frames.empty());
+    EXPECT_EQ(observed.states,
+              std::vector<FrameCryptionState>{kDecryptionFailed});
+  }
+}
