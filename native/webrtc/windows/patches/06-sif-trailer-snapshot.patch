+TEST(KeyProvider, SifTrailerSnapshotsStayCoherentDuringUpdates) {
+  KeyProviderOptions options;
+  scoped_refptr<KeyProvider> provider =
+      make_ref_counted<DefaultKeyProviderImpl>(options);
+  const std::vector<uint8_t> first(257, 0x42);
+  const std::vector<uint8_t> second(509, 0x71);
+  const bool initially_empty = provider->GetSifTrailer().empty();
+  provider->SetSifTrailer(first);
+  const auto retained_snapshot = provider->GetSifTrailer();
+  provider->SetSifTrailer(second);
+  const auto updated_snapshot = provider->GetSifTrailer();
+  std::atomic<bool> failed{false};
+  size_t reads = 0;
+  // Declared after every object captured by reference. If the second thread
+  // cannot be constructed, destruction still releases and joins the first.
+  struct JoinedThreads {
+    Event start{true, false};
+    std::thread writer;
+    std::thread reader;
+    void Join() {
+      start.Set();
+      if (writer.joinable()) writer.join();
+      if (reader.joinable()) reader.join();
+    }
+    ~JoinedThreads() { Join(); }
+  } threads;
+  threads.writer = std::thread([provider, &threads, &failed, &first, &second] {
+    if (!threads.start.Wait(TimeDelta::Seconds(5))) {
+      failed.store(true);
+      return;
+    }
+    for (size_t i = 0; i < 4096; ++i) {
+      provider->SetSifTrailer(i % 2 == 0 ? first : second);
+    }
+  });
+  threads.reader = std::thread([provider, &threads, &failed, &first, &second,
+                                &reads] {
+    if (!threads.start.Wait(TimeDelta::Seconds(5))) {
+      failed.store(true);
+      return;
+    }
+    for (size_t i = 0; i < 4096; ++i) {
+      const auto snapshot = provider->GetSifTrailer();
+      if (snapshot != first && snapshot != second) failed.store(true);
+      ++reads;
+    }
+  });
+  threads.Join();
+  provider->SetSifTrailer({});
+  const bool cleared = provider->GetSifTrailer().empty();
+  EXPECT_TRUE(initially_empty);
+  EXPECT_EQ(retained_snapshot, first);
+  EXPECT_EQ(updated_snapshot, second);
+  EXPECT_FALSE(failed.load());
+  EXPECT_EQ(reads, 4096u);
+  EXPECT_TRUE(cleared);
+}
