  * we avoid "cluttering" pre-defined exit status codes by using 127 which
  * is known to alias an application exit status and also known as launcher
  * error, see SYSTEM(3POSIX).
  */
 #define EXIT_EXECERROR  127     /* Execution error exit status.  */
+
+/* Fixed post-wait observations only. Never change child/cleanup status. */
+#define MORPHEUS_WAIT_RECORD_CAPACITY 96
+
+enum morpheus_cleanup_state {
+    MORPHEUS_CLEANUP_SKIPPED,
+    MORPHEUS_CLEANUP_PASSED,
+    MORPHEUS_CLEANUP_FAILED
+};
+
+static size_t morpheus_wait_record(char *buffer, size_t capacity,
+                                 pid_t expected, pid_t observed, int raw_status,
+                                 enum morpheus_cleanup_state cleanup) {
+    const char prefix[] = "\nMORPHEUS_APPIMAGE_WAIT_V1 ";
+    const char separator[] = " cleanup=";
+    const char *cleanup_names[] = {"skipped", "passed", "failed"};
+    const char *kind = "wait=other";
+    unsigned int number = 0;
+    size_t digits = 0;
+    if (buffer == NULL || capacity == 0 || capacity > MORPHEUS_WAIT_RECORD_CAPACITY)
+        return 0;
+    buffer[0] = '\0';
+    if ((unsigned int) cleanup >= sizeof(cleanup_names) / sizeof(cleanup_names[0]))
+        return 0;
+    if (expected > 0 && observed == -1) {
+        kind = "wait=failed";
+    } else if (expected > 0 && observed == expected && raw_status >= 0 && raw_status <= 0xffff) {
+        if (WIFEXITED(raw_status) && (raw_status & 0xff) == 0) {
+            kind = "exit=";
+            number = (unsigned int) WEXITSTATUS(raw_status);
+            digits = number >= 100 ? 3 : number >= 10 ? 2 : 1;
+        } else if (WIFSIGNALED(raw_status) && (raw_status & 0xff00) == 0
+                   && WTERMSIG(raw_status) >= 1 && WTERMSIG(raw_status) <= 64) {
+            kind = "signal=";
+            number = (unsigned int) WTERMSIG(raw_status);
+            digits = number >= 10 ? 2 : 1;
+        }
+    }
+    size_t kind_size = strlen(kind);
+    size_t cleanup_size = strlen(cleanup_names[cleanup]);
+    size_t length = sizeof(prefix) - 1 + kind_size + digits + sizeof(separator) - 1 + cleanup_size + 1;
+    if (length >= capacity || length > PIPE_BUF)
+        return 0;
+    size_t offset = 0;
+    memcpy(buffer + offset, prefix, sizeof(prefix) - 1);
+    offset += sizeof(prefix) - 1;
+    memcpy(buffer + offset, kind, kind_size);
+    offset += kind_size;
+    if (digits == 3) {
+        buffer[offset++] = (char) ('0' + number / 100);
+        number %= 100;
+    }
+    if (digits >= 2) {
+        buffer[offset++] = (char) ('0' + number / 10);
+        number %= 10;
+    }
+    if (digits != 0)
+        buffer[offset++] = (char) ('0' + number);
+    memcpy(buffer + offset, separator, sizeof(separator) - 1);
+    offset += sizeof(separator) - 1;
+    memcpy(buffer + offset, cleanup_names[cleanup], cleanup_size);
+    offset += cleanup_size;
+    buffer[offset++] = '\n';
+    buffer[offset] = '\0';
+    return offset;
+}
+
+static bool morpheus_same_pipe(const struct stat *expected, const struct stat *observed) {
+    return S_ISFIFO(expected->st_mode) && S_ISFIFO(observed->st_mode)
+        && expected->st_dev == observed->st_dev && expected->st_ino == observed->st_ino
+        && expected->st_uid == observed->st_uid && expected->st_gid == observed->st_gid;
+}
+
+static void morpheus_emit_wait_record(const char *record, size_t length) {
+    const int saved_errno = errno;
+    int guard = -1, output = -1;
+    struct stat original, reader, writer, current;
+    int original_flags;
+    if (record == NULL || length == 0 || length >= MORPHEUS_WAIT_RECORD_CAPACITY || length > PIPE_BUF
+            || fstat(STDERR_FILENO, &original) != 0 || !S_ISFIFO(original.st_mode)
+            || original.st_uid != geteuid())
+        goto done;
+    original_flags = fcntl(STDERR_FILENO, F_GETFL);
+    if (original_flags == -1 || (original_flags & (O_ASYNC | O_DIRECT))
+            || ((original_flags & O_ACCMODE) != O_WRONLY && (original_flags & O_ACCMODE) != O_RDWR))
+        goto done;
+    /* A separate read OFD pins a reader until after write: even a disappeared
+     * collector cannot make our write generate SIGPIPE. Never read this FD. */
+    guard = open("/proc/self/fd/2", O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (guard == -1 || fstat(guard, &reader) != 0 || !morpheus_same_pipe(&original, &reader))
+        goto done;
+    /* Reopening gives independent file flags. No F_SETFL, dup, signal change,
+     * regular-file write, retry or fallback to the original stderr is allowed. */
+    output = open("/proc/self/fd/2", O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    if (output == -1 || fstat(output, &writer) != 0 || !morpheus_same_pipe(&original, &writer)
+            || fstat(STDERR_FILENO, &current) != 0 || !morpheus_same_pipe(&original, &current)
+            || fcntl(STDERR_FILENO, F_GETFL) != original_flags)
+        goto done;
+    /* One bounded atomic pipe write, best effort. Full pipes skip with EAGAIN.
+     * Reporting failures must not replace the actual child or cleanup result. */
+    (void) write(output, record, length);
+done:
+    if (output != -1)
+        (void) close(output);
+    if (guard != -1)
+        (void) close(guard);
+    errno = saved_errno;
+}
+
+static void morpheus_observe_payload_wait(pid_t expected, pid_t observed, int raw_status,
+                                         enum morpheus_cleanup_state cleanup) {
+    const int saved_errno = errno;
+    char record[MORPHEUS_WAIT_RECORD_CAPACITY];
+    size_t length = morpheus_wait_record(record, sizeof(record), expected, observed, raw_status, cleanup);
+    if (length != 0)
+        morpheus_emit_wait_record(record, length);
+    errno = saved_errno;
+}
 
