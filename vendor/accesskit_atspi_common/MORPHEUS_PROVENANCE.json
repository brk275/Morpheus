  ],
  "behavior": [
    "Visible enabled/read-write textual inputs with their own string SetValue capability expose EditableText.",
    "SetTextContents rejects more than1048576UTF8bytes; live node/ancestor eligibility and request construction share one tree lock, dropped before action dispatch.",
    "Password input requires neither readable value nor text ranges.",
    "Unit coverage verifies unicode/password identity and dispatch after lock release, state/lifecycle/hidden/disabled/numeric/defunct/size refusal."
  ],
  "dependencies": "Exact same locked versions and original normalized manifests; no build hooks, new dependencies or feature changes."
