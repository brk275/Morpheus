  "behavior": [
    "Register/unregister standard org.a11y.atspi.EditableText with exact protocol signatures.",
    "Only whole-field SetTextContents dispatches the existing string action. Copy/cut/delete/insert/paste return explicit NotSupported without clipboard/action side effects.",
    "Unit coverage verifies protocol success/refusal and defunct-node failure."
  ],
  "dependencies": "Exact same locked versions and original normalized manifests; no build hooks, new dependencies or feature changes."
